* text=auto eol=lf
*.lua text eol=lf
*.cub text eol=lf
*.md text eol=lf
*.json5 text eol=lf
*.cpk binary
*.stp binary
*.fnt binary
*.img binary
*.txt text eol=lf

# GitHub language statistics: only the system counts. tools/ holds developer tools (builders, test runners), not part of
# CubeOS; .cuh are Cubic headers (not CUDA), .csc are note scores (not GSC)
tools/** linguist-vendored
*.cuh linguist-detectable=false
*.csc linguist-detectable=false
