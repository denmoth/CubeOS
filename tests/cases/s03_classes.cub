#!strict
class Animal:
    def init(self, name: str):
        self.name = name

    def speak(self) -> str:
        return self.name .. " makes a sound"

class Dog(Animal):
    def speak(self) -> str:
        return self.name .. " barks"

d = Dog("Rex")
print(d:speak())
a: Animal = d
print(a:speak())

class MyErr(Error):
    pass

try:
    raise MyErr("bad")
except MyErr as e:
    print(e.message)
