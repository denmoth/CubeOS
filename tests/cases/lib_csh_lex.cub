import t
import csh.lex as lex
eq = t.eq

toks = lex.tokens("ls -l | grep 'a b' > out.txt &")
eq(len(toks), 8, "eight tokens")
eq(toks[1].raw, "ls", "first word")
eq(toks[3].kind, "op", "pipe is an operator")
eq(toks[4].raw, "grep", "word after pipe")
eq(toks[5].raw, "'a b'", "quoted word is one token")
eq(toks[5].s, 14, "token start")
eq(toks[8].raw, "&", "ampersand")

v, g = lex.expand("\"hi $USER\"", {USER: "bob"})
eq(v, "hi bob", "double quotes expand variables")
v, g = lex.expand("'hi $USER'", {USER: "bob"})
eq(v, "hi $USER", "single quotes do not")
v, g = lex.expand("~/x", {HOME: "/home"})
eq(v, "/home/x", "tilde")
v, g = lex.expand("*.lua", {})
eq(g, true, "wildcard is noticed")
v, g = lex.expand("'*'", {})
eq(g, false, "quoted wildcard is not a glob")
v, g = lex.expand("${A}b$?", {A: "x", "?": 3})
eq(v, "xb3", "braces and status")

chains, err = lex.parse(lex.tokens("a | b c > f; d && e || g &"))
eq(err, nil, "parses")
eq(len(chains), 4, "four chains")
eq(len(chains[1].stages), 2, "pipeline of two")
eq(chains[1].stages[2].words[2], "c", "args")
eq(chains[1].stages[2].redirs[1].target, "f", "redirect target")
eq(chains[1].sep, ";", "separator")
eq(chains[2].sep, "&&", "and")
eq(chains[3].sep, "||", "or")
eq(chains[4].sep, "&", "background")
chains, err = lex.parse(lex.tokens("a |"))
eq(chains, nil, "dangling pipe is an error")
chains, err = lex.parse(lex.tokens("a >"))
eq(chains, nil, "missing redirect target is an error")
print("done")
