import t
import cfs.path as p
import cfs.errors as errors
eq = t.eq

eq(p.normalize("/a//b/./c/../d"), "/a/b/d", "normalize")
eq(p.normalize("/../.."), "/", "normalize above root")
eq(p.normalize("a/b"), "/a/b", "normalize relative")
eq(p.split("/a/b/c"), ["a", "b", "c"], "split")
eq(p.split("/"), [], "split root")
eq(p.join("/a/b", "c"), "/a/b/c", "join relative")
eq(p.join("/a/b", "/x"), "/x", "join absolute")
eq(p.join("/a/b", "../c"), "/a/c", "join parent")
eq(p.parent("/a/b/c"), "/a/b", "parent")
eq(p.parent("/a"), "/", "parent of top")
eq(p.parent("/"), "/", "parent of root")
eq(p.basename("/a/b/c.txt"), "c.txt", "basename")
eq(p.extension("c.tar.gz"), "gz", "extension")
eq(p.extension("README"), nil, "no extension")

eq(p.is_hidden(".cache"), true, "hidden")
eq(p.is_hidden("a.cache"), false, "not hidden")
eq(p.is_important("/cubeos/!boot/x"), true, "important dir")
eq(p.is_important("/cubeos/boot/x"), false, "not important")
eq(p.is_important("/a/!x"), true, "important file")
eq(p.is_inside("/a/b/c", "/a/b"), true, "inside")
eq(p.is_inside("/a/bc", "/a/b"), false, "not inside prefix only")
eq(p.is_inside("/a/b", "/a/b"), true, "inside itself")
eq(p.is_inside("/x", "/"), true, "inside root")

# имена
eq(p.name_problem("файл.txt"), nil, "cyrillic name ok")
eq(p.name_problem("Привет мир"), nil, "cyrillic with space ok")
eq(p.name_problem(""), "empty name", "empty")
eq(p.name_problem(".."), "reserved name", "dotdot")
eq(p.name_problem("a:b") != nil, true, "colon")
eq(p.name_problem("a*b") != nil, true, "star")
eq(p.name_problem("a|b") != nil, true, "pipe")
eq(p.name_problem("a\"b") != nil, true, "quote")
eq(p.name_problem("a\tb") != nil, true, "control char")
eq(p.name_problem("end ") != nil, true, "trailing space")
eq(p.name_problem("end.") != nil, true, "trailing dot")
eq(p.name_problem(string.rep("a", 64)), nil, "64 bytes ok")
eq(p.name_problem(string.rep("a", 65)) != nil, true, "65 bytes too long")
ok, e = pcall(p.check_name, "a?b", "/x/a?b")
eq(ok, false, "check_name raises")
eq(e.code, "ENAME", "check_name code")

# алиасы
al = {home: "/users/ivan/home", docs: "$home/documents", user: "/users/ivan", loop1: "$loop2", loop2: "$loop1"}
eq(p.expand("$home/a.txt", al), "/users/ivan/home/a.txt", "alias")
eq(p.expand("$docs/x", al), "/users/ivan/home/documents/x", "nested alias")
eq(p.expand("/plain/path", al), "/plain/path", "no alias")
eq(p.expand("$user", al), "/users/ivan", "alias only")
ok, e = pcall(p.expand, "$loop1/x", al)
eq(ok, false, "alias cycle raises")
eq(e.code, "ELOOP", "alias cycle code")
ok, e = pcall(p.expand, "$nope/x", al)
eq(e.code, "EINVAL", "unknown alias code")

# шаблоны
eq(p.match("/a/**", "/a/b/c"), true, "doublestar deep")
eq(p.match("/a/**", "/a"), true, "doublestar zero")
eq(p.match("/a/*", "/a/b"), true, "star one")
eq(p.match("/a/*", "/a/b/c"), false, "star not deep")
eq(p.match("/a/*.cub", "/a/x.cub"), true, "star ext")
eq(p.match("/a/*.cub", "/a/x.lua"), false, "star ext mismatch")
eq(p.match("/**/x", "/a/b/x"), true, "leading doublestar")
eq(p.match("/users/*/public/**", "/users/ivan/public/a/b"), true, "users public")
eq(p.match("/users/*/public/**", "/users/ivan/private/a"), false, "users private")
eq(p.match("/a/f?le", "/a/file"), true, "question")
eq(p.match("/a/файл*", "/a/файл1"), true, "cyrillic star")
eq(p.specificity("/cubeos/sys/sec/**") > p.specificity("/cubeos/sys/**"), true, "specificity")
eq(p.specificity("/cubeos/sys/**") > p.specificity("/cubeos/*/**"), true, "literal beats star")

e = errors.CfsError("EACCES", "no way", "/x")
eq(e.code, "EACCES", "error code")
eq(errors.is_code(e, "EACCES"), true, "is_code")
eq(isinstance(e, Error), true, "is an Error")
print("done")
