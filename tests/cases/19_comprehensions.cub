def show(t): return table.concat(t, ",")
squares = [x * x for x in range[1, 5]]
print(show(squares))
evens = [x for x in [1, 2, 3, 4, 5, 6] if x % 2 == 0]
print(show(evens))
combos = [a * 10 + b for a in range[1, 2] for b in range[1, 3] if a != b]
print(show(combos))
words = {w: len(w) for w in ["a", "bb", "ccc"]}
print(words.a, words.bb, words.ccc)
ternary = [x if x > 2 else 0 for x in [1, 2, 3, 4]]
print(show(ternary))
nested = [[i * j for j in range[1, 2]] for i in range[1, 2]]
print(show(nested[1]), show(nested[2]))
fs_list = [() => i for i in range[1, 3]]
print(fs_list[1](), fs_list[3]())
idx = {k: v for k, v in ["x", "y"]}
print(idx[1], idx[2])
base = 100
shifted = [base + n for n in range[1, 3]]
print(show(shifted))
