import t
import cfs
import boot
import boot.auth as auth_mod
import boot.console as console_mod
import kernel.cc as cckernel
import svc.logd as logd
import svc.timed as timed
import svc.devd as devd
import svc.powerd as powerd
import svc.crashd as crashd
import svc.permd as permd
import svc.notifyd as notifyd
import svc.clipboard as clipboard
import svc.stub as stub
import svc.fontd as fontd
import svc.inputd as inputd
eq = t.eq

# Пароль, набранный на настоящем экране входа, не попадает в журналы: ни символами, ни строками на каждое нажатие (D196, D220).
# Всё настоящее: загрузка со службами и logd, TermConsole, события идут через очередь CC и kernel.cc.pull в ядро, как в игре.

clock = {now: 1000}
def now():
    return clock.now

modules = {"svc.logd": logd, "svc.timed": timed, "svc.devd": devd, "svc.powerd": powerd, "svc.crashd": crashd, "svc.permd": permd,
    "svc.notifyd": notifyd, "svc.clipboard": clipboard, "svc.stub": stub, "svc.fontd": fontd, "svc.inputd": inputd}
def importer(path):
    return modules[path]

def read(path):
    f = fs.open(path, "r")
    text = f.readAll()
    f.close()
    return text

def breathe():
    os.queueEvent("test_breathe")
    os.pullEvent("test_breathe")

PASSWORD = "qjxzvkQJXZ"

fsys = cfs.new({clock: now})
fsys:mount("/", cfs.memory({now: now}))
fsys:mount("/cubeos/tmp", cfs.tmp(65536, now))
cfs.install_defaults(fsys)
fsys:mkdir(nil, "/cubeos/sys/services", {parents: true})
fsys:mkdir(nil, "/cubeos/sys/cfg", {parents: true})
fsys:mkdir(nil, "/cubeos/var", {parents: true})
for name in fs.list("/repo/sys/services"):
    fsys:write_file(nil, "/cubeos/sys/services/" .. name, read("/repo/sys/services/" .. name))
fsys:write_file(nil, "/cubeos/sys/cfg/boot.conf", "{rounds: 2}")
# debug: журнал пишет всё, что вообще пишется, так утечку не спрячет уровень
fsys:write_file(nil, "/cubeos/sys/cfg/log.conf", "{level: \"debug\"}")
users = auth_mod.Auth(fsys, {rounds: 2})
users:load()
users:create_user({name: "alice"}, PASSWORD, true)

state = {shell: false}
def idle_shell(sys, args):
    state.shell = true
    sys.wait_event(["test_never"])
def make_shell(session):
    return idle_shell

# журнал ввода включён с загрузки (пункт меню «CubeOS (input log)»): даже он не должен видеть пароль
system = boot.new({fsys: fsys, console: console_mod.TermConsole(), clock: now, import: importer, shell: make_shell,
    power: {shutdown: () => nil, reboot: () => nil}, kernel: {clock: now}, input_log: true}):start()

def settle(steps=20):
    for i in range[1, steps]:
        if i % 5 == 0:
            breathe()
        system.kernel:run_ready()
        clock.now = clock.now + 100
        system.kernel:tick()
    system.kernel:run_ready()

# одно событие ввода так, как его получает ядро в игре: очередь CC -> kernel.cc.pull -> kernel:feed
def send(name, a):
    os.queueEvent(name, a)
    for i in range[1, 50]:
        ev = cckernel.pull(0)
        if ev != nil and ev[1] == name:
            system.kernel:feed(ev[1], ev[2], ev[3])
            break
    settle(3)

def press(code):
    send("key", code)
    send("key_up", code)

def deliver(name):
    for i in range[1, 50]:
        ev = cckernel.pull(0)
        if ev != nil and ev[1] == name:
            system.kernel:feed(ev[1], ev[2], ev[3])
            break

def type_text(text):
    for i in range[1, len(text)]:
        c = string.sub(text, i, i)
        k = keys[string.lower(c)]
        if k != nil:
            os.queueEvent("key", k)
            deliver("key")
        os.queueEvent("char", c)
        deliver("char")
        settle(3)
        if k != nil:
            send("key_up", k)

# всё, что лежит в журналах (файлы /cubeos/var/log и журнал ядра в памяти)
def all_logs():
    parts = []
    for e in fsys:list(nil, "/cubeos/var/log"):
        n = type(e) == "table" and e.name or e
        parts[len(parts) + 1] = "== " .. n .. "\n" .. fsys:read_file(nil, "/cubeos/var/log/" .. n)
    for r in system.kernel.records:
        parts[len(parts) + 1] = r.text .. "\n"
    return table.concat(parts)

def count_lines(text):
    n = 0
    for line in string.gmatch(text, "[^\n]+"):
        n += 1
    return n

breathe()
settle(60)
eq(system.services:state("logd"), "running", "logd is running")

# выбор пользователя (первое событие ввода ядро отмечает в журнале один раз, это не утечка)
type_text("1")
press(keys.enter)
settle(10)

before = all_logs()
type_text(PASSWORD)
settle(10)
after = all_logs()
eq(count_lines(after) - count_lines(before), 0, "typing the password adds no log lines at all")

press(keys.enter)
settle(40)
eq(state.shell, true, "the password is accepted and the session shell starts")

text = all_logs()
eq(string.find(text, PASSWORD, 1, true), nil, "the password is not in the logs")
eq(string.find(string.lower(text), "qjxz", 1, true), nil, "no part of it either")
eq(string.find(text, "login input", 1, true), nil, "no input diagnostics from the login screen")

# журнал ввода: обычные клавиши видны (с миллисекундами и получателем), пароль только одной строкой без длины
input = fsys:read_file(nil, "/cubeos/var/log/input.log")
eq(string.find(input, "^# input log created %d+") != nil, true, "the input log starts with its creation time")
eq(string.find(input, "char \"1\" %-> %d+ login %(waiting for input%)") != nil, true, "an ordinary key is logged with its receiver")
eq(string.find(input, "%d%d:%d%d:%d%d%.%d%d%d") != nil, true, "lines have milliseconds")
eq(string.find(input, "secret input entered in %d+ login %(hidden%)") != nil, true, "the password is one hidden line")
for i in range[1, len(PASSWORD)]:
    ch = string.sub(PASSWORD, i, i)
    eq(string.find(input, "char \"" .. ch .. "\"", 1, true), nil, "no password character in the input log: " .. ch)
eq(string.find(input, "(10", 1, true) == nil and string.find(input, " 10 ", 1, true) == nil, true, "not even the password length")
print("done")
