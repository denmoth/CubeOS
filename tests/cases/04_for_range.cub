for i in range[1, 3]:
    print(i)
print("--")
for i in range[1, 3):
    print(i)
print("--")
for i in range(1, 3]:
    print(i)
print("--")
for i in range(1, 4):
    print(i)
print("--")
for i in range[0, 10) step 4:
    print(i)
print("--")
for i in range[3, 1] step -1:
    print(i)
print("--")
n = 3
for i in range[0, n):
    print(i * i)
