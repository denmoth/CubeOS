import t
import std.path as p
eq = t.eq
eq(p.normalize("/a/b/../c/./d"), "/a/c/d", "normalize")
eq(p.normalize("a//b/"), "a/b", "normalize rel")
eq(p.normalize("../x"), "../x", "normalize up")
eq(p.normalize("/.."), "/", "normalize root")
eq(p.normalize(""), ".", "normalize empty")
eq(p.join("a", "b", "c"), "a/b/c", "join")
eq(p.join("/a", "/b"), "/b", "join abs")
eq(p.join("a", "", "b"), "a/b", "join skip")
eq(p.join("a", "../b"), "b", "join up")
eq(p.dirname("/a/b/c.txt"), "/a/b", "dirname")
eq(p.dirname("c.txt"), ".", "dirname none")
eq(p.dirname("/c"), "/", "dirname root")
eq(p.basename("/a/b/c.txt"), "c.txt", "basename")
eq(p.extension("c.tar.gz"), ".gz", "ext")
eq(p.extension("noext"), "", "no ext")
eq(p.stem("c.tar.gz"), "c.tar", "stem")
eq(p.split("/a/b"), ["a", "b"], "split")
eq(p.is_absolute("/x"), true, "abs")
eq(p.relative("/a/b/c", "/a/d"), "../b/c", "relative")
eq(p.relative("/a/b", "/a/b"), ".", "relative same")
print("done")
