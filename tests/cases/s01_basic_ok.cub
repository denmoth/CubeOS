def add(a: num, b: num) -> num:
    return a + b

print(add(2, 3))

def greet(who: str, greeting: str? = nil) -> str:
    if greeting == nil:
        return "hello " .. who
    return greeting .. " " .. who

print(greet("bob"), greet("ann", "hi"))

class Point:
    x: num
    y: num

    def init(self, x: num, y: num):
        self.x = x
        self.y = y

    def len2(self) -> num:
        return self.x * self.x + self.y * self.y

p = Point(3, 4)
print(p:len2(), p.x)

config = {name: "base", size: 10}
