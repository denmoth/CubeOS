import t
import term.vterm as vterm
import term.chars as chars
eq = t.eq

def rows(vt):
    out = []
    for y in range[1, vt.h]:
        out[y] = vt:line_text(y)
    return out

# ---------------------------------------------------------------- символы
eq(chars.to_cp(65), 65, "ascii")
eq(chars.to_cp(0xE9), 0xE9, "Latin-1")
eq(chars.to_cp(150), 0xE096, "teletext is a raw code")
eq(chars.to_byte(0xE096), 150, "and back to the byte")
eq(chars.to_byte(65), 65, "ascii to byte")
eq(chars.to_byte(0x4E2D), 63, "unknown is a question mark")
eq(chars.is_teletext(0xE096), true, "teletext check")
eq(chars.is_teletext(65), false, "not teletext")
eq(chars.low_glyph(chars.to_cp(26)), 0x2192, "CC arrow to Unicode arrow")
eq(chars.teletext_bits(159), 31, "teletext bits")

# ---------------------------------------------------------------- запись
vt = vterm.new(10, 3)
vt:write("Hello")
eq(rows(vt), ["Hello     ", "          ", "          "], "write")
cx, cy = vt:getCursorPos()
eq([cx, cy], [6, 1], "cursor after write")
vt:setCursorPos(8, 1)
vt:write("abcdef")
eq(vt:line_text(1), "Hello  abc", "text beyond the edge is cut")
cx, cy = vt:getCursorPos()
eq(cx, 14, "but the cursor still moves")
vt:setCursorPos(1, 2)
vt:write(42)
eq(vt:line_text(2), "42        ", "numbers are written as text")
ok, err = pcall(vt.write, vt, {})
eq(ok, false, "tables are rejected")
eq(string.find(err, "string expected, got table", 1, true) != nil, true, "error text like CC")
vt:setCursorPos(0, 1)
vt:write("xy")
eq(vt:line_text(1), "yello  abc", "negative columns are cut on the left")
vt:setCursorPos(1, 99)
vt:write("nope")
eq(vt:line_text(3), "          ", "writing outside the screen does nothing")

# ---------------------------------------------------------------- цвета
vt2 = vterm.new(6, 2)
vt2:setTextColor(colors.red)
vt2:setBackgroundColor(colors.blue)
eq(vt2:getTextColor(), colors.red, "text color")
eq(vt2:getBackgroundColor(), colors.blue, "background color")
vt2:write("ab")
eq(vt2.fg[1][1], 14, "red is index 14")
eq(vt2.bg[1][1], 11, "blue is index 11")
eq(vt2.fg[1][3], 0, "untouched cell keeps its colors")
ok, err = pcall(vt2.setTextColor, vt2, 3)
eq(ok, false, "invalid color value")
eq(string.find(err, "Invalid color (got 3)", 1, true) != nil, true, "error text like CC")
vt2:setCursorPos(1, 2)
vt2:blit("abc", "0e5", "fff")
eq(vt2.fg[2][2], 14, "blit foreground e is red")
eq(vt2.bg[2][3], 15, "blit background f is black")
eq(vt2:line_blit(2, "fg"):sub(1, 3), "0e5", "line_blit fg")
ok, err = pcall(vt2.blit, vt2, "ab", "0", "00")
eq(ok, false, "blit lengths must match")
eq(string.find(err, "Arguments must be the same length", 1, true) != nil, true, "error text")
ok, err = pcall(vt2.blit, vt2, "a", "z", "0")
eq(ok, false, "invalid blit color")
a, b2, c = vt2:getLine(2)
eq([a:sub(1, 3), b2:sub(1, 3), c:sub(1, 3)], ["abc", "0e5", "fff"], "getLine returns text and colors")
ok, err = pcall(vt2.getLine, vt2, 5)
eq(ok, false, "getLine out of range")

# ---------------------------------------------------------------- очистка и прокрутка
vt3 = vterm.new(5, 3)
vt3:setCursorPos(1, 1)
vt3:write("one")
vt3:setCursorPos(1, 2)
vt3:write("two")
vt3:setCursorPos(1, 3)
vt3:write("tri")
vt3:setBackgroundColor(colors.green)
vt3:scroll(1)
eq(rows(vt3), ["two  ", "tri  ", "     "], "scroll up")
eq(vt3.bg[3][1], 13, "new line takes the current background")
vt3:scroll(-1)
eq(rows(vt3), ["     ", "two  ", "tri  "], "scroll down")
vt3:setCursorPos(1, 2)
vt3:clearLine()
eq(rows(vt3), ["     ", "     ", "tri  "], "clearLine")
vt3:clear()
eq(rows(vt3), ["     ", "     ", "     "], "clear")
vt3:setCursorPos(1, 1)
vt3:write("x")
vt3:scroll(5)
eq(rows(vt3), ["     ", "     ", "     "], "scroll by more than the height clears")
vt3:scroll(0)

# ---------------------------------------------------------------- курсор и размер
vt4 = vterm.new(20, 10)
eq(vt4:getCursorBlink(), false, "no blink by default")
vt4:setCursorBlink(true)
eq(vt4:getCursorBlink(), true, "blink on")
w, h = vt4:getSize()
eq([w, h], [20, 10], "size")
vt4:setCursorPos(3.7, 2.2)
cx, cy = vt4:getCursorPos()
eq([cx, cy], [3, 2], "cursor position is floored")
eq(vt4:isColor(), true, "color terminal by default")
eq(vterm.new(5, 5, {color: false}):isColor(), false, "monochrome terminal")
vt4:setCursorPos(1, 1)
vt4:write("keep")
vt4:resize(8, 4)
w, h = vt4:getSize()
eq([w, h], [8, 4], "resized")
eq(vt4:line_text(1), "keep    ", "resize keeps the content")
vt4:resize(2, 2)
eq(vt4:line_text(1), "ke", "shrinking cuts it")

# ---------------------------------------------------------------- палитра
vt5 = vterm.new(4, 2)
r, g, b = vt5:getPaletteColor(colors.white)
eq(math.abs(r - 240 / 255) < 1e-9, true, "default white")
vt5:setPaletteColor(colors.white, 1, 0.5, 0)
r, g, b = vt5:getPaletteColor(colors.white)
eq([r, math.abs(g - 0.5) < 0.01, b], [1, true, 0], "set from floats")
vt5:setPaletteColor(colors.black, 0x336699)
r, g, b = vt5:getPaletteColor(colors.black)
eq([math.floor(r * 255 + 0.5), math.floor(g * 255 + 0.5), math.floor(b * 255 + 0.5)], [0x33, 0x66, 0x99], "set from an integer")
ok, err = pcall(vt5.setPaletteColor, vt5, 5, 1, 1, 1)
eq(ok, false, "palette color must be a valid color")

# ---------------------------------------------------------------- изменения и api
vt6 = vterm.new(5, 4)
vt6:take_dirty()
vt6:setCursorPos(1, 3)
vt6:write("a")
eq(vt6:take_dirty(), [3], "only the written line is dirty")
eq(vt6:take_dirty(), [], "and it is taken once")
vt6:setCursorPos(1, 1)
vt6:write("b")
vt6:setCursorPos(1, 4)
vt6:write("c")
eq(vt6:take_dirty(), [1, 4], "several dirty lines, in order")
vt6:clear()
eq(len(vt6:take_dirty()), 4, "clear dirties everything")
changes = []
vt6.on_change = (term_obj, y) => table.insert(changes, y == nil and "all" or y)
vt6:setCursorPos(1, 2)
vt6:write("z")
vt6:clear()
eq(changes, [2, "all"], "change callback")

api = vt6:api()
api.setCursorPos(1, 1)
api.write("api")
eq(vt6:line_text(1), "api  ", "api functions work without self")
api.setTextColour(colours.lime)
eq(api.getTextColour(), colours.lime, "British spelling")
eq(api.getTextColor(), colors.lime, "American spelling")
w, h = api.getSize()
eq([w, h], [5, 4], "getSize through the api")
eq(api.isColour(), true, "isColour")
eq(api.vterm == vt6, true, "the api knows its terminal")
ok, err = pcall(api.write)
eq(ok, false, "missing argument")

print("done")
