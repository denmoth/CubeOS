import t
import x25519
import sha256
eq = t.eq

# X25519 по RFC 7748 (5.2 и 6.1; значения сверены с библиотекой cryptography на Python)

def unhex(h):
    return (string.gsub(h, "..", (x) => string.char(tonumber(x, 16))))

eq(sha256.to_hex(x25519.scalarmult(unhex("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4"),
    unhex("e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c"))),
    "c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552", "scalar multiplication matches RFC 7748 5.2")
alice = unhex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")
eq(sha256.to_hex(x25519.public_key(alice)), "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a", "Alice's public key (RFC 7748 6.1)")
bob = sha256.digest("bob's secret")
t0 = os.epoch("utc")
ab = x25519.shared(alice, x25519.public_key(bob))
ba = x25519.shared(bob, x25519.public_key(alice))
ms = os.epoch("utc") - t0
eq(ab == ba, true, "both sides get the same shared secret")
ok = pcall(() => x25519.shared(alice, string.rep(string.char(0), 32)))
eq(ok, false, "a zero public key is refused")
print("done")
