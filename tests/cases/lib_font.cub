import t
import font
import pixelbuf
eq = t.eq

# ---------------------------------------------------------------- буфер пикселей
b = pixelbuf.new(4, 3)
b:set(1, 1, 7)
b:set(10, 10, 9)
b:set(-1, 0, 9)
eq(b:get(1, 1), 7, "set and get")
eq(b:get(10, 10), nil, "get outside")
eq(b:to_text(), ["....", ".#..", "...."], "to_text")
b:fill_rect(0, 0, 2, 2, 3)
eq(b:to_text(), ["##..", "##..", "...."], "fill_rect")
eq(b:rows()[2], [3, 3, 0, 0], "rows")
small_buf = pixelbuf.new(2, 2)
small_buf:set(0, 0, 1)
b:clear()
b:blit(small_buf, 2, 1, 0)
eq(b:to_text(), ["....", "..#.", "...."], "blit with transparency")

# ---------------------------------------------------------------- шрифты
f6 = font.from_file("/repo/assets/fonts/cube-6x9.font")
f5 = font.from_file("/repo/assets/fonts/cube-5x7.font")
f8 = font.from_file("/repo/assets/fonts/cube-8x16.font")

eq([f6.width, f6.height, f6.ascent], [6, 9, 7], "6x9 metrics (the size of the native CC cell)")
eq([f5.width, f5.height, f5.ascent], [5, 7, 6], "5x7 metrics")
eq([f8.width, f8.height, f8.ascent], [8, 16, 12], "8x16 metrics")
eq(string.find(f6.meta, "misc-fixed", 1, true) != nil, true, "6x9 credits the source")
eq(string.find(f8.meta, "Spleen", 1, true) != nil, true, "8x16 credits Spleen")
eq(f6.glyph_count > 700 and f5.glyph_count > 700 and f8.glyph_count > 500, true, "enough glyphs")

# рисунки, сверенные с исходным BDF
eq(f6:glyph_text(65), ["......", "..#...", ".#.#..", "#...#.", "#####.", "#...#.", "#...#.", "......", "......"], "6x9 A")
eq(f6:glyph_text(0x416), ["......", "#.#.#.", "#.#.#.", ".###..", "#.#.#.", "#.#.#.", "#.#.#.", "......", "......"], "6x9 Zhe")
eq(f6:glyph_text(0x42F), ["......", "..###.", ".#..#.", ".#..#.", "..###.", ".#..#.", ".#..#.", "......", "......"], "6x9 Ya")
eq(f5:glyph_text(65), [".##..", "#..#.", "#..#.", "####.", "#..#.", "#..#.", "....."], "5x7 A")

# буквы русского и украинского алфавитов есть во всех шрифтах и не пустые
def has_ink(f, cp):
    for row in f:glyph_text(cp):
        if string.find(row, "#", 1, true) != nil:
            return true
    return false
needed = []
for cp in range[0x410, 0x44F]:
    needed[len(needed) + 1] = cp
for cp in [0x401, 0x451, 0x404, 0x454, 0x406, 0x456, 0x407, 0x457, 0x490, 0x491]:
    needed[len(needed) + 1] = cp
for pair in [["6x9", f6], ["5x7", f5], ["8x16", f8]]:
    missing = []
    for cp in needed:
        if not pair[2]:has(cp) or not has_ink(pair[2], cp):
            missing[len(missing) + 1] = cp
    eq(missing, [], pair[1] .. ": all Russian and Ukrainian letters are present and drawn")

for pair in [["6x9", f6], ["5x7", f5], ["8x16", f8]]:
    f = pair[2]
    eq(f:has(0x2500) and f:has(0x2588) and f:has(0x2192) and f:has(0x3B1) and f:has(0x105), true, pair[1] .. ": box, block, arrow, Greek, Latin Extended")
    eq(f:has(0x65E5), false, pair[1] .. ": no CJK")
    eq(f:has(0xFFFD), true, pair[1] .. ": replacement glyph")

# ---------------------------------------------------------------- текст
eq(f6:can_render("Hello, мир! Привіт, Їжак"), true, "can render mixed text")
eq(f6:can_render("日本語"), false, "cannot render CJK")
eq(f6:can_render("line\nbreak"), true, "newline is allowed")
eq(f6:width_of("Привет"), 36, "6x9 width of six letters")
eq(f5:width_of("Привет"), 30, "5x7 width")
eq(f6:width_of("Привет", 1), 41, "width with spacing")
eq(f6:width_of(""), 0, "empty width")
eq(f8:width_of("Привет"), 48, "8x16 width")
img = f6:render("Hi", 1)
eq(img.width, 12, "render width")
eq(img.height, 9, "render height")
eq(img:to_text()[2], ".#..#...#...", "render row 2: stems of H and the dot of i")
eq(img:to_text()[4], ".####..##...", "render row 4: bar of H, hook of i")
# неизвестный символ рисуется заменителем, а не пропадает
tofu = f6:render("日", 1)
eq(tofu:to_text(), f6:glyph_text(0xFFFD), "fallback glyph")
eq(f6:draw(pixelbuf.new(40, 9), 2, 0, "ab"), 14, "draw returns next x")

# файлы шрифтов: сжатые блоки, вместе не больше 20 КБ
total = fs.getSize("/repo/assets/fonts/cube-mono-6x9.font") + fs.getSize("/repo/assets/fonts/cube-6x9.font") + fs.getSize("/repo/assets/fonts/cube-5x7.font") + fs.getSize("/repo/assets/fonts/cube-8x16.font")
eq(total <= 20000, true, "fonts fit into 20 KB (" .. total .. " bytes)")
# основной шрифт: Monocraft в клетке 6x9
main = font.default("/repo/assets")
eq([main.width, main.height, main.ascent], [6, 9, 7], "default font has the native cell")
eq(string.find(main.meta, "Monocraft", 1, true) != nil, true, "default font is Monocraft")
eq(string.find(main.meta, "OFL", 1, true) != nil, true, "default font credits its license")
eq(main:can_render("Привіт, мир! Ёжик Їжак Ґанок Є є"), true, "default font renders Russian and Ukrainian")
eq(has_ink(main, 0x401) and has_ink(main, 0x419) and has_ink(main, 0x407) and has_ink(main, 0x490), true, "capital letters with marks are drawn")
# у заглавных с надстрочным знаком (Ё Й Ї) есть отдельная строка со знаком над буквой
eq(string.find(main:glyph_text(0x401)[1], "#", 1, true) != nil, true, "Yo keeps its dots in the first row")
# личного шрифта нет, если файла нет
eq(font.private("/repo/assets", nil, (p) => false), nil, "no private font without the file")
# рамки стыкуются между клетками: горизонталь по строке 5 целиком, вертикаль по столбцу 3 целиком
eq(main:glyph_text(0x2500)[5], "######", "horizontal line spans the cell")
vertical_ok = true
for row in main:glyph_text(0x2502):
    if string.sub(row, 3, 3) != "#":
        vertical_ok = false
eq(vertical_ok, true, "vertical line spans the cell")
eq(main:glyph_text(0x253C)[5], "######", "cross horizontal")
eq(string.sub(main:glyph_text(0x253C)[1], 3, 3), "#", "cross vertical top")
eq(string.sub(main:glyph_text(0x253C)[9], 3, 3), "#", "cross vertical bottom")
eq(main:has(0x2554) and main:has(0x2557) and main:has(0x255A) and main:has(0x255D) and main:has(0x256C), true, "double box set")
eq(main:glyph_text(0x2588)[1], "######", "full block")
# Monocraft не пустой для всех нужных букв
missing_mono = []
for cp in needed:
    if not main:has(cp) or not has_ink(main, cp):
        missing_mono[len(missing_mono) + 1] = cp
eq(missing_mono, [], "Monocraft has all Russian and Ukrainian letters")
print("done")
