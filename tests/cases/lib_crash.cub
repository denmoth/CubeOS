import t
import crash
import json5
import std.time as stime
eq = t.eq

# код причины не зависит от чисел и от строк после первой
a = crash.code("init.cub:123: attempt to index a nil value")
b = crash.code("init.cub:456: attempt to index a nil value\nstack traceback: ...")
eq(a, b, "the same error gives the same code whatever the numbers")
eq(a != crash.code("init.cub:123: something else"), true, "a different error gives a different code")
eq(string.match(a, "^E%-%x%x%x%x%x%x%x%x$") != nil, true, "the code is E- and eight hex digits")

ms = stime.from_date(2026, 10, 15, 12, 30, 45)
lines = []
for i in range[1, 30]:
    lines[i] = "line " .. i
r = crash.build({kind: "process", process: {pid: 7, name: "my app", how: "crashed"}, error: "boom"}, {clock: () => ms, log: lines})
eq([r.kind, r.error, r.time, r.time_text], ["process", "boom", ms, "2026-10-15T12:30:45Z"], "the report has the kind, error and time")
eq(len(r.log), 20, "only the last 20 log lines are kept")
eq([r.log[1], r.log[20]], ["line 11", "line 30"], "the newest lines")
eq(r.version, "CubeOS 0.3.0", "the version is recorded")
eq(r.code, crash.code("boom"), "the code comes from the error")
eq(crash.build({error: nil}, {clock: () => ms}).error, "", "a missing error is an empty text")

written = {}
def writer(path, text):
    written.path = path
    written.text = text
path = crash.write(writer, r, "/crashes")
eq(path, "/crashes/20261015-123045-my_app.json", "the file name has the time and the cleaned process name")
eq(written.path, path, "the writer got the path")
back = json5.parse(written.text)
eq([back.error, back.process.name, back.code], ["boom", "my app", r.code], "the file parses back")
boot_path = crash.write(writer, crash.build({kind: "boot", error: "x"}, {clock: () => ms}), nil)
eq(boot_path, "/cubeos/var/crash/20261015-123045-boot.json", "boot reports are named after the kind and use the default directory")

eq(crash.old_reports(["c", "a", "b", "d"], 2), ["a", "b"], "the oldest reports beyond keep are listed for removal")
eq(crash.old_reports(["a"], 5), [], "nothing is removed below the limit")
print("done")
