import t
import kernel
import cde
import cde.widgets as widgets
import clock as clock_mod
eq = t.eq

def make_term():
    api = {}
    def get_size(px):
        if px:
            return 306, 171
        return 51, 19
    def nothing(a, b, c, d):
        pass
    api.getSize = get_size
    for name in ["setBackgroundColor", "setTextColor", "clear", "setCursorPos", "blit", "setPaletteColor", "setGraphicsMode", "drawPixels", "setFrozen"]:
        api[name] = nothing
    return api

def breathe():
    os.queueEvent("t_breathe")
    os.pullEvent("t_breathe")

clock = {now: 1000}
def now():
    return clock.now
moved = []
wm = cde.wm.new({animations: {enabled: false}, term: make_term(), assets: "/repo/assets", clock: now, panel: {time_text: () => "10:00"}})
wm.on_widget_moved = (w) => rawset(moved, len(moved) + 1, w.widget)
k = kernel.new({clock: now})
breathe()
tc = clock_mod.new({tz: "UTC"})
xs = {clock: 0, calendar: 106, system: 200}
for spec in widgets.CATALOG:
    wm:launch(spec.main, {name: "widget " .. spec.id}, [{x: xs[spec.id], y: 2, time: tc, spec: spec}])
def app(sys, ctx):
    win = cde.app.open(sys, ctx, {title: "App", kind: "pixel", w: 60, h: 40, x: 20, y: 20})
    win:present()
    while true:
        ev = table.pack(win:wait_event())
        if ev[1] == "win_close":
            break
    win:close()
wm:launch(app, {name: "app"})
def desk(sys, args):
    wm:run(sys)
k:spawn(desk, [], {name: "cde", ui: true})
def settle(n=10):
    k:feed("cubeos_cde")
    for i in range[1, n]:
        clock.now = clock.now + 20
        k:tick()
        k:run_ready()
settle()
order = []
for w in wm.windows:
    order[len(order) + 1] = w.widget ?? w.title
eq(order[len(order)], "App", "normal windows are above widgets")
eq(len(wm.windows), 4, "three widgets and one app")
eq(wm.panel:item_for(wm.windows[1]), nil, "widgets are not on the taskbar")
for w in wm.windows:
    if w.widget != nil:
        eq(w.layer, "desktop", w.widget .. ": desktop layer")
        found = false
        for yy in range[0, w.ch - 1]:
            if w.canvas:get(w.cw - 2, yy) != w.canvas:get(2, yy):
                found = true
        eq(found or w.canvas:get(w.cw - 2, 5) != 0, true, w.widget .. ": something is drawn")
# Alt+D сворачивает приложение, но не виджеты
wm:toggle_desktop()
settle()
mins = {}
for w in wm.windows:
    mins[w.widget ?? w.title] = w.minimized
eq([mins.App, mins.clock, mins.calendar, mins.system], [true, false, false, false], "show desktop leaves the widgets")
wm:toggle_desktop()
settle()
# виджет под приложением остаётся под ним, даже если по нему кликнули
cl = nil
for w in wm.windows:
    if w.widget == "clock":
        cl = w
k:feed("mouse_click", 1, cl.x + 5, cl.y + 5)
k:feed("mouse_drag", 1, cl.x + 25, cl.y + 20)
k:feed("mouse_up", 1, cl.x + 25, cl.y + 20)
settle()
eq(moved, ["clock"], "dragging a widget reports the move")
eq(wm.windows[len(wm.windows)].title, "App", "a clicked widget stays below normal windows")
eq(wm.focused != nil and wm.focused.layer == "desktop", true, "but takes the focus")
print("done")
