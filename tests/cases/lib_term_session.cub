import t
import cfs
import boot
import boot.console as console_mod
import term.session as session_mod
import svc.rpc as rpc
import svc.timed as timed
import svc.powerd as powerd
import svc.clipboard as clipboard
import term.view as view_mod
eq = t.eq

# Загрузка, вход, терминал cush внутри процесса ядра: ввод через ядро, fs поверх CFS, время и питание от служб, буфер обмена, выход.

clock = {now: 1000}
def now():
    return clock.now

def breathe():
    os.queueEvent("test_breathe")
    os.pullEvent("test_breathe")

def build_fs():
    let fsys = cfs.new({clock: now})
    fsys:mount("/", cfs.memory({now: now}))
    fsys:mount("/rom", cfs.host("/rom", {readonly: true}))
    fsys:mount("/cubeos/tmp", cfs.tmp(65536, now))
    cfs.install_defaults(fsys)
    for dir in ["/cubeos/sys/services", "/cubeos/sys/cfg", "/cubeos/var", "/cubeos/shared"]:
        fsys:mkdir(nil, dir, {parents: true})
    fsys:write_file(nil, "/cubeos/sys/services/timed.conf", "{name: 'timed', module: 'svc.timed'}")
    fsys:write_file(nil, "/cubeos/sys/services/powerd.conf", "{name: 'powerd', module: 'svc.powerd'}")
    fsys:write_file(nil, "/cubeos/sys/services/clipboard.conf", "{name: 'clipboard', module: 'svc.clipboard'}")
    fsys:write_file(nil, "/cubeos/sys/cfg/boot.conf", "{rounds: 2}")
    fsys:write_file(nil, "/cubeos/sys/cfg/time.conf", "{tz: 'Europe/Kyiv', seconds: true}")
    return fsys

modules = {"svc.timed": timed, "svc.powerd": powerd, "svc.clipboard": clipboard}
def importer(path):
    return modules[path]

def fake_term():
    api = {}
    def get_size(px):
        if px:
            return 51 * 6, 19 * 9
        return 51, 19
    api.getSize = get_size
    for name in ["setBackgroundColor", "setTextColor", "clear", "setCursorPos", "blit", "setPaletteColor", "setGraphicsMode", "drawPixels", "setFrozen"]:
        api[name] = () => nil
    return api

power = {calls: []}
def power_off():
    power.calls[len(power.calls) + 1] = "shutdown"
def power_restart():
    power.calls[len(power.calls) + 1] = "reboot"

captured = {}
def ready(c):
    captured.ctx = c
def shell_for(session):
    return session_mod.program(session, {term: fake_term(), backend: "pixel", assets: "/repo/assets", host: "cubebox", ready: ready})

def settle(system, steps):
    for i in range[1, steps]:
        if i % 4 == 0:
            breathe()
        system.kernel:run_ready()
        clock.now = clock.now + 100
        system.kernel:tick()
        if system.power_action != nil:
            break
    system.kernel:run_ready()

def screen():
    vt = captured.ctx.vterm
    lines = []
    for y in range[1, vt.h]:
        lines[y] = vt:line_text(y)
    return table.concat(lines, "\n")

def has(text):
    return captured.ctx != nil and string.find(screen(), text, 1, true) != nil

# крутит ядро, пока условие не выполнится (не больше rounds кругов); возвращает результат условия
def wait(system, cond, rounds=150):
    for i in range[1, rounds]:
        if cond():
            return true
        if i % 4 == 0:
            breathe()
        system.kernel:run_ready()
        clock.now = clock.now + 100
        system.kernel:tick()
    return cond()

def wait_text(system, text, rounds=150):
    return wait(system, () => has(text), rounds)

def type_text(system, text):
    for i in range[1, string.len(text)]:
        system.kernel:feed("char", string.sub(text, i, i))
    system.kernel:feed("key", keys.enter, false)
    system.kernel:feed("key_up", keys.enter)

fsys = build_fs()
con = console_mod.ScriptedConsole(["ivan", "", "s"])
b = boot.new({fsys: fsys, console: con, clock: now, import: importer, shell: shell_for, power: {shutdown: power_off, reboot: power_restart},
    kernel: {clock: now}})
system = b:start()
eq(wait(system, () => captured.ctx != nil), true, "the terminal started in the session")
eq(wait_text(system, "ivan@cubebox:~$"), true, "the prompt shows the user, the computer and home")

# команды идут через ядро; fs это CFS пользователя
type_text(system, "echo hi from the kernel")
eq(wait_text(system, "hi from the kernel"), true, "typing goes through the kernel and the command runs")
type_text(system, "pwd")
eq(wait_text(system, "/cubeos/users/ivan/home"), true, "the home is the CFS profile folder")
type_text(system, "echo data > note.txt")
eq(wait(system, () => fsys:exists(nil, "/cubeos/users/ivan/home/note.txt")), true, "files go into the user's CFS home")
eq(fsys:read_file(nil, "/cubeos/users/ivan/home/note.txt"), "data\n", "with the right content")
type_text(system, "ls")
eq(wait_text(system, "note.txt"), true, "ls shows it")
type_text(system, "ls /cubeos/sys/cfg")
eq(wait_text(system, "boot.conf"), true, "the system config is readable")
type_text(system, "rm /cubeos/sys/cfg/boot.conf")
settle(system, 20)
eq(fsys:exists(nil, "/cubeos/sys/cfg/boot.conf"), true, "but a plain user cannot delete it")

# время от службы timed
type_text(system, "timedatectl")
eq(wait_text(system, "Time zone: Europe/Kyiv"), true, "time settings come from the timed service")
type_text(system, "timedatectl set-timezone Asia/Tokyo")
eq(wait(system, () => string.find(fsys:read_file(nil, "/cubeos/sys/cfg/time.conf"), "Asia/Tokyo", 1, true) != nil), true, "a change is saved to time.conf through the service")

# общий буфер обмена
captured.ctx.clipboard.text = "copied text"
type_text(system, "echo x")
got = {}
def reader(sys, args):
    got.clip = rpc.call(sys, "clipboard", "get")
settle(system, 10)
system.kernel:spawn(reader, [], {name: "reader", subject: system.subject})
eq(wait(system, () => got.clip != nil), true, "the clipboard service answers")
eq(got.clip, "copied text", "text copied in the terminal reaches the clipboard service")

# Ctrl+T прерывает программу, а не систему
type_text(system, "sleep 30")
settle(system, 10)
system.kernel:feed("terminate")
type_text(system, "echo after the interrupt")
eq(wait_text(system, "after the interrupt"), true, "terminate interrupts the running command and the shell goes on")

# скрытый ввод программы CraftOS (read("*")) не попадает в журнал ввода: ядро видит, что идёт ввод секрета (D220)
traced = []
system.kernel.input_fn = (line) => table.insert(traced, line)
fsys:write_file(nil, "/cubeos/users/ivan/home/pw.lua", "local p = read('*') print('length ' .. #p)")
type_text(system, "pw.lua")
settle(system, 10)
type_text(system, "hunter2")
eq(wait_text(system, "length 7"), true, "the program got the hidden input")
all_traced = table.concat(traced, "\n")
eq(string.find(all_traced, "char \"h\"", 1, true), nil, "hidden characters are not in the input log")
eq(string.find(all_traced, "secret input entered in", 1, true) != nil, true, "only a single hidden line")
eq(string.find(all_traced, "char \"p\"", 1, true) != nil, true, "the command line before it is logged as usual")
system.kernel.input_fn = nil

# выход из оболочки возвращает на вход, оттуда выключение
type_text(system, "exit")
eq(wait(system, () => len(con.prompts) >= 3), true, "after exit the login screen is back")
eq(wait(system, () => len(power.calls) > 0), true, "the shutdown choice reaches the power hook")
eq(power.calls, ["shutdown"], "exactly once")
print("done")
