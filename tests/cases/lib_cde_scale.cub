import t
import kernel
import cde
import cde.theme as theme
eq = t.eq

# подставной экран CC: Graphics заданного размера в пикселях (монитор можно «растянуть»: size.w, size.h меняются)
def make_term(size, state):
    api = {}
    def get_size(px):
        if px:
            return size.w, size.h
        return math.floor(size.w / 6), math.floor(size.h / 9)
    def set_pal(i, r, g, b):
        state.pal[i] = [math.floor(r * 255 + 0.5), math.floor(g * 255 + 0.5), math.floor(b * 255 + 0.5)]
    def nothing(a, b, c, d):
        pass
    api.getSize = get_size
    api.setPaletteColor = set_pal
    for name in ["setGraphicsMode", "setFrozen", "setBackgroundColor", "setTextColor", "clear", "setCursorPos", "blit", "drawPixels"]:
        api[name] = nothing
    return api

def breathe():
    os.queueEvent("t_breathe")
    os.pullEvent("t_breathe")

# ---------------------------------------------------------------- палитра v2: есть тёмные тона
p = theme.palette(theme.get())
def dist(r, g, b):
    i = p:nearest(r, g, b, 16, 211)
    pr, pg, pb = p:get(i)
    return math.abs(pr - r) + math.abs(pg - g) + math.abs(pb - b)
eq(dist(30, 32, 52) < 40, true, "a dark blue has a close general color")
eq(dist(60, 20, 20) < 40, true, "a dark red too")
eq(dist(128, 128, 128) < 25, true, "middle gray")
breathe()

# ---------------------------------------------------------------- масштаб
state = {pal: {}}
size = {w: 984, h: 729}
clock = {now: 1000}
def now():
    return clock.now
wm = cde.wm.new({term: make_term(size, state), assets: "/repo/assets", clock: now})
k = kernel.new({clock: now})
breathe()
eq([wm.scale, wm.W, wm.H], [2, 492, 364], "a big monitor gets 2x automatically")
eq([wm:pick_scale(1), wm:pick_scale(3), wm:pick_scale(9)], [1, 3, 4], "fixed scale settings")

def settle(n=6):
    k:feed("cubeos_cde")
    for i in range[1, n]:
        clock.now = clock.now + 20
        k:tick()
        k:run_ready()

log = []
slots = {}
def app_main(sys, ctx):
    win = cde.app.open(sys, ctx, {title: "Big", w: 60, h: 30, x: 10, y: 10})
    win.canvas:clear(40)
    mine = win:alloc_colors(3)
    slots.list = mine
    slots.taken = win:alloc_colors(50)
    win:set_colors([[mine[1], 255, 0, 128], [100, 1, 2, 3]])
    win.canvas:fill_rect(0, 0, 5, 5, mine[1])
    win:present()
    while true:
        ev = table.pack(win:wait_event())
        log[len(log) + 1] = ev
        if ev[1] == "win_close":
            break
    win:close()

wm:launch(app_main, {name: "big"})
def desk(sys, args):
    wm:run(sys)
k:spawn(desk, [], {name: "cde", ui: true})
settle()
breathe()
win = wm.windows[1]
s = wm.screen.surface
cx = win:content_x()
cy = win:content_y()
eq(s:get((cx + 10) * 2, (cy + 10) * 2), 40, "content is drawn twice as big on the screen")
eq(s:get((cx + 10) * 2 + 1, (cy + 10) * 2 + 1), 40, "every logical pixel is 2x2")
# мышь: пиксели экрана -> логические
k:feed("mouse_click", 1, (cx + 7) * 2 + 1, (cy + 4) * 2)
k:feed("mouse_up", 1, (cx + 7) * 2 + 1, (cy + 4) * 2)
settle()
click = nil
for ev in log:
    if ev[1] == "mouse_click":
        click = ev
eq([click[3], click[4]], [7, 4], "mouse events are in logical pixels")

# свои места палитры
eq(len(slots.list), 3, "three palette slots")
eq(slots.taken, nil, "cannot take more than the free slots")
eq(state.pal[slots.list[1]], [255, 0, 128], "own slot color reaches the terminal")
eq(state.pal[100] != nil and state.pal[100][1] == 1, false, "a foreign slot is not changed")
eq(s:get((cx + 1) * 2, (cy + 1) * 2), slots.list[1], "the app draws with its slot")
wm:hotkey("ctrl+alt+y", () => wm:set_theme("light"))
k:feed("key", keys.leftCtrl, false)
k:feed("key", keys.leftAlt, false)
k:feed("key", keys.y, false)
k:feed("key_up", keys.leftAlt)
k:feed("key_up", keys.leftCtrl)
settle()
eq([wm.theme.name, state.pal[slots.list[1]]], ["light", [255, 0, 128]], "a theme switch keeps app slots")

# монитор растянули: масштаб и логический экран заново, окно в пределах экрана
size.w = 2000
size.h = 1500
k:feed("monitor_resize", "right")
settle()
eq([wm.scale, wm.W, wm.H], [4, 500, 375], "a bigger monitor gets 4x")
size.w = 306
size.h = 171
k:feed("term_resize")
settle()
eq([wm.scale, wm.W, wm.H], [1, 306, 171], "back to the computer screen: 1x")
eq(win.x + win.w <= 306 and win.y + win.h <= 171, true, "the window stays on the screen")

# окно закрыто: места палитры свободны
k:feed("key", keys.leftCtrl, false)
k:feed("key", keys.t, false)
k:feed("key_up", keys.leftCtrl)
settle()
eq([len(wm.windows), len(wm.pool_free)], [0, len(theme.POOL)], "closing the window frees its slots")
print("done")
