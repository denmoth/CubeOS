a = nil
b = false
c = 0
print(a ?? "default", b ?? "default", c ?? "default")
print(a ?? c ?? 5)

user = {name: "Ann", address: {city: "Kyiv"}}
none = nil
print(user?.name, none?.name, user.address?.city)

print(5 if true else 6)
print("yes" if 1 > 2 else "no")
n = nil
print(n if true else "x")
print(false if true else "x")

print(nil is nil, 1 is 2, 1 is not 2, "a" is not nil)

t = [1, 2]
print(not t, not nil, not false)

print(1 < 2 and 2 < 3, 1 > 2 or 3 > 2)
print(10 % 3, -10 % 3, 5.5 // 2)
print(2 ** 3 ** 2)
print((2 ** 3) ** 2)
print(-3 ** 2)
