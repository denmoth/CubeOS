import t
import std.str as s
eq = t.eq
eq(s.split("a b  c"), ["a", "b", "c"], "split ws")
eq(s.split("a,b,,c", ","), ["a", "b", "", "c"], "split sep")
eq(s.split("a,b,c", ",", 1), ["a", "b,c"], "split limit")
eq(s.split("abc", "x"), ["abc"], "split none")
eq(s.split("a--b--c", "--"), ["a", "b", "c"], "split multi")
eq(s.join(["a", 1, "c"], "-"), "a-1-c", "join")
eq(s.join([]), "", "join empty")
eq(s.lines("a\nb\r\nc\n"), ["a", "b", "c"], "lines")
eq(s.strip("  hi \n"), "hi", "strip")
eq(s.strip("xxhixx", "x"), "hi", "strip chars")
eq(s.lstrip("  hi "), "hi ", "lstrip")
eq(s.rstrip("  hi "), "  hi", "rstrip")
eq(s.startswith("hello", "he"), true, "startswith")
eq(s.startswith("hello", "lo"), false, "startswith2")
eq(s.endswith("hello", "lo"), true, "endswith")
eq(s.endswith("hello", ""), true, "endswith empty")
eq(s.find("hello", "ll"), 3, "find")
eq(s.find("hello", "zz"), nil, "find none")
eq(s.count("aaaa", "aa"), 2, "count")
eq(s.replace("a-b-c", "-", "+"), "a+b+c", "replace")
eq(s.replace("a-b-c", "-", "+", 1), "a+b-c", "replace limit")
eq(s.replace("abc", "b", ""), "ac", "replace empty")
eq(s.ljust("ab", 4), "ab  ", "ljust")
eq(s.rjust("ab", 4, "0"), "00ab", "rjust")
eq(s.center("ab", 5, "*"), "*ab**", "center")
eq(s.capitalize("hELLO"), "Hello", "capitalize")
eq(s.title("hello wORLD it's"), "Hello World It's", "title")
eq(s.is_blank("  \t"), true, "blank")
eq(s.is_digits("123"), true, "digits")
eq(s.is_digits("12a"), false, "digits2")
eq(s.iequals("Ab", "aB"), true, "iequals")
print("done")
