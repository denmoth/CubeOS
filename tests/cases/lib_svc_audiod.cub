import t
import kernel
import cfs
import cfs.rules as rules
import svc.audiod as audiod
import svc.rpc as rpc
eq = t.eq

# Звук (шаг 7, частично): ноты, звуки, музыка DFPWM через подставной динамик, остановка, громкость в audio.conf.

calls = []
full = {left: 1}
speaker = {}
def play_note(inst, vol, pitch):
    calls[len(calls) + 1] = "note " .. inst .. " " .. vol .. " " .. pitch
    return true
def play_sound(name, vol, pitch):
    calls[len(calls) + 1] = "sound " .. name .. " " .. vol
    return true
def play_audio(buffer, vol):
    # первый раз динамик «занят»: проигрыватель должен подождать speaker_audio_empty
    if full.left > 0:
        full.left -= 1
        return false
    calls[len(calls) + 1] = "audio " .. len(buffer)
    return true
speaker.playNote = play_note
speaker.playSound = play_sound
speaker.playAudio = play_audio
speaker.stop = () => nil
# дисководы: bottom с пластинкой Minecraft, back с дискетой (точка монтирования disk)
record = {played: 0, stopped: 0}
rec_drive = {}
rec_drive.isDiskPresent = () => true
rec_drive.hasAudio = () => true
rec_drive.getAudioTitle = () => "C418 - cat"
def rec_play():
    record.played += 1
rec_drive.playAudio = rec_play
def rec_stop():
    record.stopped += 1
rec_drive.stopAudio = rec_stop
floppy = {label: nil, present: true}
fl_drive = {}
fl_drive.isDiskPresent = () => floppy.present
fl_drive.hasAudio = () => false
fl_drive.getMountPath = () => "disk"
fl_drive.getDiskLabel = () => floppy.label
def set_label(l):
    floppy.label = l
fl_drive.setDiskLabel = set_label
fl_drive.stopAudio = () => nil
files = {}
ffs = {}
ffs.exists = (p) => files[p] != nil
def list_files(dir):
    out = []
    for k, v in files:
        if string.sub(k, 1, len(dir) + 1) == dir .. "/":
            out[len(out) + 1] = string.sub(k, len(dir) + 2)
    return out
ffs.list = list_files
ffs.getSize = (p) => len(files[p] ?? "")
ffs.getFreeSpace = (p) => 30000
def open_file(p, mode):
    h = {}
    if string.sub(mode, 1, 1) == "r":
        h.readAll = () => files[p]
    else:
        buf = {text: ""}
        def wr(t):
            buf.text = buf.text .. t
        h.write = wr
        def cl():
            files[p] = buf.text
        h.close = cl
        return h
    h.close = () => nil
    return h
ffs.open = open_file
per = {}
per.getNames = () => ["left", "top", "bottom", "back"]
TYPES = {left: "speaker", top: "monitor", bottom: "drive", back: "drive"}
DEVS = {left: speaker, bottom: rec_drive, back: fl_drive}
per.getType = (n) => TYPES[n]
per.wrap = (n) => DEVS[n]

fsys = cfs.new({})
fsys:mount("/", cfs.memory())
fsys:mkdir(nil, "/cubeos/sys/cfg", {parents: true})
fsys:write_file(nil, "/cubeos/sys/cfg/audio.conf", "{volume: 50}")
sub = rules.subject("system", ["system"])
view = cfs.view(fsys, sub, {})
# подставной декодер: каждый байт даёт один отсчёт
def make_decoder():
    return (chunk) => [1, 2, 3, string.len(chunk)]
k = kernel.new({clock: () => 0})
k:spawn(audiod.main, {peripheral: per, view: view, decoder: make_decoder, fs: ffs}, {name: "audiod", subject: sub})
for i in range[1, 5]:
    k:run_ready()

answers = {}
def ask(sys, args):
    res, err = rpc.call(sys, "audiod", args.op, args.q)
    answers[args.tag] = [res, err]
def call(op, q, tag):
    k:spawn(ask, {op: op, q: q, tag: tag}, {name: "ask"})
    for i in range[1, 15]:
        k:run_ready()
    return answers[tag]

eq(call("speakers", nil, "s")[1], ["left"], "only speakers are listed")
call("note", {instrument: "bell", pitch: 12, volume: 2}, "n")
eq(calls[1], "note bell 1 12", "a note, with the volume halved by audio.conf (50%)")
r = call("note", {instrument: "kazoo"}, "bad")
eq(string.find(tostring(r[2]), "unknown instrument", 1, true) != nil, true, "an unknown instrument is refused")
call("sound", {name: "minecraft:entity.cat.ambient"}, "snd")
eq(calls[2], "sound minecraft:entity.cat.ambient 1.5", "a Minecraft sound: no volume given is the speaker maximum (3) times 50%")
r = call("play", {data: string.rep("x", 20000), title: "song"}, "p")
eq(r[1], true, "music starts in the background")
eq(call("status", nil, "st")[1].playing, true, "status says it is playing")
# динамик занят: проигрыватель ждёт speaker_audio_empty
k:feed("speaker_audio_empty", "left")
for i in range[1, 20]:
    k:run_ready()
k:feed("speaker_audio_empty", "left")
for i in range[1, 20]:
    k:run_ready()
audio_calls = 0
for c in calls:
    if string.sub(c, 1, 5) == "audio":
        audio_calls += 1
eq(audio_calls, 2, "20000 bytes go out in two chunks, after the speaker frees up")
eq(call("status", nil, "st2")[1].playing, false, "and then it stops by itself")
eq(call("volume", {value: 37.5}, "vf")[1], 37.5, "fractional volume is kept")
call("volume", {value: 80}, "v")
eq(string.find(fsys:read_file(nil, "/cubeos/sys/cfg/audio.conf"), "80", 1, true) != nil, true, "the volume is saved")
r = call("volume", {value: 300}, "v2")
eq(string.find(tostring(r[2]), "0 to 100", 1, true) != nil, true, "the volume is 0 to 100")
# пластинки
r = call("disc", nil, "disc")
eq(r[1] != nil and r[1].title, "C418 - cat", "play disc plays the Minecraft record in the first drive")
eq(record.played, 1, "the drive plays it itself")
call("stop", nil, "stop2")
eq(record.stopped > 0, true, "play stop stops the record too")
r = call("disc", {drive: "back"}, "nofl")
eq(string.find(tostring(r[2]), "no music disc", 1, true) != nil, true, "an empty floppy is not a record")
r = call("burn", {data: string.rep("y", 40000), title: "Big"}, "big")
eq(string.find(tostring(r[2]), "too small", 1, true) != nil, true, "a file bigger than the floppy is refused")
eq(call("burn", {data: "abc", title: "My song"}, "burn")[1], true, "burn makes a record floppy")
eq([files["disk/record.dfpwm"], floppy.label], ["abc", "My song"], "record.dfpwm and the label")
# динамик занят: музыка не кончится мгновенно, пока проверяем
full.left = 3
TYPES.bottom = nil
k:feed("disk", "back")
for i in range[1, 30]:
    k:run_ready()
eq(call("status", nil, "st3")[1].title, "My song", "inserting the record floppy plays it by itself")
k:feed("disk_eject", "back")
for i in range[1, 10]:
    k:run_ready()
eq(call("status", nil, "st4")[1].playing, false, "taking it out stops the music")
per.getNames = () => []
r = call("note", {instrument: "harp"}, "none")
eq(string.find(tostring(r[2]), "no speaker", 1, true) != nil, true, "no speaker: a clear error")
print("done")
