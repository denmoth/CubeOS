import t
import input.layout as layout
import term.chars as chars
import term.vterm as vterm
import unicode
eq = t.eq

# ручной режим (manual): раскладка CubeOS переключается сама
lay = layout.new(["en", "ru", "uk"], nil, {mode: "manual"})
eq(lay:label(), "EN", "starts in English")
eq(lay:translate("q"), "q", "English keeps the symbol")

# переключение (D223): Ctrl+Shift или Alt+Shift, при отпускании, если между ними не нажимали других клавиш
eq(lay:key(keys.leftCtrl), false, "pressing never switches")
eq(lay:key(keys.leftShift), false, "not even Ctrl then Shift")
eq(lay:key_up(keys.leftShift), true, "releasing the pair switches")
lay:key_up(keys.leftCtrl)
eq(lay:label(), "RU", "now Russian")
lay:key(keys.leftShift)
lay:key(keys.leftAlt)
lay:key_up(keys.leftAlt)
lay:key_up(keys.leftShift)
eq(lay:label(), "UK", "Alt+Shift too, in any order")
lay:key(keys.leftCtrl)
lay:key(keys.rightShift)
lay:key_up(keys.leftCtrl)
lay:key_up(keys.rightShift)
eq(lay:label(), "EN", "the order is a cycle")
# Ctrl+Shift+C, Ctrl+Shift+стрелки: другая клавиша между нажатием и отпусканием отменяет переключение
lay:key(keys.leftCtrl)
lay:key(keys.leftShift)
lay:key(keys.c)
lay:key_up(keys.c)
eq(lay:key_up(keys.leftShift), false, "Ctrl+Shift+C does not switch")
lay:key_up(keys.leftCtrl)
eq(lay:label(), "EN", "still English")
eq(lay:key(keys.leftShift), false, "Shift alone")
eq(lay:key_up(keys.leftShift), false, "does not switch")
only_ctrl = layout.new(["en", "ru"], nil, {mode: "manual", switch: "ctrl+shift"})
only_ctrl:key(keys.leftAlt)
only_ctrl:key(keys.leftShift)
only_ctrl:key_up(keys.leftShift)
eq(only_ctrl:label(), "EN", "switch: ctrl+shift ignores Alt+Shift")
off = layout.new(["en", "ru"], nil, {mode: "manual", switch: "off"})
off:key(keys.leftCtrl)
off:key(keys.leftShift)
off:key_up(keys.leftShift)
eq(off:label(), "EN", "switch: off")

# символ по месту клавиши (Windows с русской раскладкой не присылает символ) и переход на «родную» раскладку
eq(lay:base_char(keys.q, false), "q", "a letter key")
eq(lay:base_char(keys.q, true), "Q", "with Shift")
eq(lay:base_char(keys.semicolon ?? keys.semiColon, false), ";", "punctuation by name")
eq(lay:base_char(keys.enter, false), nil, "not a typing key")
eq(lay:native(), true, "English switches to the first other layout")
eq(lay:label(), "RU", "which is Russian")
eq(lay:native(), false, "already native")
lay:set("en")

# автоматический режим (D235): английский плюс второй язык, раскладка как в Windows
auto = layout.new(nil, nil, {keyboard: "ru"})
eq(auto.mode, "auto", "auto is the default")
eq(auto:translate("q"), "q", "a character from Windows is taken as it is")
eq(auto:translate("ñ"), "ñ", "any Latin-1 letter too (Spanish, German...)")
eq(auto:missing(keys.q, false), "й", "a key without a character gives the second language letter")
eq(auto:label(), "RU", "and the indicator shows it")
eq(auto:missing(keys.three, true), "№", "Shift+3 is № in the Russian layout")
eq(auto:missing(keys.enter, false), nil, "not a typing key")
auto:translate("w")
eq(auto:label(), "EN", "a Latin letter from Windows means English again")
auto:key(keys.leftCtrl)
auto:key(keys.leftShift)
eq(auto:key_up(keys.leftShift), false, "Ctrl+Shift does not switch anything in auto mode")
uk = layout.new(nil, nil, {keyboard: "uk"})
eq(uk:missing(keys.s, false), "і", "the second language can be Ukrainian")
eq(layout.load_layout("ru").title, "Русский", "layouts come from files (assets/layouts)")
eq(layout.load_layout("xx"), nil, "an unknown language has no layout")
eq(layout.transliterate("Денис Щукин", ["ru"]), "Denis Shchukin", "transliteration for account names")
eq(layout.transliterate("Їжак", ["uk"]), "Izhak", "Ukrainian transliteration")
avail = layout.available()
eq(avail[1] == "en" and len(avail) >= 3, true, "available layouts: English and the files")

# ЙЦУКЕН
lay:set("ru")
src = "ghbdtn"
out = ""
for i in range[1, string.len(src)]:
    out = out .. lay:translate(string.sub(src, i, i))
eq(out, "привет", "ghbdtn typed in Russian layout is привет")
eq(lay:translate("Q"), "Й", "capital letters follow the case")
eq(lay:translate(","), "б", "comma key is б")
eq(lay:translate("/"), ".", "slash key is the period")
eq(lay:translate("5"), "5", "digits stay")
lay:set("uk")
eq(lay:translate("s"), "і", "Ukrainian і")
eq(lay:translate("]"), "ї", "Ukrainian ї")
eq(lay:translate("'"), "є", "Ukrainian є")

# декодирование UTF-8 в клетки и обратно
cells = chars.decode("aé я\x80")
eq(len(cells), 5, "four characters plus a stray byte")
eq(cells[2], chars.LATIN + 233, "é from UTF-8 is a marked Latin-1 cell")
eq(cells[4], 1103, "я is a code point")
eq(cells[5], 128, "an invalid byte stays a byte")
eq(chars.encode(cells), "aé я\x80", "encoding returns the same string")
eq(chars.length("привет"), 6, "length in characters")
eq(chars.sub("привет", 2, 4), "рив", "sub in characters")
eq(chars.sub("abc", 2), "bc", "ASCII fast path")
eq(chars.to_cp(1103), 1103, "wide cells map to themselves")
eq(chars.to_cp(chars.LATIN + 233), 233, "marked Latin-1 maps back")

# виртуальный терминал: кириллица это по одной клетке
vt = vterm.new(10, 2, {})
vt:write("при")
x, y = vt:getCursorPos()
eq(x, 4, "three Russian letters move the cursor by three")
eq(vt.text[1][1], 1087, "п is stored as a code point")
text = vt:getLine(1)
eq(string.len(text), 10, "getLine keeps the terminal width")
eq(string.sub(text, 1, 3), "???", "CC-style line text shows wide cells as ?")

print("done")
