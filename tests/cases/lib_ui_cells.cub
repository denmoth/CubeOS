import t
import ui.cells as cells
eq = t.eq

c = cells.new(8, 3)
c:text(1, 0, "Привет", 4, 1)
eq(c:to_lines(), [" Привет ", "        ", "        "], "text by characters")
eq(c:colors_lines("fg")[1], "74444447", "text colors")
eq(c:colors_lines("bg")[1], "01111110", "background colors")
c:text(6, 0, "abcdef", 2)
eq(c:to_lines()[1], " Приве" .. "ab", "text is cut at the edge")
eq(c:colors_lines("bg")[1], "01111110", "nil background keeps the old one")
c:set(0, 2, 0x2588, 5, 6)
g1, g2, g3 = c:get(0, 2)
eq([g1, g2, g3], [0x2588, 5, 6], "set and get")
eq(c:get(9, 9), nil, "get outside")
c:set(-1, 0, 65, 1, 1)
c:set(8, 0, 65, 1, 1)
eq(c:to_lines()[1], " Приве" .. "ab", "writes outside are ignored")

# заливка, отсечение, сдвиг
d = cells.new(6, 4)
d:fill(1, 1, 3, 2, 35, 3, 2)
eq(d:to_lines(), ["      ", " ###  ", " ###  ", "      "], "fill")
d:push_clip(2, 0, 2, 4)
d:fill(0, 0, 6, 4, 46, 1, 1)
d:pop_clip()
eq(d:to_lines(), ["  ..  ", " #..  ", " #..  ", "  ..  "], "clip")
d:clear()
d:push_origin(2, 1)
d:text(0, 0, "ab")
d:pop_origin()
eq(d:to_lines()[2], "  ab  ", "origin")

# изменённая область
e = cells.new(10, 5)
e:clean()
eq(e:is_dirty(), false, "clean")
e:set(3, 2, 65)
eq([e.dx0, e.dy0, e.dx1, e.dy1], [3, 2, 3, 2], "set marks one cell")
e:fill(5, 1, 2, 2, 66)
eq([e.dx0, e.dy0, e.dx1, e.dy1], [3, 1, 6, 2], "fill extends the rectangle")
e:clean()
e:text(1, 4, "xyz")
eq([e.dx0, e.dy0, e.dx1, e.dy1], [1, 4, 3, 4], "text marks its cells")

# копирование и затемнение
src = cells.new(3, 2)
src:text(0, 0, "abc", 5, 6)
dst = cells.new(6, 3)
dst:blit(src, 2, 1)
eq(dst:to_lines(), ["      ", "  abc ", "      "], "blit")
eq(dst:colors_lines("bg")[2], "006660", "blit copies colors")
dst:blit(src, 4, 0, 1, 0, 2, 1)
eq(dst:to_lines()[1], "    bc", "blit part")
dst:remap(0, 0, 6, 3, {5: 8, 6: 9})
eq(dst:colors_lines("bg")[2], "009990", "remap background")
r = cells.new(2, 2)
r:text(0, 0, "ab", 1, 2)
r:recolor(0, 0, 2, 1, 3, nil)
eq(r:colors_lines("fg")[1], "33", "recolor keeps symbols")
eq(r:to_lines()[1], "ab", "recolor keeps text")

# размер и копия
q = cells.new(3, 2)
q:text(0, 0, "abc")
q:resize(5, 3)
eq(q:to_lines(), ["abc  ", "     ", "     "], "resize keeps content")
q:resize(2, 1)
eq(q:to_lines(), ["ab"], "shrink")
k = q:copy()
eq(k:equals(q), true, "copy equals")
k:set(0, 0, 90)
eq(k:equals(q), false, "differs")

print("done")
