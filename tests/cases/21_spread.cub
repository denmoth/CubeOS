def add3(a, b, c): return a + b + c
args = [1, 2, 3]
print(add3(*args))
xs = [0, *args, 4]
print(table.concat(xs, ","))
d1 = {a: 1, b: 2}
d2 = {**d1, b: 20, c: 3}
print(d2.a, d2.b, d2.c)
first, *rest = [1, 2, 3, 4]
print(first, table.concat(rest, ","))
*init, last = [1, 2, 3, 4]
print(table.concat(init, ","), last)
a, *mid, z = [1, 2, 3, 4, 5]
print(a, table.concat(mid, ","), z)
p, q = [7, 8]
print(p, q)
let m, *n = [9, 8, 7]
print(m, table.concat(n, ","))
print(add3(*[1, 1, 1]))
