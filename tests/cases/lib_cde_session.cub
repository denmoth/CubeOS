import t
import cfs
import boot
import boot.console as console_mod
import cde.session as cde_session
import cde.window as window_mod
import svc.timed as timed
import svc.powerd as powerd
import svc.clipboard as clipboard
eq = t.eq

# Вход, рабочий стол CDE вместо полноэкранного терминала, терминал cush в окне: ввод через ядро и менеджер окон, файлы в CFS пользователя.

clock = {now: 1000}
def now():
    return clock.now

def breathe():
    os.queueEvent("test_breathe")
    os.pullEvent("test_breathe")

def build_fs():
    let fsys = cfs.new({clock: now})
    fsys:mount("/", cfs.memory({now: now}))
    fsys:mount("/rom", cfs.host("/rom", {readonly: true}))
    fsys:mount("/cubeos/tmp", cfs.tmp(65536, now))
    cfs.install_defaults(fsys)
    for dir in ["/cubeos/sys/services", "/cubeos/sys/cfg", "/cubeos/var", "/cubeos/shared"]:
        fsys:mkdir(nil, dir, {parents: true})
    fsys:write_file(nil, "/cubeos/sys/services/timed.conf", "{name: 'timed', module: 'svc.timed'}")
    fsys:write_file(nil, "/cubeos/sys/services/powerd.conf", "{name: 'powerd', module: 'svc.powerd'}")
    fsys:write_file(nil, "/cubeos/sys/services/clipboard.conf", "{name: 'clipboard', module: 'svc.clipboard'}")
    fsys:write_file(nil, "/cubeos/sys/cfg/boot.conf", "{rounds: 2, de: 'cde'}")
    fsys:write_file(nil, "/cubeos/sys/cfg/time.conf", "{tz: 'Europe/Kyiv', seconds: true}")
    return fsys

modules = {"svc.timed": timed, "svc.powerd": powerd, "svc.clipboard": clipboard}
def importer(path):
    return modules[path]

draws = {n: 0}
def count_draw():
    draws.n += 1
def fake_term():
    api = {}
    def get_size(px):
        if px:
            return 51 * 6, 19 * 9
        return 51, 19
    api.getSize = get_size
    for name in ["setBackgroundColor", "setTextColor", "clear", "setCursorPos", "blit", "setPaletteColor", "setGraphicsMode", "setFrozen"]:
        api[name] = () => nil
    api.drawPixels = (x, y, rows) => count_draw()
    return api

captured = {}
def term_ready(c):
    captured.term = c
def wm_ready(w):
    captured.wm = w
def shell_for(session):
    return cde_session.program(session, {term: fake_term(), assets: "/repo/assets", host: "cubebox", ready: wm_ready,
        terminal_ready: term_ready})

def screen():
    vt = captured.term.vterm
    lines = []
    for y in range[1, vt.h]:
        lines[y] = vt:line_text(y)
    return table.concat(lines, "\n")

def has(text):
    return captured.term != nil and string.find(screen(), text, 1, true) != nil

def wait(system, cond, rounds=150):
    for i in range[1, rounds]:
        if cond():
            return true
        if i % 4 == 0:
            breathe()
        system.kernel:run_ready()
        clock.now = clock.now + 100
        system.kernel:tick()
    return cond()

def wait_text(system, text, rounds=150):
    return wait(system, () => has(text), rounds)

def type_text(system, text):
    for i in range[1, string.len(text)]:
        system.kernel:feed("char", string.sub(text, i, i))
    system.kernel:feed("key", keys.enter, false)
    system.kernel:feed("key_up", keys.enter)

fsys = build_fs()
con = console_mod.ScriptedConsole(["ivan", "", "s"])
b = boot.new({fsys: fsys, console: con, clock: now, import: importer, shell: shell_for, kernel: {clock: now}})
system = b:start()
eq(wait(system, () => captured.term != nil), true, "the desktop started a terminal window")
wm = captured.wm
eq(wait_text(system, "ivan@cubebox:~$"), true, "the prompt shows the user, the computer and home")
eq(len(wm.windows), 1, "one window")
win = wm.windows[1]
eq([win.title, win.kind, wm.focused == win], ["Terminal", "text", true], "the terminal window has the focus")
eq(captured.term.vterm.w, 42, "the terminal is as wide as the window")

# набор идёт: ядро -> менеджер окон -> процесс окна -> оболочка
type_text(system, "echo hi from a window")
eq(wait_text(system, "hi from a window"), true, "typing in the window runs the command")
type_text(system, "echo data > note.txt")
eq(wait(system, () => fsys:exists(nil, "/cubeos/users/ivan/home/note.txt")), true, "files go into the user's CFS home")

# то, что напечатал терминал, дошло до экрана: в клетках окна и в пикселях кадра
cells = win.cells
row = nil
for y in range[0, cells.h - 1]:
    line = []
    for x in range[0, cells.w - 1]:
        line[x + 1] = utf8.char(cells.cp[y * cells.w + x + 1])
    if string.find(table.concat(line), "hi from a window", 1, true) != nil:
        row = y
eq(row != nil, true, "the output is in the window cells")
s = wm.screen.surface
lit = 0
y0 = win.y + window_mod.TITLE + row * 9
for yy in range[y0, y0 + 8]:
    for xx in range[win.x + 1, win.x + 60]:
        if s:get(xx, yy) != cells.bg[row * cells.w + 1]:
            lit += 1
eq(lit > 20, true, "the output is drawn in the frame")
eq(draws.n > 0, true, "frames reach drawPixels")

# окно шире: терминал получает новый размер
system.kernel:feed("key", keys.leftAlt, false)
system.kernel:feed("key", keys.up, false)
system.kernel:feed("key_up", keys.leftAlt)
eq(wait(system, () => captured.term.vterm.w == math.floor((306 - 2) / 6)), true, "maximized window resizes the terminal")
type_text(system, "echo still here")
eq(wait_text(system, "still here"), true, "the shell works after the resize")

# второе окно терминала (Alt+Enter), Ctrl+T закрывает окно в фокусе
system.kernel:feed("key", keys.leftAlt, false)
system.kernel:feed("key", keys.enter, false)
system.kernel:feed("key_up", keys.leftAlt)
eq(wait(system, () => len(wm.windows) == 2), true, "Alt+Enter opens another terminal")
eq(wait(system, () => has("ivan@cubebox:~$")), true, "with its own prompt")
system.kernel:feed("key", keys.leftCtrl, false)
system.kernel:feed("key", keys.t, false)
system.kernel:feed("key_up", keys.leftCtrl)
eq(wait(system, () => len(wm.windows) == 1), true, "Ctrl+T closes the focused terminal window")

# выход из сессии: Ctrl+Alt+Q, снова экран входа
system.kernel:feed("key", keys.leftCtrl, false)
system.kernel:feed("key", keys.leftAlt, false)
system.kernel:feed("key", keys.q, false)
eq(wait(system, () => len(system.sessions:list()) == 0), true, "Ctrl+Alt+Q signs out")
print("done")
