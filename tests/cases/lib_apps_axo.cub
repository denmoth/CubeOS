import t
import kernel
import cfs
import cde
import apps.axo as axo
import apps.axo.types as types
eq = t.eq

def make_term():
    api = {}
    def get_size(px):
        if px:
            return 306, 171
        return 51, 19
    def nothing(a, b, c, d):
        pass
    api.getSize = get_size
    for name in ["setBackgroundColor", "setTextColor", "clear", "setCursorPos", "blit", "setPaletteColor", "setGraphicsMode", "drawPixels", "setFrozen"]:
        api[name] = nothing
    return api

def breathe():
    os.queueEvent("t_breathe")
    os.pullEvent("t_breathe")

# ---------------------------------------------------------------- типы и сортировка
eq([types.human_size(300), types.human_size(1536), types.human_size(3 * 1024 * 1024)], ["300 B", "1.5K", "3.0M"], "sizes")
list = [{name: "b.txt", type: "file", size: 5}, {name: ".hid", type: "file", hidden: true}, {name: "zdir", type: "dir"},
    {name: "A.lua", type: "file", size: 9}, {name: ".cfg", type: "dir", hidden: true}]
names = []
for e in types.sort(list, "name", 1):
    names[len(names) + 1] = e.name
eq(names, ["zdir", "A.lua", "b.txt", ".cfg", ".hid"], "folders first, hidden at the end")
eq([types.kind({name: "x.lua", type: "file"}), types.kind({name: "p.cimg", type: "file"}), types.kind({name: "d", type: "dir"})],
    ["lua", "image", "folder"], "kinds by extension")

# ---------------------------------------------------------------- окно
clock = {now: 1000}
def now():
    return clock.now
fsys = cfs.new({clock: now})
fsys:mount("/", cfs.memory({now: now}))
cfs.install_defaults(fsys)
home = "/cubeos/users/ann/home"
fsys:mkdir(nil, home .. "/games/snake", {parents: true})
fsys:mkdir(nil, "/cubeos/users/ann/cfg", {parents: true})
for n in ["notes.txt", "run.lua", ".secret"]:
    fsys:write_file(nil, home .. "/" .. n, "data")
v = cfs.view(fsys, nil, {aliases: cfs.default_aliases("ann")})
got = {}
wm = cde.wm.new({animations: {enabled: false}, term: make_term(), assets: "/repo/assets", clock: now})
k = kernel.new({clock: now})
breathe()
wm:launch(axo.main, {name: "axo"}, ["$home", {view: v, ready: (a) => rawset(got, "app", a)}])
def desk(sys, args):
    wm:run(sys)
k:spawn(desk, [], {name: "cde", ui: true})
def settle(n=10):
    k:feed("cubeos_cde")
    for i in range[1, n]:
        clock.now = clock.now + 20
        k:tick()
        k:run_ready()
settle()
app = got.app
def names_now():
    out = []
    for r in app.table.rows:
        out[len(out) + 1] = r.data.name
    return out
eq(app:tab().path, home, "opens $home")
eq(names_now(), ["games", "notes.txt", "run.lua"], "hidden files are not shown")
eq([app.path.alias, app.path.alias_root], ["$home", home], "the path bar shows the alias")
eq(wm.windows[1].title, "Axo - home", "window title")
def key(code, ctrl=false):
    if ctrl:
        k:feed("key", keys.leftCtrl, false)
    k:feed("key", code, false)
    if ctrl:
        k:feed("key_up", keys.leftCtrl)
    settle()
key(keys.h, true)
eq(names_now(), ["games", "notes.txt", "run.lua", ".secret"], "Ctrl+H shows hidden files at the end")
eq(app.table.rows[4].dim, true, "hidden files are dim")
key(keys.enter)
eq(app:tab().path, home .. "/games", "Enter opens the folder under the cursor")
key(keys.backspace)
eq([app:tab().path, app.table.rows[app.table.cursor].data.name], [home, "games"], "Backspace goes back with the cursor on the folder")
key(keys.n, true)
eq([len(app.tabs), app.cur, app.tabrow.visible], [2, 2, true], "Ctrl+N opens a tab, the tab bar shows")
k:feed("char", "g")
key(keys.enter)
key(keys.enter)
eq(app:tab().path, home .. "/games/snake", "the new tab goes on its own")
key(keys.left, true)
eq([app.cur, app:tab().path], [1, home], "Ctrl+Left switches back, each tab keeps its folder")
key(keys.w, true)
eq([len(app.tabs), app.tabrow.visible, app:tab().path], [1, false, home .. "/games/snake"], "Ctrl+W closes the active tab, the other one stays")
key(keys.backspace)
key(keys.backspace)
eq(app:tab().path, home, "each tab has its own history")
# путь вводом: несуществующая папка не меняет место
key(keys.l, true)
eq(app.path.editing, true, "Ctrl+L turns the path into a field")
key(keys.backspace, true)
for ch in ["/", "n", "o"]:
    k:feed("char", ch)
key(keys.enter)
eq([app.path.editing, app:tab().path], [false, home], "a missing folder does not change the place")
# сортировка кликом по заголовку «Name»: обратный порядок, папки всё равно впереди
w = wm.windows[1]
hx = w:content_x() + app.table.x + 6
hy = w:content_y() + app.table.y + 3
k:feed("mouse_click", 1, hx, hy)
k:feed("mouse_up", 1, hx, hy)
settle()
eq([app:tab().sort.dir, names_now()[1]], [-1, "games"], "header click reverses the order, folders stay first")
# ---------------------------------------------------------------- движок операций (без окна)
import apps.axo.ops as ops
fsys:mkdir(nil, "/t/a/sub", {parents: true})
fsys:mkdir(nil, "/t/b", {parents: true})
fsys:write_file(nil, "/t/a/x.txt", "1")
fsys:write_file(nil, "/t/a/sub/y.txt", "2")
fsys:write_file(nil, "/t/b/x.txt", "old")
eng = ops.engine(v)
op = eng:start("copy", ["/t/a/x.txt", "/t/a/sub"], "/t/b")
eq(op.total, 2, "copy counts files inside folders")
eng:step(100)
eq([op.state, op.conflict != nil and op.conflict.name], ["ask", "x.txt"], "same name stops and asks")
op:answer("rename")
eng:step(100)
eq([op.state, fsys:read_file(nil, "/t/b/x (2).txt"), fsys:read_file(nil, "/t/b/sub/y.txt"), fsys:read_file(nil, "/t/b/x.txt")],
    ["done", "1", "2", "old"], "keep both puts the copy next to it, folders are copied file by file")
op2 = eng:start("move", ["/t/b/sub"], "/t/a")
eng:step(100)
eq([op2.state, op2.conflict.dir], ["ask", true], "a folder with the same name asks to merge")
op2:answer("replace", true)
eng:step(100)
eq([op2.state, fsys:exists(nil, "/t/b/sub"), fsys:exists(nil, "/t/a/sub/y.txt")], ["done", false, true], "merge moves the content and removes the old folder")
op3 = eng:start("delete", ["/t/b/x (2).txt"])
eng:step(100)
eq([op3.state, fsys:exists(nil, "/t/b/x (2).txt")], ["done", false], "delete removes")
eq(ops.free_name(v, "/t/b", "x.txt"), "x (2).txt", "free names")

# ---------------------------------------------------------------- действия в окне
def keys_ctrl(code, shift=false):
    k:feed("key", keys.leftCtrl, false)
    if shift:
        k:feed("key", keys.leftShift, false)
    k:feed("key", code, false)
    if shift:
        k:feed("key_up", keys.leftShift)
    k:feed("key_up", keys.leftCtrl)
    settle(12)
# курсор на notes.txt
k:feed("char", "n")
settle()
eq(app.table.rows[app.table.cursor].data.name, "notes.txt", "type-ahead finds notes.txt")
keys_ctrl(keys.c)
eq([ops.clip.mode, ops.clip.paths[1]], ["copy", home .. "/notes.txt"], "Ctrl+C fills the shared clipboard")
settle(60)
k:feed("char", "g")
key(keys.enter)
keys_ctrl(keys.v)
settle(20)
eq(fsys:exists(nil, home .. "/games/notes.txt"), true, "Ctrl+V copies into the open folder")
eq(names_now()[2], "notes.txt", "the folder view refreshes")
# новая папка: Ctrl+Shift+N, Enter с предложенным именем
keys_ctrl(keys.n, true)
key(keys.enter)
eq(fsys:exists(nil, home .. "/games/New folder"), true, "Ctrl+Shift+N creates a folder")
# переименование: F2 выделяет имя без расширения, набранное его заменяет
settle(60)
k:feed("char", "n")
settle()
k:feed("char", "o")
settle()
key(keys.f2)
for ch in ["m", "e", "m", "o"]:
    k:feed("char", ch)
key(keys.enter)
eq(fsys:exists(nil, home .. "/games/memo.txt"), true, "F2 renames and keeps the extension")
# удаление: вопрос, Enter подтверждает
key(keys.delete)
key(keys.enter)
settle(20)
eq(fsys:exists(nil, home .. "/games/memo.txt"), false, "Del asks and removes after Enter")

# ---------------------------------------------------------------- ассоциации
import apps.axo.assoc as assoc
a = assoc.read_all(v)
eq([assoc.handlers_for(a, "x.lua"), assoc.handlers_for(a, "n.txt"), assoc.handlers_for(a, "startup"), assoc.handlers_for(a, "z.zzz")],
    [["cubed", "run"], ["cubed"], ["cubed", "run"], []], "defaults: .lua opens in cubed, runs second; unknown has nothing")
assoc.always(v, "zzz", "cubed")
eq(assoc.handlers_for(assoc.read_all(v), "z.zzz"), ["cubed"], "Always open this way writes the personal file")
assoc.always(v, "lua", "run")
eq(assoc.handlers_for(assoc.read_all(v), "x.lua"), ["run", "cubed"], "the chosen app goes first, the others follow")
eq([assoc.runnable("a.lua"), assoc.runnable("a.txt"), assoc.runnable("prog")], [true, false, true], "runnable files")
# окно выбора для неизвестного типа (сессии нет: открыть нельзя, но окно появляется)
fsys:write_file(nil, home .. "/games/data.zzq", "?")
key(keys.f5)
settle(60)
k:feed("char", "d")
key(keys.enter)
eq(app.ui:top_layer() != nil, true, "an unknown type opens the Open with window")
key(256)
eq(app.ui:top_layer() == nil, true, "Esc closes it")

print("done")
