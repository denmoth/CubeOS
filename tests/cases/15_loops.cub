words = 0
for w in ["a", "b", "c"]:
    if w == "b":
        continue
    words += 1
print(words)

total = 0
i = 0
while i < 10:
    i += 1
    if i % 2 == 0:
        continue
    for k in range[1, 2]:
        if k == 2:
            break
        total += i
print(total)

