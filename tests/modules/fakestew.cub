# fakestew: a stand-in for the stew object (docs/packages/09-stew-api.md) with canned data: installed packages, a catalog with
# Cobble, PineStore and a custom source, plan and apply that call on_progress through every stage. For the Store test and shots.
#
#   s = fakestew.new({pause: 0})          pause: seconds between stages (inside the worker process)
#   s.hold_at = "place"; s.hold = true    apply stops after that stage until s.hold = false (screenshots of a running install)
#   s.fail_id = "bob.beats"               apply of a plan with this package fails and rolls back
#   s.log                                 calls in order ("refresh", "plan", "apply", "set_storage ...")

import kernel.sys as ksys

def v(size, isize, extra=nil):
    e = extra ?? {}
    e.size = size
    e.installed_size = isize
    e.depends = e.depends ?? {"cubeos.cdk": "^0.5"}
    e.permissions = e.permissions ?? {need: ["gfx"], want: []}
    return e

