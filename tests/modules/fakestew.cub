def installed_data():
    def rec(id, version, storage, size, kind, apps=nil):
        return {id: id, version: version, source: "cobble", storage: storage, priority: "optional", kind: kind, depends: {}, want: {},
            modules: {}, contributes: {apps: apps ?? []}, options: {}, files: [], auto: false, pinned: false, size: size}
    return {
        "cubeos.boot": rec("cubeos.boot", "0.5.0", "unpacked", 48000, "lib"),
        "cubeos.cdk": rec("cubeos.cdk", "0.5.0", "unpacked", 96000, "lib"),
        "cubeos.cgl": rec("cubeos.cgl", "0.5.0", "packed", 41000, "lib"),
        "cubeos.axo": rec("cubeos.axo", "0.5.0", "packed", 52000, "app", [{id: "axo", name: "Axo", entry: "apps.axo"}]),
        "denmoth.chess": rec("denmoth.chess", "1.0.0", "packed", 29000, "app", [{id: "chess", name: "Chess", entry: "chess"}]),
        "denmoth.weather": rec("denmoth.weather", "2.0.0", "unpacked", 20000, "app", [{id: "weather", name: "Weather", entry: "weather"}]),
    }

def newer(a, b):
    pa = []
    for n in string.gmatch(tostring(a), "%d+"):
        pa[len(pa) + 1] = tonumber(n)
    pb = []
    for n in string.gmatch(tostring(b), "%d+"):
        pb[len(pb) + 1] = tonumber(n)
    for i in range[1, math.max(len(pa), len(pb))]:
        if (pa[i] ?? 0) != (pb[i] ?? 0):
            return (pa[i] ?? 0) > (pb[i] ?? 0)
    return false

export class FakeStew:
    def init(self, opts=nil):
        o = opts ?? {}
        self.log = []
        self.cat = catalog_data()
        self.inst = installed_data()
        self.pause = o.pause ?? 0
        self.hold = false
        self.hold_at = nil
        self.fail_id = nil
        self.progress = []
        self.last_plan_req = nil

    def _note(self, text):
        self.log[len(self.log) + 1] = text

    def _rec(self, id):
        for r in self.cat:
            if r.id == id:
                return r
        return nil

    def _entry(self, r):
        e = {}
        for k, x in r:
            e[k] = x
        have = self.inst[r.id]
        e.installed = have != nil and have.version or nil
        e.update = (have != nil and newer(r.latest, have.version)) and r.latest or nil
        return e

    def installed(self):
        return self.inst

    def sources(self):
        return [{name: "cobble", kind: "cobble", url: "OWNER/cobble", trust: "official"},
            {name: "pinestore", kind: "pinestore", url: "https://pinestore.cc", trust: "community"},
            {name: "friend", kind: "http", url: "https://example.com/index.json5", trust: "user"}]

    def refresh(self, name=nil, on_progress=nil):
        self:_note("refresh")
        return {ok: ["cobble", "pinestore", "friend"], failed: []}

    def catalog(self):
        out = []
        for r in self.cat:
            out[len(out) + 1] = self:_entry(r)
        return out

    def search(self, text, filter=nil):
        self:_note("search " .. tostring(text))
        q = string.lower(text ?? "")
        f = filter ?? {}
        out = []
        for r in self.cat:
            hay = string.lower(r.id .. " " .. r.name .. " " .. r.description)
            if (q == "" or string.find(hay, q, 1, true) != nil) and (f.source == nil or f.source == r.source) and (f.category == nil or f.category == r.category) and (f.kind == nil or f.kind == r.kind):
                out[len(out) + 1] = self:_entry(r)
        return out

    def info(self, id):
        r = self:_rec(id)
        e = r != nil and self:_entry(r) or {id: id, name: id}
        e.installed_rec = self.inst[id]
        if self.inst[id] != nil:
            e.manifest = {id: id, author: r != nil and r.author or nil, permissions: {need: ["gfx"], want: []}}
        return e

    def _size(self, id):
        r = self:_rec(id)
        if r == nil:
            return 0, 0
        e = r.versions[r.latest] ?? {}
        return e.size ?? 0, e.installed_size ?? 0

    def plan(self, req):
        self:_note("plan")
        self.last_plan_req = req
        steps = []
        down = 0
        delta = 0
        def add(op, id, auto):
            outer down, delta
            r = self:_rec(id)
            sz, isz = self:_size(id)
            have = self.inst[id]
            steps[len(steps) + 1] = {op: op, id: id, version: r != nil and r.latest or nil, "from": have != nil and have.version or nil,
                size: sz, installed_size: isz, source: r != nil and r.source or "cobble", trust: r != nil and r.trust or "official", auto: auto}
            if op != "remove":
                down += sz
                delta += isz - (have != nil and (have.size ?? 0) or 0)
            else:
                delta -= have != nil and (have.size ?? 0) or 0
        perms = {}
        for id in req.install ?? []:
            r = self:_rec(id)
            if r != nil:
                e = r.versions[r.latest] ?? {}
                for d, rng in e.depends ?? {}:
                    if self.inst[d] == nil:
                        add("install", d, true)
                add("install", id, false)
                if e.permissions != nil and len(e.permissions.need ?? []) > 0:
                    perms[id] = e.permissions.need
        for id in req.update ?? []:
            add("update", id, false)
        for id in req.remove ?? []:
            add("remove", id, false)
        return {ok: true, steps: steps, download: down, installed_delta: delta, peak: down + math.max(0, delta), free: 400000, reserve: 16384,
            fits: true, missing: [], conflicts: [], warnings: [], new_permissions: perms, runs_setup: []}

    def _wait(self, stage):
        if self.pause > 0:
            ksys.sleep(self.pause)
        if self.hold_at == stage:
            while self.hold:
                ksys.sleep(0.05)

    def apply(self, p, opts=nil):
        self:_note("apply")
        o = opts ?? {}
        n = len(p.steps)
        fail = false
        for st in p.steps:
            if st.id == self.fail_id:
                fail = true
        for stage in ["download", "verify", "place", "setup", "commit"]:
            if fail and stage == "place":
                if o.on_progress != nil:
                    o.on_progress("rollback", p.steps[1].id, 1, n)
                return {ok: false, error: "sha256 mismatch in " .. p.steps[1].id}
            for i, st in p.steps:
                self.progress[len(self.progress) + 1] = stage
                if o.on_progress != nil:
                    o.on_progress(stage, st.id, i, n)
            self:_wait(stage)
        for st in p.steps:
            if st.op == "remove":
                self.inst[st.id] = nil
            else:
                apps = []
                r = self:_rec(st.id)
                if r != nil and r.kind == "app":
                    apps = [{id: string.match(st.id, "[^%.]+$"), name: r.name, entry: st.id}]
                self.inst[st.id] = {id: st.id, version: st.version, source: st.source, storage: "packed", priority: "optional",
                    kind: r != nil and r.kind or "app", depends: {}, want: {}, modules: {}, contributes: {apps: apps},
                    options: (self.last_plan_req != nil and self.last_plan_req.options != nil and self.last_plan_req.options[st.id]) or {},
                    files: [], auto: st.auto, pinned: false, size: st.installed_size}
        return {ok: true}

    def install(self, ids, opts=nil):
        return self:apply(self:plan({install: ids}), opts)

    def remove(self, ids, opts=nil):
        return self:apply(self:plan({remove: ids}), opts)

    def update(self, ids=nil, opts=nil):
        return self:apply(self:plan({update: ids ?? []}), opts)

    def set_storage(self, id, mode):
        self:_note("set_storage " .. id .. " " .. mode)
        if self.inst[id] == nil:
            return {ok: false, error: "not installed"}
        self.inst[id].storage = mode
        return {ok: true}

    def options(self, id):
        return self.inst[id] != nil and self.inst[id].options or nil

export def new(opts=nil):
    return FakeStew(opts)
