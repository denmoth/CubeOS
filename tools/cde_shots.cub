# Снимки рабочего стола CDE без игры: демо (examples/cde_demo) в подставном терминале CC: Graphics на настоящем ядре,
# кадры сохраняются как PPM (build/ui_cde_*.ppm). Запуск: tools/cde_shots.sh (он же делает PNG).

import kernel
import cde_demo as demo

def make_term(cols, rows):
    api = {}
    def get_size(px):
        if px:
            return cols * 6, rows * 9
        return cols, rows
    def nothing(a, b, c, d):
        pass
    api.getSize = get_size
    for name in ["setBackgroundColor", "setTextColor", "clear", "setCursorPos", "blit", "setPaletteColor", "setGraphicsMode", "drawPixels", "setFrozen"]:
        api[name] = nothing
    return api

def dump(wm, name):
    s = wm.screen.surface
    pal = wm.screen.palette
    f = fs.open("/repo/build/" .. name .. ".ppm", "wb")
    f.write("P6\n" .. s.w .. " " .. s.h .. "\n255\n")
    for y in range[0, s.h - 1]:
        parts = []
        for x in range[0, s.w - 1]:
            v = s.px[y * s.w + x + 1]
            r, g, b = pal:get(v < 0 and 0 or v)
            parts[x + 1] = string.char(r, g, b)
        f.write(table.concat(parts))
    f.close()
    os.queueEvent("shot")
    os.pullEvent("shot")

clock = {now: 1000}
def now():
    return clock.now

def settle(k, n=8):
    for i in range[1, n]:
        clock.now = clock.now + 50
        k:tick()
        k:run_ready()
    os.queueEvent("shot")
    os.pullEvent("shot")

def shoot(cols, rows, tag, theme_name):
    wm = demo.build({term: make_term(cols, rows), assets: "/repo/assets", clock: now, theme: theme_name})
    k = kernel.new({clock: now})
    def desk(sys, args):
        wm:run(sys)
    k:spawn(desk, [], {name: "cde", ui: true})
    settle(k)
    dump(wm, "ui_cde_" .. tag .. "_1_start")
    # щёлкнуть по заметкам и набрать строку
    notes = nil
    for w in wm.windows:
        if w.title == "Notes":
            notes = w
    if notes != nil:
        k:feed("mouse_click", 1, notes.x + 8, notes.y + 30)
        k:feed("mouse_up", 1, notes.x + 8, notes.y + 30)
        for ch in ["H", "i", " ", "C", "D", "E", "!"]:
            k:feed("char", ch)
        k:feed("key", keys.enter, false)
        for ch in ["n", "e", "w"]:
            k:feed("char", ch)
    settle(k)
    # перетащить куб за заголовок
    cube = nil
    for w in wm.windows:
        if w.title == "Cube":
            cube = w
    if cube != nil:
        k:feed("mouse_click", 1, cube.x + 20, cube.y + 5)
        k:feed("mouse_drag", 1, cube.x + 10, cube.y + 2)
        k:feed("mouse_drag", 1, 12, 8)
        k:feed("mouse_up", 1, 12, 8)
        settle(k)
    dump(wm, "ui_cde_" .. tag .. "_2_moved")
    # предпросмотр половинки при перетаскивании к правому краю
    if cube != nil:
        k:feed("mouse_click", 1, cube.x + 20, cube.y + 5)
        k:feed("mouse_drag", 1, cube.x + 40, cube.y + 30)
        k:feed("mouse_drag", 1, wm.W - 1, 60)
        settle(k)
        dump(wm, "ui_cde_" .. tag .. "_3_snap_preview")
        k:feed("mouse_up", 1, wm.W - 1, 60)
        settle(k)
        dump(wm, "ui_cde_" .. tag .. "_4_right_half")
    # Alt+↑ на заметках: на весь экран
    if notes != nil:
        k:feed("mouse_click", 1, notes.x + 30, notes.y + 5)
        k:feed("mouse_up", 1, notes.x + 30, notes.y + 5)
    k:feed("key", keys.leftAlt, false)
    k:feed("key", keys.up, false)
    k:feed("key_up", keys.leftAlt)
    settle(k)
    dump(wm, "ui_cde_" .. tag .. "_5_max")

# tools/cde_shots.sh term: только терминал в окне
if not fs.exists("/repo/build/cde_shots_term_only"):
    shoot(51, 19, "small", "tokyo-night")
    shoot(51, 19, "dark", "dark")
    shoot(51, 19, "light", "light")
    shoot(51, 19, "nord", "nord")
    shoot(82, 40, "monitor", "tokyo-night")

# ---------------------------------------------------------------- терминал в окне после настоящего входа (CFS в памяти)
import cfs
import boot
import boot.console as console_mod
import cde.session as cde_session
import svc.timed as timed
import svc.powerd as powerd
import svc.clipboard as clipboard

def term_shots():
    let fsys = cfs.new({clock: now})
    fsys:mount("/", cfs.memory({now: now}))
    fsys:mount("/rom", cfs.host("/rom", {readonly: true}))
    fsys:mount("/cubeos/tmp", cfs.tmp(65536, now))
    cfs.install_defaults(fsys)
    for dir in ["/cubeos/sys/services", "/cubeos/sys/cfg", "/cubeos/var", "/cubeos/shared"]:
        fsys:mkdir(nil, dir, {parents: true})
    fsys:write_file(nil, "/cubeos/sys/services/timed.conf", "{name: 'timed', module: 'svc.timed'}")
    fsys:write_file(nil, "/cubeos/sys/services/clipboard.conf", "{name: 'clipboard', module: 'svc.clipboard'}")
    fsys:write_file(nil, "/cubeos/sys/cfg/boot.conf", "{rounds: 2, de: 'cde'}")
    fsys:write_file(nil, "/cubeos/sys/cfg/time.conf", "{tz: 'Europe/Kyiv', seconds: true}")
    mods = {"svc.timed": timed, "svc.powerd": powerd, "svc.clipboard": clipboard}
    got = {}
    def shell_for(session):
        return cde_session.program(session, {term: make_term(51, 19), assets: "/repo/assets", host: "cubeos",
            ready: (w) => rawset(got, "wm", w), terminal_ready: (c) => rawset(got, "term", c)})
    con = console_mod.ScriptedConsole(["denmoth", "", "s"])
    b = boot.new({fsys: fsys, console: con, clock: now, import: (p) => mods[p], shell: shell_for, kernel: {clock: now}})
    system = b:start()
    k = system.kernel
    def run(n):
        for i in range[1, n]:
            k:run_ready()
            clock.now = clock.now + 100
            k:tick()
            if i % 4 == 0:
                os.queueEvent("shot")
                os.pullEvent("shot")
    def typ(text):
        for i in range[1, string.len(text)]:
            k:feed("char", string.sub(text, i, i))
        k:feed("key", keys.enter, false)
        k:feed("key_up", keys.enter)
        run(25)
    run(60)
    wm = got.wm
    typ("fetch")
    run(20)
    dump(wm, "ui_cde_term_1_fetch")
    typ("ls /rom")
    k:feed("paste", "echo Привет из окна | rev")
    k:feed("key", keys.enter, false)
    run(25)
    dump(wm, "ui_cde_term_2_cmds")
    wm:launch(demo.clock_app, {name: "clock"})
    k:feed("cubeos_cde")
    run(20)
    win = wm.windows[1]
    cw = wm.windows[2]
    if cw != nil:
        wm:move_resize(cw, wm.W - cw.w - 4, wm.H - cw.h - 4, cw.w, cw.h)
    wm:move_resize(win, 4, 4, win.w, win.h)
    k:feed("mouse_click", 1, win.x + 30, win.y + 5)
    k:feed("mouse_up", 1, win.x + 30, win.y + 5)
    run(10)
    dump(wm, "ui_cde_term_3_with_clock")
    k:feed("key", keys.leftAlt, false)
    k:feed("key", keys.up, false)
    k:feed("key_up", keys.leftAlt)
    run(20)
    typ("ls -l /rom/programs")
    dump(wm, "ui_cde_term_4_max")

term_shots()
