# Кадры анимаций CDE без игры: каждые 50 мс (20 кадров, как обновляется экран CC) пишется кадр build/anim_<сцена>_<номер>.ppm.
# Запуск: tools/anim_shots.sh (он же собирает GIF build/ui_anim_<сцена>.gif).

import kernel
import cde
import cdk.gallery as gallery
import cde_demo as demo

def make_term(cols, rows):
    api = {}
    def get_size(px):
        if px:
            return cols * 6, rows * 9
        return cols, rows
    def nothing(a, b, c, d):
        pass
    api.getSize = get_size
    for name in ["setBackgroundColor", "setTextColor", "clear", "setCursorPos", "blit", "setPaletteColor", "setGraphicsMode", "drawPixels", "setFrozen"]:
        api[name] = nothing
    return api

counter = {n: 0}
def dump(wm, scene):
    counter.n += 1
    s = wm.screen.surface
    pal = wm.screen.palette
    f = fs.open("/repo/build/anim_" .. scene .. "_" .. string.format("%03d", counter.n) .. ".ppm", "wb")
    f.write("P6\n" .. s.w .. " " .. s.h .. "\n255\n")
    for y in range[0, s.h - 1]:
        parts = []
        for x in range[0, s.w - 1]:
            v = s.px[y * s.w + x + 1]
            r, g, b = pal:get(v < 0 and 0 or v)
            parts[x + 1] = string.char(r, g, b)
        f.write(table.concat(parts))
    f.close()
    os.queueEvent("shot")
    os.pullEvent("shot")

clock = {now: 1000}
def now():
    return clock.now

def setup(theme_name):
    wm = cde.wm.new({term: make_term(51, 19), assets: "/repo/assets", clock: now, theme: theme_name})
    k = kernel.new({clock: now})
    def desk(sys, args):
        wm:run(sys)
    k:spawn(desk, [], {name: "cde", ui: true})
    return wm, k

# n кадров по 50 мс: ядро крутится несколько раз за кадр (приложения успевают нарисовать)
def frames(wm, k, scene, n):
    for i in range[1, n]:
        for j in range[1, 5]:
            clock.now = clock.now + 10
            k:tick()
            k:run_ready()
        dump(wm, scene)

def keys_down(k, list):
    for c in list:
        k:feed("key", c, false)
    for i in range[len(list), 1] step -1:
        k:feed("key_up", list[i])

# ---------------------------------------------------------------- окна: открытие, развернуть, вернуть, свернуть, закрыть
counter.n = 0
wm, k = setup("tokyo-night")
frames(wm, k, "windows", 2)
wm:launch(demo.clock_app, {name: "clock"})
k:feed("cubeos_cde")
frames(wm, k, "windows", 6)
wm:launch(demo.cube_app, {name: "cube"})
k:feed("cubeos_cde")
frames(wm, k, "windows", 8)
keys_down(k, [keys.leftAlt, keys.up])
frames(wm, k, "windows", 8)
keys_down(k, [keys.leftAlt, keys.down])
frames(wm, k, "windows", 8)
keys_down(k, [keys.leftAlt, keys.leftShift, keys.left])
frames(wm, k, "windows", 8)
keys_down(k, [keys.leftAlt, keys.down])
frames(wm, k, "windows", 4)
keys_down(k, [keys.leftAlt, keys.down])
frames(wm, k, "windows", 8)
keys_down(k, [keys.leftAlt, keys.right])
frames(wm, k, "windows", 8)
keys_down(k, [keys.leftCtrl, keys.t])
frames(wm, k, "windows", 8)

# ---------------------------------------------------------------- элементы cdk
counter.n = 0
wm, k = setup("tokyo-night")
got = {}
wm:launch(gallery.main, {name: "gallery"}, [(u) => rawset(got, "ui", u)])
k:feed("cubeos_cde")
frames(wm, k, "widgets", 6)
ui = got.ui
win = wm.windows[1]
page = ui.root.children[1].tabs[1].content
found = {checkbox: [], switch: [], progress: [], tabs: []}
def walk(w):
    if found[w.kind] != nil:
        found[w.kind][len(found[w.kind]) + 1] = w
    for c in w.children:
        walk(c)
walk(ui.root)
def click(w, dx=nil, dy=nil):
    x = win:content_x() + w.x + (dx ?? math.floor(w.w / 2))
    y = win:content_y() + w.y + (dy ?? math.floor(w.h / 2))
    k:feed("mouse_click", 1, x, y)
    k:feed("mouse_up", 1, x, y)
click(found.switch[2], 9)
frames(wm, k, "widgets", 5)
click(found.checkbox[2], 4)
frames(wm, k, "widgets", 5)
click(found.switch[1], 9)
frames(wm, k, "widgets", 5)
tabs = found.tabs[1]
k:feed("mouse_click", 1, win:content_x() + tabs.x + 60, win:content_y() + tabs.y + 5)
k:feed("mouse_up", 1, win:content_x() + tabs.x + 60, win:content_y() + tabs.y + 5)
frames(wm, k, "widgets", 6)
lists = tabs.tabs[2].content
files = lists.children[1]
click(files, 20, 7)
frames(wm, k, "widgets", 2)
for i in range[1, 4]:
    k:feed("key", keys.down, false)
    frames(wm, k, "widgets", 3)
side = lists.children[2]
click(side.children[2])
frames(wm, k, "widgets", 6)
k:feed("key", keys.escape ?? 256, false)
frames(wm, k, "widgets", 2)
click(side.children[3])
frames(wm, k, "widgets", 8)
