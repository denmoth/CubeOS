# Screenshots of the installer screens: runs the real screens over the real stew catalog (build/packages) in a fake 51x19 colour
# terminal, dumps the canvas of every screen as text+colours into build/setup_<n>_<screen>.txt; tools/setup_shots.sh turns the
# dumps into PNG (build/setup_*.png). Nothing is installed (apply is replaced by a fake that only reports progress).
import setup
import setup.canvas as canvas_mod
import stew as stew_mod

COLS = 51
ROWS = 19
ROOT = "/shots_root"
if fs.exists(ROOT):
    fs.delete(ROOT)
fs.makeDir(ROOT)

def make_term(w, h):
    api = {}
    def get_size():
        return w, h
    api.getSize = get_size
    api.isColour = () => true
    for name in ["blit", "setCursorPos", "clear", "setBackgroundColour", "setTextColour", "setPaletteColour", "write", "clearLine"]:
        api[name] = (a, b, c) => nil
    def get_pal(c):
        return 0.5, 0.5, 0.5
    api.getPaletteColour = get_pal
    return api

shots = {n: 0}

def dump(s, tag):
    shots.n += 1
    c = s.c
    f = fs.open("/repo/build/setup_" .. string.format("%02d", shots.n) .. "_" .. tag .. ".txt", "wb")
    f.write(c.w .. " " .. c.h .. "\n")
    for y in range[1, c.h]:
        f.write(table.concat(c.ch[y]) .. "\n" .. table.concat(c.fg[y]) .. "\n" .. table.concat(c.bg[y]) .. "\n")
    f.close()

def K(k):
    return ["key", k]

def typ(list, text):
    for i in range[1, len(text)]:
        list[len(list) + 1] = ["char", string.sub(text, i, i)]

ev = []
seen = {}
def ytick(s):
    os.queueEvent("shots_yield")
    os.pullEvent("shots_yield")
def drive(s):
    # called as an event: dump the screen once, then script the way to the next one
    os.queueEvent("shots_yield")
    os.pullEvent("shots_yield")
    name = s.cur
    if s.qpos > 400:
        error("shots: stuck on " .. s.cur, 0)
    nxt = []
    if seen[name] == nil:
        seen[name] = true
        dump(s, name)
        if name == "welcome":
            nxt = [K(keys.down), K(keys.space), K(keys.enter)]
        elif name == "profile":
            nxt = [K(keys.down), K(keys.down), K(keys.down), K(keys.enter)]
        elif name == "manual":
            nxt = [K(keys.right), K(keys.down), K(keys.down), K(keys.tab)]
        elif name == "options":
            nxt = [K(keys.tab)]
        elif name == "storage" or name == "fit":
            nxt = [K(keys.enter)]
        elif name == "user":
            typ(nxt, "Den Moth")
            nxt[len(nxt) + 1] = K(keys.enter)
            nxt[len(nxt) + 1] = K(keys.enter)
            typ(nxt, "secret")
            nxt[len(nxt) + 1] = K(keys.enter)
            typ(nxt, "secret")
            nxt[len(nxt) + 1] = K(keys.enter)
            nxt[len(nxt) + 1] = K(keys.enter)
        elif name == "summary":
            nxt = [K(keys.enter)]
        else:
            nxt = [K(keys.enter)]
    else:
        nxt = [K(keys.enter)]
    pos = s.qpos
    k = 0
    for e in nxt:
        table.insert(s.queue, pos + k + 1, e)
        table.insert(s.queue, pos + k + 2, ytick)
        k += 2
    table.insert(s.queue, pos + k + 1, drive)

ev[1] = drive

st = stew_mod.new({fs: fs, root: ROOT})
real_plan = st.plan
done = {mid: false}
holder = {s: nil}
def fake_apply(self, p, opts):
    n = len(p.steps)
    for stage in ["download", "verify", "place"]:
        for i in range[1, n]:
            opts.on_progress(stage, p.steps[i].id, i, n)
            if stage == "place" and i == n - n / 3 and not done.mid:
                done.mid = true
                dump(holder.s, "progress")
    return {ok: true}
st.apply = fake_apply
def yield_now():
    os.queueEvent("shots_yield")
    os.pullEvent("shots_yield")
def wrap(name):
    orig = st[name]
    def wrapped(self, *a):
        yield_now()
        r = orig(self, *a)
        yield_now()
        return r
    st[name] = wrapped
wrap("refresh")
wrap("catalog")
wrap("plan")

env = {term: make_term(COLS, ROWS), stew: st, fs: fs, root: ROOT, events: ev, strict: true, timer: (x) => nil, sleep: (x) => nil,
    clock: () => 0, peripheral: {getNames: () => []}, animate: false, make_account: (u, s) => nil,
    source: {name: "local", kind: "path", url: "/repo/build/packages"}, cleanup: () => nil, reboot: () => nil}
s = setup.new(env)
holder.s = s
yield_now()
ok, res = pcall(() => s:run())
print("shots " .. shots.n .. " " .. tostring(ok) .. " " .. tostring(res))
fs.delete(ROOT)
