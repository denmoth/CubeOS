# Снимки панели задач CDE без игры: демо (examples/cde_demo) в подставном терминале CC: Graphics на настоящем ядре, кадры в PPM
# (build/ui_panel_*.ppm). Запуск: tools/panel_shots.sh (он же делает PNG).

import kernel
import cde_demo as demo

def make_term(cols, rows):
    api = {}
    def get_size(px):
        if px:
            return cols * 6, rows * 9
        return cols, rows
    def nothing(a, b, c, d):
        pass
    api.getSize = get_size
    for name in ["setBackgroundColor", "setTextColor", "clear", "setCursorPos", "blit", "setPaletteColor", "setGraphicsMode", "drawPixels", "setFrozen"]:
        api[name] = nothing
    return api

def dump(wm, name):
    s = wm.screen.surface
    pal = wm.screen.palette
    f = fs.open("/repo/build/" .. name .. ".ppm", "wb")
    f.write("P6\n" .. s.w .. " " .. s.h .. "\n255\n")
    for y in range[0, s.h - 1]:
        parts = []
        for x in range[0, s.w - 1]:
            v = s.px[y * s.w + x + 1]
            r, g, b = pal:get(v < 0 and 0 or v)
            parts[x + 1] = string.char(r, g, b)
        f.write(table.concat(parts))
    f.close()
    os.queueEvent("shot")
    os.pullEvent("shot")

clock = {now: 1000}
def now():
    return clock.now

def settle(k, n=8):
    k:feed("cubeos_cde")
    for i in range[1, n]:
        clock.now = clock.now + 50
        k:tick()
        k:run_ready()
    os.queueEvent("shot")
    os.pullEvent("shot")

def by_title(wm, title):
    for w in wm.windows:
        if w.title == title:
            return w
    return nil

def shoot(cols, rows, tag, theme_name, panel):
    wm = demo.build({term: make_term(cols, rows), assets: "/repo/assets", clock: now, theme: theme_name,
        panel: panel, animations: {enabled: false}})
    k = kernel.new({clock: now})
    def desk(sys, args):
        wm:run(sys)
    k:spawn(desk, [], {name: "cde", ui: true})
    settle(k)
    dump(wm, "ui_panel_" .. tag .. "_1")
    # свернуть заметки кнопкой панели (она в фокусе или нет: два нажатия)
    notes = by_title(wm, "Notes")
    it = wm.panel:item_for(notes)
    if it != nil:
        px = it.x + 3
        py = wm.panel.rect.y + it.y + 3
        if wm.focused != notes:
            k:feed("mouse_click", 1, px, py)
            k:feed("mouse_up", 1, px, py)
            settle(k)
        k:feed("mouse_click", 1, px, py)
        k:feed("mouse_up", 1, px, py)
        settle(k)
    dump(wm, "ui_panel_" .. tag .. "_2_min")
    # развернуть кубик: он занимает рабочую область, панель остаётся
    cube = by_title(wm, "Cube")
    wm:set_state(cube, "max")
    wm:set_panel({position: "top", align: "center"})
    settle(k)
    dump(wm, "ui_panel_" .. tag .. "_3_top_center")

shoot(51, 19, "tokyo", "tokyo-night", {time_text: () => "14:32"})
shoot(51, 19, "light", "light", {time_text: () => "09:05"})
shoot(51, 19, "nord", "nord", {time_text: () => "23:59"})
shoot(164, 81, "monitor", "dark", {time_text: () => "14:32"})
