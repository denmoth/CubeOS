# Снимки панели задач CDE без игры: демо (examples/cde_demo) в подставном терминале CC: Graphics на настоящем ядре, кадры в PPM
# (build/ui_panel_*.ppm). Запуск: tools/panel_shots.sh (он же делает PNG).

import kernel
import cde_demo as demo
import cde.apps as apps_mod
import cde.startmenu as startmenu
import cde.tray as tray_mod
import svc.rpc as rpc

def make_term(cols, rows):
    api = {}
    def get_size(px):
        if px:
            return cols * 6, rows * 9
        return cols, rows
    def nothing(a, b, c, d):
        pass
    api.getSize = get_size
    for name in ["setBackgroundColor", "setTextColor", "clear", "setCursorPos", "blit", "setPaletteColor", "setGraphicsMode", "drawPixels", "setFrozen"]:
        api[name] = nothing
    return api

def dump(wm, name):
    s = wm.screen.surface
    pal = wm.screen.palette
    f = fs.open("/repo/build/" .. name .. ".ppm", "wb")
    f.write("P6\n" .. s.w .. " " .. s.h .. "\n255\n")
    for y in range[0, s.h - 1]:
        parts = []
        for x in range[0, s.w - 1]:
            v = s.px[y * s.w + x + 1]
            r, g, b = pal:get(v < 0 and 0 or v)
            parts[x + 1] = string.char(r, g, b)
        f.write(table.concat(parts))
    f.close()
    os.queueEvent("shot")
    os.pullEvent("shot")

clock = {now: 1000}
def now():
    return clock.now

def settle(k, n=8):
    k:feed("cubeos_cde")
    for i in range[1, n]:
        clock.now = clock.now + 50
        k:tick()
        k:run_ready()
    os.queueEvent("shot")
    os.pullEvent("shot")

def by_title(wm, title):
    for w in wm.windows:
        if w.title == title:
            return w
    return nil

def shoot(cols, rows, tag, theme_name, panel):
    wm = demo.build({term: make_term(cols, rows), assets: "/repo/assets", clock: now, theme: theme_name,
        panel: panel, animations: {enabled: false}})
    k = kernel.new({clock: now})
    def desk(sys, args):
        wm:run(sys)
    k:spawn(desk, [], {name: "cde", ui: true})
    settle(k)
    dump(wm, "ui_panel_" .. tag .. "_1")
    # свернуть заметки кнопкой панели (она в фокусе или нет: два нажатия)
    notes = by_title(wm, "Notes")
    it = wm.panel:item_for(notes)
    if it != nil:
        px = it.x + 3
        py = wm.panel.rect.y + it.y + 3
        if wm.focused != notes:
            k:feed("mouse_click", 1, px, py)
            k:feed("mouse_up", 1, px, py)
            settle(k)
        k:feed("mouse_click", 1, px, py)
        k:feed("mouse_up", 1, px, py)
        settle(k)
    dump(wm, "ui_panel_" .. tag .. "_2_min")
    # развернуть кубик: он занимает рабочую область, панель остаётся
    cube = by_title(wm, "Cube")
    wm:set_state(cube, "max")
    wm:set_panel({position: "top", align: "center"})
    settle(k)
    dump(wm, "ui_panel_" .. tag .. "_3_top_center")

def menu_shoot(cols, rows, tag, theme_name):
    wm = demo.build({term: make_term(cols, rows), assets: "/repo/assets", clock: now, theme: theme_name,
        panel: {time_text: () => "14:32"}, animations: {enabled: false}})
    reg = apps_mod.new()
    def nop(w):
        pass
    reg:add({id: "terminal", name: "Terminal", icon: "terminal", keywords: ["console"], run: nop})
    reg:add({id: "widgets", name: "Widget gallery", icon: "cube", run: nop})
    reg:add({id: "files", name: "File manager", icon: "folder", run: nop})
    reg:add({id: "settings", name: "Settings", icon: "gear", run: nop})
    reg:add({id: "calc", name: "Calculator", icon: "plus", run: nop})
    reg:add({id: "notes", name: "Notes", icon: "file", run: nop})
    reg:add({id: "t1", name: "Theme: Tokyo Night", icon: "star", kind: "action", detail: "Appearance", run: nop})
    reg:add({id: "t2", name: "Theme: Nord", icon: "star", kind: "action", detail: "Appearance", run: nop})
    reg:add({id: "t3", name: "Theme: Light", icon: "star", kind: "action", detail: "Appearance", run: nop})
    opts = {user: "denmoth", footer: [{text: "Log out", icon: "close", run: nop}]}
    wm.on_start = () => startmenu.toggle(wm, reg, opts)
    k = kernel.new({clock: now})
    def desk(sys, args):
        wm:run(sys)
    k:spawn(desk, [], {name: "cde", ui: true})
    settle(k)
    k:feed("key", keys.leftAlt, false)
    k:feed("key_up", keys.leftAlt)
    settle(k, 14)
    dump(wm, "ui_panel_" .. tag .. "_menu")
    for ch in ["t", "h", "e"]:
        k:feed("char", ch)
    settle(k, 10)
    k:feed("key", keys.down, false)
    settle(k, 10)
    dump(wm, "ui_panel_" .. tag .. "_menu_search")

def service(name, handlers):
    def run(sys, a):
        sys.register(name)
        rpc.serve(sys, handlers)
    return run

def tray_shoot(tag, theme_name):
    audio = {volume: 65, muted: false, speakers: ["speaker_0", "speaker_1"], playing: false}
    net = {name: "cube-1", modems: [{side: "back", wired: true}], paired: 1}
    kb = {keyboard: "ru", mode: "manual", layouts: [{name: "ru", title: "Russian"}, {name: "uk", title: "Ukrainian"}]}
    ah = {}
    ah.status = (q, f) => audio
    ah.volume = (q, f) => audio.volume
    nh = {}
    nh.status = (q, f) => net
    nh.peers = (q, f) => [{id: 2, name: "cube-2", paired: true, wired: true}, {id: 3, name: "farm-3", paired: false, wired: true}]
    kh = {}
    kh.get = (q, f) => kb
    wm = demo.build({term: make_term(51, 19), assets: "/repo/assets", clock: now, theme: theme_name,
        panel: {time_text: () => "14:32"}, animations: {enabled: false}})
    k = kernel.new({clock: now})
    k:spawn(service("audiod", ah), [], {name: "audiod"})
    k:spawn(service("netd", nh), [], {name: "netd"})
    k:spawn(service("inputd", kh), [], {name: "inputd"})
    tray = tray_mod.new(wm)
    tray:install()
    def desk(sys, args):
        wm:run(sys)
    k:spawn(desk, [], {name: "cde", ui: true})
    settle(k, 30)
    dump(wm, "ui_panel_" .. tag .. "_tray")
    for key in ["sound", "net", "layout"]:
        for it in wm.panel.items:
            if it.key == "tray:" .. key:
                px = it.x + 3
                py = wm.panel.rect.y + it.y + 3
                k:feed("mouse_click", 1, px, py)
                k:feed("mouse_up", 1, px, py)
                settle(k, 20)
                dump(wm, "ui_panel_" .. tag .. "_tray_" .. key)
                k:feed("key", 256, false)
                settle(k, 10)

def wp_shoot(name, tag):
    wm = demo.build({term: make_term(51, 19), assets: "/repo/assets", clock: now, theme: "tokyo-night",
        panel: {time_text: () => "14:32"}, background: name, animations: {enabled: tag != "static"}})
    k = kernel.new({clock: now})
    def desk(sys, args):
        wm:run(sys)
    k:spawn(desk, [], {name: "cde", ui: true})
    settle(k, 10)
    wm:toggle_desktop()
    settle(k, 10)
    dump(wm, "ui_panel_wp_" .. name .. "_a")
    if wm.live != nil:
        clock.now = clock.now + 700
        settle(k, 4)
        dump(wm, "ui_panel_wp_" .. name .. "_b")

for n in ["boot-wave", "nyan", "matrix", "vaporwave", "creeper", "sus"]:
    wp_shoot(n, "x")
tray_shoot("tokyo", "tokyo-night")
tray_shoot("light", "light")
menu_shoot(51, 19, "tokyo", "tokyo-night")
menu_shoot(51, 19, "light", "light")
shoot(51, 19, "tokyo", "tokyo-night", {time_text: () => "14:32"})
shoot(51, 19, "light", "light", {time_text: () => "09:05"})
shoot(51, 19, "nord", "nord", {time_text: () => "23:59"})
shoot(164, 81, "monitor", "dark", {time_text: () => "14:32"})
