# Снимки терминала без игры: запускает программу «Терминал» (cush) пиксельным выводом в CraftOS-PC, набирает команды и сохраняет кадры
# как PPM (build/ui_term_*.ppm). Запуск: tools/term_shots.sh (он же превращает кадры в PNG).

import term.app as term_app
import term.view as view_mod
import ui
import ui.theme as themes

COLS = 96
ROWS = 30

def make_term(cols, rows):
    api = {}
    def get_size(px):
        if px:
            return cols * 6, rows * 9
        return cols, rows
    def nothing(a, b, c, d):
        pass
    api.getSize = get_size
    for name in ["setBackgroundColor", "setTextColor", "clear", "setCursorPos", "blit", "setPaletteColor", "setGraphicsMode", "drawPixels", "setFrozen"]:
        api[name] = nothing
    return api

def dump(screen, name):
    s = screen.surface
    pal = screen.palette
    f = fs.open("/repo/build/" .. name .. ".ppm", "wb")
    f.write("P6\n" .. s.w .. " " .. s.h .. "\n255\n")
    for y in range[0, s.h - 1]:
        parts = []
        for x in range[0, s.w - 1]:
            v = s.px[y * s.w + x + 1]
            r, g, b = pal:get(v < 0 and 0 or v)
            parts[x + 1] = string.char(r, g, b)
        f.write(table.concat(parts))
    f.close()

term_api = make_term(COLS, ROWS)
out = ui.open_out({term: term_api, backend: "pixel", theme: themes.get("cubeos")})
sh = ui.new_shell(out, {theme: themes.get("cubeos"), clock: () => "14:32", animations: false})
HIST = "/repo/build/term_shots_history"
if fs.exists(HIST):
    fs.delete(HIST)
f = fs.open(HIST, "w")
f.write("ls /rom\ncat notes.txt | grep todo\nsleep 5 &\n")
f.close()
sh:register(term_app.spec({history_path: HIST, user: "denmoth", host: "cubeos", greeting: true}))
sh:launch("terminal")
out:open()

def frames(n):
    for i in range[1, n]:
        sh:tick(0.1)
        sh:render()

def typ(text):
    for i in range[1, string.len(text)]:
        sh:handle("char", string.sub(text, i, i))

def enter():
    sh:handle("key", keys.enter, false)
    sh:handle("key_up", keys.enter)
    frames(3)

frames(3)
typ("fetch")
enter()
frames(2)
dump(out.screen, "ui_term_fetch")

typ("ls -l /rom")
enter()
typ("ls /rom/programs | grep l | wc -l")
enter()
typ("echo Привет, мир | tr")
enter()
typ("cat nosuchfile")
enter()
typ("echo hello | wc -w")
enter()
frames(2)
dump(out.screen, "ui_term_pipes")

# набор строки: подсветка и серая подсказка из истории
typ("ls /rom | grep -i pro")
frames(2)
dump(out.screen, "ui_term_typing")

# выделение: прокрутка назад и ... снимок после Shift+PgUp
sh:handle("key", keys.leftShift, false)
sh:handle("key", keys.pageUp, false)
sh:handle("key_up", keys.pageUp)
sh:handle("key_up", keys.leftShift)
frames(2)
dump(out.screen, "ui_term_scrollback")
fs.delete(HIST)
