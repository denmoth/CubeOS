# ---------------------------------------------------------------- Pulse
procs = [{pid: 1, name: "init", state: "waiting", user: "system", cpu_ms: 100, ui: false}, {pid: 4, name: "logd", state: "waiting", user: "system", cpu_ms: 40, ui: false},
    {pid: 6, name: "audiod", state: "waiting", user: "system", cpu_ms: 90, ui: false}, {pid: 8, name: "netd", state: "waiting", user: "system", cpu_ms: 220, ui: false},
    {pid: 12, name: "cde", state: "running", user: "denmoth", cpu_ms: 1500, ui: true}, {pid: 15, name: "axo", state: "waiting", user: "denmoth", cpu_ms: 420, ui: true},
    {pid: 17, name: "terminal", state: "waiting", user: "denmoth", cpu_ms: 310, ui: true}]
app, w = open_app(pulse.main, [nil, {view: vw, ps: () => procs, ready: (p) => rawset(got, "app", p)}])
for i in range[1, 40]:
    procs[5].cpu_ms = procs[5].cpu_ms + 300 + math.floor(math.sin(i / 3) * 250 + 250)
    procs[2].cpu_ms = procs[2].cpu_ms + (i % 7 == 0 and 400 or 5)
    settle(26)
dump(wm, "ui_app_pulse")
key(keys.three)
settle(10)
dump(wm, "ui_app_pulse_perf")
close_app(w)

# ---------------------------------------------------------------- Settings
conf = {theme: "tokyo-night", scale: "auto", wallpaper: "aurora", lock_wallpaper: "aurora", avatar: "cat"}
d = {wm: wm, conf: conf, user: "denmoth",
    theme_names: () => [{name: "tokyo-night", display: "Tokyo Night"}, {name: "dark", display: "Dark"}, {name: "light", display: "Light"}, {name: "nord", display: "Nord"}],
    wallpapers: () => ["aurora", "cube", "cube-live", "creeper", "grid", "matrix", "nyan", "night-city", "sunset", "vaporwave", "wave"],
    avatars: () => ["letter", "custom", "astronaut", "cat", "creeper", "cube", "fox", "ghost", "robot"],
    widgets: () => [{id: "clock", name: "Clock", on: true}, {id: "calendar", name: "Calendar", on: false}, {id: "system", name: "System", on: true}],
    save: (a, b) => nil, save_login: (a, b) => nil, set_theme: (n) => nil, set_scale: (x) => nil, set_animation: (a, b) => nil, set_wallpaper: (s) => nil,
    set_panel: (c) => nil, set_widget: (a, b) => nil, lock: () => nil}
app, w = open_app(settings.main, [nil, {view: vw, desktop: d, assets: "/repo/assets", ready: (p) => rawset(got, "app", p)}])
dump(wm, "ui_app_settings")
app.ui:set_focus(app.list)
key(keys.down)
dump(wm, "ui_app_settings2")
key(keys.down)
key(keys.down)
dump(wm, "ui_app_settings_login")
key(keys.down)
settle(10)
dump(wm, "ui_app_settings_sound")
key(keys.down)
key(keys.down)
key(keys.down)
key(keys.down)
dump(wm, "ui_app_settings_about")
close_app(w)
