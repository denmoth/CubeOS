# Снимки приложений CDE (Pixel, Brush, Jukebox, Calc, Notes, Clock, Pulse, Settings) без игры: build/ui_app_*.ppm.
# Запуск: tools/apps_shots.sh. Каждое приложение открывается на весь экран; службы и рабочий стол подставные.

import kernel
import cfs
import cde
import cgl.cimg as cimg
import svc.rpc as rpc
import apps.pixel as pixel
import apps.brush as brush
import apps.jukebox as jukebox
import apps.calc as calc
import apps.notes as notes
import apps.clock as clockapp
import apps.pulse as pulse
import apps.settings as settings

def make_term(cols, rows):
    api = {}
    def get_size(px):
        if px:
            return cols * 6, rows * 9
        return cols, rows
    def nothing(a, b, c, d):
        pass
    api.getSize = get_size
    for name in ["setBackgroundColor", "setTextColor", "clear", "setCursorPos", "blit", "setPaletteColor", "setGraphicsMode", "drawPixels", "setFrozen"]:
        api[name] = nothing
    return api

def dump(wm, name):
    s = wm.screen.surface
    pal = wm.screen.palette
    f = fs.open("/repo/build/" .. name .. ".ppm", "wb")
    f.write("P6\n" .. s.w .. " " .. s.h .. "\n255\n")
    for y in range[0, s.h - 1]:
        parts = []
        for x in range[0, s.w - 1]:
            v = s.px[y * s.w + x + 1]
            r, g, b = pal:get(v < 0 and 0 or v)
            parts[x + 1] = string.char(r, g, b)
        f.write(table.concat(parts))
    f.close()
    os.queueEvent("shot")
    os.pullEvent("shot")

def read_real(path):
    f = fs.open(path, "rb")
    data = f.readAll()
    f.close()
    return data

clock = {now: 1792000000000}
def now():
    return clock.now
fsys = cfs.new({clock: now})
fsys:mount("/", cfs.memory({now: now}))
cfs.install_defaults(fsys)
home = "/cubeos/users/denmoth/home"
for d in [home .. "/pictures", home .. "/music", home .. "/documents", "/cubeos/users/denmoth/cfg", "/cubeos/run/services"]:
    fsys:mkdir(nil, d, {parents: true})
fsys:write_file(nil, home .. "/pictures/sunset.cimg", read_real("/repo/assets/wallpapers/sunset.cimg"))
fsys:write_file(nil, home .. "/pictures/aurora.cimg", read_real("/repo/assets/wallpapers/aurora.cimg"))
fsys:write_file(nil, home .. "/pictures/creeper.cimg", read_real("/repo/assets/wallpapers/creeper.cimg"))
fsys:write_file(nil, home .. "/documents/farm.lua", table.concat(["-- auto farm: harvests wheat and replants it", "local modem = peripheral.find(\"modem\")", "local SEED = \"minecraft:wheat_seeds\"", "",
    "local function ripe()", "    local ok, data = turtle.inspect()", "    return ok and data.state.age == 7", "end", "",
    "for row = 1, 12 do", "    if ripe() then", "        turtle.dig()", "        turtle.place()", "        print(\"harvested row\", row, 3.5)", "    end", "    turtle.forward()", "end"], string.char(10)))
for n in ["logd", "timed", "devd", "audiod", "netd", "extd", "permd"]:
    fsys:write_file(nil, "/cubeos/run/services/" .. n, "running" .. string.char(10))
vw = cfs.view(fsys, nil, {aliases: cfs.default_aliases("denmoth")})

wm = cde.wm.new({term: make_term(51, 19), assets: "/repo/assets", clock: now, panel: {time_text: () => "14:32"}, background: "aurora", animations: {enabled: false}})
k = kernel.new({clock: now})
def settle(n=10):
    k:feed("cubeos_cde")
    for i in range[1, n]:
        clock.now = clock.now + 40
        k:tick()
        k:run_ready()
    os.queueEvent("shot")
    os.pullEvent("shot")
def desk(sys, args):
    wm:run(sys)
k:spawn(desk, [], {name: "cde", ui: true})
settle(10)

got = {}
# ошибка приложения при запуске не должна пропасть молча: пишется в build/dbg.txt
def guard(main):
    def run(sys, ctx):
        ok, err = pcall(main, sys, ctx)
        if not ok:
            f = fs.open("/repo/build/dbg.txt", "a")
            f.writeLine("CRASH " .. tostring(err))
            f.close()
    return run
def poke():
    k:feed("key_up", keys.leftCtrl)
    settle(6)
def open_app(main, args):
    got.app = nil
    wm:launch(guard(main), {name: "app"}, args)
    settle(20)
    w = wm.windows[len(wm.windows)]
    wm:set_state(w, "max")
    settle(20)
    return got.app, w
def close_app(w):
    wm:request_close(w)
    settle(10)
def key(code, ctrl=false, shift=false):
    if ctrl:
        k:feed("key", keys.leftCtrl, false)
    if shift:
        k:feed("key", keys.leftShift, false)
    k:feed("key", code, false)
    if shift:
        k:feed("key_up", keys.leftShift)
    if ctrl:
        k:feed("key_up", keys.leftCtrl)
    settle(8)
def chars(text):
    for ch in string.gmatch(text, "."):
        k:feed("char", ch)
    settle(6)

# звуковая служба: нотки принимает, ничего не играет
played = {n: 0}
audiod = {}
audiod.status = (q, f) => {playing: false, volume: 70, muted: false, speakers: ["speaker_0"]}
audiod.notes = (q, f) => rawset(played, "n", played.n + len(q.list)) and len(q.list)
audiod.sound = (q, f) => true
audiod.stop = (q, f) => true
audiod.volume = (q, f) => 70
def audio_service(sys, a):
    sys.register("audiod")
    rpc.serve(sys, audiod)
k:spawn(audio_service, [], {name: "audiod"})
settle(5)

# ---------------------------------------------------------------- Pixel
app, w = open_app(pixel.main, [home .. "/pictures/sunset.cimg", {view: vw, ready: (p) => rawset(got, "app", p)}])
key(keys.i)
dump(wm, "ui_app_pixel")
key(keys.right)
dump(wm, "ui_app_pixel2")
close_app(w)

# ---------------------------------------------------------------- Brush: сцена
app, w = open_app(brush.main, [nil, {view: vw, ready: (p) => rawset(got, "app", p)}])
cv = app.canvas
G = 32
def col(hue, shade):
    return G + hue * 15 + shade
# небо полосами, солнце, холмы, дом и ёлки
for i in range[0, 11]:
    cv:fill_rect(0, i * 4, cv.w, 4, col(6, 6 + math.floor(i / 2)))
cv:fill_rect(0, 44, cv.w, 3, col(2, 12))
for i in range[0, 5]:
    cv:circle(92, 30, 16 - i * 3, col(1, 14 - i), true)
for x in range[0, cv.w - 1]:
    h = 52 + math.floor(math.sin(x / 11) * 5 + math.sin(x / 5) * 2)
    cv:fill_rect(x, h, 1, cv.h - h, col(4, 7))
for x in range[0, cv.w - 1]:
    h = 64 + math.floor(math.sin(x / 8 + 2) * 4)
    cv:fill_rect(x, h, 1, cv.h - h, col(4, 5))
cv:fill_rect(20, 54, 22, 16, col(0, 10))
cv:triangle(17, 54, 45, 54, 31, 40, col(0, 5), true)
cv:fill_rect(28, 60, 6, 10, col(1, 4))
for tx in [60, 70, 100, 110]:
    cv:fill_rect(tx, 62, 3, 8, col(1, 3))
    cv:triangle(tx - 7, 64, tx + 10, 64, tx + 1, 48, col(4, 4), true)
    cv:triangle(tx - 5, 56, tx + 8, 56, tx + 1, 44, col(4, 8), true)
app:pick_color(col(9, 12), 1)
app.vp:invalidate()
poke()
dump(wm, "ui_app_brush")
close_app(w)

# ---------------------------------------------------------------- Jukebox
app, w = open_app(jukebox.main, [nil, {view: vw, assets: "/repo/assets", ready: (p) => rawset(got, "app", p)}])
key(keys.enter)
settle(60)
dump(wm, "ui_app_jukebox")
settle(120)
dump(wm, "ui_app_jukebox2")
key(keys.two)
dump(wm, "ui_app_jukebox_mc")
