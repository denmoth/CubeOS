# term.chars: набор символов CC (байты 0..255) и их вид в наших буферах клеток
#
# Классические программы пишут в терминал байты. Набор CC: 32..126 ASCII, 160..255 Latin-1, 128..159 «телетекст» (блоки 2x3),
# 0..31 и 127 это значки и стрелки (в CC они рисуются шрифтом терминала). Для показа в буфере клеток (ui.cells) байт превращается
# в код символа Unicode: обычные символы как есть, значки в похожие символы Unicode, телетекст и прочее в «сырые» коды
# 0xE000 + байт. Вывод на настоящий CC (ui.out_text) возвращает сырые коды в байты, пиксельный вывод (ui.out_pixel) сам рисует
# телетекст блоками.
#
#   chars.to_cp(0x41) -> 65           chars.to_cp(150) -> 0xE096 (телетекст)       chars.to_byte(0xE096) -> 150
#   chars.teletext_bits(150)          -> маска шести подпикселей (1 левый верх, 2 правый верх, 4, 8, 16, 32 правый низ)

import unicode

export const RAW_BASE = 0xE000

# значки нижних кодов CC в похожие символы Unicode (что есть в шрифте Monocraft: стрелки, точки, треугольники)
const LOW = {
    1: 0x263A, 2: 0x263B, 3: 0x2665, 4: 0x25C6, 5: 0x2663, 6: 0x2660, 7: 0x2022, 8: 0x25D8, 9: 0x25CB, 10: 0x25D9, 11: 0x2642,
    12: 0x2640, 13: 0x266A, 14: 0x266B, 15: 0x263C, 16: 0x25BA, 17: 0x25C4, 18: 0x2195, 19: 0x203C, 20: 0xB6, 21: 0xA7, 22: 0x25AC,
    23: 0x21A8, 24: 0x2191, 25: 0x2193, 26: 0x2192, 27: 0x2190, 28: 0x221F, 29: 0x2194, 30: 0x25B2, 31: 0x25BC
}

# Терминал CC хранит байты, а нам нужна кириллица. Строки UTF-8 разбираются в клетки: правильная последовательность UTF-8 это
# один код символа, всё остальное (в том числе байты 128..159 телетекста и одиночные байты Latin-1) это байт как есть. Символы
# 128..255 из правильной UTF-8 хранятся как LATIN + код, чтобы кодирование обратно вернуло именно их.
export const LATIN = 0x200000

# строка -> список клеток (байты 0..255, коды Unicode, LATIN + код)
export def decode(s):
    out = []
    n = 0
    if string.find(s, "[^ -~]") == nil:
        for i in range[1, string.len(s)]:
            out[i] = string.byte(s, i)
        return out
    i = 1
    total = string.len(s)
    while i <= total:
        b = string.byte(s, i)
        need = 0
        cp = 0
        if b >= 0xC2 and b <= 0xDF:
            need = 1
            cp = b - 0xC0
        elif b >= 0xE0 and b <= 0xEF:
            need = 2
            cp = b - 0xE0
        elif b >= 0xF0 and b <= 0xF4:
            need = 3
            cp = b - 0xF0
        ok = need > 0 and i + need <= total
        if ok:
            for k in range[1, need]:
                c = string.byte(s, i + k)
                if c < 0x80 or c > 0xBF:
                    ok = false
                    break
                cp = cp * 64 + (c - 0x80)
        n += 1
        if ok:
            out[n] = cp < 256 and LATIN + cp or cp
            i += need + 1
        else:
            out[n] = b
            i += 1
    return out

# список клеток -> строка (обратное к decode)
export def encode(cells):
    parts = []
    for i in range[1, len(cells)]:
        v = cells[i]
        if v >= LATIN:
            v -= LATIN
            parts[i] = unicode.char(v)
        elif v >= 256:
            parts[i] = unicode.char(v)
        else:
            parts[i] = string.char(v)
    return table.concat(parts)

# длина строки в клетках и подстрока по клеткам (с 1, включая границы), для строк с кириллицей
export def length(s):
    if string.find(s, "[^ -~]") == nil:
        return string.len(s)
    return len(decode(s))

export def sub(s, i, j=nil):
    if string.find(s, "[^ -~]") == nil:
        return string.sub(s, i, j)
    cs = decode(s)
    n = len(cs)
    first = i
    last = j ?? n
    if first < 0:
        first = n + 1 + first
    if last < 0:
        last = n + 1 + last
    if first < 1:
        first = 1
    if last > n:
        last = n
    part = []
    k = 0
    for p in range[first, last]:
        k += 1
        part[k] = cs[p]
    return encode(part)

# байт CC -> код символа
export def to_cp(b):
    if b >= LATIN:
        return b - LATIN
    if b >= 256:
        return b
    if b >= 32 and b < 127:
        return b
    if b >= 160:
        return b == 160 and 32 or b
    if b >= 128 and b < 160:
        return RAW_BASE + b
    if b == 127:
        return 0x2588
    if b == 0:
        return 32
    # 1..31: значок Unicode, но байт тоже запоминаем: ui.out_text вернёт именно его
    return RAW_BASE + b

# код символа из буфера клеток -> байт терминала CC (для вывода на настоящий CC)
export def to_byte(cp):
    if cp >= RAW_BASE and cp < RAW_BASE + 256:
        return cp - RAW_BASE
    if cp < 256:
        return cp
    return 63

# значок Unicode для сырого кода нижней части (для пиксельного вывода) или nil
export def low_glyph(cp):
    if cp > RAW_BASE and cp < RAW_BASE + 32:
        return LOW[cp - RAW_BASE]
    return nil

# телетекст: байты 128..159 это шесть подпикселей 2x3: бит 1 левый верх, 2 правый верх, 4 левый средний, 8 правый средний,
# 16 левый нижний; правый нижний подпиксель байта 128..159 всегда фоновый (как в cgl.teletext). Возвращает маску из шести бит,
# где бит 32 это правый нижний (в символах CC он не используется).
export def teletext_bits(b):
    return b - 128

export def is_teletext(cp):
    return cp >= RAW_BASE + 128 and cp < RAW_BASE + 160

# строка CC (байты) -> строка UTF-8 для показа в обычных программах CubeOS
export def to_utf8(s):
    out = []
    for i in range[1, string.len(s)]:
        out[i] = unicode.char(low_glyph(to_cp(string.byte(s, i))) ?? (to_cp(string.byte(s, i)) >= RAW_BASE and 63 or to_cp(string.byte(s, i))))
    return table.concat(out)
