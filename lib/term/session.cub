# term.session: сессия с терминалом (оболочка cush) внутри процесса ядра: программа, которую запускает вход (boot) для пользователя
#
#   shell = (session) => session_mod.program(session, {assets: "/repo/assets"})      для boot.new({shell: ...})
#
# Процесс получает вид CFS пользователя (sys.view()), поэтому программы CraftOS работают поверх CFS: права, ссылки и корзина действуют
# и для них (fs подменён на cfs.legacy_fs(view)). Ввод идёт через sys.wait_event (а не через CC напрямую), события таймеров и сети доходят
# программам, Ctrl+T превращается в событие terminate для активной программы (оболочка прервёт программу, а не систему).
# Служебные вещи оболочка берёт у служб: время и его сохранение (timed), выключение и перезагрузка (powerd), общий буфер обмена (clipboard);
# если службы нет, всё работает локально. Настройки пользователя: $cfg/cush.conf, история команд $cfg/cush_history.
#
# opts: term (по умолчанию настоящий), backend ("auto", "pixel", "text"), assets (папка assets для шрифта), host (имя компьютера),
#   ready(ctx) (для тестов: {vterm, env, ui, proc, out} сразу после запуска), history (строк прокрутки, 2000)

import ui
import cfs
import json5
import fonts as fonts_mod
import term.vterm as vterm
import term.view as view_mod
import term.palette as palette
import compat.env as env_mod
import compat.proc as proc_mod
import cush.shell as cush
import svc.rpc as rpc
import svc.timeclient as timeclient

# события ввода идут через интерфейс (раскладка, мышь), остальные программе напрямую
const INPUT = {key: true, key_up: true, char: true, paste: true, mouse_click: true, mouse_drag: true, mouse_up: true,
    mouse_scroll: true, monitor_touch: true, term_resize: true, monitor_resize: true}

export def program(session, opts=nil):
    o = opts ?? {}

    def main(sys, args):
        view = sys.view()
        open_opts = {backend: o.backend ?? "auto"}
        if o.term != nil:
            open_opts.term = o.term
        if o.assets != nil:
            open_opts.assets = o.assets
        # шрифт пиксельного терминала (D239): настройки системы и пользователя ($cfg/fonts.conf), запасные шрифты для недостающих букв
        font_name = nil
        if o.font == nil:
            def read_conf(path):
                if path != nil and view:exists(path):
                    return view:read(path)
                return nil
            okf, f, fname = pcall(() => fonts_mod.terminal_font(fonts_mod.read_conf(read_conf, view:expand("$cfg") .. "/fonts.conf"),
                fonts_mod.scan(fonts_mod.dirs(view:expand("$data") .. "/fonts"))))
            if okf and f != nil:
                open_opts.font = f
                font_name = fname
        else:
            open_opts.font = o.font
        out = ui.open_out(open_opts)
        u = ui.runtime.new(out, {theme: ui.theme.get("cubeos")})
        cols, rows = out:size()
        vt = vterm.new(cols, rows, {palette: palette.get("cubeos"), history: o.history ?? 2000})
        # клавиатура (D235): второй язык и режим из /cubeos/sys/cfg/locale.conf (keyboard, keyboard_mode), раскладки в assets/layouts
        lc = {}
        if view:exists("/cubeos/sys/cfg/locale.conf"):
            okc, data = pcall(() => json5.parse(view:read("/cubeos/sys/cfg/locale.conf")))
            if okc and type(data) == "table":
                lc = data
        tv = view_mod.new(vt, {width: "fill", height: "fill", keyboard: lc.keyboard ?? "ru", layout_mode: lc.keyboard_mode ?? "auto",
            layout_dirs: [(o.assets ?? "/repo/assets") .. "/lang", "/cubeos/share/lang"]})
        # обычный пользователь и гость получают ограниченное окружение (без debug, свои копии общих таблиц; D243)
        env = env_mod.new({vterm: vt, fs: cfs.legacy_fs(view), restricted: session.admin_capable != true})

        # ROM-библиотеки, которые не загрузились (иначе программы потом падают с пустым colors и подобным), в журнал
        failed = []
        for e in (env.api_errors ?? []):
            sys.log("error", "terminal: ROM library failed to load: " .. e)
            failed[len(failed) + 1] = string.match(e, "^([^:]+)") ?? e
        notes = []
        if len(failed) > 0:
            notes[1] = "ROM libraries not loaded: " .. table.concat(failed, ", ") .. " (see: logs)"
        sys.log("info", "terminal started for " .. tostring(session.user))

        t = timeclient.new(sys)

        # Оболочка и программы работают в сопрограмме compat.proc, а системные вызовы ядра (sys.send, receive...) можно делать только из
        # процесса. Поэтому вызовы служб идут «через хозяина»: сопрограмма кладёт запрос в очередь и ждёт событие cubeos_reply, а цикл
        # хозяина (pull) выполняет запрос и отвечает ему этим событием.
        pending = []
        counter = {n: 0}
        def host_call(name, payload):
            counter.n += 1
            id = counter.n
            pending[len(pending) + 1] = {id: id, name: name, payload: payload}
            while true:
                ev, rid, a, b = os.pullEvent("cubeos_reply")
                if rid == id:
                    return a, b
        def time_save(changes):
            return host_call("time_save", changes)
        def power(action):
            return host_call("power", action)
        # запрос без ожидания ответа (запись в журнал): сопрограмма не останавливается
        def post(name, payload):
            pending[len(pending) + 1] = {id: nil, name: name, payload: payload}
        def shell_log(level, text):
            post("log", {level: level, text: text})
        # журнал ввода (logd input): on true/false включает и выключает, nil спрашивает состояние
        def inputlog(on):
            return host_call("inputlog", on)
        # sudo (D226): status, elevate (пароль или nil: без пароля после входа по паролю), fs (файлы с правами администратора), forget
        def sudo(op, password=nil):
            return host_call("sudo", {op: op, password: password})
        # учётная запись: passwd, pin, remember, status; autologin и trust_disk только после sudo
        def account(op, args=nil):
            return host_call("account", {op: op, args: args})
        # клавиатура системы (служба inputd): get или set {keyboard, mode}
        def keyboard(op, args=nil):
            return host_call("keyboard", {op: op, args: args})
        # звук (служба audiod): op и args как у её запросов
        def audio(op, args=nil):
            return host_call("audio", {op: op, args: args})
        # сеть (служба netd): op и args как у её запросов
        def net(op, args=nil):
            return host_call("net", {op: op, args: args})
        cfg = view:expand("$cfg")
        env.cush_opts = {history_path: cfg .. "/cush_history", config_path: cfg .. "/cush.conf", user: session.user, host: o.host,
            home: session.env.home, time: t.time, time_save: time_save, power: power, inputlog: inputlog, log: shell_log, notes: notes, sudo: sudo, account: account, keyboard: keyboard, audio: audio, net: net, assets: o.assets ?? "/repo/assets",
            lang_dir: [(o.assets ?? "/repo/assets") .. "/lang", "/cubeos/share/lang"], unicode: out.kind == "pixel",
            info: {display: out.kind == "pixel" and "pixel mode" or "text mode", font: out.kind == "pixel" and (font_name ?? "cube-mono-6x9") or nil}}

        died = {err: nil}
        # cur.proc: оболочка сейчас (удержание Ctrl+T без программы запускает новую, старая забывается)
        cur = {proc: nil}
        def on_exit(p, ok, err):
            if p != cur.proc:
                return
            if not ok:
                died.err = err
            u.quit = true
        def on_shutdown(p, reboot):
            u.quit = true
        def start_shell():
            p = proc_mod.new(env, "cush", [], {name: "terminal", main: cush.main, on_exit: on_exit, on_shutdown: on_shutdown})
            cur.proc = p
            p:start()
        def restart_shell():
            sys.log("warn", "terminal: the shell was restarted (Ctrl+T held with no program running)")
            env.secret_input = 0
            env.cush_opts.notes = ["The shell was restarted (Ctrl+T held)."]
            start_shell()
        tv:on("event", (w, name, a, b, c) => cur.proc:feed(name, a, b, c))
        u:set_root(tv)
        u:focus_widget(tv)
        start_shell()

        # общий буфер обмена: берём текущий, копируем в службу всё, что скопировано в терминале
        clip = view_mod.clipboard
        last = clip.text
        current = rpc.call(sys, "clipboard", "get")
        if type(current) == "string":
            view_mod.copy_text(current)
            last = current

        def serve_account(req):
            m = session.manager
            if m == nil:
                return false, "accounts are not available here"
            q = req.payload
            if req.name == "account":
                sys.busy("checking the password")
                ok, why = m:account(session.id, q.op, q.args)
                sys.busy(nil)
                return ok, why
            if q.op == "status":
                return m:account(session.id, "status"), nil
            if q.op == "elevate":
                if q.password == nil:
                    return m:elevate_trusted(session.id)
                sys.busy("checking the password")
                ok, why, wait = m:elevate(session.id, q.password)
                sys.busy(nil)
                if not ok and why == "locked":
                    why = "too many attempts, wait " .. tostring(wait) .. " s"
                elif not ok and why == "bad password":
                    why = "wrong password"
                return ok, why
            if q.op == "fs":
                return cfs.legacy_fs(m:view(session.id)), nil
            if q.op == "forget":
                m:drop_elevation(session.id)
                return true, nil
            return false, "unknown sudo operation"

        def serve_pending():
            while len(pending) > 0:
                req = table.remove(pending, 1)
                ok = false
                why = nil
                if req.name == "time_save":
                    ok, why = t.save(req.payload)
                elif req.name == "power":
                    res, err = rpc.call(sys, "powerd", req.payload)
                    ok = res != nil
                    why = err
                elif req.name == "log":
                    sys.log(req.payload.level, req.payload.text)
                elif req.name == "net":
                    # сопряжение и поиск идут по сети и считают ключ: до 30 секунд
                    res, err = rpc.call(sys, "netd", req.payload.op, req.payload.args, 30)
                    ok = res
                    why = err
                elif req.name == "audio":
                    res, err = rpc.call(sys, "audiod", req.payload.op, req.payload.args)
                    ok = res
                    why = err
                elif req.name == "keyboard":
                    res, err = rpc.call(sys, "inputd", req.payload.op, req.payload.args)
                    ok = res
                    why = err
                elif req.name == "sudo" or req.name == "account":
                    ok, why = serve_account(req)
                elif req.name == "inputlog":
                    res, err = rpc.call(sys, "logd", "input", req.payload != nil and {on: req.payload} or {})
                    ok = res
                    why = err
                if req.id != nil:
                    cur.proc:feed("cubeos_reply", req.id, ok, why)

        # скрытый ввод в программе (read("*")): ядро не пишет его в журнал ввода (D220)
        secret = {on: false}
        def sync_secret():
            want = (env.secret_input ?? 0) > 0
            if want != secret.on:
                secret.on = want
                sys.secret_input(want)

        def pull():
            serve_pending()
            sync_secret()
            ev, a, b, c, d, e = sys.wait_event()
            # удержание Ctrl+T (через секунду CC сам шлёт terminate; короткое нажатие терминал обрабатывает сам): программу убить без
            # вопросов, а если программы нет, перезапустить оболочку (D222)
            if ev == "cubeos_keyboard":
                tv:set_keyboard(a, b)
                return "none"
            if ev == "terminate":
                shell = env.cush_shell
                if shell != nil and shell.fg != nil:
                    cur.proc:feed("cubeos_kill")
                else:
                    restart_shell()
                return "none"
            proc = cur.proc
            if INPUT[ev] != true:
                if ev == "timer":
                    if proc:owns_timer(a):
                        proc:feed(ev, a, b, c, d, e)
                elif ev == "alarm":
                    if proc:owns_alarm(a):
                        proc:feed(ev, a, b, c, d, e)
                else:
                    proc:feed(ev, a, b, c, d, e)
            if clip.text != last:
                last = clip.text
                rpc.call(sys, "clipboard", "set", {text: last, source: "terminal"})
            return ev, a, b, c

        if o.ready != nil:
            o.ready({vterm: vt, env: env, ui: u, proc: cur.proc, out: out, clipboard: clip, current: cur})
        ui.runtime.run(u, {pull: pull})
        pcall(() => out:close())
        if out.screen != nil and out.screen.close != nil:
            pcall(out.screen.close, out.screen)
        if died.err != nil:
            error("the terminal crashed: " .. tostring(died.err), 0)
    return main
