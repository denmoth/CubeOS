# term.palette: палитры терминала CubeOS (16 цветов CC, программы CC видят их как свои цвета)
#
#   vt = vterm.new(w, h, {palette: palette.get("cubeos")})
#
# Порядок как у цветов CC: белый, оранжевый, пурпурный, голубой, жёлтый, салатовый, розовый, серый, светло-серый, бирюзовый,
# фиолетовый, синий, коричневый, зелёный, красный, чёрный.

const PALETTES = {
    cubeos: [[192, 202, 245], [255, 158, 100], [187, 154, 247], [122, 162, 247], [224, 175, 104], [158, 206, 106], [255, 121, 198],
        [65, 72, 104], [120, 124, 153], [125, 207, 255], [157, 124, 216], [61, 89, 161], [146, 113, 86], [80, 180, 110],
        [247, 118, 142], [26, 27, 38]],
    classic: [[240, 240, 240], [242, 178, 51], [229, 127, 216], [153, 178, 242], [222, 222, 108], [127, 204, 25], [242, 178, 204],
        [76, 76, 76], [153, 153, 153], [76, 153, 178], [178, 102, 229], [51, 102, 204], [127, 102, 76], [87, 166, 78],
        [204, 76, 76], [17, 17, 17]],
    light: [[36, 41, 46], [215, 99, 0], [160, 50, 150], [3, 102, 214], [160, 120, 0], [34, 134, 58], [214, 51, 132], [180, 186, 192],
        [106, 115, 125], [0, 137, 160], [111, 66, 193], [0, 82, 204], [140, 100, 60], [30, 110, 50], [203, 36, 49], [250, 250, 250]]
}

export def get(name):
    return PALETTES[name] ?? PALETTES.cubeos

export def names():
    out = []
    for k, v in PALETTES:
        out[len(out) + 1] = k
    table.sort(out)
    return out
