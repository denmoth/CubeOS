# cpk: пакет .cpk версии 1 (docs/packages/01-cpk-format.md). Один файл на пакет: манифест без сжатия, файлы лежат в блоках,
# блок сжимается целиком и распаковывается при первом обращении к любому своему файлу (ленивая загрузка).
#
# Раскладка (числа little endian, смещения от начала файла):
#   "CPK" 0x01
#   u32 длина манифеста, манифест (JSON5, без сжатия)
#   u16 число блоков, на блок: u32 смещение, u32 хранимый размер, u32 исходный размер, u8 метод, u32 CRC32 исходных данных
#   u16 число файлов, на файл: u16 длина пути, путь, u16 номер блока (с 1), u32 смещение в блоке, u32 размер, u8 флаги
#   данные блоков
#   32 байта sha256 всего, что выше
#   u16 длина подписи + подпись (в v1 длина 0)
# Методы: 0 без сжатия, 1 lzfast, 2 deflate. Флаги файла: 1 Lua, 2 карта строк (путь "<файл>.map"), 4 ресурс.
#
#   data = cpk.build(manifest_text, files, {method: 2, block: 32768, on_block: fn})
#       files: [{path, data, flags, method}]; порядок задаёт группировку (соседи идут в один блок)
#   a = cpk.open(data)                     из строки; cpk.open_file(path, fsys) читает с диска частями (seek)
#   a.manifest_text  a:manifest()  a:list() -> [{path, size, flags, block}]  a:exists(p)  a:read(p) -> строка или nil
#   a:verify() -> true или false, причина     a:size_info() -> {stored, raw, blocks, files}
#   cpk.extract(a, fsys, dest)            распаковать все файлы в папку

import deflate
import lzfast
import crc32 as crc
import sha256
import json5

export const MAGIC = "CPK\1"
export const STORE = 0
export const FAST = 1
export const STRONG = 2
export const F_LUA = 1
export const F_MAP = 2
export const F_RES = 4

export def has_flag(flags, bit):
    return math.floor((flags ?? 0) / bit) % 2 == 1

def _le(n, bytes):
    out = []
    for i in range[1, bytes]:
        out[i] = string.char(n % 256)
        n = math.floor(n / 256)
    return table.concat(out)

def _num(s, pos, bytes):
    n = 0
    mul = 1
    for i in range[0, bytes - 1]:
        n += string.byte(s, pos + i) * mul
        mul *= 256
    return n

def _pack(data, method):
    if method == FAST:
        return lzfast.compress(data)
    if method == STRONG:
        return deflate.deflate(data)
    return data

def _unpack(data, method):
    if method == FAST:
        return lzfast.decompress(data)
    if method == STRONG:
        return deflate.inflate(data)
    if method == STORE:
        return data
    error("cpk: unknown compression method " .. tostring(method), 0)

# пути только относительные, через /, без «..» и пустых частей
export def safe_path(p):
    if type(p) != "string" or p == "" or string.find(p, "\\", 1, true) != nil or string.find(p, "//", 1, true) != nil:
        return false
    if string.sub(p, 1, 1) == "/" or string.sub(p, -1) == "/":
        return false
    for part in string.gmatch(p, "[^/]+"):
        if part == "." or part == "..":
            return false
    return true

# Разложить файлы по блокам: соседи до limit байт вместе; крупный файл и файл со своим методом отдельно
def _group(files, limit, method):
    groups = []
    cur = nil
    for f in files:
        m = f.method ?? method
        if len(f.data) >= limit or m != method:
            groups[len(groups) + 1] = {method: m, files: [f], size: len(f.data)}
        else:
            if cur == nil or cur.size + len(f.data) > limit:
                cur = {method: method, files: [], size: 0}
                groups[len(groups) + 1] = cur
            cur.files[len(cur.files) + 1] = f
            cur.size += len(f.data)
    return groups

export def build(manifest_text, files, opts=nil):
    o = opts ?? {}
    method = o.method ?? STRONG
    limit = o.block ?? 32768
    seen = {}
    for f in files:
        if not safe_path(f.path):
            error("cpk: bad path in package: " .. tostring(f.path), 0)
        if seen[f.path]:
            error("cpk: file twice in package: " .. f.path, 0)
        seen[f.path] = true
    groups = _group(files, limit, method)
    if len(groups) > 65535 or len(files) > 65535:
        error("cpk: too many files", 0)
    blobs = []
    btab = []
    ftab = []
    for bi in range[1, len(groups)]:
        g = groups[bi]
        parts = []
        off = 0
        for f in g.files:
            parts[len(parts) + 1] = f.data
            ftab[len(ftab) + 1] = _le(len(f.path), 2) .. f.path .. _le(bi, 2) .. _le(off, 4) .. _le(len(f.data), 4) .. string.char(f.flags ?? 0)
            off += len(f.data)
        raw = table.concat(parts)
        stored = _pack(raw, g.method)
        m = g.method
        if m != STORE and len(stored) >= len(raw):
            stored = raw
            m = STORE
        blobs[bi] = stored
        btab[bi] = {stored: len(stored), raw: len(raw), method: m, crc: crc.crc32(raw)}
        if o.on_block != nil:
            o.on_block(bi, len(groups))
    head_len = 4 + 4 + len(manifest_text) + 2 + 17 * len(btab) + 2
    for t in ftab:
        head_len += len(t)
    pos = head_len
    bparts = []
    for bi in range[1, len(btab)]:
        b = btab[bi]
        bparts[bi] = _le(pos, 4) .. _le(b.stored, 4) .. _le(b.raw, 4) .. string.char(b.method) .. _le(b.crc, 4)
        pos += b.stored
    body = MAGIC .. _le(len(manifest_text), 4) .. manifest_text .. _le(len(btab), 2) .. table.concat(bparts) .. _le(len(ftab), 2) .. table.concat(ftab) .. table.concat(blobs)
    return body .. sha256.digest(body) .. _le(0, 2)

# --- чтение ---

# общий кэш распакованных блоков: ключ «архив:блок», ограничен по объёму, при переполнении выбрасываются самые старые
cache = {size: 0, limit: 262144, order: [], items: {}}

export def cache_limit(bytes):
    cache.limit = bytes
    _trim()

export def cache_clear():
    cache.size = 0
    cache.order = []
    cache.items = {}

def _trim():
    while cache.size > cache.limit and len(cache.order) > 0:
        key = table.remove(cache.order, 1)
        item = cache.items[key]
        if item != nil:
            cache.size -= len(item)
            cache.items[key] = nil

def _cache_put(key, data):
    if cache.items[key] == nil:
        cache.order[len(cache.order) + 1] = key
        cache.size += len(data)
    cache.items[key] = data
    _trim()

ids = {n: 0}

export class Archive:
    # src: {read(offset с 0, length) -> строка, size}
    def init(self, src, name=nil):
        self.src = src
        ids.n += 1
        self.key = (name ?? "cpk") .. "#" .. ids.n
        head = src.read(0, 8)
        if head == nil or len(head) < 8 or string.sub(head, 1, 4) != MAGIC:
            if head != nil and string.sub(head, 1, 3) == "CPK":
                error("cpk: package format " .. string.byte(head, 4) .. " is newer than this system understands", 0)
            error("cpk: not a .cpk package", 0)
        mlen = _num(head, 5, 4)
        self.manifest_text = src.read(8, mlen)
        pos = 8 + mlen
        nb = _num(src.read(pos, 2), 1, 2)
        btab = src.read(pos + 2, 17 * nb)
        self.blocks = []
        for i in range[1, nb]:
            p = (i - 1) * 17 + 1
            self.blocks[i] = {offset: _num(btab, p, 4), stored: _num(btab, p + 4, 4), raw: _num(btab, p + 8, 4),
                method: string.byte(btab, p + 12), crc: _num(btab, p + 13, 4)}
        pos += 2 + 17 * nb
        nf = _num(src.read(pos, 2), 1, 2)
        pos += 2
        # таблица файлов переменной длины: читаем кусок до начала первого блока
        data_start = nb > 0 and self.blocks[1].offset or (src.size - 34)
        ftab = src.read(pos, data_start - pos)
        self.files = []
        self.index = {}
        p = 1
        for i in range[1, nf]:
            plen = _num(ftab, p, 2)
            path = string.sub(ftab, p + 2, p + 1 + plen)
            q = p + 2 + plen
            e = {path: path, block: _num(ftab, q, 2), offset: _num(ftab, q + 2, 4), size: _num(ftab, q + 6, 4), flags: string.byte(ftab, q + 10)}
            self.files[i] = e
            self.index[path] = e
            p = q + 11

    def manifest(self):
        if self._manifest == nil:
            self._manifest = json5.parse(self.manifest_text)
        return self._manifest

    def list(self):
        return self.files

    def exists(self, path):
        return self.index[path] != nil

    def is_dir(self, path):
        if path == "" or path == "/":
            return true
        prefix = path .. "/"
        for f in self.files:
            if string.sub(f.path, 1, len(prefix)) == prefix:
                return true
        return false

    # прямые потомки папки (для монтирования как папки)
    def children(self, path):
        prefix = (path == "" or path == "/") and "" or (path .. "/")
        out = []
        seen = {}
        for f in self.files:
            if string.sub(f.path, 1, len(prefix)) == prefix:
                rest = string.sub(f.path, len(prefix) + 1)
                name = string.match(rest, "^[^/]+")
                if name != nil and not seen[name]:
                    seen[name] = true
                    out[len(out) + 1] = name
        table.sort(out)
        return out

    def block(self, i):
        key = self.key .. ":" .. i
        hit = cache.items[key]
        if hit != nil:
            return hit
        b = self.blocks[i]
        if b == nil:
            error("cpk: damaged package (no block " .. tostring(i) .. ")", 0)
        raw = _unpack(self.src.read(b.offset, b.stored), b.method)
        if len(raw) != b.raw or crc.crc32(raw) != b.crc:
            error("cpk: damaged package (block " .. i .. " checksum)", 0)
        _cache_put(key, raw)
        return raw

    def read(self, path):
        e = self.index[path]
        if e == nil:
            return nil
        if e.size == 0:
            return ""
        raw = self:block(e.block)
        return string.sub(raw, e.offset + 1, e.offset + e.size)

    def size_info(self):
        stored = 0
        raw = 0
        for b in self.blocks:
            stored += b.stored
            raw += b.raw
        return {stored: stored, raw: raw, blocks: len(self.blocks), files: len(self.files), total: self.src.size}

    # хэш всего архива и CRC каждого блока
    def verify(self):
        size = self.src.size
        if size < 38:
            return false, "too short"
        body = self.src.read(0, size - 34)
        sum = self.src.read(size - 34, 32)
        if sha256.digest(body) != sum:
            return false, "sha256 mismatch"
        for i in range[1, len(self.blocks)]:
            ok, err = pcall(self.block, self, i)
            if not ok:
                return false, tostring(err)
        return true

    def sha256_hex(self):
        return sha256.to_hex(self.src.read(self.src.size - 34, 32))

export def open(data, name=nil):
    src = {size: len(data), read: (off, n) => string.sub(data, off + 1, off + n)}
    return Archive(src, name)

# читает с диска частями: в памяти только заголовок и распакованные блоки из кэша
export def open_file(path, fsys=nil):
    f = fsys ?? fs
    size = f.getSize(path)
    def read(off, n):
        h = f.open(path, "rb")
        if h == nil:
            error("cpk: cannot read " .. path, 0)
        h.seek("set", off)
        s = h.read(n) ?? ""
        h.close()
        return s
    return Archive({size: size, read: read}, path)

export def extract(a, fsys, dest, opts=nil):
    o = opts ?? {}
    n = 0
    for e in a:list():
        if not safe_path(e.path):
            error("cpk: unsafe path in package: " .. e.path, 0)
        if o.skip_maps and has_flag(e.flags, F_MAP):
            continue
        target = fsys.combine(dest, e.path)
        fsys.makeDir(fsys.getDir(target))
        h = fsys.open(target, "wb")
        if h == nil:
            error("cpk: cannot write " .. target, 0)
        h.write(a:read(e.path))
        h.close()
        n += 1
        if o.on_file != nil:
            o.on_file(e.path, e.size)
    return n
