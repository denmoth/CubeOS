# compat.env: окружение CraftOS для legacy-программ
#
#   env = compat_env.new({vterm: vt})            окружение с терминалом vt (term.vterm) вместо настоящего экрана
#   proc = compat_proc.new(env, "rom/programs/shell.lua", ["echo", "привет"])
#
# Окружение собирается как это делает bios CC: стандартные функции Lua, «родные» API (term, fs, os, http, peripheral, redstone),
# функции из compat.bios (write, print, read, sleep, loadfile...) и библиотеки из /rom/apis, загруженные заново в это окружение,
# чтобы textutils, paintutils, window, parallel, rednet и другие пользовались терминалом и os этого окружения, а не настоящими.
# Работает поверх настоящего /rom CC (его программы edit, lua, list, wget и прочие запускаются как есть).

import compat.bios as bios
import compat.vararg as va
import version as version_mod

# стандартные имена Lua, которые окружение берёт у хозяина
const STANDARD = ["assert", "collectgarbage", "error", "getmetatable", "ipairs", "next", "pairs", "pcall", "rawequal", "rawget",
    "rawlen", "rawset", "select", "setmetatable", "tonumber", "tostring", "type", "xpcall", "unpack", "bit32", "bit", "coroutine",
    "debug", "math", "string", "table", "utf8", "_VERSION"]

# «родные» API CC, которые остаются настоящими (в окружении они доступны через права процесса)
const PASSTHROUGH = ["http", "peripheral", "redstone", "rs", "commands", "turtle", "pocket"]

# Ограниченное окружение (restricted: обычные пользователи и гости, D243): debug урезан до traceback, getinfo (без самих функций)
# и getregistry (только свои библиотеки: его просит require из ROM), без getupvalue/getlocal/sethook; библиотеки-таблицы и «родные» API это копии
# (настоящие общие для всего компьютера: подменённая в них функция выполнилась бы в системной службе с её правами); getmetatable
# не отдаёт метатаблицу строк и объектов классов Cubic (их методы общие с системой), setmetatable их не меняет.
const SHARED_LIBS = {string: true, table: true, math: true, coroutine: true, bit32: true, bit: true, utf8: true}

# метатаблица, которую программа пользователя не должна видеть: строки и экземпляры классов Cubic (rt.class: __index это она сама)
def _protected_mt(v, mt):
    if type(v) == "string":
        return true
    return type(mt) == "table" and rawget(mt, "__name") != nil and rawget(mt, "__index") == mt

def _safe_getmetatable(v):
    mt = getmetatable(v)
    if _protected_mt(v, mt):
        return nil
    return mt

# getinfo без ссылок на функции (через них можно было бы вызвать чужой код); уровень стека считается от вызвавшей программы
def _safe_getinfo(a, b=nil, c=nil):
    info = nil
    if type(a) == "thread":
        info = debug.getinfo(a, b, c)
    elif type(a) == "number":
        info = debug.getinfo(a + 1, b)
    else:
        info = debug.getinfo(a, b)
    if type(info) == "table":
        info.func = nil
        info.activelines = nil
    return info

def _safe_debug(env):
    loaded = {}
    for name in ["string", "table", "math", "coroutine", "bit32", "utf8"]:
        if env[name] != nil:
            loaded[name] = env[name]
    return {traceback: debug.traceback, getinfo: _safe_getinfo, getregistry: () => {_LOADED: loaded}}

def _safe_setmetatable(t, mt):
    if _protected_mt(t, getmetatable(t)):
        error("cannot change the metatable of a system object", 2)
    return setmetatable(t, mt)

# ROM-библиотеки, которые не грузятся заново (используется настоящая или окружение уже имеет свою)
const SKIP_APIS = {"fs.lua": true, "peripheral.lua": true}

def _copy_table(src):
    out = {}
    for k, v in src:
        out[k] = v
    return out

# opts: restricted (ограниченное окружение, см. выше), vterm (терминал term.vterm) или term (готовый терминал CC: настоящий, монитор, окно), version (по умолчанию version.full(), то, что вернёт os.version()), fs (по умолчанию настоящий fs), os (по умолчанию настоящий os), settings (true:
# загрузить ROM-settings), apis_dir ("rom/apis"), quiet (не печатать ошибки загрузки)
export def new(opts):
    o = opts
    env = {}
    restricted = o.restricted == true
    for name in STANDARD:
        if not (restricted and name == "debug"):
            v = _G[name]
            if restricted and SHARED_LIBS[name] and type(v) == "table":
                v = _copy_table(v)
            env[name] = v
    for name in PASSTHROUGH:
        v = _G[name]
        if restricted and type(v) == "table":
            v = _copy_table(v)
        env[name] = v
    if restricted:
        env.debug = _safe_debug(env)
        env.getmetatable = _safe_getmetatable
        env.setmetatable = _safe_setmetatable
    env.fs = o.fs ?? _G.fs
    env.os = _copy_table(o.os ?? _G.os)
    env.term = o.term ?? o.vterm:api()
    bios.install(env)
    # система называется CubeOS: программы CC и баннер оболочки видят её имя, а не CraftOS
    version = o.version ?? version_mod.full()
    env.os.version = () => version
    # ROM-библиотеки в порядке каталога, как их грузит bios
    dir = o.apis_dir ?? "rom/apis"
    names = env.fs.list(dir)
    table.sort(names)
    # term должен быть раньше window и textutils; остальные порядок не меняет
    for n in names:
        if string.sub(n, -4) == ".lua" and SKIP_APIS[n] == nil:
            path = dir .. "/" .. n
            if not env.fs.isDir(path):
                bios.load_api(env, path)
    # дальше os.loadAPI из программ печатает ошибки на экран, как в CC (при сборке окружения они только копятся в env.api_errors)
    env.show_api_errors = true
    # require и package, как их даёт shell программам (модули из /rom/modules/main и рядом с программой)
    maker = bios.do_file(env, "rom/modules/main/cc/require.lua")
    env.require, env.package = maker.make(env, "")
    env.vterm = o.vterm
    return env
