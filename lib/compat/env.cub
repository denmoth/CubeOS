# compat.env: окружение CraftOS для legacy-программ
#
#   env = compat_env.new({vterm: vt})            окружение с терминалом vt (term.vterm) вместо настоящего экрана
#   proc = compat_proc.new(env, "rom/programs/shell.lua", ["echo", "привет"])
#
# Окружение собирается как это делает bios CC: стандартные функции Lua, «родные» API (term, fs, os, http, peripheral, redstone),
# функции из compat.bios (write, print, read, sleep, loadfile...) и библиотеки из /rom/apis, загруженные заново в это окружение,
# чтобы textutils, paintutils, window, parallel, rednet и другие пользовались терминалом и os этого окружения, а не настоящими.
# Работает поверх настоящего /rom CC (его программы edit, lua, list, wget и прочие запускаются как есть).

import compat.bios as bios
import compat.vararg as va

# стандартные имена Lua, которые окружение берёт у хозяина
const STANDARD = ["assert", "collectgarbage", "error", "getmetatable", "ipairs", "next", "pairs", "pcall", "rawequal", "rawget",
    "rawlen", "rawset", "select", "setmetatable", "tonumber", "tostring", "type", "xpcall", "unpack", "bit32", "bit", "coroutine",
    "debug", "math", "string", "table", "utf8", "_VERSION"]

# «родные» API CC, которые остаются настоящими (в окружении они доступны через права процесса)
const PASSTHROUGH = ["http", "peripheral", "redstone", "rs", "commands", "turtle", "pocket"]

# ROM-библиотеки, которые не грузятся заново (используется настоящая или окружение уже имеет свою)
const SKIP_APIS = {"fs.lua": true, "peripheral.lua": true}

def _copy_table(src):
    out = {}
    for k, v in src:
        out[k] = v
    return out

# opts: vterm (терминал term.vterm) или term (готовый терминал CC: настоящий, монитор, окно), version ("CubeOS 2.0", то, что вернёт os.version()), fs (по умолчанию настоящий fs), os (по умолчанию настоящий os), settings (true:
# загрузить ROM-settings), apis_dir ("rom/apis"), quiet (не печатать ошибки загрузки)
export def new(opts):
    o = opts
    env = {}
    for name in STANDARD:
        env[name] = _G[name]
    for name in PASSTHROUGH:
        env[name] = _G[name]
    env.fs = o.fs ?? _G.fs
    env.os = _copy_table(o.os ?? _G.os)
    env.term = o.term ?? o.vterm:api()
    # система называется CubeOS: программы CC и баннер оболочки видят её имя, а не CraftOS
    version = o.version ?? "CubeOS 2.0"
    env.os.version = () => version
    bios.install(env)
    # ROM-библиотеки в порядке каталога, как их грузит bios
    dir = o.apis_dir ?? "rom/apis"
    names = env.fs.list(dir)
    table.sort(names)
    # term должен быть раньше window и textutils; остальные порядок не меняет
    for n in names:
        if string.sub(n, -4) == ".lua" and SKIP_APIS[n] == nil:
            path = dir .. "/" .. n
            if not env.fs.isDir(path):
                bios.load_api(env, path)
    # require и package, как их даёт shell программам (модули из /rom/modules/main и рядом с программой)
    maker = bios.do_file(env, "rom/modules/main/cc/require.lua")
    env.require, env.package = maker.make(env, "")
    env.vterm = o.vterm
    return env
