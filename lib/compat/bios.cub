# compat.bios: глобальные функции CraftOS для legacy-программ: write, print, printError, read, sleep, loadfile, dofile, os.run, os.loadAPI...
#
#   bios.install(env)        дописывает в таблицу окружения env всё, что обычно делает bios CC (кроме ROM-библиотек, их грузит compat.env)
#
# Окружение env это таблица, которая служит _ENV legacy-программы: у неё свои term, fs, os, и т. д. Функции здесь берут term и os
# из env при каждом вызове, поэтому term.redirect действует. События программа получает через coroutine.yield: хозяин
# (compat.proc) возобновляет её корутину событиями; os.pullEventRaw это и есть yield.
#
# Это независимая реализация по описанию API CC (поведение write с переносом слов, редактор строки read с историей и дополнением,
# sleep, loadfile/dofile, os.run, loadAPI), не копия bios.lua.

import compat.vararg as va
import term.chars as chars

# ---------------------------------------------------------------- вывод

# write: выводит текст с переносом по словам и прокруткой; возвращает число напечатанных строк
export def write_text(env, text):
    term = env.term
    text = tostring(text)
    w, h = term.getSize()
    x, y = term.getCursorPos()
    lines = 0
    def new_line():
        outer y, x
        if y + 1 <= h:
            term.setCursorPos(1, y + 1)
        else:
            term.setCursorPos(1, h)
            term.scroll(1)
        x, y = term.getCursorPos()
        lines += 1
    while chars.length(text) > 0:
        space = string.match(text, "^[ \t]+")
        if space != nil:
            term.write(space)
            x, y = term.getCursorPos()
            text = chars.sub(text, chars.length(space) + 1)
        nl = string.match(text, "^\n")
        if nl != nil:
            new_line()
            text = chars.sub(text, 2)
        word = string.match(text, "^[^ \t\n]+")
        if word != nil:
            text = chars.sub(text, chars.length(word) + 1)
            if chars.length(word) > w:
                # слово длиннее строки режется по строкам
                while chars.length(word) > 0:
                    if x > w:
                        new_line()
                    term.write(word)
                    word = chars.sub(word, w - x + 2)
                    x, y = term.getCursorPos()
            else:
                if x + chars.length(word) - 1 > w:
                    new_line()
                term.write(word)
                x, y = term.getCursorPos()
    return lines

export def print_text(env, args, count):
    parts = {}
    for i in range[1, count]:
        parts[i] = tostring(args[i])
    term = env.term
    lines = write_text(env, table.concat(parts, "\t"))
    w, h = term.getSize()
    x, y = term.getCursorPos()
    if y + 1 <= h:
        term.setCursorPos(1, y + 1)
    else:
        term.setCursorPos(1, h)
        term.scroll(1)
    return lines + 1

export def print_error(env, args, count):
    term = env.term
    color = term.isColor()
    if color:
        old = term.getTextColor()
        # colors может быть ещё не загружен (ошибка при загрузке самой colors): 16384 это colors.red
        term.setTextColor(env.colors != nil and env.colors.red or 16384)
    print_text(env, args, count)
    if color:
        term.setTextColor(old)

# ---------------------------------------------------------------- события и время

export const pull_event_raw = va.pull_event_raw
export const pull_event = va.pull_event

export def sleep_for(env, seconds):
    os_api = env.os
    timer = os_api.startTimer(seconds ?? 0)
    while true:
        ev, id = os_api.pullEvent("timer")
        if id == timer:
            return

# ---------------------------------------------------------------- редактор строки

# read(replace_char, history, complete, default): строка с курсором, историей (стрелки вверх и вниз), дополнением (Tab), вставкой
export def read_line(env, replace_char=nil, history=nil, complete=nil, default=nil):
    # ввод из пайпа или файла (оболочка кладёт env.stdin = {lines, pos}): строки по одной, потом nil
    st = env.stdin
    if st != nil:
        line = st.lines[st.pos]
        if line != nil:
            st.pos += 1
        return line
    term = env.term
    os_api = env.os
    keys_api = env.keys
    term.setCursorBlink(true)
    line = default ?? ""
    pos = chars.length(line)
    scroll = 0
    sx, sy = term.getCursorPos()
    w, h = term.getSize()
    history_index = nil
    saved_line = nil
    completions = {}
    completion_index = 0
    if replace_char != nil:
        replace_char = chars.sub(replace_char, 1, 1)
        # скрытый ввод (пароль): хозяин терминала сообщает ядру, и журнал ввода его не пишет (D220)
        env.secret_input = (env.secret_input ?? 0) + 1
    def shown(s):
        if replace_char != nil:
            return string.rep(replace_char, chars.length(s))
        return s
    def redraw(clear_char=nil):
        outer scroll, text, h, w
        w, h = term.getSize()
        room = w - sx + 1
        if pos < scroll:
            scroll = pos
        elif pos > scroll + room - 1:
            scroll = pos - room + 1
        term.setCursorPos(sx, sy)
        text = clear_char != nil and string.rep(clear_char, chars.length(line)) or shown(line)
        visible = chars.sub(text, scroll + 1, scroll + room)
        term.write(visible .. string.rep(" ", room - chars.length(visible)))
        if completion_index > 0 and clear_char == nil and complete != nil:
            ghost = completions[completion_index]
            if ghost != nil and pos == chars.length(line):
                gx = sx + chars.length(line) - scroll
                if gx <= w:
                    old_fg = term.getTextColor()
                    if term.isColor():
                        term.setTextColor(env.colors.gray)
                    term.setCursorPos(gx, sy)
                    term.write(chars.sub(ghost, 1, w - gx + 1))
                    term.setTextColor(old_fg)
        term.setCursorPos(sx + pos - scroll, sy)
    def recompute_completions():
        outer completion_index, completions
        completions = {}
        completion_index = 0
        if complete != nil and pos == chars.length(line):
            result = complete(line)
            if result != nil:
                completions = result
                if len(completions) > 0:
                    completion_index = 1
    recompute_completions()
    redraw()
    while true:
        ev, a, b, c = os_api.pullEvent()
        if ev == "char":
            line = chars.sub(line, 1, pos) .. a .. chars.sub(line, pos + 1)
            pos += chars.length(a)
            recompute_completions()
            redraw()
        elif ev == "paste":
            text = string.gsub(a, "\n.*$", "")
            line = chars.sub(line, 1, pos) .. text .. chars.sub(line, pos + 1)
            pos += chars.length(text)
            recompute_completions()
            redraw()
        elif ev == "key":
            if a == keys_api.enter or a == keys_api.numPadEnter:
                if completion_index > 0 and completions[completion_index] != nil and pos == chars.length(line) and false:
                    pass
                break
            elif a == keys_api.left:
                if pos > 0:
                    pos -= 1
                    recompute_completions()
                    redraw()
            elif a == keys_api.right:
                if pos < chars.length(line):
                    pos += 1
                    recompute_completions()
                    redraw()
                elif completion_index > 0 and completions[completion_index] != nil:
                    # вправо в конце строки принимает дополнение
                    line = line .. completions[completion_index]
                    pos = chars.length(line)
                    recompute_completions()
                    redraw()
            elif a == keys_api.home:
                pos = 0
                redraw()
            elif a == keys_api["end"]:
                pos = chars.length(line)
                recompute_completions()
                redraw()
            elif a == keys_api.backspace:
                if pos > 0:
                    redraw(" ")
                    line = chars.sub(line, 1, pos - 1) .. chars.sub(line, pos + 1)
                    pos -= 1
                    recompute_completions()
                    redraw()
            elif a == keys_api.delete:
                if pos < chars.length(line):
                    redraw(" ")
                    line = chars.sub(line, 1, pos) .. chars.sub(line, pos + 2)
                    recompute_completions()
                    redraw()
            elif a == keys_api.up or a == keys_api.down:
                if completion_index > 0 and len(completions) > 1:
                    completion_index += a == keys_api.up and -1 or 1
                    if completion_index < 1:
                        completion_index = len(completions)
                    if completion_index > len(completions):
                        completion_index = 1
                    redraw()
                elif history != nil:
                    redraw(" ")
                    if a == keys_api.up:
                        if history_index == nil:
                            saved_line = line
                            history_index = len(history)
                        elif history_index > 1:
                            history_index -= 1
                        if history[history_index] != nil:
                            line = history[history_index]
                    else:
                        if history_index != nil:
                            history_index += 1
                            if history[history_index] != nil:
                                line = history[history_index]
                            else:
                                history_index = nil
                                line = saved_line ?? ""
                    pos = chars.length(line)
                    recompute_completions()
                    redraw()
            elif a == keys_api.tab:
                if completion_index > 0 and completions[completion_index] != nil and pos == chars.length(line):
                    line = line .. completions[completion_index]
                    pos = chars.length(line)
                    recompute_completions()
                    redraw()
        elif ev == "mouse_click":
            if b >= sx and c == sy:
                pos = math.max(0, math.min(chars.length(line), scroll + b - sx))
                redraw()
        elif ev == "term_resize":
            redraw()
    term.setCursorBlink(false)
    x, y = term.getCursorPos()
    w, h = term.getSize()
    term.setCursorPos(w + 1, y)
    # перевод строки после ввода
    print_text(env, va.pack(), 0)
    if replace_char != nil:
        env.secret_input = math.max(0, (env.secret_input ?? 1) - 1)
    return line

# ---------------------------------------------------------------- загрузка кода

export def load_file(env, path, mode=nil, load_env=nil):
    f = env.fs.open(path, "rb") ?? env.fs.open(path, "r")
    if f == nil:
        return nil, "File not found"
    data = f.readAll()
    f.close()
    return load(data, "@" .. env.fs.combine(path), mode ?? "t", load_env ?? env)

export def do_file(env, path):
    fn, err = load_file(env, path, "t", env)
    if fn == nil:
        error(err, 0)
    return fn()

# ---------------------------------------------------------------- установка в окружение

export def install(env):
    env._G = env
    env._ENV = nil
    env._HOST = env._HOST ?? "ComputerCraft 1.115 (CubeOS compatibility layer)"
    env.write = (text) => write_text(env, text)
    env.print = va.variadic(env, print_text)
    env.printError = va.variadic(env, print_error)
    env.read = (replace_char, history, complete, default) => read_line(env, replace_char, history, complete, default)
    env.sleep = (seconds) => sleep_for(env, seconds)
    env.loadfile = (path, mode, load_env) => load_file(env, path, mode, load_env)
    env.dofile = (path) => do_file(env, path)
    env.loadstring = (text, name) => load(text, name ?? "=(loadstring)", "t", env)
    env.load = (chunk, name, mode, load_env) => load(chunk, name, mode, load_env ?? env)
    os_table = env.os
    os_table.pullEventRaw = pull_event_raw
    os_table.pullEvent = pull_event
    os_table.sleep = env.sleep
    os_table.version = () => "CraftOS 1.9"
    os_table.run = va.runner(env, run_program)
    os_table.loadAPI = (path) => load_api(env, path)
    os_table.unloadAPI = (name) => unload_api(env, name)

# запускает программу как os.run: окружение run_env, ошибка печатается, возвращает успех
export def run_program(env, run_env, path, args):
    setmetatable(run_env, {__index: env})
    fn, err = load_file(env, path, "t", run_env)
    if fn == nil:
        if err != nil and err != "":
            print_error(env, va.pack(err), 1)
        return false
    ok, perr = pcall(va.call, fn, args)
    if not ok:
        if perr != nil and perr != "" and perr != "Terminated":
            print_error(env, va.pack(perr), 1)
        return false
    return true

# ошибка загрузки API: в env.api_errors (по ним оболочка и сессия пишут журнал) и на экран, как это делает CC
def _api_failed(env, name, err):
    env.api_errors = env.api_errors ?? []
    env.api_errors[len(env.api_errors) + 1] = name .. ": " .. tostring(err)
    # на экран только если об этом просят (env.show_api_errors, как делает os.loadAPI в CC); система пишет их в журнал, а API модов, которых
    # нет на этом компьютере (aero, sublevel), не должны засорять терминал при каждом входе
    if err != nil and env.show_api_errors == true:
        print_error(env, va.pack(err), 1)

# os.loadAPI: выполняет файл в своей среде (чтение из env), переменные файла становятся таблицей env[имя файла без .lua]
export def load_api(env, path):
    name = env.fs.getName(path)
    name = string.gsub(name, "%.lua$", "")
    if env.fs.isDir(path):
        return false
    api_env = {isAPI: true}
    setmetatable(api_env, {__index: env})
    fn, err = load_file(env, path, "t", api_env)
    if fn == nil:
        _api_failed(env, name, err)
        return false
    ok, perr = pcall(fn)
    if not ok:
        _api_failed(env, name, perr)
        return false
    api = {}
    for k, v in api_env:
        if type(k) != "string" or string.sub(k, 1, 1) != "_":
            api[k] = v
    env[name] = api
    return true

export def unload_api(env, name):
    if name != "_G":
        env[name] = nil
