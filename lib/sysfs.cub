# sysfs: деревья виртуальных каталогов /cubeos/proc, /cubeos/run, /cubeos/hardware (cfs.virtual строит их при каждом обращении)
#
#   fsys:mount("/cubeos/proc", cfs.virtual(() => sysfs.proc_tree(kernel, {boot_ms: ms})))
#   fsys:mount("/cubeos/run", cfs.virtual(() => sysfs.run_tree(system)))
#   fsys:mount("/cubeos/hardware", cfs.virtual(() => sysfs.hardware_tree(devices)))
#
# proc: <pid>/{status,cmdline,user,started,focus}, ps, uptime, version, meminfo.
# run: services/<имя> (running, failed, blocked, stopped...), session/<id>, boot.state.
# hardware: peripherals/<имя>/{type,methods}, displays, speakers, modems, drives (имена по типам). Подробности docs/spec/services.md

import version
import hal

def _pad(text, width):
    s = tostring(text)
    while string.len(s) < width:
        s = s .. " "
    return s

export def proc_tree(k, opts=nil):
    o = opts ?? {}
    tree = {}
    lines = [_pad("PID", 6) .. _pad("STATE", 10) .. _pad("USER", 12) .. "NAME\n"]
    for p in k:ps():
        proc = k:proc(p.pid)
        status = ("Name: " .. p.name .. "\nState: " .. p.state .. "\nPid: " .. p.pid .. "\nPPid: " .. tostring(p.parent ?? 0) ..
            "\nUser: " .. p.user .. "\nCpuMs: " .. math.floor(p.cpu_ms) .. "\nUi: " .. tostring(p.ui == true) .. "\n")
        tree[tostring(p.pid)] = {status: status, cmdline: p.name .. "\n", user: p.user .. "\n",
            started: tostring(proc != nil and proc.started_at or 0) .. "\n", focus: (k.focus_pid == p.pid and "1" or "0") .. "\n"}
        lines[len(lines) + 1] = _pad(p.pid, 6) .. _pad(p.state, 10) .. _pad(p.user, 12) .. p.name .. "\n"
    tree.ps = table.concat(lines)
    boot_ms = o.boot_ms ?? k.clock()
    tree.uptime = string.format("%.2f\n", (k.clock() - boot_ms) / 1000)
    tree.version = version.full() .. "\n"
    # в настоящем CC нет collectgarbage (hal.memory_kb даёт nil)
    tree.meminfo = "MemUsedKB: " .. tostring(hal.memory_kb() ?? "unknown") .. "\n"
    return tree

export def run_tree(system):
    tree = {services: {}, session: {}}
    if system.services != nil:
        for e in system.services:list():
            tree.services[e.name] = e.state .. "\n"
    if system.sessions != nil:
        for s in system.sessions:list():
            tree.session[tostring(s.id)] = ("user: " .. tostring(s.profile ?? "") .. "\ndisplay: " .. tostring(s.display ?? "") ..
                "\nstate: " .. tostring(s.state ?? "active") .. "\n")
    st = system.state != nil and system.state.data or {}
    tree["boot.state"] = ("mode: " .. tostring(system.mode) .. "\nreason: " .. tostring(system.reason ?? "") .. "\nfailures: " ..
        tostring(st.failures ?? 0) .. "\nboots: " .. tostring(st.boots ?? 0) .. "\nunclean: " .. tostring(system.unclean == true) .. "\n")
    return tree

# devices: {имя: {type, methods: [имена]}}
export def hardware_tree(devices):
    tree = {peripherals: {}, displays: {}, speakers: {}, modems: {}, drives: {}}
    groups = {monitor: "displays", speaker: "speakers", modem: "modems", drive: "drives"}
    for name, d in devices:
        methods = d.methods ?? []
        tree.peripherals[name] = {type: d.type .. "\n", methods: table.concat(methods, "\n") .. (len(methods) > 0 and "\n" or "")}
        group = groups[d.type]
        if group != nil:
            tree[group][name] = d.type .. "\n"
    return tree
