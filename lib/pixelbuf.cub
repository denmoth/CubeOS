# pixelbuf: буфер пикселей в памяти (кадр для отрисовки текста, иконок, игр)
#
#   buf = pixelbuf.new(40, 16)          # ширина, высота; пиксели заполнены нулём
#   buf:set(3, 2, 1)                    # координаты с нуля, как в term.drawPixels
#   buf:fill_rect(0, 0, 10, 4, 5)
#   buf:rows()                          # список строк-списков цветов (для term.drawPixels)
#   buf:to_text()                       # для отладки: "#" там, где цвет не ноль
#
# Выходы за границы тихо игнорируются (клиппинг).

export class Buf:
    def init(self, width, height, fill=0):
        self.width = width
        self.height = height
        self.cells = []
        for i in range[1, width * height]:
            self.cells[i] = fill

    def set(self, x, y, color):
        if x < 0 or y < 0 or x >= self.width or y >= self.height:
            return
        self.cells[y * self.width + x + 1] = color

    def get(self, x, y):
        if x < 0 or y < 0 or x >= self.width or y >= self.height:
            return nil
        return self.cells[y * self.width + x + 1]

    def fill_rect(self, x, y, w, h, color):
        for yy in range[y, y + h - 1]:
            for xx in range[x, x + w - 1]:
                self:set(xx, yy, color)

    def clear(self, color=0):
        for i in range[1, self.width * self.height]:
            self.cells[i] = color

    # копирует другой буфер (src) в позицию x, y; transparent: цвет, который не копируется
    def blit(self, src, x, y, transparent=nil):
        for sy in range[0, src.height - 1]:
            for sx in range[0, src.width - 1]:
                c = src:get(sx, sy)
                if c != transparent:
                    self:set(x + sx, y + sy, c)

    # список строк, каждая строка это список цветов
    def rows(self):
        out = []
        for y in range[0, self.height - 1]:
            row = []
            for x in range[0, self.width - 1]:
                row[x + 1] = self.cells[y * self.width + x + 1]
            out[y + 1] = row
        return out

    # текстовая картинка: "#" где цвет не ноль, "." где ноль
    def to_text(self):
        lines = []
        for y in range[0, self.height - 1]:
            parts = []
            for x in range[0, self.width - 1]:
                parts[x + 1] = self.cells[y * self.width + x + 1] != 0 and "#" or "."
            lines[y + 1] = table.concat(parts)
        return lines

export def new(width, height, fill=0):
    return Buf(width, height, fill)
