]

INDEX = {}
for row in T:
    INDEX[row[1]] = row

export def tr(id, text, vars=nil):
    out = text
    if id == "ru" or id == "uk":
        row = INDEX[text]
        if row != nil:
            out = row[id == "ru" and 2 or 3]
    if vars != nil:
        for k, v in vars:
            out = string.gsub(out, "{" .. k .. "}", tostring(v))
    return out
