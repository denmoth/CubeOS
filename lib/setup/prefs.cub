export def defaults(lang_id="en", hw=nil):
    label = hw != nil and hw.label or nil
    return {
        lang: lang_id, keyboard: lang_id == "uk" and "uk" or "ru", keyboard_mode: "auto", tz: "UTC", time_source: "utc",
        time_format: "24h", seconds: false, date_format: lang_id == "en" and "%Y-%m-%d" or "%d.%m.%Y", week_start: "monday",
        label: label ?? "", session: "cde", autologin: false, pin: "", remember: 5, log_level: "info",
        theme: "tokyo-night", wallpaper: "aurora", scale: "auto", panel: "bottom", animations: true,
        volume: 100, muted: false, autoplay: true, wireless: false, encrypt: "on", pinestore: true,
    }

export def visible(page, ctx):
    return not page.desktop or ctx.desktop == true

export def field_visible(f, ctx):
    return not f.desktop or ctx.desktop == true

export def label_of(f, value):
    if f.type == "toggle":
        return value and "On" or "Off"
    if f.type == "secret":
        return (value ?? "") == "" and "None" or string.rep("*", len(value))
    if f.type == "range":
        return tostring(value) .. "%"
    if f.type == "text":
        return (value ?? "") == "" and "(none)" or value
    for ch in f.choices ?? []:
        if ch[1] == value:
            return ch[2]
    return tostring(value)

# next or previous value of a choice / range / toggle
export def step(f, value, d):
    if f.type == "toggle":
        return not value
    if f.type == "range":
        return math.max(f.min, math.min(f.max, (value ?? f.min) + d * (f.step ?? 1)))
    if f.type == "choice":
        n = len(f.choices)
        cur = 1
        for i in range[1, n]:
            if f.choices[i][1] == value:
                cur = i
        return f.choices[(cur - 1 + d) % n + 1][1]
    return value

export def pin_problem(pin):
    if pin == nil or pin == "":
        return nil
    if string.match(pin, "^%d+$") == nil:
        return "The PIN is digits only"
    if len(pin) < 4 or len(pin) > 8:
        return "The PIN is 4 to 8 digits"
    return nil

def _read(fsys, path):
    h = fsys.open(path, "r")
    if h == nil:
        return nil
    s = h.readAll()
    h.close()
    return s

def _write(fsys, path, data):
    fsys.makeDir(fsys.getDir(path))
    h = fsys.open(path, "w")
    if h == nil:
        error("cannot write " .. path, 0)
    h.write(data)
    h.close()

# поменять значения в файле настроек, сохранив комментарии; нет файла: новый
def _patch(fsys, path, values):
    text = _read(fsys, path)
    if text == nil:
        fresh = {}
        for item in values:
            fresh[item[1][1]] = item[2]
        _write(fsys, path, json5.stringify(fresh, {json5: true, indent: 2}) .. "\n")
        return
    for item in values:
        ok, res = pcall(json5.patch, text, item[1], item[2])
        if ok:
            text = res
    _write(fsys, path, text)

export def apply(fsys, root, v, user, opts=nil):
    o = opts ?? {}
    problems = []
    def p(rel):
        return fsys.combine(root, rel)
    def attempt(what, fn):
        ok, err = pcall(fn)
        if not ok:
            problems[len(problems) + 1] = what .. ": " .. tostring(err)
    cfg = "cubeos/sys/cfg/"
    attempt("language", () => _patch(fsys, p(cfg .. "locale.conf"), [[["lang"], v.lang], [["keyboard"], v.keyboard], [["keyboard_mode"], v.keyboard_mode]]))
    attempt("time", () => _patch(fsys, p(cfg .. "time.conf"), [[["tz"], v.tz], [["source"], v.time_source], [["format"], v.time_format],
        [["seconds"], v.seconds == true], [["date_format"], v.date_format], [["week_start"], v.week_start], [["locale"], v.lang]]))
    attempt("sound", () => _patch(fsys, p(cfg .. "audio.conf"), [[["volume"], v.volume], [["muted"], v.muted == true], [["autoplay"], v.autoplay == true]]))
    attempt("network", () => _patch(fsys, p(cfg .. "net.conf"), [[["name"], v.label ?? ""], [["wireless"], v.wireless == true], [["encrypt"], v.encrypt]]))
    attempt("log", () => _patch(fsys, p(cfg .. "log.conf"), [[["level"], v.log_level]]))
    boot = [[["lang"], v.lang], [["de"], v.session ?? "cde"]]
    if v.autologin and user != nil:
        boot[len(boot) + 1] = [["autologin"], user.name]
    attempt("boot", () => _patch(fsys, p(cfg .. "boot.conf"), boot))
    if user != nil:
        desk = {theme: v.theme, wallpaper: v.wallpaper, scale: v.scale, panel: {position: v.panel}, animations: {enabled: v.animations == true}}
        if user.avatar != nil:
            desk.avatar = user.avatar
        attempt("desktop", () => _write(fsys, p("cubeos/users/" .. user.name .. "/cfg/cde.conf"), json5.stringify(desk, {json5: true, indent: 2}) .. "\n"))
        a = o.auth
        if a != nil:
            if (v.pin ?? "") != "":
                attempt("PIN", () => a:set_pin(user.name, v.pin))
            attempt("sign-in", () => a:set_field(user.name, "remember_minutes", v.remember ?? 0))
    if o.set_label != nil and (v.label ?? "") != "":
        attempt("computer name", () => o.set_label(v.label))
    if o.sources != nil and v.pinestore == false:
        attempt("package sources", () => o.sources(v))
    return problems
