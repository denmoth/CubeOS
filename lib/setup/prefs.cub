    ["Asia/Vladivostok", "Vladivostok"], ["Asia/Tbilisi", "Tbilisi"], ["Asia/Yerevan", "Yerevan"], ["Asia/Baku", "Baku"],
    ["Asia/Almaty", "Almaty"], ["Asia/Tashkent", "Tashkent"], ["Asia/Dubai", "Dubai"], ["Asia/Kolkata", "India"],
    ["Asia/Shanghai", "China"], ["Asia/Tokyo", "Tokyo"], ["Asia/Seoul", "Seoul"], ["Australia/Sydney", "Sydney"],
