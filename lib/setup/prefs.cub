# setup.prefs: everything the installer lets you set up besides packages and the account, and how it is written into the
# installed system. One description serves both installer screens (pixel and text) and the summary.
#
#   prefs.PAGES                         [{id, title, icon, when, fields: [field]}]
#   field = {id, label, help, type: "choice" | "toggle" | "text" | "secret" | "range", choices: [[value, label]], min, max, step, max_len}
#   prefs.defaults(lang_id, hw)         {field id: value}
#   prefs.visible(page, ctx)            ctx = {desktop: bool}: does the page apply to the chosen packages
#   prefs.label_of(field, value)        the text shown for a value
#   prefs.apply(fsys, root, v, user, opts)   writes the configs; opts = {auth, set_label, sources: fn(list)}; returns [problems]

import json5

