# apps.axo: Axo (Axolotl), файловый менеджер CDE (docs/21-axo.md, D260)
#
#   wm:launch(axo.main, {name: "axo"}, ["$home", {session, assets}])   ctx.args[1]: папка; ctx.args[2]: session (окна терминала для cubed
#                                                                       и запуска), assets; для тестов view, ready(app)
#
# Подшаг 1: Enter и двойной клик открывают папку, Backspace назад, Ctrl+↑ вверх, Ctrl+N новая вкладка, Ctrl+W закрыть вкладку,
# Ctrl+←/→ и правый Alt+←/→ между вкладками, Ctrl+H скрытые файлы, Ctrl+L и F6 ввести путь, F5 обновить, буквы прыгают к имени.
# Подшаг 2: Ctrl+C, Ctrl+X, Ctrl+V (общий буфер всех окон Axo), F2 переименовать, Ctrl+Shift+N новая папка, Del в корзину и
# Shift+Del навсегда (оба спрашивают), правая кнопка: меню, перетаскивание строк на папку, место слева, вкладку, другую панель или
# другое окно Axo (Ctrl: копия). Прогресс полоской у нижнего края окна, совпадение имён спрашивает.
# Подшаг 3: файл открывается первым приложением ассоциации (apps.axo.assoc), Ctrl+двойной клик и Ctrl+Enter вторым; неизвестный тип и
# «Открыть с помощью...»: окно выбора с галочкой «Всегда открывать так»; «Запустить» для программ.
# Подшаг 4: пробел быстрый просмотр (текст, картинка; ↑↓ листают файлы), Ctrl+I панель сведений, F9 панель мест, F3 две панели
# (у каждой своя папка и история; вкладки относятся к левой), Ctrl+F поиск по именам в папке и вложенных (результаты по мере
# поиска, Esc назад), «Settings...» в меню (минимальный режим без анимаций).
# Подшаг 5: место «Network» (сопряжённые компьютеры, их общие папки, подключение одним кликом: netd mount), «Share on the network»
# и «Stop sharing» в меню папки (netd share), Ctrl+P свойства (размер папки, права, действующее правило; «Change access» пишет своё
# правило через permd). Не администратору действие подтверждается именем и паролем администратора (окно в духе UAC).
# Настройки $cfg/axo.conf: show_hidden, show_places, show_info, confirm_trash, confirm_delete, minimal, ext_marks.
# Расширители (подшаг 6.4, служба extd): точка на значке у файлов расширителя (ext_marks), серые строки, пока он не на связи;
# «Extend with...» у папки, «Detach» у расширенной папки, окно «Extenders...» в меню и на Ctrl+E (список, как диск, снять).

import cdk
import cfs.path as paths
import cgl.cimg as cimg
import cgl.color as color
import json5
import unicode
import cde.wallpaper as wallpaper_mod
import apps.axo.types as types
import apps.axo.parts as parts
import apps.axo.ops as ops
import apps.axo.assoc as assoc
import cde.terminal as terminal_app
import svc.rpc as rpc

export const NAME = "Axo"
export const FULL_NAME = "Axolotl file manager"

const PLACES = [["Home", "home", "$home"], ["Desktop", "desktop", "$desktop"], ["Documents", "file", "$docs"], ["Pictures", "image", "$pictures"],
    ["Trash", "trash", "$trash"], ["Drives", "drive", "$mnt"], ["Network", "netfolder", "network:"], ["Root", "folder", "/"]]
const KIND_NAMES = {folder: "Folder", drive: "Drive", netfolder: "Network folder", lua: "Lua program", cubic: "Cubic program", text: "Text file",
    image: "Picture", music: "Music", archive: "Archive", script: "Script", file: "File"}
const PREVIEW_BYTES = 4096

export class Axo:
    def init(self, sys, ctx):
        o = ctx.args != nil and ctx.args[2] or nil
        self.sys = sys
        self.ctx = ctx
        self.wm = ctx.wm
        self.view = (o != nil and o.view) or sys.view()
        self.session = o != nil and o.session or nil
        self.assets = o != nil and o.assets or "/repo/assets"
        self.assoc = assoc.read_all(self.view)
        self.conf = self:_read_conf()
        self.show_hidden = self.conf.show_hidden == true
        self.minimal = self.conf.minimal == true
        self.ext_marks = self.conf.ext_marks != false
        start = ctx.args != nil and ctx.args[1] or "$home"
        self.tabs = [self:_new_tab(self:_expand(start))]
        self.cur = 1
        self.second = nil
        self.split = false
        self.active = 1
        self.search = nil
        self.ui = cdk.open(sys, ctx, {title: NAME, w: 282, h: 158, min_w: 170, min_h: 96, icon: "axo"})
        self.eng = ops.engine(self.view)
        self.inbox = []
        self.asking = nil
        self.drag = nil
        self.note_until = 0
        self.look = nil
        ops.windows[self.ui.win] = self
        self:_build()
        self:refresh()
        if o != nil and o.ready != nil:
            o.ready(self)

    # ------------------------------------------------------------ настройки и пути

    def _conf_path(self):
        return self.view != nil and (self.view:expand("$cfg") .. "/axo.conf") or nil

    def _read_conf(self):
        p = self:_conf_path()
        if p == nil:
            return {}
        ok, data = pcall(() => self.view:exists(p) and json5.parse(self.view:read(p)) or {})
        return ok and type(data) == "table" and data or {}

    def _save(self, key, value):
        p = self:_conf_path()
        self.conf[key] = value
        if p == nil:
            return
        def write():
            text = self.view:exists(p) and self.view:read(p) or "{}\n"
            self.view:write_atomic(p, json5.patch(text, [key], value))
        pcall(write)

    def _expand(self, p):
        p = tostring(p ?? "/")
        if string.sub(p, 1, 8) == "network:":
            return p
        if string.sub(p, 1, 1) != "/" and string.sub(p, 1, 1) != "$":
            cur = self.tabs != nil and self:tab() != nil and self:tab().path or "/"
            p = paths.join(cur, p)
        ok, e = pcall(() => self.view:expand(p))
        return paths.normalize(ok and e or p)

    # самый длинный алиас, в котором лежит путь: "$home/games", путь алиаса
    def _alias(self, path):
        best_len = 0
        text = nil
        root = nil
        for name, v in self.view.aliases ?? {}:
            ok, full = pcall(() => paths.normalize(self.view:expand("$" .. name)))
            if ok and full != "/" and paths.is_inside(path, full) and string.len(full) > best_len:
                best_len = string.len(full)
                root = full
                text = "$" .. name .. string.sub(path, string.len(full) + 1)
        return text, root

    def _new_tab(self, path):
        return {path: path, back: [], fwd: [], sort: {key: "name", dir: 1}, cursor: nil}

    # состояние панели i (1 левая: вкладка, 2 правая) и активной панели
    def _state(self, i):
        if i == 2 and self.second != nil:
            return self.second
        return self.tabs[self.cur]

    def tab(self):
        return self:_state(self.active)

    def _table(self, i):
        return i == 2 and self.table2 or self.table1

    # ------------------------------------------------------------ окно

    def _make_table(self, i):
        let me = self
        return cdk.data_table({grow: 1, empty: "Nothing here", visible: i == 1,
            columns: [{key: "name", title: "Name", grow: 1}, {key: "size", title: "Size", width: 42, align: "right"},
                {key: "modified", title: "Date", width: 58, align: "right"}],
            on_sort: (key, dir) => me:_sorted(i, key, dir), on_activate: (n, row, ev) => me:_pane_do(i, () => me:activate(row, ev)),
            on_select: (t) => me:_pane_do(i, () => me:_selection()), on_focus: (t) => me:_set_active(i),
            on_menu: (n, row, ev) => me:_pane_do(i, () => me:context_menu(row, ev)),
            on_drag_start: (sel) => me:_pane_do(i, () => me:_drag_start(sel)), on_drag: (ev) => me:_drag_move(ev), on_drop: (ev) => me:_drop(ev)})

    def _build(self):
        ui = self.ui
        let me = self
        self.b_back = parts.tool("back", "Back (Backspace)", (b) => me:back())
        self.b_fwd = parts.tool("forward", "Forward", (b) => me:forward())
        self.b_up = parts.tool("up", "Parent folder (Ctrl+Up)", (b) => me:up())
        self.b_search = parts.tool("search", "Search (Ctrl+F)", (b) => me:start_search())
        self.b_hidden = parts.tool("eye", "Hidden files (Ctrl+H)", (b) => me:toggle_hidden())
        self.b_menu = parts.tool("menu", "Menu", (b) => me:menu(b))
        def path_go(p):
            me:go(p)
            me.ui:set_focus(me.table)
        self.path = parts.path_bar({on_go: path_go})
        self.search_box = cdk.text_input({grow: 1, visible: false, placeholder: "Search by name", on_change: (t) => me:_search_changed(t),
            on_submit: (t) => me.ui:set_focus(me.table)})
        toolbar = cdk.row({padding: 2, gap: 1, align: "center"}, [self.b_back, self.b_fwd, self.b_up, self.path, self.search_box, self.b_search,
            self.b_hidden, self.b_menu])
        self.tabbar = parts.tab_bar({grow: 1, height: 13, on_pick: (i) => me:switch(i), on_close: (i) => me:close_tab(i), on_new: () => me:new_tab()})
        self.tabbar.animate = not self.minimal
        self.tabrow = cdk.row({padding: 2, visible: false}, [self.tabbar])
        items = []
        for p in PLACES:
            items[len(items) + 1] = {text: p[1], icon: p[2], path: p[3]}
        self.places = cdk.list_view({width: 70, height: 26, items: items, visible: self.conf.show_places != false,
            on_activate: (i, it) => me:go(it.path), on_select: (i, it) => me:go(it.path)})
        self.table1 = self:_make_table(1)
        self.table2 = self:_make_table(2)
        self.table = self.table1
        self.info = parts.info_panel({visible: self.conf.show_info == true})
        body = cdk.row({grow: 1, gap: 2}, [self.places, self.table1, self.table2, self.info])
        self.status = cdk.label("", {variant: "dim"})
        self.strip = parts.ops_strip({visible: false, on_cancel: (op) => op:cancel()})
        root = cdk.column({padding: 0, gap: 1}, [toolbar, self.tabrow, body, self.strip, cdk.row({padding: 2}, [self.status])])
        ui:set_root(root)
        ui:set_focus(self.table)
        ui.on_key = (ev) => me:key(ev)
        def closing():
            ops.windows[me.ui.win] = nil
            return true
        ui.on_close = closing
        ui:every(0.05, () => me:_tick())

    # выполнить действие от имени панели i (клик по ней делает её активной)
    def _pane_do(self, i, fn):
        self:_set_active(i)
        fn()

    def _set_active(self, i):
        if i == self.active or (i == 2 and not self.split):
            return
        self:_remember_cursor()
        self.active = i
        self.table = self:_table(i)
        self:_chrome()

    def _kind_color(self, kind):
        st = self.ui.style
        if kind == "folder":
            return st.warn
        if kind == "image" or kind == "script":
            return st.ok
        if kind == "music":
            return st.danger
        if kind == "text" or kind == "file":
            return st.dim
        return st.accent

    def _row_for(self, e, base, now, cut, name=nil):
        kind = types.kind(e, base)
        row = {cells: {name: name ?? e.name, size: e.type == "dir" and "" or types.human_size(e.size), modified: types.date_text(e.modified, now)},
            icon: types.icon(kind), icon_color: self:_kind_color(kind), dim: e.hidden or cut[paths.join(base, name ?? e.name)] == true, data: e,
            kind: kind}
        # лежит на расширителе: точка на значке; расширитель не на связи: строка серая, «away» вместо даты
        if e.layer == "ext":
            if e.offline:
                row.dim = true
                row.cells.modified = "away"
            if self.ext_marks or e.offline:
                row.badge = e.offline and self.ui.style.dim or self.ui.style.accent
        return row

    # перечитать папку панели i (по умолчанию активной); cursor_name: на каком имени поставить курсор
    def refresh_pane(self, i, cursor_name=nil):
        t = self:_state(i)
        tbl = self:_table(i)
        path = t.path
        if string.sub(path, 1, 8) == "network:":
            self:_net_rows(i, tbl, string.sub(path, 9))
            return
        ok, list = pcall(() => self.view:list(path, {hidden: true}))
        rows = []
        tbl.empty = "Nothing here"
        if not ok:
            tbl.empty = "Cannot open: " .. string.gsub(tostring(list), "^.-: ", "", 1)
            list = []
        shown = []
        for e in list:
            if self.show_hidden or not e.hidden:
                shown[len(shown) + 1] = e
        types.sort(shown, t.sort.key, t.sort.dir)
        now = os.epoch("local")
        cut = {}
        if ops.clip.mode == "cut":
            for c in ops.clip.paths:
                cut[c] = true
        for e in shown:
            rows[len(rows) + 1] = self:_row_for(e, path, now, cut)
        tbl.sort = t.sort
        tbl:set_rows(rows, (r) => r.data.name, cursor_name ?? t.cursor)

    def refresh(self, cursor_name=nil):
        if self.search != nil and self.search.pane == self.active:
            self:_search_restart()
        else:
            self:refresh_pane(self.active, cursor_name)
        if self.split:
            other = self.active == 1 and 2 or 1
            if self.search == nil or self.search.pane != other:
                self:refresh_pane(other)
        self:_chrome()

    # путь, заголовок, кнопки, вкладки, сведения, строка состояния по активной панели
    def _chrome(self):
        t = self:tab()
        path = t.path
        net = string.sub(path, 1, 8) == "network:"
        alias = nil
        root = nil
        if not net:
            alias, root = self:_alias(path)
        self.path:set(net and ("/Network" .. (path != "network:" and ("/" .. string.sub(path, 9)) or "")) or path, alias, root)
        name = net and (path == "network:" and "Network" or string.sub(path, 9)) or (path == "/" and "/" or paths.basename(path))
        self.ui.win:set_title(NAME .. " - " .. name)
        self.b_back.enabled = len(t.back) > 0
        self.b_fwd.enabled = len(t.fwd) > 0
        self.b_up.enabled = path != "/"
        self.b_hidden.on = self.show_hidden
        self.b_search.on = self.search != nil
        for b in [self.b_back, self.b_fwd, self.b_up, self.b_hidden, self.b_search]:
            b:invalidate()
        self:_tabs_changed()
        self:_selection()

    def _note(self, text):
        self.status:set_text(text)
        self.note_until = os.epoch("utc") + 2500

    def _selection(self):
        self:_info()
        if self.look != nil:
            self:_look_update()
        self:_status()

    def _status(self):
        if os.epoch("utc") < self.note_until:
            return
        rows = self.table.rows
        if self.search != nil and self.search.pane == self.active:
            self.status:set_text((self.search.done and "" or "Searching... ") .. len(rows) .. " found for \"" .. self.search.query .. "\"")
            return
        dirs = 0
        for r in rows:
            if r.data.type == "dir":
                dirs += 1
        text = len(rows) .. (len(rows) == 1 and " item" or " items")
        if dirs > 0:
            text = text .. " (" .. dirs .. (dirs == 1 and " folder)" or " folders)")
        sel = self.table:selected()
        if len(sel) > 1:
            size = 0
            for p in sel:
                size += p[2].data.size ?? 0
            text = text .. ", " .. len(sel) .. " selected, " .. types.human_size(size)
        ok, sp = pcall(() => self.view:space(self:tab().path))
        if ok and type(sp) == "table" and sp.free != nil:
            text = text .. ", " .. types.human_size(sp.free) .. " free"
        self.status:set_text(text)

    def _tabs_changed(self):
        names = []
        for t in self.tabs:
            names[len(names) + 1] = t.path == "/" and "/" or paths.basename(t.path)
        self.tabbar:set(names, self.cur)
        self.tabrow:set_visible(len(self.tabs) > 1)

    def _sorted(self, i, key, dir):
        self:_set_active(i)
        t = self:tab()
        t.sort = {key: key, dir: dir}
        cur = self.table.rows[self.table.cursor]
        self:refresh(cur != nil and cur.data.name or nil)

    # ------------------------------------------------------------ навигация

    def go(self, p):
        if p == "/Network":
            p = "network:"
        elif string.sub(tostring(p), 1, 9) == "/Network/":
            p = "network:" .. string.sub(p, 10)
        path = self:_expand(p)
        if string.sub(path, 1, 8) == "network:":
            return self:_go_to(path)
        ok, st = pcall(() => self.view:stat(path))
        if not ok or st == nil:
            self:_note("No such folder: " .. path)
            return false
        if st.type != "dir":
            self:_note("Not a folder: " .. path)
            return false
        return self:_go_to(path)

    def _go_to(self, path):
        self:stop_search(false)
        t = self:tab()
        if path == t.path:
            self:refresh()
            return true
        t.cursor = nil
        t.back[len(t.back) + 1] = t.path
        t.fwd = []
        old = t.path
        t.path = path
        # вверх: курсор на папке, из которой вышли
        self:refresh_pane(self.active, paths.is_inside(old, path) and paths.basename(old) or nil)
        self:_chrome()
        return true

    def back(self):
        t = self:tab()
        if len(t.back) == 0:
            return
        self:stop_search(false)
        t.fwd[len(t.fwd) + 1] = t.path
        old = t.path
        t.path = table.remove(t.back)
        self:refresh_pane(self.active, paths.is_inside(old, t.path) and paths.basename(old) or nil)
        self:_chrome()

    def forward(self):
        t = self:tab()
        if len(t.fwd) == 0:
            return
        self:stop_search(false)
        t.back[len(t.back) + 1] = t.path
        t.path = table.remove(t.fwd)
        self:refresh_pane(self.active)
        self:_chrome()

    def up(self):
        t = self:tab()
        if t.path == "/" or t.path == "network:":
            return
        if string.sub(t.path, 1, 8) == "network:":
            self:go("network:")
            return
        self:go(paths.parent(t.path))

    def _full(self, e):
        return paths.join(self:tab().path, e.name)

    def activate(self, row, ev):
        e = row.data
        if e.type == "peer" or e.type == "share":
            self:_net_open(e)
            return
        if e.type == "dir":
            if ev != nil and ev.ctrl:
                self:_open_tab(e)
            else:
                self:go(self:_full(e))
            return
        self:open_file(e, ev != nil and ev.ctrl == true)

    # ------------------------------------------------------------ открыть файл

    def open_file(self, e, second=false):
        list = assoc.handlers_for(self.assoc, e.name)
        if len(list) == 0:
            self:open_with(e)
            return
        h = second and (list[2] ?? list[1]) or list[1]
        self:launch(h, self:_full(e))

    # открыть путь приложением h (cubed, run, pixel)
    def launch(self, h, path):
        info = assoc.HANDLERS[h]
        name = paths.basename(path)
        if info == nil or info.missing:
            self:_note((info != nil and info.short or h) .. " is not in CubeOS yet")
            return false
        if self.session == nil:
            self:_note("Opening needs a desktop session")
            return false
        q = "\"" .. path .. "\""
        opts = {assets: self.assets}
        if h == "cubed":
            opts.command = "cubed " .. q
            opts.title = "cubed - " .. name
            opts.icon = "script"
        else:
            opts.command = q
            opts.keep = true
            opts.title = name
        wm = self.wm
        session = self.session
        wm:defer(() => wm:launch(terminal_app.main, {name: "terminal"}, [session, opts]))
        self:_note((h == "run" and "Running " or "Opening ") .. name)
        return true

    # окно «Открыть с помощью»: список приложений и галочка «Всегда открывать так»
    def open_with(self, e):
        ui = self.ui
        let me = self
        ext = assoc.ext_of(e.name)
        path = self:_full(e)
        items = []
        for h in assoc.ORDER:
            info = assoc.HANDLERS[h]
            items[len(items) + 1] = {text: info.title, icon: info.icon, id: h, color: info.missing and ui.style.dim or nil}
        card = nil
        always = cdk.checkbox(ext == "" and "Always for files without an extension" or ("Always open ." .. ext .. " files this way"))
        def done(it):
            ui:close_layer(card)
            ui:set_focus(me.table)
            if it == nil:
                return
            if always.checked:
                okw, err = assoc.always(me.view, ext, it.id)
                me.assoc = assoc.read_all(me.view)
            me:launch(it.id, path)
        list = cdk.list_view({height: len(items) * ui.style.line, items: items, on_activate: (i, it) => done(it)})
        card = cdk.card({padding: 6, gap: 4}, [cdk.label("Open \"" .. paths.basename(e.name) .. "\" with", {variant: "accent"}), list, always,
            cdk.row({gap: 4}, [cdk.spacer(), cdk.button("Cancel", {on_click: (b) => done(nil)}),
                cdk.button("Open", {variant: "primary", on_click: (b) => done(list.items[list.selected])})])])
        card.on_escape = () => done(nil)
        ui:open_layer(card, {center: true, modal: true, dismiss: false})
        ui:set_focus(list)

    def toggle_hidden(self):
        self.show_hidden = not self.show_hidden
        self:_save("show_hidden", self.show_hidden)
        cur = self.table.rows[self.table.cursor]
        self:refresh(cur != nil and cur.data.name or nil)

    # ------------------------------------------------------------ панели: места, сведения, разделение

    def toggle_places(self):
        self.places:set_visible(not self.places.visible)
        self:_save("show_places", self.places.visible)

    def toggle_info(self):
        self.info:set_visible(not self.info.visible)
        self:_save("show_info", self.info.visible)
        self:_info()

    def toggle_split(self):
        self.split = not self.split
        if self.split:
            t = self:tab()
            self.second = self:_new_tab(t.path)
            self.table2:set_visible(true)
            self:refresh_pane(2)
            self:_set_active(2)
            self.ui:set_focus(self.table2)
        else:
            if self.search != nil and self.search.pane == 2:
                self:stop_search(false)
            self:_set_active(1)
            self.table2:set_visible(false)
            self.second = nil
            self.ui:set_focus(self.table1)
        self:_chrome()

    # картинка .cimg, вписанная в w x h (цвета палитры экрана)
    def _picture(self, path, w, h):
        ok, data = pcall(() => self.view:read(path))
        if not ok or data == nil:
            return nil
        okd, src, spal = pcall(cimg.decode, data)
        if not okd:
            return nil
        return wallpaper_mod.fit_image(src, spal ?? color.default_palette(), math.min(w, src.w), math.min(h, src.h), "fit", self.ui.win.wm.palette)

    def _info(self):
        if not self.info.visible:
            return
        sel = self.table:selected()
        if len(sel) == 0:
            t = self:tab()
            self.info:set({icon: "folder", icon_color: self.ui.style.warn, lines: [[t.path == "/" and "/" or paths.basename(t.path), "text"],
                [len(self.table.rows) .. " items", "dim"]]})
            return
        if len(sel) > 1:
            size = 0
            for p in sel:
                size += p[2].data.size ?? 0
            self.info:set({icon: "file", lines: [[len(sel) .. " items selected", "text"], [types.human_size(size), "dim"]]})
            return
        row = sel[1][2]
        e = row.data
        lines = [[paths.basename(e.name), "text"], [KIND_NAMES[row.kind] ?? "File", "accent"]]
        if e.type != "dir":
            lines[len(lines) + 1] = [types.human_size(e.size), "dim"]
        if (e.modified ?? 0) > 0:
            lines[len(lines) + 1] = [os.date("%d.%m.%y %H:%M", math.floor(e.modified / 1000)), "dim"]
        if e.hidden:
            lines[len(lines) + 1] = ["Hidden", "dim"]
        if e.readonly:
            lines[len(lines) + 1] = ["Read only", "dim"]
        if e.layer == "ext" or e.layer == "both":
            lines[len(lines) + 1] = [(e.layer == "both" and "Also on " or "On ") .. tostring(e.label ?? "extender") .. (e.offline and " (away)" or ""),
                e.offline and "dim" or "accent"]
        img = nil
        if row.kind == "image":
            img = self:_picture(self:_full(e), self.info.w - 8, 44)
        self.info:set({icon: row.icon, icon_color: row.icon_color, image: img, lines: lines})

    # ------------------------------------------------------------ быстрый просмотр

    def quick_look(self):
        if self.look != nil:
            self:_look_close()
            return
        ui = self.ui
        let me = self
        cv = ui.win.canvas
        self.look = parts.quick_look({pw: cv.w - 24, ph: cv.h - 24, on_move: (d) => me:_look_move(d), on_close: () => me:_look_close()})
        card = cdk.card({padding: 1}, [self.look])
        self.look_card = card
        card.on_escape = () => me:_look_close()
        ui:open_layer(card, {center: true, modal: true, dismiss: true, on_close: () => me:_look_gone()})
        ui:set_focus(self.look)
        self:_look_update()

    def _look_close(self):
        if self.look_card != nil:
            card = self.look_card
            self.look_card = nil
            self.look = nil
            self.ui:close_layer(card)
            self.ui:set_focus(self.table)

    def _look_gone(self):
        self.look = nil
        self.look_card = nil

    def _look_move(self, d):
        t = self.table
        if len(t.rows) == 0:
            return
        t:select_only(math.max(1, math.min(len(t.rows), t.cursor + d)))
        self:_look_update()

    def _look_update(self):
        q = self.look
        if q == nil:
            return
        row = self.table.rows[self.table.cursor]
        if row == nil:
            q:show("", "none", "Nothing selected")
            return
        e = row.data
        full = self:_full(e)
        title = paths.basename(e.name) .. (e.type == "dir" and "" or ("  " .. types.human_size(e.size)))
        if e.type == "dir":
            okl, list = pcall(() => self.view:list(full, {hidden: self.show_hidden}))
            lines = []
            if okl:
                for x in list:
                    lines[len(lines) + 1] = (x.type == "dir" and "/" or " ") .. x.name
            q:show(title, "text", lines)
        elif row.kind == "image":
            img = self:_picture(full, q.pw - 8, q.ph - 20)
            q:show(title, img != nil and "image" or "none", img ?? "Cannot read this picture")
        elif row.kind == "music" or row.kind == "archive":
            q:show(title, "none", "No preview for this kind of file")
        else:
            ok, data = pcall(() => self.view:read(full))
            if not ok or data == nil:
                q:show(title, "none", "Cannot read")
                return
            text = string.sub(data, 1, PREVIEW_BYTES)
            for i in range[1, math.min(string.len(text), 512)]:
                b = string.byte(text, i)
                if b < 9 or (b > 13 and b < 32):
                    q:show(title, "none", "Binary file")
                    return
            lines = []
            for ln in string.gmatch(text .. "\n", "([^\n]*)\n"):
                lines[len(lines) + 1] = string.gsub(ln, "\t", "    ")
            q:show(title, "text", lines)

    # ------------------------------------------------------------ поиск

    def start_search(self):
        if string.sub(self:tab().path, 1, 8) == "network:":
            self:_note("Search works in folders")
            return
        if self.search != nil:
            self.ui:set_focus(self.search_box)
            return
        self.search = {pane: self.active, root: self:tab().path, query: "", queue: [], done: true, results: []}
        self.path:set_visible(false)
        self.search_box:set_visible(true)
        self.search_box:set_text("")
        self.ui:set_focus(self.search_box)
        self:_chrome()

    def stop_search(self, restore=true):
        if self.search == nil:
            return
        pane = self.search.pane
        self.search = nil
        self.search_box:set_visible(false)
        self.path:set_visible(true)
        if restore:
            self:refresh_pane(pane)
            self.ui:set_focus(self.table)
            self:_chrome()

    def _search_changed(self, text):
        s = self.search
        if s == nil:
            return
        s.query = unicode_lower(text)
        self:_search_restart()

    def _search_restart(self):
        s = self.search
        s.queue = [s.root]
        s.results = []
        s.done = s.query == ""
        tbl = self:_table(s.pane)
        tbl.empty = s.query == "" and "Type a name to search" or "Nothing found"
        tbl:set_rows([])
        if s.query == "":
            s.queue = []
        self:_status()

    # немного поиска за тик: обход папок по очереди, найденные сразу в таблице
    def _search_step(self):
        s = self.search
        if s == nil or s.done:
            return
        t0 = os.epoch("utc")
        added = false
        now = os.epoch("local")
        while len(s.queue) > 0 and os.epoch("utc") - t0 < 15:
            dir = table.remove(s.queue, 1)
            ok, list = pcall(() => self.view:list(dir, {hidden: self.show_hidden}))
            if ok:
                for e in list:
                    full = paths.join(dir, e.name)
                    if e.type == "dir" and not e.mount:
                        s.queue[len(s.queue) + 1] = full
                    if string.find(unicode_lower(e.name), s.query, 1, true) != nil:
                        rel = string.sub(full, string.len(s.root) + (s.root == "/" and 1 or 2))
                        hit = {}
                        for k, v in e:
                            hit[k] = v
                        hit.name = rel
                        s.results[len(s.results) + 1] = self:_row_for(hit, s.root, now, {}, rel)
                        added = true
        if len(s.queue) == 0:
            s.done = true
        if added or s.done:
            tbl = self:_table(s.pane)
            tbl:set_rows(s.results, (r) => r.data.name)
            self:_status()

    # ------------------------------------------------------------ вкладки

    def _remember_cursor(self):
        cur = self.table.rows[self.table.cursor]
        if self.search == nil:
            self:tab().cursor = cur != nil and cur.data.name or nil

    def new_tab(self):
        self:stop_search(false)
        self:_set_active(1)
        self:_remember_cursor()
        t = self:tab()
        self.tabs[len(self.tabs) + 1] = self:_new_tab(t.path)
        self.cur = len(self.tabs)
        self:refresh()

    def close_tab(self, i=nil):
        i = i ?? self.cur
        if len(self.tabs) <= 1:
            return
        self:stop_search(false)
        table.remove(self.tabs, i)
        self.cur = math.max(1, math.min(len(self.tabs), self.cur > i and self.cur - 1 or self.cur))
        self:refresh()

    def switch(self, i):
        n = len(self.tabs)
        if n <= 1:
            return
        i = (i - 1) % n + 1
        if i == self.cur:
            return
        self:stop_search(false)
        self:_set_active(1)
        self:_remember_cursor()
        self.cur = i
        self:refresh()

    # ------------------------------------------------------------ меню, настройки, клавиши

    def menu(self, b):
        let me = self
        items = [{text: "New folder", icon: "folder", shortcut: "Ctrl+Shift+N", on_select: (it) => me:new_folder()},
            {text: "Paste", icon: "file", shortcut: "Ctrl+V", disabled: len(ops.clip.paths) == 0, on_select: (it) => me:paste()},
            {separator: true},
            {text: "New tab", icon: "plus", shortcut: "Ctrl+N", on_select: (it) => me:new_tab()},
            {text: "Close tab", icon: "close", shortcut: "Ctrl+W", disabled: len(self.tabs) <= 1, on_select: (it) => me:close_tab()},
            {text: "Split view", icon: "menu", shortcut: "F3", checked: self.split, on_select: (it) => me:toggle_split()},
            {separator: true},
            {text: "Places panel", icon: "home", shortcut: "F9", checked: self.places.visible, on_select: (it) => me:toggle_places()},
            {text: "Information panel", icon: "info", shortcut: "Ctrl+I", checked: self.info.visible, on_select: (it) => me:toggle_info()},
            {text: "Show hidden files", icon: "eye", shortcut: "Ctrl+H", checked: self.show_hidden, on_select: (it) => me:toggle_hidden()},
            {separator: true},
            {text: "Extenders...", icon: "drive", shortcut: "Ctrl+E", on_select: (it) => me:extenders()},
            {text: "Settings...", icon: "gear", on_select: (it) => me:settings()},
            {text: "About Axo", icon: "axo", on_select: (it) => cdk.message(me.ui, "Axo", "Axo (Axolotl) file manager for CubeOS.")}]
        cdk.menu(self.ui, items, b.x + b.w - 118, b.y + b.h + 1)

    def settings(self):
        ui = self.ui
        let me = self
        card = nil
        c_places = cdk.checkbox("Places panel", {checked: self.places.visible})
        c_info = cdk.checkbox("Information panel", {checked: self.info.visible})
        c_hidden = cdk.checkbox("Show hidden files", {checked: self.show_hidden})
        c_trash = cdk.checkbox("Ask before moving to trash", {checked: self.conf.confirm_trash != false})
        c_delete = cdk.checkbox("Ask before deleting forever", {checked: self.conf.confirm_delete != false})
        c_min = cdk.checkbox("Minimal mode (no animations)", {checked: self.minimal})
        c_marks = cdk.checkbox("Mark files on extenders", {checked: self.ext_marks})
        def done(save):
            ui:close_layer(card)
            ui:set_focus(me.table)
            if not save:
                return
            if c_places.checked != me.places.visible:
                me:toggle_places()
            if c_info.checked != me.info.visible:
                me:toggle_info()
            if c_hidden.checked != me.show_hidden:
                me:toggle_hidden()
            me:_save("confirm_trash", c_trash.checked)
            me:_save("confirm_delete", c_delete.checked)
            me.minimal = c_min.checked
            me.tabbar.animate = not me.minimal
            me:_save("minimal", me.minimal)
            if c_marks.checked != me.ext_marks:
                me.ext_marks = c_marks.checked
                me:_save("ext_marks", me.ext_marks)
                me:refresh()
        card = cdk.card({padding: 6, gap: 3}, [cdk.label("Axo settings", {variant: "accent"}), c_places, c_info, c_hidden, c_trash, c_delete, c_min, c_marks,
            cdk.row({gap: 4}, [cdk.spacer(), cdk.button("Cancel", {on_click: (b) => done(false)}),
                cdk.button("Save", {variant: "primary", on_click: (b) => done(true)})])])
        card.on_escape = () => done(false)
        ui:open_layer(card, {center: true, modal: true, dismiss: false})

    def key(self, ev):
        k = ev.key
        if self.path.editing:
            if k == 256 or k == 1:
                self.path:edit(false)
                self.ui:set_focus(self.table)
            return
        if self.search != nil and (k == 256 or k == 1):
            self:stop_search(true)
            return
        if k == keys.n and ev.ctrl and ev.shift:
            self:new_folder()
        elif k == keys.c and ev.ctrl:
            self:copy_sel(false)
        elif k == keys.x and ev.ctrl:
            self:copy_sel(true)
        elif k == keys.v and ev.ctrl:
            self:paste()
        elif k == keys.f and ev.ctrl:
            self:start_search()
        elif k == keys.p and ev.ctrl:
            self:properties()
        elif k == keys.e and ev.ctrl:
            self:extenders()
        elif k == keys.i and ev.ctrl:
            self:toggle_info()
        elif k == keys.f9:
            self:toggle_places()
        elif k == keys.f3:
            self:toggle_split()
        elif k == keys.space and not ev.ctrl:
            self:quick_look()
        elif k == keys.f2:
            self:rename()
        elif k == keys.delete:
            self:delete_sel(ev.shift)
        elif k == keys.backspace:
            self:back()
        elif k == keys.up and ev.ctrl:
            self:up()
        elif (k == keys.left or k == keys.right) and (ev.ctrl or ev.alt):
            self:switch(self.cur + (k == keys.left and -1 or 1))
        elif k == keys.n and ev.ctrl:
            self:new_tab()
        elif k == keys.w and ev.ctrl:
            self:close_tab()
        elif k == keys.h and ev.ctrl:
            self:toggle_hidden()
        elif (k == keys.l and ev.ctrl) or k == keys.f6:
            self.path:edit(true)
        elif k == keys.f5:
            self:refresh()

    # ------------------------------------------------------------ действия с файлами

    def _selected_paths(self):
        out = []
        for pr in self.table:selected():
            out[len(out) + 1] = self:_full(pr[2].data)
        return out

    def copy_sel(self, cut):
        list = self:_selected_paths()
        if len(list) == 0:
            return
        ops.set_clip(cut and "cut" or "copy", list)
        self:_note((cut and "Cut " or "Copied ") .. len(list) .. (len(list) == 1 and " item" or " items"))
        cur = self.table.rows[self.table.cursor]
        if self.search == nil:
            self:refresh(cur != nil and cur.data.name or nil)

    def paste(self):
        if len(ops.clip.paths) == 0:
            return
        if string.sub(self:tab().path, 1, 8) == "network:":
            self:_note("Open a connected network folder to paste there")
            return
        kind = ops.clip.mode == "cut" and "move" or "copy"
        list = []
        for p in ops.clip.paths:
            list[len(list) + 1] = p
        self:_run(kind, list, self:tab().path)
        if kind == "move":
            ops.set_clip(nil, [])

    def _run(self, kind, list, dest):
        op = self.eng:start(kind, list, dest)
        self.strip:set(self.eng.ops)
        return op

    def delete_sel(self, forever):
        list = self:_selected_paths()
        if len(list) == 0:
            return
        let me = self
        what = len(list) == 1 and ("\"" .. paths.basename(list[1]) .. "\"") or (len(list) .. " items")
        def go(v):
            if v == true:
                me:_run(forever and "delete" or "trash", list, nil)
        ask = forever and self.conf.confirm_delete != false or (not forever and self.conf.confirm_trash != false)
        if not ask:
            go(true)
            return
        if forever:
            cdk.dialog(self.ui, {title: "Delete forever?", icon: "warn", text: "Delete " .. what .. " forever? This cannot be undone.",
                buttons: [{text: "Cancel", value: false}, {text: "Delete", variant: "danger", icon: "trash", value: true}], on_result: go})
        else:
            cdk.dialog(self.ui, {title: "Move to trash?", icon: "trash", text: "Move " .. what .. " to the trash?",
                buttons: [{text: "Cancel", value: false}, {text: "Move", variant: "primary", icon: "trash", value: true}], on_result: go})

    # окошко с полем ввода: on_ok(text); select_to: сколько символов выделить сначала
    def _ask_text(self, title, value, ok_text, on_ok, select_to=nil):
        ui = self.ui
        let me = self
        card = nil
        def done(text):
            ui:close_layer(card)
            ui:set_focus(me.table)
            if text != nil:
                on_ok(text)
        field = cdk.text_input({width: 150, text: value, on_submit: (t) => done(t)})
        card = cdk.card({padding: 6, gap: 5}, [cdk.label(title, {variant: "accent"}), field,
            cdk.row({gap: 4}, [cdk.spacer(), cdk.button("Cancel", {on_click: (b) => done(nil)}),
                cdk.button(ok_text, {variant: "primary", on_click: (b) => done(field.text)})])])
        card.on_escape = () => done(nil)
        ui:open_layer(card, {center: true, modal: true, dismiss: false})
        ui:set_focus(field)
        if select_to != nil:
            field.anchor = 0
            field.cursor = select_to
            field:invalidate()

    def rename(self):
        sel = self.table:selected()
        if len(sel) != 1:
            return
        e = sel[1][2].data
        old = self:_full(e)
        base = paths.basename(old)
        dir = paths.parent(old)
        dot = string.match(base, "^.+()%.[^%.]+$")
        let me = self
        def ok(text):
            if text == base or text == "":
                return
            problem = paths.name_problem(text)
            if problem != nil:
                me:_note("Cannot rename: " .. problem)
                return
            okm, err = pcall(() => me.view:move(old, paths.join(dir, text)))
            if not okm:
                me:_note("Cannot rename: " .. string.gsub(tostring(err), "^.-: ", "", 1))
                return
            me:refresh(text)
        self:_ask_text("Rename", base, "Rename", ok, e.type == "dir" and len(base) or ((dot ?? (len(base) + 1)) - 1))

    def new_folder(self):
        base = self:tab().path
        let me = self
        def ok(text):
            problem = paths.name_problem(text)
            if problem != nil:
                me:_note("Cannot create: " .. problem)
                return
            okm, err = pcall(() => me.view:mkdir(paths.join(base, text)))
            if not okm:
                me:_note("Cannot create: " .. string.gsub(tostring(err), "^.-: ", "", 1))
                return
            me:stop_search(false)
            me:refresh(text)
        name = "New folder"
        okx, st = pcall(() => self.view:stat(paths.join(base, name)))
        if okx and st != nil:
            name = ops.free_name(self.view, base, name)
        self:_ask_text("New folder", name, "Create", ok, len(name))

    def context_menu(self, row, ev):
        let me = self
        items = []
        if row != nil:
            e = row.data
            if e.type == "dir":
                items = [{text: "Open", icon: "folder", shortcut: "Enter", on_select: (it) => me:activate(row, {})},
                    {text: "Open in new tab", icon: "plus", shortcut: "Ctrl+Enter", on_select: (it) => me:_open_tab(e)}]
            else:
                hs = assoc.handlers_for(self.assoc, e.name)
                if len(hs) > 0:
                    items[len(items) + 1] = {text: "Open with " .. assoc.HANDLERS[hs[1]].short, icon: assoc.HANDLERS[hs[1]].icon, shortcut: "Enter",
                        on_select: (it) => me:open_file(e, false)}
                if len(hs) > 1:
                    items[len(items) + 1] = {text: "Open with " .. assoc.HANDLERS[hs[2]].short, icon: assoc.HANDLERS[hs[2]].icon,
                        shortcut: "Ctrl+Enter", on_select: (it) => me:open_file(e, true)}
                items[len(items) + 1] = {text: "Open with...", icon: "menu", on_select: (it) => me:open_with(e)}
                if assoc.runnable(e.name) and hs[1] != "run" and hs[2] != "run":
                    items[len(items) + 1] = {text: "Run", icon: "play", on_select: (it) => me:launch("run", me:_full(e))}
                items[len(items) + 1] = {text: "Quick look", icon: "eye", shortcut: "Space", on_select: (it) => me:quick_look()}
            for it in [{separator: true},
                {text: "Cut", icon: "minus", shortcut: "Ctrl+X", on_select: (it) => me:copy_sel(true)},
                {text: "Copy", icon: "file", shortcut: "Ctrl+C", on_select: (it) => me:copy_sel(false)},
                {text: "Paste", icon: "file", shortcut: "Ctrl+V", disabled: len(ops.clip.paths) == 0, on_select: (it) => me:paste()},
                {separator: true},
                {text: "Rename", icon: "script", shortcut: "F2", disabled: len(self.table:selected()) != 1, on_select: (it) => me:rename()},
                {text: "Move to trash", icon: "trash", shortcut: "Del", on_select: (it) => me:delete_sel(false)},
                {text: "Delete forever", icon: "warn", shortcut: "Shift+Del", on_select: (it) => me:delete_sel(true)}]:
                items[len(items) + 1] = it
            items[len(items) + 1] = {separator: true}
            if e.type == "dir":
                items[len(items) + 1] = {text: "Share on the network...", icon: "netfolder", on_select: (it) => me:share_dialog(e)}
                items[len(items) + 1] = self:_ext_item(self:_full(e))
            items[len(items) + 1] = {text: "Properties", icon: "info", shortcut: "Ctrl+P", on_select: (it) => me:properties()}
        else:
            items = [{text: "New folder", icon: "folder", shortcut: "Ctrl+Shift+N", on_select: (it) => me:new_folder()},
                {text: "Paste", icon: "file", shortcut: "Ctrl+V", disabled: len(ops.clip.paths) == 0, on_select: (it) => me:paste()},
                {separator: true},
                {text: "Show hidden files", icon: "eye", shortcut: "Ctrl+H", checked: self.show_hidden, on_select: (it) => me:toggle_hidden()},
                {text: "Refresh", icon: "restart", shortcut: "F5", on_select: (it) => me:refresh()}]
            if string.sub(self:tab().path, 1, 8) != "network:":
                items[len(items) + 1] = {separator: true}
                items[len(items) + 1] = self:_ext_item(self:tab().path)
        cdk.menu(self.ui, items, ev.x, ev.y)

    def _open_tab(self, e):
        path = self:_full(e)
        self:new_tab()
        self:go(path)

    # ------------------------------------------------------------ перетаскивание

    def _drag_start(self, sel):
        list = []
        for pr in sel:
            list[len(list) + 1] = self:_full(pr[2].data)
        self.drag = {paths: list, target: nil, from: self.active}

    # папка под точкой окна (x, y на холсте): строка-папка таблицы любой панели, место слева, вкладка; nil: не цель
    def _target_at(self, x, y):
        for i in [1, 2]:
            t = self:_table(i)
            if t.visible:
                st = self:_state(i)
                r = t:row_at(x, y)
                if r != nil:
                    e = t.rows[r].data
                    full = paths.join(st.path, e.name)
                    if e.type == "dir":
                        for p in self.drag.paths:
                            if p == full:
                                return nil, nil, i
                        return full, r, i
                    return nil, nil, i
                if t:contains(x, y):
                    return st.path, nil, i
        pl = self.places
        if pl.visible and pl:contains(x, y):
            k = math.floor((y - pl.y + pl.offset) / pl:row_h(self.ui.style)) + 1
            it = pl.items[k]
            if it != nil:
                return self:_expand(it.path), nil, nil
        tb = self.tabbar
        if self.tabrow.visible and tb:contains(x, y):
            k = math.floor((x - tb.x) / tb:_chip_w(self.ui.style)) + 1
            if self.tabs[k] != nil:
                return self.tabs[k].path, nil, nil
        return nil, nil, nil

    def _drag_move(self, ev):
        if self.drag == nil:
            return
        target, row, pane = self:_target_at(ev.x, ev.y)
        for i in [1, 2]:
            t = self:_table(i)
            want = pane == i and row or nil
            if t.drop_row != want:
                t.drop_row = want
                t:invalidate()
        self.drag.target = target
        n = len(self.drag.paths)
        what = n == 1 and paths.basename(self.drag.paths[1]) or (n .. " items")
        from_dir = paths.parent(self.drag.paths[1])
        if target != nil and target != from_dir:
            self:_note((self.ui.mods.ctrl and "Copy " or "Move ") .. what .. " to " .. (target == "/" and "/" or paths.basename(target)))
        else:
            self:_note("Drag " .. what .. " onto a folder (Ctrl: copy)")

    def _drop(self, ev):
        d = self.drag
        self.drag = nil
        self.note_until = 0
        for i in [1, 2]:
            self:_table(i).drop_row = nil
        if d == nil:
            return
        kind = self.ui.mods.ctrl and "copy" or "move"
        target, row, pane = self:_target_at(ev.x, ev.y)
        if target == nil and pane == nil:
            # другое окно Axo под мышью
            win = self.ui.win
            px = win:content_x() + ev.x
            py = win:content_y() + ev.y
            other, part = self.wm:hit(px, py)
            app = other != nil and ops.windows[other] or nil
            if app != nil and app != self:
                app.inbox[len(app.inbox) + 1] = {kind: kind, paths: d.paths}
                self:_note((kind == "copy" and "Copying " or "Moving ") .. "to another Axo window")
            self:_status()
            return
        if target == nil or (target == paths.parent(d.paths[1]) and kind == "move"):
            self:_status()
            return
        self:_run(kind, d.paths, target)

    # ------------------------------------------------------------ таймер: операции, вопросы, входящие, поиск

    def _tick(self):
        self:_search_step()
        while len(self.inbox) > 0:
            req = table.remove(self.inbox, 1)
            self:_run(req.kind, req.paths, self:tab().path)
        if len(self.eng.ops) == 0:
            return
        changed = self.eng:step(25)
        now = os.epoch("utc")
        refresh = false
        for op in self.eng.ops:
            if op.state == "ask" and self.asking == nil:
                self:_ask_conflict(op)
            touched = false
            for i in [1, 2]:
                if (i == 1 or self.split) and op.touched[self:_state(i).path]:
                    touched = true
            if (op.state == "done" or op.state == "cancelled") and op.finished_at == nil:
                op.finished_at = now
                refresh = refresh or touched
                if len(op.errors) > 0:
                    cdk.message(self.ui, "Some items failed", table.concat(op.errors, "\n"))
            if touched and changed and (self.last_refresh == nil or now - self.last_refresh > 400):
                refresh = true
        keep = []
        for op in self.eng.ops:
            if op.finished_at == nil or now - op.finished_at < 1500:
                keep[len(keep) + 1] = op
        if len(keep) != len(self.eng.ops):
            self.eng.ops = keep
        if refresh and self.search == nil:
            self.last_refresh = now
            cur = self.table.rows[self.table.cursor]
            self:refresh(cur != nil and cur.data.name or nil)
        self.strip:set(self.eng.ops)

    def _ask_conflict(self, op):
        ui = self.ui
        c = op.conflict
        self.asking = op
        let me = self
        card = nil
        all = cdk.checkbox("Do the same for the rest")
        def pick(choice):
            ui:close_layer(card)
            me.asking = nil
            if choice == "cancel":
                op:cancel()
            else:
                op:answer(choice, all.checked == true)
            ui:set_focus(me.table)
        replace = c.dir and "Merge" or "Replace"
        card = cdk.card({padding: 6, gap: 5}, [cdk.label("\"" .. c.name .. "\" already exists", {variant: "accent"}), all,
            cdk.row({gap: 3}, [cdk.button(replace, {variant: "danger", on_click: (b) => pick("replace")}),
                cdk.button("Skip", {on_click: (b) => pick("skip")}),
                cdk.button("Keep both", {variant: "primary", on_click: (b) => pick("rename")})])])
        card.on_escape = () => pick("cancel")
        ui:open_layer(card, {center: true, modal: true, dismiss: false})

    # ------------------------------------------------------------ сеть

    def _rpc(self, service, op, args=nil, timeout=4):
        ok, res, err = pcall(() => rpc.call(self.sys, service, op, args, timeout))
        if not ok:
            return nil, tostring(res)
        return res, err

    # выполнить запрос к службе, которой нужен администратор: сначала как есть, при отказе окно подтверждения и снова с паролем
    def _admin_call(self, service, op, args, reason, done):
        res, err = self:_rpc(service, op, args)
        if err == nil:
            done(res, nil)
            return
        if string.find(tostring(err), "administrator", 1, true) == nil:
            done(nil, err)
            return
        let me = self
        def with_creds(creds):
            if creds == nil:
                done(nil, "cancelled")
                return
            q = {}
            for k, v in args ?? {}:
                q[k] = v
            q.admin_user = creds.user
            q.admin_password = creds.password
            res2, err2 = me:_rpc(service, op, q)
            done(res2, err2)
        self:ask_admin(reason, with_creds)

    # окно подтверждения администратора: имя (если сам пользователь не администратор) и пароль
    def ask_admin(self, reason, on_done):
        ui = self.ui
        let me = self
        card = nil
        user = self.session != nil and self.session.user or nil
        is_admin = false
        if user != nil and self.session.manager != nil and self.session.manager.auth != nil:
            is_admin = self.session.manager.auth:is_admin(user)
        name = cdk.text_input({width: 140, placeholder: "Administrator name", visible: not is_admin})
        pw = cdk.text_input({width: 140, placeholder: "Password", password: true})
        def done(ok):
            ui:close_layer(card)
            ui:set_focus(me.table)
            if not ok:
                on_done(nil)
                return
            on_done({user: is_admin and user or name.text, password: pw.text})
        pw.on_submit = (t) => done(true)
        card = cdk.card({padding: 6, gap: 4}, [cdk.row({gap: 4, align: "center"}, [cdk.icon("lock", {color: ui.style.warn}),
                cdk.label("Administrator permission", {variant: "accent"})]),
            cdk.label(reason, {variant: "dim"}), name, pw,
            cdk.row({gap: 4}, [cdk.spacer(), cdk.button("Cancel", {on_click: (b) => done(false)}),
                cdk.button("Allow", {variant: "danger", icon: "lock", on_click: (b) => done(true)})])])
        card.on_escape = () => done(false)
        ui:open_layer(card, {center: true, modal: true, dismiss: false})
        ui:set_focus(is_admin and pw or name)

    def _net_rows(self, i, tbl, host):
        rows = []
        if host == "":
            peers, err = self:_rpc("netd", "peers")
            if peers == nil:
                tbl.empty = "Network service is not running"
            else:
                tbl.empty = "No computers seen yet (net scan)"
                table.sort(peers, (a, b) => (a.paired and 0 or 1) < (b.paired and 0 or 1))
                for p in peers:
                    nm = tostring(p.name ?? p.id)
                    rows[len(rows) + 1] = {cells: {name: nm, size: "", modified: p.paired and "paired" or ""}, icon: p.paired and "netfolder" or "user",
                        icon_color: p.paired and self.ui.style.accent or self.ui.style.dim, dim: not p.paired, kind: "netfolder",
                        data: {name: nm, type: "peer", host: tostring(p.name ?? p.id), paired: p.paired}}
        else:
            shares, err = self:_rpc("netd", "remote_shares", {host: host}, 6)
            if shares == nil:
                tbl.empty = "Cannot reach " .. host .. ": " .. string.gsub(tostring(err), "^.-: ", "", 1)
            else:
                tbl.empty = host .. " shares nothing"
                for sh in shares:
                    nm = tostring(sh.name)
                    rows[len(rows) + 1] = {cells: {name: nm, size: sh.readonly and "read" or "", modified: ""}, icon: "netfolder",
                        icon_color: self.ui.style.warn, kind: "netfolder", data: {name: nm, type: "share", host: host, readonly: sh.readonly}}
        tbl.sort = {key: "name", dir: 1}
        tbl:set_rows(rows, (r) => r.data.name)

    def _net_open(self, e):
        if e.type == "peer":
            if not e.paired:
                self:_note("Pair first: net pair " .. e.host .. " CODE")
                return
            self:go("network:" .. e.host)
            return
        # общая папка: уже подключена: туда; иначе подключить (netd mount) и открыть
        mounts = self:_rpc("netd", "mounts") ?? []
        for m in mounts:
            if tostring(m.host) == e.host and tostring(m.share) == e.name and m.point != nil:
                self:go(m.point)
                return
        let me = self
        def mounted(res, err):
            if err != nil:
                me:_note("Cannot connect: " .. string.gsub(tostring(err), "^.-: ", "", 1))
                return
            me:go(res.point ?? ("/cubeos/net/" .. e.host .. "/" .. e.name))
        self:_admin_call("netd", "mount", {host: e.host, share: e.name}, "Connect \"" .. e.name .. "\" from " .. e.host .. ".", mounted)

    def share_dialog(self, e):
        path = self:_full(e)
        shares = self:_rpc("netd", "shares") ?? []
        current = nil
        for sh in shares:
            if sh.path == path:
                current = sh
        let me = self
        if current != nil:
            def stopped(res, err):
                me:_note(err == nil and ("Stopped sharing " .. current.name) or ("Cannot stop: " .. tostring(err)))
            cdk.dialog(self.ui, {title: "Shared as \"" .. current.name .. "\"", icon: "netfolder", text: "Paired computers can open this folder.",
                buttons: [{text: "Close", value: false}, {text: "Stop sharing", variant: "danger", value: true}],
                on_result: (v) => v == true and me:_admin_call("netd", "unshare", {name: current.name}, "Stop sharing \"" .. current.name .. "\".", stopped)})
            return
        ui = self.ui
        card = nil
        name = cdk.text_input({width: 140, text: paths.basename(path)})
        ro = cdk.checkbox("Read only for others", {checked: true})
        def done(ok):
            ui:close_layer(card)
            ui:set_focus(me.table)
            if not ok:
                return
            def shared(res, err):
                me:_note(err == nil and ("Shared as " .. name.text) or ("Cannot share: " .. string.gsub(tostring(err), "^.-: ", "", 1)))
            me:_admin_call("netd", "share", {name: name.text, path: path, readonly: ro.checked}, "Share \"" .. paths.basename(path) .. "\" on the network.", shared)
        name.on_submit = (t) => done(true)
        card = cdk.card({padding: 6, gap: 4}, [cdk.label("Share on the network", {variant: "accent"}), cdk.label("Name for other computers", {variant: "dim"}),
            name, ro, cdk.row({gap: 4}, [cdk.spacer(), cdk.button("Cancel", {on_click: (b) => done(false)}),
                cdk.button("Share", {variant: "primary", icon: "netfolder", on_click: (b) => done(true)})])])
        card.on_escape = () => done(false)
        ui:open_layer(card, {center: true, modal: true, dismiss: false})
        ui:set_focus(name)

    # ------------------------------------------------------------ расширители (служба extd)

    def _err_text(self, err):
        return string.gsub(tostring(err), "^.-: ", "", 1)

    # точка расширителя, которой является папка path: (расширитель, точка) или nil
    def _ext_point(self, path, list=nil):
        for x in list ?? (self:_rpc("extd", "list") ?? []):
            for p in x.points ?? []:
                if p.path == path:
                    return x, p
        return nil, nil

    def _ext_item(self, path):
        let me = self
        x, p = self:_ext_point(path)
        if x != nil:
            return {text: "Detach " .. tostring(x.label), icon: "drive", on_select: (it) => me:ext_detach(x, path)}
        return {text: "Extend with...", icon: "drive", on_select: (it) => me:extend_dialog(path)}

    # куда можно расширить: известные расширители на связи и подключённые устройства без метки
    def _ext_choices(self, list):
        out = []
        for x in list:
            if x.online:
                out[len(out) + 1] = {text: tostring(x.label), icon: "drive", detail: x.free != nil and (types.human_size(x.free) .. " free") or "",
                    kind: "ext", id: x.id, label: x.label}
        for s in self:_rpc("extd", "sources") ?? []:
            if s.id == nil and not s.readonly:
                out[len(out) + 1] = {text: paths.basename(s.path), icon: "drive", detail: "new", color: self.ui.style.dim, kind: "src", path: s.path}
        return out

    # сделать устройство расширителем (имя спрашивается), потом then(id, label)
    def _ext_make(self, it, label, then):
        let me = self
        name = label != "" and label or it.text
        def made(res, err):
            if err != nil:
                me:_note("Cannot make an extender: " .. me:_err_text(err))
                return
            then(res.id, res.label)
        self:_admin_call("extd", "make", {source: it.path, label: name}, "Make \"" .. it.text .. "\" a storage extender named \"" .. name .. "\".", made)

    def extend_dialog(self, path):
        list, err = self:_rpc("extd", "list")
        if list == nil:
            self:_note("The extender service is not running")
            return
        choices = self:_ext_choices(list)
        if len(choices) == 0:
            self:_note("Connect a floppy disk or a network folder first")
            return
        ui = self.ui
        let me = self
        card = nil
        lv = cdk.list_view({items: choices, width: 160, height: math.min(60, 4 + len(choices) * 11)})
        name = cdk.text_input({width: 160, placeholder: "Name for a new extender"})
        prefer = cdk.checkbox("New files stay here while there is room", {checked: false})
        def done(ok):
            ui:close_layer(card)
            ui:set_focus(me.table)
            if not ok or lv.selected == 0:
                return
            it = choices[lv.selected]
            def attach(id, label):
                def attached(res, err):
                    if err != nil:
                        me:_note("Cannot extend: " .. me:_err_text(err))
                        return
                    me:_note(paths.basename(path) .. " is extended with " .. tostring(label))
                    me:refresh()
                me:_admin_call("extd", "add_point", {id: id, path: path, mode: "folder", priority: prefer.checked and "local" or "extender"},
                    "Extend \"" .. paths.basename(path) .. "\" with " .. tostring(label) .. ".", attached)
            if it.kind == "src":
                me:_ext_make(it, name.text, attach)
            else:
                attach(it.id, it.label)
        lv.on_activate = (i, it) => done(true)
        card = cdk.card({padding: 6, gap: 3}, [cdk.row({gap: 4, align: "center"}, [cdk.icon("drive", {color: ui.style.accent}),
                cdk.label("Extend \"" .. paths.basename(path) .. "\"", {variant: "accent"})]),
            cdk.label("New files go to the extender.", {variant: "dim"}),
            lv, name, prefer,
            cdk.row({gap: 4}, [cdk.spacer(), cdk.button("Cancel", {on_click: (b) => done(false)}),
                cdk.button("Extend", {variant: "primary", icon: "drive", on_click: (b) => done(true)})])])
        card.on_escape = () => done(false)
        ui:open_layer(card, {center: true, modal: true, dismiss: false})
        ui:set_focus(lv)

    def ext_detach(self, x, path, after=nil):
        let me = self
        def removed(res, err):
            me:_note(err == nil and (tostring(x.label) .. " detached from " .. paths.basename(path)) or ("Cannot detach: " .. me:_err_text(err)))
            me:refresh()
            if after != nil:
                after()
        def go(v):
            if v == true:
                me:_admin_call("extd", "remove_point", {id: x.id, path: path}, "Detach " .. tostring(x.label) .. " from \"" .. path .. "\".", removed)
        cdk.dialog(self.ui, {title: "Detach " .. tostring(x.label) .. "?", icon: "drive",
            text: "Its files leave with it; files on this computer stay.",
            buttons: [{text: "Cancel", value: false}, {text: "Detach", variant: "danger", value: true}], on_result: go})

    # окно всех расширителей: что подключено, куда, сколько места; открыть, подключить как диск, снять
    def extenders(self):
        list, err = self:_rpc("extd", "list")
        if list == nil:
            self:_note("The extender service is not running")
            return
        ui = self.ui
        st = ui.style
        let me = self
        card = nil
        items = []
        for x in list:
            state = x.online and (x.free != nil and (types.human_size(x.free) .. " free") or "connected") or "away"
            items[len(items) + 1] = {text: tostring(x.label), icon: "drive", detail: state, color: x.online and st.text or st.dim, kind: "ext", x: x}
            for p in x.points ?? []:
                items[len(items) + 1] = {text: "  " .. (self:_alias(p.path) ?? p.path), icon: p.mode == "disk" and "drive" or "folder",
                    detail: p.mode == "disk" and "disk" or (p.priority == "local" and "here first" or ""), color: x.online and st.text or st.dim,
                    kind: "point", x: x, point: p}
        for it in self:_ext_choices(list):
            if it.kind == "src":
                it.text = it.text .. " (not an extender)"
                items[len(items) + 1] = it
        if len(items) == 0:
            items = [{text: "No extenders. Connect a floppy disk or a network folder.", color: st.dim, kind: "none"}]
        lv = cdk.list_view({items: items, width: 190, height: math.min(90, 4 + len(items) * 11)})
        def close():
            ui:close_layer(card)
            ui:set_focus(me.table)
        def picked():
            return lv.selected > 0 and items[lv.selected] or nil
        def open():
            it = picked()
            if it != nil and it.kind == "point":
                close()
                me:go(it.point.path)
        def as_disk():
            it = picked()
            if it == nil or it.kind == "none" or it.kind == "point":
                return
            close()
            def attach(id, label):
                point = "/cubeos/mnt/" .. string.gsub(tostring(label), "[^%w%-_]", "_")
                def done(res, err):
                    if err != nil:
                        me:_note("Cannot attach: " .. me:_err_text(err))
                        return
                    me:go(point)
                me:_admin_call("extd", "add_point", {id: id, path: point, mode: "disk"}, "Attach " .. tostring(label) .. " as a disk.", done)
            if it.kind == "src":
                me:_ext_make(it, "", attach)
            else:
                attach(it.x.id, it.x.label)
        def detach():
            it = picked()
            if it != nil and it.kind == "point":
                close()
                me:ext_detach(it.x, it.point.path)
        lv.on_activate = (i, it) => open()
        card = cdk.card({padding: 6, gap: 3}, [cdk.row({gap: 4, align: "center"}, [cdk.icon("drive", {color: st.accent}),
                cdk.label("Storage extenders", {variant: "accent"})]),
            cdk.label("Extra space from floppies and other PCs.", {variant: "dim"}), lv,
            cdk.row({gap: 4}, [cdk.button("Open", {icon: "folder", on_click: (b) => open()}),
                cdk.button("As a disk", {icon: "drive", on_click: (b) => as_disk()}),
                cdk.button("Detach", {variant: "danger", on_click: (b) => detach()}), cdk.spacer(),
                cdk.button("Close", {on_click: (b) => close()})])])
        card.on_escape = () => close()
        ui:open_layer(card, {center: true, modal: true, dismiss: false})
        ui:set_focus(lv)

    # ------------------------------------------------------------ свойства

    # размер папки с ограничением по времени: (байты, файлы, всё ли посчитано)
    def _tree_size(self, path):
        t0 = os.epoch("utc")
        total = 0
        files = 0
        queue = [path]
        while len(queue) > 0:
            if os.epoch("utc") - t0 > 300:
                return total, files, false
            dir = table.remove(queue, 1)
            ok, list = pcall(() => self.view:list(dir, {hidden: true}))
            if ok:
                for e in list:
                    if e.type == "dir":
                        if not e.mount:
                            queue[len(queue) + 1] = paths.join(dir, e.name)
                    else:
                        total += e.size ?? 0
                        files += 1
        return total, files, true

    def _rights_words(self, r):
        words = []
        for pair in [["r", "read"], ["w", "write"], ["x", "run"], ["l", "list"]]:
            if string.find(r, pair[1], 1, true) != nil:
                words[len(words) + 1] = pair[2]
        return len(words) > 0 and table.concat(words, ", ") or "no access"

    def properties(self):
        sel = self.table:selected()
        if len(sel) != 1 or sel[1][2].data.type == "peer" or sel[1][2].data.type == "share":
            return
        row = sel[1][2]
        e = row.data
        path = self:_full(e)
        ui = self.ui
        let me = self
        lines = [["Kind", KIND_NAMES[row.kind] ?? "File"], ["Location", paths.parent(path)]]
        if e.type == "dir":
            size, files, all = self:_tree_size(path)
            lines[len(lines) + 1] = ["Size", (all and "" or "more than ") .. types.human_size(size) .. ", " .. files .. " files"]
        else:
            lines[len(lines) + 1] = ["Size", types.human_size(e.size) .. " (" .. tostring(e.size ?? 0) .. " bytes)"]
        if (e.modified ?? 0) > 0:
            lines[len(lines) + 1] = ["Modified", os.date("%d.%m.%Y %H:%M", math.floor(e.modified / 1000))]
        acc = self:_rpc("permd", "access", {path: path})
        rights = acc != nil and acc.rights or nil
        if rights == nil:
            okr, rv = pcall(() => self.view:rights(path))
            rights = okr and rv or ""
        lines[len(lines) + 1] = ["Access", self:_rights_words(rights)]
        if acc != nil and acc.rule != nil:
            who = []
            for k, v in acc.rule.allow:
                who[len(who) + 1] = k .. ": " .. v
            table.sort(who)
            lines[len(lines) + 1] = ["Rule", acc.rule.path .. (acc.custom and " (own)" or "")]
            lines[len(lines) + 1] = ["Who", table.concat(who, ", ")]
        flags = []
        if e.hidden:
            flags[len(flags) + 1] = "hidden"
        if e.readonly:
            flags[len(flags) + 1] = "read-only drive"
        if e.important:
            flags[len(flags) + 1] = "important (!)"
        if len(flags) > 0:
            lines[len(lines) + 1] = ["Flags", table.concat(flags, ", ")]
        kids = [cdk.row({gap: 4, align: "center"}, [cdk.icon(row.icon, {color: row.icon_color}), cdk.label(paths.basename(e.name), {variant: "accent"})])]
        for ln in lines:
            kids[len(kids) + 1] = cdk.row({gap: 4}, [cdk.label(ln[1], {variant: "dim", width: 54}), cdk.label(ln[2], {grow: 1})])
        card = nil
        def close():
            ui:close_layer(card)
            ui:set_focus(me.table)
        kids[len(kids) + 1] = cdk.row({gap: 4}, [cdk.spacer(),
            cdk.button("Change access...", {icon: "lock", on_click: (b) => me:_access_editor(path, e, acc, close)}),
            cdk.button("Close", {variant: "primary", on_click: (b) => close()})])
        card = cdk.card({padding: 6, gap: 2}, kids)
        card.on_escape = () => close()
        ui:open_layer(card, {center: true, modal: true, dismiss: false})

    # кто и что может: строки «субъект r w x l» и новая строка; сохранение своим правилом через permd
    def _access_editor(self, path, e, acc, close_props):
        close_props()
        ui = self.ui
        let me = self
        target = e.type == "dir" and (path .. "/**") or path
        allow = {}
        if acc != nil and acc.rule != nil:
            for k, v in acc.rule.allow:
                allow[k] = v
        rows = []
        kids = [cdk.label("Access to " .. paths.basename(path), {variant: "accent"}), cdk.label(e.type == "dir" and "The folder and everything inside" or "This file", {variant: "dim"})]
        def add_row(who, r):
            boxes = []
            for ch in ["r", "w", "x", "l"]:
                boxes[len(boxes) + 1] = cdk.checkbox(ch, {checked: string.find(r, ch, 1, true) != nil})
            rows[len(rows) + 1] = {who: who, boxes: boxes}
            kids[len(kids) + 1] = cdk.row({gap: 3, align: "center"}, [cdk.label(who, {width: 48}), boxes[1], boxes[2], boxes[3], boxes[4]])
        names = []
        for k, v in allow:
            names[len(names) + 1] = k
        table.sort(names)
        for k in names:
            add_row(k, allow[k])
        extra = cdk.text_input({width: 70, placeholder: "user or role"})
        kids[len(kids) + 1] = cdk.row({gap: 3, align: "center"}, [cdk.label("Add", {variant: "dim", width: 24}), extra])
        card = nil
        def done(ok):
            ui:close_layer(card)
            ui:set_focus(me.table)
            if not ok:
                return
            out = {}
            for r in rows:
                v = ""
                for i, ch in ["r", "w", "x", "l"]:
                    if r.boxes[i].checked:
                        v = v .. ch
                if v != "":
                    out[r.who] = v
            if extra.text != "":
                out[extra.text] = "rl"
            def saved(res, err):
                me:_note(err == nil and "Access changed" or ("Cannot change access: " .. string.gsub(tostring(err), "^.-: ", "", 1)))
            me:_admin_call("permd", "set_access", {path: target, allow: out}, "Change who can open \"" .. paths.basename(path) .. "\".", saved)
        kids[len(kids) + 1] = cdk.row({gap: 4}, [cdk.spacer(), cdk.button("Cancel", {on_click: (b) => done(false)}),
            cdk.button("Save", {variant: "primary", icon: "lock", on_click: (b) => done(true)})])
        card = cdk.card({padding: 6, gap: 2}, kids)
        card.on_escape = () => done(false)
        ui:open_layer(card, {center: true, modal: true, dismiss: false})

    def run(self):
        self.ui:run()

def unicode_lower(s):
    return unicode.lower(tostring(s ?? ""))

export def main(sys, ctx):
    app = Axo(sys, ctx)
    app:run()
