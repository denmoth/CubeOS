# apps.calc.eval: безопасный разбор и вычисление выражений для калькулятора (без load). 2+3*4, (1+2)^3, sqrt(16), sin(pi/2), 5!, 7%3, 2pi.
#
#   v, err = eval.evaluate("2+3*4", {deg: true, ans: 14})
#   eval.format(v) -> "14"
#
# Функции: sqrt cbrt sin cos tan asin acos atan sinh cosh tanh ln log (по основанию 10) log2 exp abs floor ceil round sign min max pow hyp.
# Постоянные: pi, e, ans (прошлый ответ). Знаки: + - * / % (остаток) ^ (степень) ! (факториал); умножение можно опустить: 2pi, 3(4+1).

const FUNCS = {sqrt: math.sqrt, sin: math.sin, cos: math.cos, tan: math.tan, exp: math.exp, abs: math.abs, floor: math.floor, ceil: math.ceil,
    asin: math.asin, acos: math.acos, atan: math.atan}

def _cbrt(x):
    return x < 0 and -((-x) ** (1 / 3)) or x ** (1 / 3)

def _sign(x):
    return x > 0 and 1 or (x < 0 and -1 or 0)

def _round(x):
    return math.floor(x + 0.5)

def _log10(x):
    return math.log(x) / math.log(10)

def _log2(x):
    return math.log(x) / math.log(2)

def _sinh(x):
    return (math.exp(x) - math.exp(-x)) / 2

def _cosh(x):
    return (math.exp(x) + math.exp(-x)) / 2

def _tanh(x):
    a = math.exp(x)
    b = math.exp(-x)
    return (a - b) / (a + b)

def _hyp(a, b):
    return math.sqrt(a * a + b * b)

def _fact(n):
    if n < 0 or n != math.floor(n):
        return nil
    if n > 170:
        return math.huge
    r = 1
    for i in range[2, n]:
        r = r * i
    return r

def _tokens(text):
    out = []
    i = 1
    n = string.len(text)
    while i <= n:
        ch = string.sub(text, i, i)
        if ch == " ":
            i += 1
        elif ch == ",":
            out[len(out) + 1] = {t: ","}
            i += 1
        elif string.match(ch, "[%d%.]"):
            digits = string.match(text, "^%d*%.?%d*", i)
            v = tonumber(digits)
            if v == nil:
                return nil, "Bad number " .. digits
            out[len(out) + 1] = {t: "num", v: v}
            i += string.len(digits)
        elif string.match(ch, "%a"):
            word = string.match(text, "^[%a_][%w_]*", i)
            out[len(out) + 1] = {t: "id", v: string.lower(word)}
            i += string.len(word)
        elif string.find("+-*/%^!()", ch, 1, true) != nil:
            out[len(out) + 1] = {t: ch}
            i += 1
        else:
            return nil, "Unexpected " .. ch
    return out

export def format(v):
    if v == nil:
        return ""
    if v != v:
        return "Not a number"
    if v == math.huge:
        return "Infinity"
    if v == -math.huge:
        return "-Infinity"
    if v == math.floor(v) and math.abs(v) < 1e15:
        return string.format("%d", v)
    return string.format("%.10g", v)

export def evaluate(text, opts=nil):
    o = opts ?? {}
    toks, err = _tokens(text)
    if toks == nil:
        return nil, err
    if len(toks) == 0:
        return nil, nil
    pos = {i: 1}
    deg = o.deg == true
    def peek():
        return toks[pos.i]
    def take():
        t = toks[pos.i]
        pos.i += 1
        return t
    def fail(msg):
        raise Error(msg)
    def angle_in(x):
        return deg and x * math.pi / 180 or x
    def angle_out(x):
        return deg and x * 180 / math.pi or x
    holder = {}
    def call(name, args):
        a = args[1]
        if name == "sin" or name == "cos" or name == "tan":
            r = FUNCS[name](angle_in(a))
            # красивые нули: sin(pi) и cos(pi/2) не должны давать 1e-16
            if math.abs(r) < 1e-12:
                r = 0
            return r
        if name == "asin" or name == "acos" or name == "atan":
            return angle_out(FUNCS[name](a))
        if FUNCS[name] != nil:
            return FUNCS[name](a)
        if name == "cbrt":
            return _cbrt(a)
        if name == "sinh":
            return _sinh(a)
        if name == "cosh":
            return _cosh(a)
        if name == "tanh":
            return _tanh(a)
        if name == "ln":
            return math.log(a)
        if name == "log":
            return _log10(a)
        if name == "log2":
            return _log2(a)
        if name == "sign":
            return _sign(a)
        if name == "round":
            return _round(a)
        if name == "min":
            return math.min(table.unpack(args))
        if name == "max":
            return math.max(table.unpack(args))
        if name == "pow":
            return a ** (args[2] ?? 2)
        if name == "hyp":
            return _hyp(a, args[2] ?? 0)
        fail("Unknown function " .. name)
    def primary():
        t = take()
        if t == nil:
            fail("Unfinished expression")
        if t.t == "num":
            return t.v
        if t.t == "(":
            v = holder.expr()
            c = take()
            if c == nil or c.t != ")":
                fail("Missing )")
            return v
        if t.t == "id":
            nx = peek()
            if nx != nil and nx.t == "(":
                take()
                args = []
                nx2 = peek()
                if nx2 != nil and nx2.t == ")":
                    take()
                else:
                    while true:
                        args[len(args) + 1] = holder.expr()
                        c = take()
                        if c == nil:
                            fail("Missing )")
                        if c.t == ")":
                            break
                        if c.t != ",":
                            fail("Missing )")
                if len(args) == 0:
                    fail("Missing value for " .. t.v)
                return call(t.v, args)
            if t.v == "pi":
                return math.pi
            if t.v == "e":
                return math.exp(1)
            if t.v == "ans":
                return o.ans ?? 0
            fail("Unknown name " .. t.v)
        fail("Unexpected " .. t.t)
    def postfix():
        v = primary()
        while true:
            nx = peek()
            if nx != nil and nx.t == "!":
                take()
                v = _fact(v)
                if v == nil:
                    fail("Factorial needs a whole number")
            else:
                break
        return v
    def power():
        base = postfix()
        nx = peek()
        if nx != nil and nx.t == "^":
            take()
            # степень правоассоциативна, минус в показателе допустим
            return base ** holder.unary()
        return base
    def unary():
        nx = peek()
        if nx != nil and nx.t == "-":
            take()
            return -holder.unary()
        if nx != nil and nx.t == "+":
            take()
            return holder.unary()
        return power()
    holder.unary = unary
    def term():
        v = unary()
        while true:
            nx = peek()
            if nx == nil:
                break
            if nx.t == "*":
                take()
                v = v * unary()
            elif nx.t == "/":
                take()
                d = unary()
                if d == 0:
                    fail("Cannot divide by zero")
                v = v / d
            elif nx.t == "%":
                take()
                d = unary()
                if d == 0:
                    fail("Cannot divide by zero")
                v = v - d * math.floor(v / d)
            elif nx.t == "num" or nx.t == "id" or nx.t == "(":
                # 2pi, 3(4+1): умножение опущено
                v = v * unary()
            else:
                break
        return v
    def expr():
        v = term()
        while true:
            nx = peek()
            if nx != nil and nx.t == "+":
                take()
                v = v + term()
            elif nx != nil and nx.t == "-":
                take()
                v = v - term()
            else:
                break
        return v
    holder.expr = expr
    ok, res = pcall(expr)
    if not ok:
        return nil, string.gsub(tostring(res), "^.-: ", "", 1)
    if peek() != nil:
        return nil, "Unexpected " .. peek().t
    return res
