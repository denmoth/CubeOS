# cde.session: рабочий стол как программа сессии после входа (вместо полноэкранного терминала)
#
#   shell = (session) => cde_session.program(session, {assets: "/repo/assets"})      для boot.new({shell: ...})
#
# Процесс сессии становится оконным менеджером (держит фокус ввода ядра), приложения запускаются его потомками с правами и видом CFS
# пользователя. Первым открывается терминал. Alt+Enter новый терминал, Ctrl+Alt+T следующая тема (пока нет настроек), F11 полный
# экран, Ctrl+Alt+= и Ctrl+Alt+- крупнее и мельче (масштаб), Ctrl+Alt+K витрина элементов cdk, Ctrl+Alt+Q выход из сессии
# (панель задач cde.panel; «Пуск» с меню на шаге 3.2). Ctrl+Alt+P панель сверху или снизу, Ctrl+Alt+O кнопки окон слева или по центру, Ctrl+Alt+L блокировка экрана.
# Настройки пользователя $cfg/cde.conf (JSON5): theme (имя темы), scale ("auto" или 1..4); тема и масштаб, выбранные сочетаниями,
# сохраняются туда же; panel ({position, align, height, clock}, cde.panel); wallpaper (имя обоев или {name, mode}, Ctrl+Alt+W следующие, cde.wallpaper); animations ({enabled, speed, windows, glow, widgets}, cde.fx), Ctrl+Alt+A включает и выключает анимации.
# opts: term, assets, theme, widgets (список виджетов вместо conf.widgets), host, ready(wm) (для тестов), terminal_ready(ctx) (для тестов: ready терминала)

import cde.wm as wm_mod
import cde.terminal as terminal
import cdk.gallery as gallery
import cde.apps as apps_mod
import cde.startmenu as startmenu
import cde.tray as tray_mod
import cde.widgets as widgets_mod
import cde.lock as lock_mod
import apps.axo as axo
import apps.launcher as launcher
import cde.theme as theme_mod
import cde.wallpaper as wallpaper_mod
import clock as clock_mod
import json5

const SCALES = ["auto", 1, 2, 3, 4]

export def program(session, opts=nil):
    o = opts ?? {}

    def main(sys, args):
        view = sys.view()
        conf_path = nil
        conf = {}
        if view != nil:
            conf_path = view:expand("$cfg") .. "/cde.conf"
            def read_conf():
                if view:exists(conf_path):
                    data = json5.parse(view:read(conf_path))
                    if type(data) == "table":
                        return data
                return {}
            okc, data = pcall(read_conf)
            if okc:
                conf = data
        def save(key, value):
            if conf_path == nil:
                return
            def write_conf():
                text = view:exists(conf_path) and view:read(conf_path) or "{}\n"
                view:write_atomic(conf_path, json5.patch(text, [key], value))
            okw, err = pcall(write_conf)
            if not okw:
                sys.log("warn", "desktop: cannot save " .. key .. ": " .. tostring(err))
            conf[key] = value
        # настройки экрана входа всей системы (/cubeos/sys/cfg/login.conf): менять может только администратор
        def save_login(key, value):
            path = "/cubeos/sys/cfg/login.conf"
            def write_login():
                text = view:exists(path) and view:read(path) or "{}\n"
                view:write_atomic(path, json5.patch(text, [key], value))
            okl, err = pcall(write_login)
            if not okl:
                sys.log("warn", "desktop: cannot change the login screen: " .. tostring(err))
        # часы панели: настройки времени системы (time.conf), без файла UTC
        clock_obj = {}
        def make_time():
            text = nil
            if view != nil:
                okr, t = pcall(view.read, view, "/cubeos/sys/cfg/time.conf")
                if okr and type(t) == "string":
                    text = t
            c = clock_mod.from_text(text ?? "{}")
            clock_obj.c = c
            return () => c:time_text()
        panel_conf = {}
        for k, v in (type(conf.panel) == "table" and conf.panel or {}):
            panel_conf[k] = v
        if panel_conf.time_text == nil:
            okt, tt = pcall(make_time)
            if okt:
                panel_conf.time_text = tt
        panel = o.panel
        if panel == nil:
            panel = panel_conf
        # свои обои: картинки .cimg в $cfg/wallpapers пользователя
        wall_dir = view != nil and (view:expand("$cfg") .. "/wallpapers") or nil
        def user_wallpapers():
            out = []
            if wall_dir != nil:
                okl, list = pcall(view.list, view, wall_dir)
                if okl and type(list) == "table":
                    for e in list:
                        m = string.match(tostring(type(e) == "table" and e.name or e), "^(.+)%.cimg$")
                        if m != nil:
                            out[len(out) + 1] = m
            return out
        def wallpaper_loader(name):
            if wall_dir == nil or string.find(name, "/", 1, true) != nil or string.find(name, "..", 1, true) != nil:
                return nil
            okr, data = pcall(view.read, view, wall_dir .. "/" .. name .. ".cimg")
            return okr and data or nil
        wm = wm_mod.new({term: o.term, background: o.background ?? conf.wallpaper, wallpaper_loader: wallpaper_loader, assets: o.assets ?? "/repo/assets", theme: o.theme ?? conf.theme, scale: conf.scale ?? "auto",
            animations: o.animations ?? conf.animations, panel: panel})
        term_opts = {assets: o.assets, host: o.host, ready: o.terminal_ready}
        def open_terminal():
            wm:launch(terminal.main, {name: "terminal"}, [session, term_opts])
        def logout():
            wm:stop()
        wm:hotkey("alt+enter", open_terminal)
        wm:hotkey("ctrl+alt+q", logout)
        def next_theme():
            wm:next_theme()
            save("theme", wm.theme.name)
        def zoom(dir):
            pos = 1
            for i, v in SCALES:
                if v == wm.scale_setting:
                    pos = i
            # от «auto» шаг идёт от масштаба, который сейчас на экране
            if pos == 1:
                pos = wm.scale + 1
            pos = math.max(2, math.min(len(SCALES), pos + dir))
            wm:set_scale(SCALES[pos])
            save("scale", SCALES[pos])
        wm:hotkey("ctrl+alt+t", next_theme)
        def toggle_anim():
            wm.anim.enabled = not wm.anim.enabled
            save("animations", wm.anim)
        wm:hotkey("ctrl+alt+a", toggle_anim)
        # панель: Ctrl+Alt+P сверху или снизу, Ctrl+Alt+L кнопки окон слева или по центру (потом «Настройки»)
        def save_panel():
            save("panel", {position: wm.panel.position, align: wm.panel.align, height: wm.panel.height})
        def panel_position():
            if wm.panel != nil:
                wm:set_panel({position: wm.panel.position == "top" and "bottom" or "top"})
                save_panel()
        def panel_align():
            if wm.panel != nil:
                wm:set_panel({align: wm.panel.align == "center" and "left" or "center"})
                save_panel()
        wm:hotkey("ctrl+alt+p", panel_position)
        # Ctrl+Alt+W следующие обои по кругу (пока нет «Настроек»)
        def next_wallpaper():
            names = wallpaper_mod.names(wm.wallpaper_dirs, user_wallpapers())
            cur = type(wm.background) == "table" and wm.background.name or wm.background
            pick = names[1]
            for i, n in names:
                if n == cur and names[i + 1] != nil:
                    pick = names[i + 1]
            wm:set_wallpaper(pick)
            save("wallpaper", pick)
        wm:hotkey("ctrl+alt+w", next_wallpaper)
        # каталог для меню «Пуск»: приложения и команды (темы, масштаб, панель, анимации, выход)
        reg = apps_mod.new()
        reg:add({id: "terminal", name: "Terminal", icon: "terminal", keywords: ["console", "shell", "cmd", "терминал", "консоль", "термінал"],
            run: (w) => open_terminal()})
        # API рабочего стола для приложений (Настройки, Pixel): собирается в конце, пока там пусто
        holder = {}
        app_env = {session: session, assets: o.assets ?? "/repo/assets", desktop: () => holder.api}
        reg:add({id: "axo", name: "Axo", icon: "axo", detail: "Files", keywords: ["axolotl", "files", "explorer", "folders", "файлы", "проводник", "аксолотль", "папки"],
            run: (w) => w:launch(axo.main, {name: "axo"}, ["$home", {session: session, assets: o.assets ?? "/repo/assets", desktop: holder.api,
                open_app: (id, p) => w:defer(() => launcher.open(id, w, app_env, p))}])})
        launcher.add_all(reg, wm, app_env)
        reg:add({id: "widgets", name: "Widget gallery", icon: "cube", keywords: ["cdk", "controls", "ui", "виджеты", "элементы"],
            run: (w) => w:launch(gallery.main, {name: "gallery"})})
        def logout_entry():
            return {id: "logout", name: "Log out", icon: "close", kind: "action", keywords: ["exit", "quit", "sign out", "выход", "выйти"],
                run: (w) => w:stop()}
        def run_theme(name):
            def run(w):
                w:set_theme(name)
                save("theme", name)
            return run
        def run_scale(v):
            def run(w):
                w:set_scale(v)
                save("scale", v)
            return run
        def run_panel(change):
            def run(w):
                w:set_panel(change)
                save_panel()
            return run
        def run_wallpaper(name):
            def run(w):
                w:set_wallpaper(name)
                save("wallpaper", name)
            return run
        def run_widget(id):
            def run(w):
                toggle_widget(id)
            return run
        def command(id, name, icon, words, run):
            return {id: id, name: name, icon: icon, kind: "action", keywords: words, run: run}
        def commands():
            out = []
            for name in theme_mod.list(wm.theme_dirs):
                th = theme_mod.find(name, wm.theme_dirs)
                out[len(out) + 1] = command("theme:" .. name, "Theme: " .. (th.display ?? name), "star",
                    ["colors", "dark", "light", "тема", "цвета"], run_theme(name))
            for name in wallpaper_mod.names(wm.wallpaper_dirs, user_wallpapers()):
                out[len(out) + 1] = command("wallpaper:" .. name, "Wallpaper: " .. name, "star", ["background", "desktop", "обои", "фон"],
                    run_wallpaper(name))
            for v in SCALES:
                out[len(out) + 1] = command("scale:" .. tostring(v), "Scale: " .. (v == "auto" and "Auto" or v .. "x"), "search",
                    ["zoom", "size", "масштаб"], run_scale(v))
            if wm.panel != nil:
                words = ["taskbar", "панель"]
                out[len(out) + 1] = command("panel:top", "Panel at the top", "gear", words, run_panel({position: "top"}))
                out[len(out) + 1] = command("panel:bottom", "Panel at the bottom", "gear", words, run_panel({position: "bottom"}))
                out[len(out) + 1] = command("panel:center", "Panel buttons in the center", "gear", words, run_panel({align: "center"}))
                out[len(out) + 1] = command("panel:left", "Panel buttons on the left", "gear", words, run_panel({align: "left"}))
            out[len(out) + 1] = command("anim", "Animations: " .. (wm.anim.enabled and "turn off" or "turn on"), "play",
                ["effects", "анимации"], (w) => toggle_anim())
            out[len(out) + 1] = logout_entry()
            return out
        reg:provider(commands)
        # экран блокировки и входа: обои, аватар, форма аватаров (пока нет «Настроек»)
        def avatar_names():
            out = ["letter", "custom"]
            okl, files = pcall(fs.list, (o.assets ?? "/repo/assets") .. "/avatars")
            if okl and files != nil:
                table.sort(files)
                for f in files:
                    n = string.match(f, "^(.+)%.cimg$")
                    if n != nil:
                        out[len(out) + 1] = n
            return out
        def run_pref(key, value, login_key=nil):
            def run(w):
                save(key, value)
                if login_key != nil:
                    save_login(login_key, value)
            return run
        def screen_commands():
            out = []
            for name in wallpaper_mod.names(wm.wallpaper_dirs, user_wallpapers()):
                out[len(out) + 1] = command("lockwp:" .. name, "Lock screen wallpaper: " .. name, "lock", ["lock", "background", "блокировка", "обои"],
                    run_pref("lock_wallpaper", name))
                out[len(out) + 1] = command("loginwp:" .. name, "Login screen wallpaper: " .. name, "user", ["login", "background", "вход", "обои"],
                    run_login(name))
            for name in avatar_names():
                out[len(out) + 1] = command("avatar:" .. name, "Avatar: " .. name, "user", ["avatar", "picture", "аватар", "иконка"],
                    run_pref("avatar", name))
            for shape in ["circle", "square"]:
                out[len(out) + 1] = command("shape:" .. shape, "Avatar shape: " .. shape, "user", ["avatar", "round", "square", "аватар", "форма"],
                    run_pref("avatar_shape", shape, "shape"))
            return out
        def run_login(name):
            def run(w):
                save_login("wallpaper", name)
            return run
        reg:provider(screen_commands)
        # блокировка экрана: Ctrl+Alt+L, «Пуск» (команда и кнопка внизу)
        # аватар пользователя для экрана блокировки: встроенный (assets/avatars), свой ($cfg/avatar.cimg) или буква
        def avatar_image():
            name = conf.avatar
            cfgd = view != nil and view:expand("$cfg") or nil
            if cfgd != nil and (name == nil or name == "custom"):
                okr, data = pcall(view.read, view, cfgd .. "/avatar.cimg")
                if okr and data != nil:
                    return data
            if name != nil and name != "letter" and name != "custom":
                path = (o.assets ?? "/repo/assets") .. "/avatars/" .. name .. ".cimg"
                if fs.exists(path):
                    f = fs.open(path, "rb")
                    data = f.readAll()
                    f.close()
                    return data
            return nil
        def lock_screen():
            lock_mod.start(wm, session, {time: clock_obj.c, wallpaper: conf.lock_wallpaper ?? "aurora", shape: conf.avatar_shape,
                image: avatar_image(), read: wallpaper_loader, assets: o.assets ?? "/repo/assets"})
        wm:hotkey("ctrl+alt+l", lock_screen)
        reg:add({id: "lock", name: "Lock screen", icon: "lock", kind: "action", keywords: ["lock", "secure", "заблокировать", "блокировка"],
            run: (w) => lock_screen()})
        menu_opts = {user: tostring(session.user ?? "user"), footer: [{text: "Lock", icon: "lock", run: (w) => lock_screen()}, {text: "Log out", icon: "close", run: (w) => w:stop()}]}
        def toggle_menu():
            startmenu.toggle(wm, reg, menu_opts)
        wm.on_start = toggle_menu
        tray = tray_mod.new(wm)
        tray.clock = () => clock_obj.c
        tray:install()
        wm.on_clock = () => tray:open_clock()
        wm:hotkey("ctrl+space", toggle_menu)
        # виджеты рабочего стола: conf.widgets = [{id, x, y}], без настройки только часы справа сверху
        wlist = []
        wsrc = o.widgets ?? conf.widgets
        if type(wsrc) == "table":
            for e in wsrc:
                wlist[len(wlist) + 1] = {id: e.id, x: e.x, y: e.y}
        else:
            wlist[1] = {id: "clock"}
        def save_widgets():
            save("widgets", wlist)
        def widget_entry(id):
            for e in wlist:
                if e.id == id:
                    return e
            return nil
        # место по умолчанию: столбиком у правого края под уже стоящими
        def default_spot(spec):
            y = wm.area.y + 8
            for e in wlist:
                other = widgets_mod.find(e.id)
                if other != nil and e.id != spec.id and e.x != nil and e.x > wm.W - 140:
                    y = math.max(y, e.y + other.h + 6)
            return wm.W - spec.w - 8, y
        def start_widget(e):
            spec = widgets_mod.find(e.id)
            if spec == nil:
                return
            if e.x == nil:
                e.x, e.y = default_spot(spec)
            wm:launch(spec.main, {name: "widget " .. e.id}, [{x: e.x, y: e.y, time: clock_obj.c, spec: spec}])
        def widget_win(id):
            for w in wm.windows:
                if w.widget == id and not w.closed:
                    return w
            return nil
        def toggle_widget(id):
            e = widget_entry(id)
            if e != nil:
                w = widget_win(id)
                if w != nil:
                    wm:request_close(w)
                for i, x in wlist:
                    if x.id == id:
                        table.remove(wlist, i)
                        break
            else:
                e = {id: id}
                wlist[len(wlist) + 1] = e
                start_widget(e)
            save_widgets()
        def widget_moved(win):
            e = widget_entry(win.widget)
            if e != nil:
                e.x = win.x
                e.y = win.y
                save_widgets()
        wm.on_widget_moved = widget_moved
        def set_anim(key, v):
            wm.anim[key] = v
            save("animations", wm.anim)
        def set_wall(spec):
            wm:set_wallpaper(spec)
            save("wallpaper", spec)
        def set_widget(id, on):
            if (widget_entry(id) != nil) != on:
                toggle_widget(id)
        def widget_commands():
            out = []
            for spec in widgets_mod.CATALOG:
                on = widget_entry(spec.id) != nil
                out[len(out) + 1] = command("widget:" .. spec.id, (on and "Remove widget: " or "Add widget: ") .. spec.name, "star",
                    ["desktop", "widgets", "виджеты", "рабочий стол"], run_widget(spec.id))
            return out
        reg:provider(widget_commands)
        for e in wlist:
            start_widget(e)
        # API для приложений: всё, что трогает менеджер окон, выполняется в его процессе (wm:defer)
        def theme_names():
            out = []
            for name in theme_mod.list(wm.theme_dirs):
                th = theme_mod.find(name, wm.theme_dirs)
                out[len(out) + 1] = {name: name, display: th.display ?? name}
            return out
        def app_list():
            out = []
            for e in reg:entries():
                if (e.kind ?? "app") == "app" and e.id != "terminal" and e.id != "widgets":
                    out[len(out) + 1] = {id: e.id, name: e.name, icon: e.icon}
            return out
        def widget_list():
            out = []
            for spec in widgets_mod.CATALOG:
                out[len(out) + 1] = {id: spec.id, name: spec.name, on: widget_entry(spec.id) != nil}
            return out
        holder.api = {wm: wm, conf: conf, save: save, save_login: save_login, user: session.user,
            theme_names: theme_names, widgets: widget_list, avatars: avatar_names,
            wallpapers: () => wallpaper_mod.names(wm.wallpaper_dirs, user_wallpapers()),
            set_theme: (name) => wm:defer(() => run_theme(name)(wm)),
            set_scale: (v) => wm:defer(() => run_scale(v)(wm)),
            set_animation: (key, v) => wm:defer(() => set_anim(key, v)),
            set_wallpaper: (spec) => wm:defer(() => set_wall(spec)),
            set_panel: (change) => wm:defer(() => run_panel(change)(wm)),
            set_widget: (id, on) => wm:defer(() => set_widget(id, on)),
            lock: () => wm:defer(lock_screen), logout: () => wm:defer(logout),
            apps: () => app_list(),
            clock_conf: () => clock_obj.c != nil and clock_obj.c.conf or {},
            set_time: (partial) => wm:defer(() => clock_obj.c != nil and clock_obj.c:set_conf(partial)),
            autostart: () => type(conf.autostart) == "table" and conf.autostart or [],
            set_autostart: (list) => save("autostart", list)}
        wm:hotkey("ctrl+alt+o", panel_align)
        wm:hotkey("ctrl+alt+k", () => wm:launch(gallery.main, {name: "gallery"}))
        wm:hotkey("ctrl+alt+equals", () => zoom(1))
        wm:hotkey("ctrl+alt+minus", () => zoom(-1))
        open_terminal()
        # программы, которые пользователь велел открывать после входа (Настройки, раздел Startup): conf.autostart = [id, ...]
        if type(conf.autostart) == "table":
            for id in conf.autostart:
                e = reg:find(id)
                if e != nil and id != "terminal":
                    pcall(e.run, wm)
        sys.log("info", "desktop started for " .. tostring(session.user))
        if o.ready != nil:
            o.ready(wm)
        wm:run(sys)
        # приложения сессии закрываются вместе с ней
        for w in wm.windows:
            pcall(sys.kill, w.pid, "kill")
        pcall(() => wm.screen:close())
    return main
