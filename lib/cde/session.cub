# cde.session: рабочий стол как программа сессии после входа (вместо полноэкранного терминала)
#
#   shell = (session) => cde_session.program(session, {assets: "/repo/assets"})      для boot.new({shell: ...})
#
# Процесс сессии становится оконным менеджером (держит фокус ввода ядра), приложения запускаются его потомками с правами и видом CFS
# пользователя. Первым открывается терминал. Alt+Enter новый терминал, Ctrl+Alt+T следующая тема (пока нет настроек), F11 полный
# экран, Ctrl+Alt+= и Ctrl+Alt+- крупнее и мельче (масштаб), Ctrl+Alt+K витрина элементов cdk, Ctrl+Alt+Q выход из сессии
# (панель задач cde.panel; «Пуск» с меню на шаге 3.2). Ctrl+Alt+P панель сверху или снизу, Ctrl+Alt+L кнопки окон слева или по центру.
# Настройки пользователя $cfg/cde.conf (JSON5): theme (имя темы), scale ("auto" или 1..4); тема и масштаб, выбранные сочетаниями,
# сохраняются туда же; panel ({position, align, height, clock}, cde.panel); animations ({enabled, speed, windows, glow, widgets}, cde.fx), Ctrl+Alt+A включает и выключает анимации.
# opts: term, assets, theme, host, ready(wm) (для тестов), terminal_ready(ctx) (для тестов: ready терминала)

import cde.wm as wm_mod
import cde.terminal as terminal
import cdk.gallery as gallery
import cde.apps as apps_mod
import cde.startmenu as startmenu
import cde.tray as tray_mod
import cde.theme as theme_mod
import clock as clock_mod
import json5

const SCALES = ["auto", 1, 2, 3, 4]

export def program(session, opts=nil):
    o = opts ?? {}

    def main(sys, args):
        view = sys.view()
        conf_path = nil
        conf = {}
        if view != nil:
            conf_path = view:expand("$cfg") .. "/cde.conf"
            def read_conf():
                if view:exists(conf_path):
                    data = json5.parse(view:read(conf_path))
                    if type(data) == "table":
                        return data
                return {}
            okc, data = pcall(read_conf)
            if okc:
                conf = data
        def save(key, value):
            if conf_path == nil:
                return
            def write_conf():
                text = view:exists(conf_path) and view:read(conf_path) or "{}\n"
                view:write_atomic(conf_path, json5.patch(text, [key], value))
            okw, err = pcall(write_conf)
            if not okw:
                sys.log("warn", "desktop: cannot save " .. key .. ": " .. tostring(err))
        # часы панели: настройки времени системы (time.conf), без файла UTC
        def make_time():
            text = nil
            if view != nil:
                okr, t = pcall(view.read, view, "/cubeos/sys/cfg/time.conf")
                if okr and type(t) == "string":
                    text = t
            c = clock_mod.from_text(text ?? "{}")
            return () => c:time_text()
        panel_conf = {}
        for k, v in (type(conf.panel) == "table" and conf.panel or {}):
            panel_conf[k] = v
        if panel_conf.time_text == nil:
            okt, tt = pcall(make_time)
            if okt:
                panel_conf.time_text = tt
        panel = o.panel
        if panel == nil:
            panel = panel_conf
        wm = wm_mod.new({term: o.term, assets: o.assets ?? "/repo/assets", theme: o.theme ?? conf.theme, scale: conf.scale ?? "auto",
            animations: o.animations ?? conf.animations, panel: panel})
        term_opts = {assets: o.assets, host: o.host, ready: o.terminal_ready}
        def open_terminal():
            wm:launch(terminal.main, {name: "terminal"}, [session, term_opts])
        def logout():
            wm:stop()
        wm:hotkey("alt+enter", open_terminal)
        wm:hotkey("ctrl+alt+q", logout)
        def next_theme():
            wm:next_theme()
            save("theme", wm.theme.name)
        def zoom(dir):
            pos = 1
            for i, v in SCALES:
                if v == wm.scale_setting:
                    pos = i
            # от «auto» шаг идёт от масштаба, который сейчас на экране
            if pos == 1:
                pos = wm.scale + 1
            pos = math.max(2, math.min(len(SCALES), pos + dir))
            wm:set_scale(SCALES[pos])
            save("scale", SCALES[pos])
        wm:hotkey("ctrl+alt+t", next_theme)
        def toggle_anim():
            wm.anim.enabled = not wm.anim.enabled
            save("animations", wm.anim)
        wm:hotkey("ctrl+alt+a", toggle_anim)
        # панель: Ctrl+Alt+P сверху или снизу, Ctrl+Alt+L кнопки окон слева или по центру (потом «Настройки»)
        def save_panel():
            save("panel", {position: wm.panel.position, align: wm.panel.align, height: wm.panel.height})
        def panel_position():
            if wm.panel != nil:
                wm:set_panel({position: wm.panel.position == "top" and "bottom" or "top"})
                save_panel()
        def panel_align():
            if wm.panel != nil:
                wm:set_panel({align: wm.panel.align == "center" and "left" or "center"})
                save_panel()
        wm:hotkey("ctrl+alt+p", panel_position)
        # каталог для меню «Пуск»: приложения и команды (темы, масштаб, панель, анимации, выход)
        reg = apps_mod.new()
        reg:add({id: "terminal", name: "Terminal", icon: "terminal", keywords: ["console", "shell", "cmd", "терминал", "консоль", "термінал"],
            run: (w) => open_terminal()})
        reg:add({id: "widgets", name: "Widget gallery", icon: "cube", keywords: ["cdk", "controls", "ui", "виджеты", "элементы"],
            run: (w) => w:launch(gallery.main, {name: "gallery"})})
        def logout_entry():
            return {id: "logout", name: "Log out", icon: "close", kind: "action", keywords: ["exit", "quit", "sign out", "выход", "выйти"],
                run: (w) => w:stop()}
        def run_theme(name):
            def run(w):
                w:set_theme(name)
                save("theme", name)
            return run
        def run_scale(v):
            def run(w):
                w:set_scale(v)
                save("scale", v)
            return run
        def run_panel(change):
            def run(w):
                w:set_panel(change)
                save_panel()
            return run
        def command(id, name, icon, words, run):
            return {id: id, name: name, icon: icon, kind: "action", keywords: words, run: run}
        def commands():
            out = []
            for name in theme_mod.list(wm.theme_dirs):
                th = theme_mod.find(name, wm.theme_dirs)
                out[len(out) + 1] = command("theme:" .. name, "Theme: " .. (th.display ?? name), "star",
                    ["colors", "dark", "light", "тема", "цвета"], run_theme(name))
            for v in SCALES:
                out[len(out) + 1] = command("scale:" .. tostring(v), "Scale: " .. (v == "auto" and "Auto" or v .. "x"), "search",
                    ["zoom", "size", "масштаб"], run_scale(v))
            if wm.panel != nil:
                words = ["taskbar", "панель"]
                out[len(out) + 1] = command("panel:top", "Panel at the top", "gear", words, run_panel({position: "top"}))
                out[len(out) + 1] = command("panel:bottom", "Panel at the bottom", "gear", words, run_panel({position: "bottom"}))
                out[len(out) + 1] = command("panel:center", "Panel buttons in the center", "gear", words, run_panel({align: "center"}))
                out[len(out) + 1] = command("panel:left", "Panel buttons on the left", "gear", words, run_panel({align: "left"}))
            out[len(out) + 1] = command("anim", "Animations: " .. (wm.anim.enabled and "turn off" or "turn on"), "play",
                ["effects", "анимации"], (w) => toggle_anim())
            out[len(out) + 1] = logout_entry()
            return out
        reg:provider(commands)
        menu_opts = {user: tostring(session.user ?? "user"), footer: [{text: "Log out", icon: "close", run: (w) => w:stop()}]}
        def toggle_menu():
            startmenu.toggle(wm, reg, menu_opts)
        wm.on_start = toggle_menu
        tray_mod.new(wm):install()
        wm:hotkey("ctrl+space", toggle_menu)
        wm:hotkey("ctrl+alt+l", panel_align)
        wm:hotkey("ctrl+alt+k", () => wm:launch(gallery.main, {name: "gallery"}))
        wm:hotkey("ctrl+alt+equals", () => zoom(1))
        wm:hotkey("ctrl+alt+minus", () => zoom(-1))
        open_terminal()
        sys.log("info", "desktop started for " .. tostring(session.user))
        if o.ready != nil:
            o.ready(wm)
        wm:run(sys)
        # приложения сессии закрываются вместе с ней
        for w in wm.windows:
            pcall(sys.kill, w.pid, "kill")
        pcall(() => wm.screen:close())
    return main
