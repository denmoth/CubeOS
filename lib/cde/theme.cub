# cde.theme: темы рабочего стола (файлы .theme в JSON5), палитра экрана и вид окон
#
#   th = theme.find("tokyo-night", ["/repo/assets/themes"])    файл темы (неизвестное поле берётся из tokyo-night)
#   pal = theme.palette(th)            палитра cgl на 256 цветов для cgl.open({palette: pal})
#   d = theme.deco(th, font)           размеры рамки окна: заголовок, радиус углов, кнопки, тень
#   dim = theme.dim_map(pal, 0.55)     номер цвета -> номер того же цвета потемнее (тени окон)
#
# Раскладка палитры (одна на весь экран, её видят все приложения; приложения берут цвета через ближайший цвет, cde.app.rgb):
#   0..15     16 цветов CC в тонах темы (белый, оранжевый, ... чёрный): текстовые окна и программы, рисующие цветами CC
#   16..31    16 серых от почти чёрного до почти белого
#   32..211   общие цвета: 12 оттенков x 3 насыщенности x 5 яркостей (в том числе тёмные тона, которых нет в кубе 6x6x6)
#   212..215  свободные места для приложений (win:alloc_colors), вместе с 248..255
#   216..223  обои (8 ступеней)
#   224..231  градиент заголовка активного окна (8 ступеней)
#   232..247  цвета интерфейса (роли ниже), 248..255 свободные места для приложений (анимации палитрой)
#
# Файл темы (assets/themes/*.theme, свои в $cfg/themes):
#   {name, display, dark, text: [16 цветов CC], desk: [ступени обоев], title_active: "#hex" или [цвета градиента], роли...,
#    window: {buttons: "right" | "left", order: ["min", "max", "close"], style: "win" | "mac" | "kde", radius: 0..4, border: true,
#             title_height: 12, title_align: "left" | "center", shadow: 0..3, shadow_strength: 0.55}}

import cgl.color as color
import json5

export const DESK0 = 216
export const DESK_N = 8
export const GRAD0 = 224
export const GRAD_N = 8
export const WIN_BG = 232
export const TITLE_INACTIVE = 233
export const TITLE_TEXT = 234
export const TITLE_DIM = 235
export const BORDER_ACTIVE = 236
export const BORDER_INACTIVE = 237
export const CLOSE = 238
export const BUTTON_DOWN = 239
export const ACCENT = 240
export const PREVIEW = 241
export const DESK_LINE = 242
export const DESK_GLOW = 243
export const BTN_CLOSE = 244
export const BTN_MIN = 245
export const BTN_MAX = 246
# сплошной цвет активного заголовка (середина градиента): значки, подложки
export const TITLE_ACTIVE = 247
export const SPARE0 = 248
export const GRAY0 = 16
export const GENERAL0 = 32
# свободные места палитры, которые приложения берут себе (win:alloc_colors) и меняют на ходу (анимации палитрой)
export const POOL = [212, 213, 214, 215, 248, 249, 250, 251, 252, 253, 254, 255]

const HUES = 12
const SATS = [0.35, 0.65, 1]
const VALS = [0.22, 0.4, 0.58, 0.77, 0.96]

const ROLES = ["win_bg", "title_inactive", "title_text", "title_dim", "border_active", "border_inactive", "close", "button_down",
    "accent", "preview", "desk_line", "desk_glow", "btn_close", "btn_min", "btn_max"]

const WINDOW_DEFAULTS = {buttons: "right", order: ["min", "max", "close"], style: "win", radius: 2, border: true, title_height: 12,
    title_align: "left", shadow: 2, shadow_strength: 0.55}

# встроенная тема: запасной вариант, если файлов нет, и значения для полей, которых нет в файле
const BUILTIN = {
    name: "tokyo-night",
    display: "Tokyo Night",
    dark: true,
    text: ["#c0caf5", "#ff9e64", "#bb9af7", "#7dcfff", "#e0af68", "#9ece6a", "#f7a8c8", "#414868", "#787c99", "#2ac3de",
        "#9d7cd8", "#7aa2f7", "#b4916a", "#73daca", "#f7768e", "#16161e"],
    desk: ["#11121a", "#161825", "#1b1e30", "#20253c", "#262c48", "#2d3456", "#353d66", "#3f4878"],
    title_active: ["#2a3050", "#24283b"],
    win_bg: "#1a1b26", title_inactive: "#1c1e2b", title_text: "#c0caf5", title_dim: "#565f89",
    border_active: "#7aa2f7", border_inactive: "#2f344d", close: "#f7768e", button_down: "#3b4261", accent: "#7aa2f7",
    preview: "#bb9af7", desk_line: "#3d4670", desk_glow: "#7aa2f7", btn_close: "#f7768e", btn_min: "#e0af68", btn_max: "#9ece6a",
    window: WINDOW_DEFAULTS
}

def _merge(base, over):
    out = {}
    for k, v in base:
        out[k] = v
    if type(over) == "table":
        for k, v in over:
            if k == "window":
                win = {}
                for wk, wv in base.window:
                    win[wk] = wv
                if type(v) == "table":
                    for wk, wv in v:
                        win[wk] = wv
                out.window = win
            else:
                out[k] = v
    return out

# тема из текста файла (JSON5); недостающие поля из встроенной
export def parse(text):
    data = json5.parse(text)
    if type(data) != "table":
        raise Error("a theme file must be an object")
    return _merge(BUILTIN, data)

def _read(path):
    if not fs.exists(path):
        return nil
    h = fs.open(path, "r")
    if h == nil:
        return nil
    text = h.readAll()
    h.close()
    return text

# тема по имени из папок dirs (первая найденная); без файла встроенная (её имя tokyo-night)
export def find(name=nil, dirs=nil, reader=nil):
    rd = reader ?? _read
    for d in dirs ?? []:
        text = rd(d .. "/" .. (name ?? "tokyo-night") .. ".theme")
        if text != nil:
            ok, th = pcall(parse, text)
            if ok:
                return th
    return _merge(BUILTIN, nil)

# имена тем в папках (без повторов, по алфавиту)
export def list(dirs, lister=nil):
    seen = {}
    out = []
    for d in dirs ?? []:
        ok, files = pcall(lister ?? fs.list, d)
        if ok and files != nil:
            for f in files:
                n = string.match(f, "^(.+)%.theme$")
                if n != nil and not seen[n]:
                    seen[n] = true
                    out[len(out) + 1] = n
    table.sort(out)
    return out

# старое имя: тема без файлов (тесты, демо)
export def get(name=nil):
    return _merge(BUILTIN, nil)

def _set_hex(p, index, hex):
    r, g, b = color.parse_hex(hex)
    p:set(index, r, g, b)

# список цветов (строка или список строк) -> n ступеней [r, g, b]
def _steps(value, n):
    stops = []
    list_ = type(value) == "table" and value or [value]
    for hex in list_:
        r, g, b = color.parse_hex(hex)
        stops[len(stops) + 1] = [r, g, b]
    if len(stops) == 1:
        stops[2] = stops[1]
    out = []
    count = len(stops)
    for i in range[0, n - 1]:
        pos = n == 1 and 0 or i / (n - 1) * (count - 1)
        k = math.min(math.floor(pos), count - 2)
        a = stops[k + 1]
        b = stops[k + 2]
        t = pos - k
        r, g, bl = color.lerp_rgb(a[1], a[2], a[3], b[1], b[2], b[3], t)
        out[i + 1] = [r, g, bl]
    return out

# общие цвета 16..211: серые и оттенки по кругу (одинаковые во всех темах)
def _general(p):
    for i in range[0, 15]:
        level = math.floor(10 + i * 235 / 15 + 0.5)
        p:set(GRAY0 + i, level, level, level)
    n = GENERAL0
    for hi in range[0, HUES - 1]:
        for sat in SATS:
            for val in VALS:
                r, g, b = color.hsv_to_rgb(hi * 360 / HUES, sat, val)
                p:set(n, r, g, b)
                n += 1

# палитра рабочего стола: цвета CC в тонах темы, общие цвета, цвета интерфейса
export def palette(th):
    p = color.default_palette()
    _general(p)
    for i in range[0, 15]:
        _set_hex(p, i, th.text[i + 1])
    for i, c in _steps(th.desk, DESK_N):
        p:set(DESK0 + i - 1, c[1], c[2], c[3])
    grad = _steps(th.title_active, GRAD_N)
    for i, c in grad:
        p:set(GRAD0 + i - 1, c[1], c[2], c[3])
    mid = grad[math.floor(GRAD_N / 2) + 1]
    p:set(TITLE_ACTIVE, mid[1], mid[2], mid[3])
    for i, role in ROLES:
        _set_hex(p, WIN_BG + i - 1, th[role])
    for i in POOL:
        _set_hex(p, i, th.win_bg)
    return p

# список [номер, r, g, b] для screen:set_colors: смена темы на ходу (пиксели не перерисовываются)
export def entries(th):
    p = palette(th)
    out = []
    for i in range[0, 255]:
        r, g, b = p:get(i)
        out[len(out) + 1] = [i, r, g, b]
    return out

# градиент заголовка одним цветом (тогда рисуется заливкой)
export def solid_title(th):
    return type(th.title_active) != "table" or len(th.title_active) < 2 or th.title_active[1] == th.title_active[len(th.title_active)]

# ширина кнопки заголовка по стилю
export def button_w(style):
    if style == "mac":
        return 11
    return 13

# размеры рамки окна по теме и шрифту
export def deco(th, font):
    w = th.window
    title = math.max(font.height + 3, math.floor(tonumber(w.title_height) ?? 12))
    return {title: title, radius: math.max(0, math.min(4, math.floor(tonumber(w.radius) ?? 2))), border: w.border != false,
        shadow: math.max(0, math.min(3, math.floor(tonumber(w.shadow) ?? 2))), shadow_strength: tonumber(w.shadow_strength) ?? 0.55,
        side: w.buttons == "left" and "left" or "right", order: w.order ?? ["min", "max", "close"], style: w.style ?? "win",
        align: w.title_align == "center" and "center" or "left", bw: button_w(w.style), solid: solid_title(th)}

# сколько пикселей срезано скруглением в строке i от края (i с нуля), радиус r
const CORNERS = [[1], [2, 1], [3, 1, 1], [4, 2, 1, 1]]

export def corner_inset(r, i):
    if r <= 0 or i >= r:
        return 0
    return CORNERS[r][i + 1]

# номер цвета -> номер ближайшего к тому же цвету, умноженному на factor (тени, затемнение под диалогом)
export def dim_map(p, factor=0.55):
    map = {}
    for i in range[0, 255]:
        r, g, b = p:get(i)
        map[i] = p:nearest(math.floor(r * factor), math.floor(g * factor), math.floor(b * factor))
    return map
