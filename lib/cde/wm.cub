# cde.wm: оконный менеджер рабочего стола. Работает в процессе ядра (сессия CDE), держит фокус ввода ядра и раздаёт ввод окнам.
#
#   wm = cde.wm.new({term: term, assets: "/repo/assets", theme: "tokyo-night"})
#   wm:launch(program, {name: "clock"}, args)      program(sys, ctx): процесс ядра, потомок менеджера; окно: cde.app.open(sys, ctx, {...})
#   wm:hotkey("alt+enter", () => ...)              своё сочетание (поверх стандартных)
#   kernel:spawn((sys, a) => wm:run(sys), [], {name: "cde", ui: true})
#
# Мышь: клик поднимает окно и даёт ему фокус; заголовок тянет окно (у края экрана рамка предпросмотра: вверх на весь экран,
# влево и вправо половинки), двойной клик по заголовку разворачивает; края и углы меняют размер; кнопки свернуть, развернуть,
# закрыть. Колесо идёт окну под мышью. Клавиши (D249): Alt+←/→ предыдущее и следующее окно, Alt+↑ развернуть, Alt+↓ вернуть
# или свернуть, Alt+Shift+←/→ половинки, Ctrl+T закрыть окно (удержание Ctrl+T закрывает принудительно), Alt+D рабочий стол,
# одиночное нажатие левого Alt вызывает on_start («Пуск», шаг 3).
#
# Окну приходят события (последний аргумент номер окна):
#   key(код, held, id), key_up(код, id), char(символ, id), paste(текст, id)
#   mouse_click/mouse_drag/mouse_up(кнопка, x, y, id), mouse_scroll(направление, x, y, id): у пиксельного окна x, y это пиксели
#     содержимого с нуля, у текстового клетки с единицы (как в терминале CC)
#   win_resize(ширина, высота, id): пиксели или столбцы и строки; win.canvas уже новая поверхность, нарисовать заново
#   win_close(id): просьба закрыть (кнопка ×, Ctrl+T); win_focus(id), win_blur(id); win_theme(имя темы, id): тема сменилась

import cgl
import font as font_lib
import cde.theme as theme
import cde.window as window_mod
import cde.compositor as comp_mod
import cde.wallpaper as wallpaper_mod
import cde.fx as fx_mod
import cde.panel as panel_mod

const WM_EVENTS = ["key", "key_up", "char", "paste", "mouse_click", "mouse_drag", "mouse_up", "mouse_scroll", "terminate",
    "term_resize", "monitor_resize", "monitor_touch", "cubeos_cde"]
# автоматический масштаб: сколько логических пикселей нужно на одну единицу масштаба (306x171 это 1x, монитор 984x729 это 2x)
const AUTO_W = 420
const AUTO_H = 240
const MAX_SCALE = 4
export const APP_EVENTS = ["key", "key_up", "char", "paste", "mouse_click", "mouse_drag", "mouse_up", "mouse_scroll",
    "win_resize", "win_close", "win_focus", "win_blur", "win_theme"]
# полоса у края окна, за которую меняют размер (пикселей внутрь и наружу)
const GRIP = 2
const DOUBLE_MS = 450
const BLINK_MS = 500
const REAP_MS = 1000

def _now_ms():
    return os.epoch("utc")

export class WM:
    # opts: term, screen (готовый экран cgl; иначе cgl.open), assets (папка со шрифтами и темами), font, theme (имя темы или
    #       таблица темы), theme_dirs (папки с файлами .theme; по умолчанию assets/themes), wallpaper (поверхность), clock (мс),
    #       on_start (левый Alt), scale ("auto" или 1..4: во сколько раз крупнее; логический экран = экран / масштаб),
    #       animations ({enabled, speed, windows, glow, widgets}, cde.fx), panel (настройки панели задач, cde.panel; без неё панели нет)
    def init(self, opts=nil):
        o = opts ?? {}
        assets = o.assets ?? "/repo/assets"
        self.theme_dirs = o.theme_dirs ?? [assets .. "/themes"]
        self.theme = type(o.theme) == "table" and o.theme or theme.find(o.theme, self.theme_dirs)
        self.palette = theme.palette(self.theme)
        if o.screen != nil:
            self.screen = o.screen
            self.screen:set_colors(theme.entries(self.theme))
            self.palette = self.screen.palette
        else:
            open_opts = {palette: self.palette}
            if o.term != nil:
                open_opts.term = o.term
            self.screen = cgl.open(open_opts)
        self.font = o.font ?? font_lib.default(assets)
        self.deco = theme.deco(self.theme, self.font)
        self.scale_setting = o.scale ?? "auto"
        self.scale = self:pick_scale(self.scale_setting)
        self.W = math.floor(self.screen.w / self.scale)
        self.H = math.floor(self.screen.h / self.scale)
        # обои: background (имя или {name, mode}, см. cde.wallpaper), wallpaper_dirs (папки с картинками .cimg), wallpaper_loader(имя)
        # (текст файла или nil: пользовательские папки), wallpaper_fn(w, h) (своя поверхность, для тестов и демо)
        self.clock = o.clock ?? _now_ms
        self.background = o.background ?? "cube"
        self.wallpaper_dirs = o.wallpaper_dirs ?? [assets .. "/wallpapers"]
        self.wallpaper_loader = o.wallpaper_loader
        self.wallpaper_fn = o.wallpaper_fn
        self.wall_owner = {}
        self.live = nil
        self.comp = comp_mod.new(self.screen, self.font, {wallpaper: o.wallpaper, deco: self.deco, scale: self.scale})
        self.windows = self.comp.windows
        self.anim = fx_mod.make_settings(o.animations)
        self.fx = fx_mod.new(self)
        self.comp.fx = self.fx
        # панель задач и рабочая область (экран без панели)
        self.panel = nil
        if o.panel != nil and o.panel != false:
            self.panel = panel_mod.new(self, o.panel == true and {} or o.panel)
            self.comp.panel = self.panel
        self.area = self:_work_area()
        # свободные места палитры для приложений: номер -> окно, которое его взяло
        self.pool_free = []
        for slot in theme.POOL:
            self.pool_free[len(self.pool_free) + 1] = slot
        self.owned = {}
        self.comp.wallpaper = o.wallpaper ?? self:_wallpaper_surface()
        self.focused = nil
        self.next_id = 1
        self.pending = []
        self.to_launch = []
        self.deferred = []
        self.hotkeys = {}
        self.mods = {}
        self.drag = nil
        self.last_click = nil
        self.alt_tap = false
        self.swallow_char = nil
        self.hidden = nil
        self.sys = nil
        self.pid = nil
        self.on_start = o.on_start
        self.running = false
        self.waiting = false
        self.wake_sent = false
        self.next_blink = 0
        self.next_reap = 0
        self.cascade = 0
        self.exits = []
        self.co = nil
        self:_default_hotkeys()

    # ------------------------------------------------------------ приложения

    # запускает приложение процессом ядра (потомком менеджера). program(sys, ctx): ctx.wm, ctx.args. Вне процесса менеджера
    # (до run или из чужого кода) запуск ставится в очередь и выполняется на ближайшем проходе менеджера
    def launch(self, program, opts=nil, args=nil):
        self.to_launch[len(self.to_launch) + 1] = {program: program, opts: opts ?? {}, args: args ?? []}
        if self.running and coroutine.running() == self.co:
            self:_spawn_pending()

    # выполнить fn в процессе менеджера на ближайшем проходе (из приложений: смена темы, панели, выход; вызовы ядра и события окнам
    # работают только отсюда)
    def defer(self, fn):
        self.deferred[len(self.deferred) + 1] = fn
        self:_wake(nil)

    def _spawn_pending(self):
        list = self.to_launch
        self.to_launch = []
        for entry in list:
            self:_spawn(entry)

    def _spawn(self, entry):
        let me = self
        ctx = {wm: self, args: entry.args}
        prog = entry.program
        def app_main(sys, a):
            app_ok, app_err = pcall(prog, sys, a[1])
            me:_app_exited(sys.getpid(), app_ok, app_err)
        ok, res = pcall(self.sys.spawn, app_main, [ctx], {name: entry.opts.name ?? "app"})
        if not ok:
            self:_log("error", "cannot start " .. tostring(entry.opts.name) .. ": " .. tostring(res))

    # процесс приложения закончился (сам или с ошибкой): его окна закрываются
    def _app_exited(self, pid, ok, err):
        for w in self.windows:
            if w.pid == pid:
                w.closed = true
        for w in self.pending:
            if w.pid == pid:
                w.closed = true
        if not ok:
            self.exits[len(self.exits) + 1] = {pid: pid, err: tostring(err)}
            pcall(self.sys.log, "error", "app " .. pid .. " crashed: " .. tostring(err))
        self:_wake(nil)

    def _log(self, level, text):
        if self.sys != nil:
            pcall(self.sys.log, level, text)

    # ------------------------------------------------------------ вызовы из окон (из процессов приложений)

    def _new_window(self, pid, opts):
        id = self.next_id
        self.next_id = id + 1
        win = window_mod.new(self, id, pid, opts)
        win.placed = opts != nil and opts.x != nil
        self.pending[len(self.pending) + 1] = win
        self:_wake(win)
        return win

    # будит менеджер, если он ждёт событий (иначе он и так увидит изменения на следующем проходе)
    def _wake(self, win):
        if self.waiting and not self.wake_sent and self.sys != nil and coroutine.running() != self.co:
            self.wake_sent = true
            pcall(self.sys.post, self.pid, "cubeos_cde")

    # n мест палитры окну (список номеров) или nil, если свободных столько нет
    def _alloc(self, win, n):
        if n <= 0 or n > len(self.pool_free):
            return nil
        list = []
        for i in range[1, n]:
            slot = table.remove(self.pool_free, 1)
            self.owned[slot] = win
            list[i] = slot
        return list

    # меняет цвета своих мест палитры: список [номер, r, g, b]; чужие номера пропускаются
    def _set_colors(self, win, list):
        mine = []
        for e in list:
            if self.owned[e[1]] == win:
                mine[len(mine) + 1] = e
        if len(mine) > 0:
            self.screen:set_colors(mine)
        return len(mine)

    # окно закрыто: его места палитры свободны и снова цвета фона темы
    def _free_colors(self, win):
        back = []
        r, g, b = theme.palette(self.theme):get(theme.WIN_BG)
        for slot, owner in self.owned:
            if owner == win:
                back[len(back) + 1] = slot
        for slot in back:
            self.owned[slot] = nil
            self.pool_free[len(self.pool_free) + 1] = slot
        if len(back) > 0:
            table.sort(self.pool_free)
            entries = []
            for slot in back:
                entries[len(entries) + 1] = [slot, r, g, b]
            self.screen:set_colors(entries)

    def _title_changed(self, win):
        win.title_dirty = true
        self:_wake(win)

    def _client_wait(self, win, timeout, extra):
        filter = APP_EVENTS
        if extra != nil:
            filter = []
            for n in APP_EVENTS:
                filter[len(filter) + 1] = n
            for n in extra:
                filter[len(filter) + 1] = n
        res = table.pack(self.sys.wait_event(filter, timeout))
        return unpack(res, 1, res.n)

    # ------------------------------------------------------------ главный цикл

    def run(self, sys):
        self.sys = sys
        self.pid = sys.getpid()
        self.co = coroutine.running()
        self.running = true
        self.comp:damage_all()
        now = self.clock()
        self.next_reap = now + REAP_MS
        self.next_blink = now + BLINK_MS
        self:_spawn_pending()
        while self.running:
            self:service()
            # флаг ожидания ставится до проверки: окно, нарисованное после неё, разбудит менеджер событием
            self.waiting = true
            self.wake_sent = false
            if not self:_has_work():
                ev = table.pack(sys.wait_event(WM_EVENTS, self:_timeout()))
                self.waiting = false
                if ev[1] != nil:
                    self:handle(ev)
            self.waiting = false
            self:_timers()
        self.running = false

    def stop(self):
        self.running = false

    def _has_work(self):
        if len(self.pending) > 0 or len(self.to_launch) > 0 or len(self.deferred) > 0 or len(self.comp.rects) > 0:
            return true
        for w in self.windows:
            if w.wake_pending or w.closed or w.title_dirty:
                return true
        return false

    def _timeout(self):
        now = self.clock()
        until = self.next_reap
        if self:_blinking() and self.next_blink < until:
            until = self.next_blink
        # идёт анимация: кадр каждые 50 мс (20 кадров, как обновляется экран CC)
        if self.fx:active() and now + 50 < until:
            until = now + 50
        if self.live != nil and self.live.next < until:
            until = math.max(now, self.live.next)
        if self.panel != nil and self.panel.next_tick < until:
            until = math.max(now, self.panel.next_tick)
        return math.max(0, until - now) / 1000

    def _blinking(self):
        f = self.focused
        return f != nil and f.kind == "text" and f.cursor_on and f:visible()

    def _timers(self):
        now = self.clock()
        if now >= self.next_blink:
            self.next_blink = now + BLINK_MS
            f = self.focused
            if self:_blinking():
                f:_blink(not f.blink)
        if now >= self.next_reap:
            self.next_reap = now + REAP_MS
            self:_reap()
        if self.panel != nil:
            self.panel:tick(now)
        if self.live != nil and now >= self.live.next:
            self.live:step(now, self.anim.speed)
        if self.fx:active():
            self.fx:step()

    # окна процессов, которых больше нет (убиты, упали мимо обёртки)
    def _reap(self):
        if self.sys == nil or len(self.windows) == 0:
            return
        ok, list = pcall(self.sys.ps)
        if not ok or list == nil:
            return
        alive = {}
        for p in list:
            alive[p.pid] = true
        for w in self.windows:
            if not alive[w.pid]:
                w.closed = true

    # один проход: новые окна, закрытые окна, нарисованное приложениями, сборка кадра
    def service(self):
        if len(self.deferred) > 0:
            list = self.deferred
            self.deferred = []
            for fn in list:
                ok, err = pcall(fn)
                if not ok:
                    self:_log("error", "deferred call failed: " .. tostring(err))
        if len(self.to_launch) > 0 and self.sys != nil:
            self:_spawn_pending()
        if len(self.pending) > 0:
            list = self.pending
            self.pending = []
            for win in list:
                if not win.closed:
                    self:_place(win)
        i = 1
        while i <= len(self.windows):
            w = self.windows[i]
            if w.closed:
                self.comp:damage_window(w)
                self.fx:close(w)
                self:_free_colors(w)
                table.remove(self.windows, i)
                if self.focused == w:
                    self:_set_focus(self:_topmost())
                if self.drag != nil and self.drag.win == w:
                    self.drag = nil
                    self.comp:set_preview(nil)
            else:
                if w.title_dirty:
                    w.title_dirty = false
                    self:_damage_title(w)
                if len(w.requests) > 0:
                    reqs = w.requests
                    w.requests = []
                    for rq in reqs:
                        self:_request(w, rq)
                cv = w.canvas
                if cv.dx0 <= cv.dx1 and cv.dy0 <= cv.dy1:
                    if w:visible():
                        self.comp:damage(w:content_x() + cv.dx0, w:content_y() + cv.dy0, cv.dx1 - cv.dx0 + 1, cv.dy1 - cv.dy0 + 1)
                    cv:clean()
                w.wake_pending = false
                i += 1
        if self.panel != nil:
            self.panel:update()
        self.comp:compose()

    def _damage_title(self, w):
        l, t, r, b = w:insets()
        if t > 0:
            self.comp:damage(w.x, w.y, w.w, t)

    # просьба окна (свой заголовок, кнопки приложения): min, max, full, normal
    def _request(self, win, action):
        if action == "min":
            self:minimize(win)
        elif action == "max":
            self:toggle_max(win)
        elif action == "full":
            self:toggle_full(win)
        elif action == "normal":
            self:set_state(win, "normal")

    # новое окно: место (лесенкой от центра, если приложение не задало), поверх всех, фокус
    def _place(self, win):
        if not win.placed:
            win.x, win.y = self:_smart_spot(win.w, win.h)
        win.canvas:clean()
        self.windows[len(self.windows) + 1] = win
        self.comp:damage_window(win)
        self:_set_focus(win)
        self.fx:open(win)

    # место для нового окна (как «умная» расстановка KDE): из точек сетки выбирается та, где окно меньше всего закрывает видимые
    # окна; при равенстве ближе к центру экрана
    def _smart_spot(self, w, h):
        a = self.area
        max_x = a.x + math.max(0, a.w - w)
        max_y = a.y + math.max(0, a.h - h)
        cx = (a.x + max_x) / 2
        cy = (a.y + max_y) / 2
        best_x = math.floor(cx)
        best_y = math.floor(cy)
        best = nil
        step = 8
        others = []
        for o in self.windows:
            if o:visible():
                others[len(others) + 1] = o
        y = a.y
        while y <= max_y:
            x = a.x
            while x <= max_x:
                overlap = 0
                for o in others:
                    ox = math.max(0, math.min(x + w, o.x + o.w) - math.max(x, o.x))
                    oy = math.max(0, math.min(y + h, o.y + o.h) - math.max(y, o.y))
                    overlap += ox * oy
                score = overlap * 1000 + (x - cx) * (x - cx) + (y - cy) * (y - cy)
                if best == nil or score < best:
                    best = score
                    best_x = x
                    best_y = y
                x = x == max_x and max_x + 1 or math.min(max_x, x + step)
            y = y == max_y and max_y + 1 or math.min(max_y, y + step)
        return best_x, best_y

    # ------------------------------------------------------------ фокус и порядок

    def _topmost(self):
        for i in range[len(self.windows), 1] step -1:
            w = self.windows[i]
            # окно, которое сейчас проявляется или возвращается из свёрнутого (fx_hidden), тоже на экране
            if w:visible_raw() and not w.closed:
                return w
        return nil

    def _raise(self, win):
        for i, w in self.windows:
            if w == win:
                if i != len(self.windows):
                    table.remove(self.windows, i)
                    self.windows[len(self.windows) + 1] = win
                    self.comp:damage_window(win)
                return

    # события окнам шлёт только сам процесс менеджера (вызов ядра из чужого места ушёл бы не туда)
    def _post(self, win, name, a, b, c):
        if self.sys == nil or win == nil or win.closed or coroutine.running() != self.co:
            return
        if c != nil:
            pcall(self.sys.post, win.pid, name, a, b, c, win.id)
        elif b != nil:
            pcall(self.sys.post, win.pid, name, a, b, win.id)
        elif a != nil:
            pcall(self.sys.post, win.pid, name, a, win.id)
        else:
            pcall(self.sys.post, win.pid, name, win.id)

    def _set_focus(self, win):
        old = self.focused
        if win != nil:
            self:_raise(win)
        if old == win:
            return
        self.focused = win
        self.comp.focused = win
        if old != nil and not old.closed:
            self:_damage_title(old)
            old:_blink(true)
            self:_post(old, "win_blur")
        if win != nil:
            self.comp:damage_window(win)
            self.fx:focus_glow(win)
            self.next_blink = self.clock() + BLINK_MS
            win:_blink(true)
            self:_post(win, "win_focus")

    def focus(self, win):
        if win.minimized:
            win.minimized = false
            self.comp:damage_window(win)
            self.fx:unminimize(win)
        self:_set_focus(win)

    # следующее (dir 1) или предыдущее (-1) окно по порядку открытия, свёрнутые разворачиваются
    def cycle(self, dir):
        list = []
        for w in self.windows:
            if not w.closed:
                list[len(list) + 1] = w
        if len(list) == 0:
            return
        table.sort(list, (a, b) => a.id < b.id)
        pos = 0
        for i, w in list:
            if w == self.focused:
                pos = i
        n = len(list)
        nxt = pos + dir
        if pos == 0:
            nxt = dir > 0 and 1 or n
        if nxt < 1:
            nxt = n
        if nxt > n:
            nxt = 1
        self:focus(list[nxt])

    # ------------------------------------------------------------ состояния окна

    # рабочая область: экран без панели задач
    def _work_area(self):
        if self.panel != nil:
            return self.panel:work_area()
        return {x: 0, y: 0, w: self.W, h: self.H}

    # прямоугольник для состояния: max, left, right (в рабочей области), full (весь экран)
    def area_for(self, state):
        a = self.area
        half = math.floor(a.w / 2)
        if state == "full":
            return {x: 0, y: 0, w: self.W, h: self.H}
        if state == "max":
            return {x: a.x, y: a.y, w: a.w, h: a.h}
        if state == "left":
            return {x: a.x, y: a.y, w: half, h: a.h}
        if state == "right":
            return {x: a.x + half, y: a.y, w: a.w - half, h: a.h}
        return nil

    # animate = false: без анимации (окно тянут мышью)
    def set_state(self, win, state, animate=true):
        # окно постоянного размера не разворачивается и не прилипает (полный экран можно)
        if not win.resizable and state != "normal" and state != "full":
            return
        if win.minimized:
            win.minimized = false
        if state == win.state:
            self.comp:damage_window(win)
            return
        if win.state == "normal":
            win.normal = {x: win.x, y: win.y, w: win.w, h: win.h}
        r = self:area_for(state)
        if r == nil:
            r = win.normal ?? {x: win.x, y: win.y, w: win.w, h: win.h}
            state = "normal"
        old = {x: win.x, y: win.y, w: win.w, h: win.h}
        snap = (animate and win:visible() and self.anim.enabled) and self.fx:snapshot(win) or nil
        win.state = state
        self:move_resize(win, r.x, r.y, r.w, r.h)
        if snap != nil:
            self.fx:morph(win, old, snap)

    def toggle_max(self, win):
        if win.state == "max":
            self:set_state(win, "normal")
        else:
            self:set_state(win, "max")

    # F11: полный экран без рамки и повторно обратно (к тому состоянию, что было до него)
    def toggle_full(self, win):
        if win.state == "full":
            back = win.before_full ?? "normal"
            if back == "normal":
                old = {x: win.x, y: win.y, w: win.w, h: win.h}
                snap = (win:visible() and self.anim.enabled) and self.fx:snapshot(win) or nil
                win.state = "normal"
                r = win.normal ?? {x: win.x, y: win.y, w: win.w, h: win.h}
                self:move_resize(win, r.x, r.y, r.w, r.h)
                if snap != nil:
                    self.fx:morph(win, old, snap)
            else:
                self:set_state(win, back)
        else:
            win.before_full = win.state
            self:set_state(win, "full")

    def minimize(self, win):
        if win.minimized:
            return
        snap = (win:visible() and self.anim.enabled) and self.fx:snapshot(win) or nil
        win.minimized = true
        self.comp:damage_window(win)
        if snap != nil:
            self.fx:minimize(win, snap)
        if self.focused == win:
            self:_set_focus(nil)
            top = self:_topmost()
            if top != nil:
                self:_set_focus(top)

    # Alt+D: свернуть всё, повторно вернуть как было
    def toggle_desktop(self):
        if self.hidden != nil:
            list = self.hidden
            self.hidden = nil
            for w in list:
                if not w.closed and w.minimized:
                    w.minimized = false
                    self.comp:damage_window(w)
                    self.fx:unminimize(w)
            top = self:_topmost()
            if top != nil:
                self:_set_focus(top)
            return
        self.hidden = []
        for w in self.windows:
            if w:visible():
                self.hidden[len(self.hidden) + 1] = w
                snap = self.anim.enabled and self.fx:snapshot(w) or nil
                w.minimized = true
                self.comp:damage_window(w)
                if snap != nil:
                    self.fx:minimize(w, snap)
        self:_set_focus(nil)

    def request_close(self, win):
        if win != nil:
            self:_post(win, "win_close")

    # принудительно: процесс окна убивается, все его окна закрываются
    def force_close(self, win):
        if win == nil:
            return
        if self.sys != nil and coroutine.running() == self.co:
            pcall(self.sys.kill, win.pid, "kill")
        for w in self.windows:
            if w.pid == win.pid:
                w.closed = true

    # новое место и размер (внешний прямоугольник); содержимое пересоздаётся, если его размер изменился
    def move_resize(self, win, x, y, w, h):
        self.comp:damage_window(win)
        cw, ch = win:content_for(w, h)
        if win.kind == "text" and win.state == "normal":
            cw = math.max(win.font.width, math.floor(cw / win.font.width) * win.font.width)
            ch = math.max(win.font.height, math.floor(ch / win.font.height) * win.font.height)
            w, h = win:outer_for(cw, ch)
        win.x = x
        win.y = y
        win.w = w
        win.h = h
        changed = win:_make_content(cw, ch)
        win.canvas:clean()
        self.comp:damage_window(win)
        if changed:
            if win.kind == "text":
                self:_post(win, "win_resize", win:cols(), win:rows())
            else:
                self:_post(win, "win_resize", cw, ch)

    # ------------------------------------------------------------ клавиши

    def _default_hotkeys(self):
        let me = self
        def prev():
            me:cycle(-1)
        def nxt():
            me:cycle(1)
        def up():
            if me.focused != nil:
                me:set_state(me.focused, "max")
        def down():
            f = me.focused
            if f != nil:
                if f.state != "normal":
                    me:set_state(f, "normal")
                else:
                    me:minimize(f)
        def left():
            if me.focused != nil:
                me:set_state(me.focused, me.focused.state == "left" and "normal" or "left")
        def right():
            if me.focused != nil:
                me:set_state(me.focused, me.focused.state == "right" and "normal" or "right")
        def close():
            me:request_close(me.focused)
        def desk():
            me:toggle_desktop()
        def full():
            if me.focused != nil:
                me:toggle_full(me.focused)
        self.hotkeys["alt+left"] = prev
        self.hotkeys["alt+right"] = nxt
        self.hotkeys["alt+up"] = up
        self.hotkeys["alt+down"] = down
        self.hotkeys["alt+shift+left"] = left
        self.hotkeys["alt+shift+right"] = right
        self.hotkeys["ctrl+t"] = close
        self.hotkeys["alt+d"] = desk
        self.hotkeys["f11"] = full

    # своё сочетание: "ctrl+alt+shift+имя" (имя клавиши как в keys.getName); fn = nil снимает
    def hotkey(self, combo, fn):
        self.hotkeys[string.lower(combo)] = fn

    def _mod(self, name):
        if name == "ctrl":
            return self.mods[keys.leftCtrl] or self.mods[keys.rightCtrl]
        if name == "alt":
            return self.mods[keys.leftAlt]
        return self.mods[keys.leftShift] or self.mods[keys.rightShift]

    def _is_mod(self, code):
        return code == keys.leftCtrl or code == keys.rightCtrl or code == keys.leftAlt or code == keys.rightAlt or code == keys.leftShift or code == keys.rightShift

    def _combo(self, code):
        name = keys.getName(code) ?? tostring(code)
        parts = []
        if self:_mod("ctrl"):
            parts[len(parts) + 1] = "ctrl"
        if self:_mod("alt"):
            parts[len(parts) + 1] = "alt"
        if self:_mod("shift"):
            parts[len(parts) + 1] = "shift"
        parts[len(parts) + 1] = name
        return table.concat(parts, "+")

    def _key(self, code, held):
        self.swallow_char = nil
        if self:_is_mod(code):
            if code == keys.leftAlt and not held:
                self.alt_tap = true
            elif code != keys.leftAlt:
                self.alt_tap = false
            self.mods[code] = true
            self:_post(self.focused, "key", code, held == true)
            return
        self.alt_tap = false
        if true:
            fn = self.hotkeys[self:_combo(code)]
            if fn != nil:
                # символ той же клавиши (Ctrl+T, Alt+D), если CC его пришлёт, окну не достаётся
                key_name = keys.getName(code)
                self.swallow_char = (key_name != nil and string.len(key_name) == 1) and key_name or nil
                fn()
                return
        self:_post(self.focused, "key", code, held == true)

    def _key_up(self, code):
        was_tap = code == keys.leftAlt and self.alt_tap
        self.mods[code] = nil
        self.alt_tap = false
        self:_post(self.focused, "key_up", code)
        if was_tap and self.on_start != nil:
            self.on_start()

    # ------------------------------------------------------------ мышь

    # окно под точкой и часть окна: "title", "button" (which), "content", "border", "resize" (края)
    def hit(self, px, py):
        if self.panel != nil and self.panel:contains(px, py):
            return nil, "panel", nil
        for i in range[len(self.windows), 1] step -1:
            w = self.windows[i]
            if w:visible() and px >= w.x - GRIP and px < w.x + w.w + GRIP and py >= w.y - GRIP and py < w.y + w.h + GRIP:
                inside = w:contains(px, py)
                if w.resizable and w.state == "normal":
                    edges = {left: px < w.x + GRIP, right: px >= w.x + w.w - GRIP, top: py < w.y + 1,
                        bottom: py >= w.y + w.h - GRIP}
                    if edges.left or edges.right or edges.top or edges.bottom:
                        return w, "resize", edges
                if inside:
                    l, t, r, b = w:insets()
                    if py < w.y + t:
                        for bt in self.comp:buttons(w):
                            if px >= bt.x and px < bt.x + bt.w and py >= w.y + 1:
                                return w, "button", bt.which
                        return w, "title", nil
                    if not w.decorated and w.state != "full" and w:in_drag_area(px, py):
                        return w, "title", nil
                    if w:in_content(px, py):
                        return w, "content", nil
                    return w, "border", nil
        return nil, "desktop", nil

    # координаты события для окна: пиксели с нуля или клетки с единицы
    def _local(self, win, px, py):
        lx = px - win:content_x()
        ly = py - win:content_y()
        if win.kind == "text":
            return math.floor(lx / win.font.width) + 1, math.floor(ly / win.font.height) + 1
        return lx, ly

    def _click(self, btn, px, py):
        win, part, extra = self:hit(px, py)
        if part == "panel":
            it = self.panel:item_at(px, py)
            if it != nil:
                self.panel:set_pressed(it.key)
                self.drag = {kind: "panel", item: it}
            return
        if win == nil:
            self:_set_focus(nil)
            return
        self:focus(win)
        if part == "resize":
            self.drag = {kind: "resize", win: win, edges: extra, sx: px, sy: py, r: {x: win.x, y: win.y, w: win.w, h: win.h}}
        elif part == "button":
            self.comp.pressed = {win: win, which: extra}
            self:_damage_title(win)
            self.drag = {kind: "button", win: win, which: extra}
        elif part == "title":
            now = self.clock()
            lc = self.last_click
            if lc != nil and lc.win == win and now - lc.at <= DOUBLE_MS and math.abs(px - lc.x) + math.abs(py - lc.y) <= 4 and win.resizable:
                self.last_click = nil
                self:toggle_max(win)
                return
            self.last_click = {win: win, at: now, x: px, y: py}
            self.drag = {kind: "move", win: win, ox: px - win.x, oy: py - win.y, sx: px, sy: py, moved: false}
        elif part == "content":
            self.drag = {kind: "content", win: win, btn: btn}
            lx, ly = self:_local(win, px, py)
            self:_post(win, "mouse_click", btn, lx, ly)

    def _drag(self, btn, px, py):
        d = self.drag
        if d == nil or d.kind == "panel":
            return
        win = d.win
        if d.kind == "move":
            if not d.moved and math.abs(px - d.sx) + math.abs(py - d.sy) < 2:
                return
            d.moved = true
            self.last_click = nil
            if win.state != "normal":
                # развёрнутое окно, которое тянут за заголовок, возвращается к обычному размеру под мышью
                ratio = d.ox / math.max(1, win.w)
                self:set_state(win, "normal", false)
                d.ox = math.floor(ratio * win.w)
                d.oy = math.min(d.oy, self.deco.title - 2)
            x = math.max(30 - win.w, math.min(self.W - 30, px - d.ox))
            y = math.max(self.area.y, math.min(self.area.y + self.area.h - self.deco.title, py - d.oy))
            if x != win.x or y != win.y:
                self:move_resize(win, x, y, win.w, win.h)
            snap = nil
            if win.resizable:
                if py <= self.area.y:
                    snap = "max"
                elif px <= 0:
                    snap = "left"
                elif px >= self.W - 1:
                    snap = "right"
            d.snap = snap
            self.comp:set_preview(snap != nil and self:area_for(snap) or nil)
        elif d.kind == "resize":
            r = d.r
            e = d.edges
            dx = px - d.sx
            dy = py - d.sy
            min_w, min_h = win:outer_for(win.min_w, win.min_h)
            x = r.x
            y = r.y
            w = r.w
            h = r.h
            if e.right:
                w = math.max(min_w, r.w + dx)
            if e.bottom:
                h = math.max(min_h, r.h + dy)
            if e.left:
                w = math.max(min_w, r.w - dx)
                x = r.x + r.w - w
            if e.top:
                h = math.max(min_h, r.h - dy)
                y = r.y + r.h - h
            if x != win.x or y != win.y or w != win.w or h != win.h:
                self:move_resize(win, x, y, w, h)
                if e.left:
                    win.x = r.x + r.w - win.w
                if e.top:
                    win.y = r.y + r.h - win.h
        elif d.kind == "content":
            lx, ly = self:_local(win, px, py)
            self:_post(win, "mouse_drag", btn, lx, ly)

    def _up(self, btn, px, py):
        d = self.drag
        self.drag = nil
        if d == nil:
            return
        if d.kind == "panel":
            self.panel:set_pressed(nil)
            it = self.panel:item_at(px, py)
            if it != nil and it.key == d.item.key:
                self.panel:activate(it, btn)
            return
        win = d.win
        if d.kind == "button":
            self.comp.pressed = nil
            self:_damage_title(win)
            w2, part, which = self:hit(px, py)
            if w2 == win and part == "button" and which == d.which:
                if which == "close":
                    self:request_close(win)
                elif which == "max":
                    self:toggle_max(win)
                else:
                    self:minimize(win)
        elif d.kind == "move":
            self.comp:set_preview(nil)
            if d.snap != nil:
                self:set_state(win, d.snap)
        elif d.kind == "content":
            lx, ly = self:_local(win, px, py)
            self:_post(win, "mouse_up", btn, lx, ly)

    def _scroll(self, dir, px, py):
        win, part, extra = self:hit(px, py)
        if part == "panel":
            it = self.panel:item_at(px, py)
            if it != nil and it.kind == "tray" and it.tray.scroll != nil:
                it.tray.scroll(self.panel, dir)
            else:
                self:cycle(dir > 0 and 1 or -1)
            return
        if win != nil and part == "content":
            lx, ly = self:_local(win, px, py)
            self:_post(win, "mouse_scroll", dir, lx, ly)

    # ------------------------------------------------------------ события

    def handle(self, ev):
        name = ev[1]
        if name == "monitor_touch":
            # касание монитора: нажатие и отпускание в этой точке
            px, py = self:_logical(ev[3], ev[4])
            self:_click(1, px, py)
            self:_up(1, px, py)
        elif name == "mouse_click" or name == "mouse_drag" or name == "mouse_up" or name == "mouse_scroll":
            px, py = self:_logical(ev[3], ev[4])
            if name == "mouse_click":
                self:_click(ev[2], px, py)
            elif name == "mouse_drag":
                self:_drag(ev[2], px, py)
            elif name == "mouse_up":
                self:_up(ev[2], px, py)
            else:
                self:_scroll(ev[2], px, py)
        elif name == "key":
            self:_key(ev[2], ev[3])
        elif name == "key_up":
            self:_key_up(ev[2])
        elif name == "char":
            swallow = self.swallow_char
            self.swallow_char = nil
            if swallow == nil or string.lower(tostring(ev[2])) != swallow:
                self:_post(self.focused, "char", ev[2])
        elif name == "paste":
            self:_post(self.focused, "paste", ev[2])
        elif name == "terminate":
            # удержание Ctrl+T: CC сам шлёт terminate; окно в фокусе закрывается без вопросов (D222)
            self:force_close(self.focused)
        elif name == "term_resize" or name == "monitor_resize":
            self:_resized()

    # событие мыши (пиксели экрана или клетки телетекста) -> логический пиксель
    def _logical(self, x, y):
        px, py = self.screen:to_pixel(x, y)
        return math.floor(px / self.scale), math.floor(py / self.scale)

    # масштаб для настройки: число 1..4 (меньше, если логический экран вышел бы совсем маленьким) или "auto" по размеру экрана
    def pick_scale(self, setting):
        sw = self.screen.w
        sh = self.screen.h
        if setting == "auto" or tonumber(setting) == nil:
            return math.max(1, math.min(MAX_SCALE, math.floor(math.min(sw / AUTO_W, sh / AUTO_H))))
        k = math.max(1, math.min(MAX_SCALE, math.floor(tonumber(setting))))
        while k > 1 and (sw / k < 200 or sh / k < 110):
            k -= 1
        return k

    # ------------------------------------------------------------ обои

    # поверхность обоев по настройке background (живые обои занимают места палитры и запускают анимацию)
    def _wallpaper_surface(self):
        if self.wallpaper_fn != nil:
            return self.wallpaper_fn(self.W, self.H)
        let me = self
        self:_free_colors(self.wall_owner)
        self.live = nil
        def read_image(name):
            if me.wallpaper_loader != nil:
                ok, data = pcall(me.wallpaper_loader, name)
                if ok and data != nil:
                    return data
            for d in me.wallpaper_dirs:
                f = fs.open(d .. "/" .. name .. ".cimg", "rb")
                if f != nil:
                    data = f.readAll()
                    f.close()
                    return data
            return nil
        animated = self.anim.enabled and self.anim.wallpaper != false
        ctx = {palette: self.palette, theme: () => me.theme, read: read_image, now: () => me.clock(), animated: animated,
            damage: (x, y, w, h) => me.comp:damage(x, y, w, h),
            alloc: (n) => animated and me:_alloc(me.wall_owner, n) or nil,
            set_colors: (list) => me:_set_colors(me.wall_owner, list)}
        surf, live = wallpaper_mod.make(self.background, self.W, self.H, ctx)
        self.live = live
        return surf

    # другие обои на ходу: имя или {name, mode}
    def set_wallpaper(self, spec):
        self.background = spec
        self.comp.wallpaper = self:_wallpaper_surface()
        self.comp:damage_all()

    # сменить масштаб на ходу ("auto" или 1..4)
    def set_scale(self, setting):
        self.scale_setting = setting
        self:_relayout()

    # экран поменял размер (терминал компьютера, монитор): масштаб заново, новые обои, окна в пределах экрана
    def _resized(self):
        self.screen:resize()
        self:_relayout()

    def _relayout(self):
        self.scale = self:pick_scale(self.scale_setting)
        self.comp:set_scale(self.scale)
        self.W = self.comp.W
        self.H = self.comp.H
        self.comp.wallpaper = self:_wallpaper_surface()
        if self.panel != nil:
            self.panel:fit(self.W, self.H)
        self.area = self:_work_area()
        self:_fit_windows()
        self.comp:damage_all()

    # окна по новой рабочей области: развёрнутые и половинки заново, остальные не выходят за область
    def _fit_windows(self):
        a = self.area
        for w in self.windows:
            r = self:area_for(w.state)
            if r != nil:
                self:move_resize(w, r.x, r.y, r.w, r.h)
            else:
                nw = math.min(w.w, a.w)
                nh = math.min(w.h, a.h)
                self:move_resize(w, math.max(a.x, math.min(a.x + a.w - nw, w.x)), math.max(a.y, math.min(a.y + a.h - nh, w.y)), nw, nh)

    # настройки панели на ходу: {position: "top" | "bottom", align: "left" | "center", height, clock}
    def set_panel(self, o):
        if self.panel == nil:
            return
        self.panel:configure(o)
        self.area = self:_work_area()
        self:_fit_windows()
        self.comp:damage_all()

    # ------------------------------------------------------------ тема

    # смена темы на ходу: палитра (обои и всё, что нарисовано цветами темы, меняются без перерисовки), рамки окон по новой теме
    # (размер содержимого сохраняется), окнам событие win_theme. th: имя темы из theme_dirs или таблица темы
    def set_theme(self, th):
        if type(th) != "table":
            th = theme.find(th, self.theme_dirs)
        self.theme = th
        # места палитры, которые держат приложения, тема не трогает
        entries = []
        for e in theme.entries(th):
            if self.owned[e[1]] == nil:
                entries[len(entries) + 1] = e
        self.screen:set_colors(entries)
        self.palette = self.screen.palette
        self.deco = theme.deco(th, self.font)
        self.comp:set_deco(self.deco, theme.dim_map(self.palette, self.deco.shadow_strength))
        if self.panel != nil:
            self.panel:retheme()
        # свечение рамки, начатое при старой теме, кончилось бы её цветом: гасим, цвет рамки уже новый
        self.fx.glow = nil
        for w in self.windows:
            r = self:area_for(w.state)
            if r != nil:
                self:move_resize(w, r.x, r.y, r.w, r.h)
            else:
                ow, oh = w:outer_for(w.cw, w.ch)
                self:move_resize(w, w.x, w.y, ow, oh)
            self:_post(w, "win_theme", th.name)
        self.comp:damage_all()

    # следующая тема из папок тем по кругу (для сочетания клавиш, пока нет настроек)
    def next_theme(self):
        names = theme.list(self.theme_dirs)
        if len(names) == 0:
            return
        pick = names[1]
        for i, n in names:
            if n == self.theme.name and names[i + 1] != nil:
                pick = names[i + 1]
        self:set_theme(pick)

export def new(opts=nil):
    return WM(opts)
