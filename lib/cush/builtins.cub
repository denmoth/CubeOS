# cush.builtins: встроенные команды оболочки cush (cd, ls, grep, cat, jobs...). Каждая это функция (sh, args) -> код возврата (0 это успех);
# вывод идёт через sh:println и term текущей задачи (в пайпе это буфер), сообщения об ошибках через sh:eprint прямо на экран.
# Команды-фильтры (grep, head, tail, wc, sort, uniq, cat, tee) читают строки из файлов в аргументах или из пайпа (sh.env.stdin).

import term.chars as chars
import unicode
import clock
import svc.logd as logd
import cush.help as help_mod
import json5
import sha256

# имя -> функция; описания, флаги и примеры в реестре cush.commands (справка: cush.help)
export const table_of = {}

def add(name, fn):
    table_of[name] = fn

# ------------------------------------------------------------ вспомогательное

# разбор аргументов: короткие флаги вида -la и именованные с числом (-n 5, -5); возвращает множество флагов, число и остальные
def flags_of(args, with_number=false):
    flags = {}
    rest = []
    number = nil
    i = 1
    while i <= len(args):
        a = args[i]
        if string.sub(a, 1, 1) == "-" and string.len(a) > 1 and string.match(a, "^%-%d+$") != nil and with_number:
            number = tonumber(string.sub(a, 2))
        elif a == "-n" and with_number and args[i + 1] != nil:
            number = tonumber(args[i + 1])
            i += 1
        elif string.sub(a, 1, 1) == "-" and string.len(a) > 1 and string.sub(a, 2, 2) != "-":
            for k in range[2, string.len(a)]:
                flags[string.sub(a, k, k)] = true
        else:
            rest[len(rest) + 1] = a
        i += 1
    return flags, number, rest

def read_lines(sh, path):
    fsys = sh.env.fs
    full = sh:resolve(path)
    if not fsys.exists(full) or fsys.isDir(full):
        return nil
    f = fsys.open(full, "r")
    if f == nil:
        return nil
    out = []
    while true:
        line = f.readLine()
        if line == nil:
            break
        out[len(out) + 1] = line
    f.close()
    return out

# строки для фильтра: файлы из списка или пайп; nil и сообщение, если нечего читать
def input_lines(sh, name, files):
    if len(files) == 0:
        st = sh.env.stdin
        if st == nil:
            sh:eprint(name .. ": no input (give a file or use a pipe)")
            return nil
        out = []
        while st.lines[st.pos] != nil:
            out[len(out) + 1] = st.lines[st.pos]
            st.pos += 1
        return out
    out = []
    for f in files:
        lines = read_lines(sh, f)
        if lines == nil:
            sh:eprint(name .. ": " .. f .. ": No such file")
            return nil
        for l in lines:
            out[len(out) + 1] = l
    return out

# ------------------------------------------------------------ навигация и файлы

def b_cd(sh, args):
    target = args[1] ?? sh.vars.HOME
    if target == "-":
        target = sh.vars.OLDPWD ?? sh.dir
    full = sh:resolve(target)
    if not sh.env.fs.isDir(full):
        sh:eprint("cd: " .. target .. ": no such directory")
        return 1
    sh.vars.OLDPWD = sh.dir
    sh.dir = full
    sh.vars.PWD = "/" .. full
    return 0
add("cd", b_cd)

def b_pwd(sh, args):
    sh:println("/" .. sh.dir)
    return 0
add("pwd", b_pwd)

def color_for(sh, full, name):
    fsys = sh.env.fs
    if fsys.isDir(full):
        return "3"
    if string.sub(name, 1, 1) == ".":
        return "7"
    ext = string.match(name, "%.([%w]+)$")
    if ext == "lua":
        return "5"
    if ext == "cub":
        return "2"
    if ext == "json" or ext == "json5" or ext == "txt" or ext == "md":
        return "4"
    return "0"

def b_ls(sh, args):
    flags, n, rest = flags_of(args)
    fsys = sh.env.fs
    target = rest[1] ?? ""
    full = sh:resolve(target)
    if not fsys.exists(full):
        sh:eprint("ls: " .. (rest[1] ?? "") .. ": no such file or directory")
        return 1
    names = []
    if fsys.isDir(full):
        names = fsys.list(full)
    else:
        names = [fsys.getName(full)]
        full = fsys.getDir(full)
    shown = []
    for nm in names:
        if flags.a or string.sub(nm, 1, 1) != ".":
            shown[len(shown) + 1] = nm
    def by_kind(a, b):
        da = fsys.isDir(fsys.combine(full, a))
        db = fsys.isDir(fsys.combine(full, b))
        if da != db:
            return da
        return string.lower(a) < string.lower(b)
    table.sort(shown, by_kind)
    w, h = sh.env.term.getSize()
    if flags.l:
        total = 0
        for nm in shown:
            p = fsys.combine(full, nm)
            d = fsys.isDir(p)
            kind = d and "d" or "-"
            mode = fsys.isReadOnly(p) and "r-" or "rw"
            size = "-"
            if not d:
                bytes = fsys.getSize(p)
                size = flags.h and string.format("%.1fK", bytes / 1024) or tostring(bytes)
            line = kind .. mode .. " " .. string.rep(" ", 8 - string.len(size)) .. size .. " "
            sh:write_color("8", line)
            sh:write_color(color_for(sh, p, nm), nm .. (d and "/" or ""))
            sh:println("")
        return 0
    if sh.piped or flags["1"]:
        for nm in shown:
            sh:println(nm)
        return 0
    widest = 0
    for nm in shown:
        widest = math.max(widest, chars.length(nm) + (fsys.isDir(fsys.combine(full, nm)) and 1 or 0))
    colw = widest + 2
    cols = math.max(1, math.floor(w / colw))
    rows = math.ceil(len(shown) / cols)
    for r in range[1, rows]:
        for c in range[0, cols - 1]:
            idx = c * rows + r
            nm = shown[idx]
            if nm != nil:
                p = fsys.combine(full, nm)
                label = nm .. (fsys.isDir(p) and "/" or "")
                sh:write_color(color_for(sh, p, nm), label)
                if c < cols - 1 and shown[(c + 1) * rows + r] != nil:
                    sh:write_color("0", string.rep(" ", colw - chars.length(label)))
        sh:println("")
    return 0
add("ls", b_ls)

def b_cat(sh, args):
    lines = input_lines(sh, "cat", args)
    if lines == nil:
        return 1
    for l in lines:
        sh:println(l)
    return 0
add("cat", b_cat)

def b_head(sh, args):
    flags, n, rest = flags_of(args, true)
    lines = input_lines(sh, "head", rest)
    if lines == nil:
        return 1
    for i in range[1, math.min(n ?? 10, len(lines))]:
        sh:println(lines[i])
    return 0
add("head", b_head)

def b_tail(sh, args):
    flags, n, rest = flags_of(args, true)
    lines = input_lines(sh, "tail", rest)
    if lines == nil:
        return 1
    count = n ?? 10
    for i in range[math.max(1, len(lines) - count + 1), len(lines)]:
        sh:println(lines[i])
    return 0
add("tail", b_tail)

def b_wc(sh, args):
    flags, n, rest = flags_of(args)
    lines = input_lines(sh, "wc", rest)
    if lines == nil:
        return 1
    words = 0
    bytes = 0
    for l in lines:
        for w in string.gmatch(l, "%S+"):
            words += 1
        bytes += string.len(l) + 1
    parts = []
    all = not (flags.l or flags.w or flags.c)
    if all or flags.l:
        parts[len(parts) + 1] = tostring(len(lines))
    if all or flags.w:
        parts[len(parts) + 1] = tostring(words)
    if all or flags.c:
        parts[len(parts) + 1] = tostring(bytes)
    sh:println(table.concat(parts, " "))
    return 0
add("wc", b_wc)

def b_sort(sh, args):
    flags, n, rest = flags_of(args)
    lines = input_lines(sh, "sort", rest)
    if lines == nil:
        return 1
    if flags.n:
        table.sort(lines, (a, b) => (tonumber(string.match(a, "^%s*(-?[%d%.]+)")) ?? 0) < (tonumber(string.match(b, "^%s*(-?[%d%.]+)")) ?? 0))
    else:
        table.sort(lines)
    if flags.r:
        rev = []
        for i in range[len(lines), 1] step -1:
            rev[len(rev) + 1] = lines[i]
        lines = rev
    last = nil
    for l in lines:
        if not (flags.u and l == last):
            sh:println(l)
        last = l
    return 0
add("sort", b_sort)

def b_uniq(sh, args):
    flags, n, rest = flags_of(args)
    lines = input_lines(sh, "uniq", rest)
    if lines == nil:
        return 1
    last = nil
    count = 0
    def flush():
        if last != nil:
            if flags.c:
                sh:println(string.rep(" ", 4 - string.len(tostring(count))) .. count .. " " .. last)
            else:
                sh:println(last)
    for l in lines:
        if l == last:
            count += 1
        else:
            flush()
            last = l
            count = 1
    flush()
    return 0
add("uniq", b_uniq)

def b_grep(sh, args):
    flags, n, rest = flags_of(args)
    pattern = table.remove(rest, 1)
    if pattern == nil:
        sh:eprint("usage: grep [-ivnc] pattern [file...]")
        return 2
    lines = input_lines(sh, "grep", rest)
    if lines == nil:
        return 1
    needle = flags.i and string.lower(pattern) or pattern
    found = 0
    for i in range[1, len(lines)]:
        l = lines[i]
        hay = flags.i and string.lower(l) or l
        s, e = string.find(hay, needle, 1, true)
        hit = s != nil
        if flags.v:
            hit = not hit
        if hit:
            found += 1
            if not flags.c:
                if flags.n:
                    sh:write_color("2", tostring(i))
                    sh:write_color("7", ":")
                if s != nil and not flags.v and not sh.piped:
                    sh:write_color("0", string.sub(l, 1, s - 1))
                    sh:write_color("e", string.sub(l, s, e))
                    sh:write_color("0", string.sub(l, e + 1))
                    sh:println("")
                else:
                    sh:println(l)
    if flags.c:
        sh:println(tostring(found))
    return found > 0 and 0 or 1
add("grep", b_grep)

def b_tee(sh, args):
    lines = input_lines(sh, "tee", [])
    if lines == nil:
        return 1
    f = sh.env.fs.open(sh:resolve(args[1] ?? "tee.out"), "w")
    for l in lines:
        sh:println(l)
        if f != nil:
            f.writeLine(l)
    if f != nil:
        f.close()
    return 0
add("tee", b_tee)

def b_echo(sh, args):
    flags, n, rest = flags_of(args)
    text = table.concat(rest, " ")
    if flags.n:
        sh:write_color("0", text)
    else:
        sh:println(text)
    return 0
add("echo", b_echo)

def b_mkdir(sh, args):
    status = 0
    for a in args:
        ok, err = pcall(sh.env.fs.makeDir, sh:resolve(a))
        if not ok:
            sh:eprint("mkdir: " .. a .. ": " .. tostring(err))
            status = 1
    return status
add("mkdir", b_mkdir)

def b_touch(sh, args):
    for a in args:
        p = sh:resolve(a)
        if not sh.env.fs.exists(p):
            f = sh.env.fs.open(p, "w")
            if f != nil:
                f.close()
    return 0
add("touch", b_touch)

def b_rm(sh, args):
    flags, n, rest = flags_of(args)
    status = 0
    for a in rest:
        p = sh:resolve(a)
        if p == "" or p == "rom":
            sh:eprint("rm: refusing to remove '/" .. p .. "'")
            status = 1
        elif not sh.env.fs.exists(p):
            sh:eprint("rm: " .. a .. ": no such file or directory")
            status = 1
        elif sh.env.fs.isDir(p) and not flags.r:
            sh:eprint("rm: " .. a .. ": is a directory (use -r)")
            status = 1
        else:
            ok, err = pcall(sh.env.fs.delete, p)
            if not ok:
                sh:eprint("rm: " .. a .. ": " .. tostring(err))
                status = 1
    return status
add("rm", b_rm)

def b_cp(sh, args):
    if len(args) < 2:
        sh:eprint("usage: cp source dest")
        return 2
    dest = sh:resolve(args[len(args)])
    status = 0
    for i in range[1, len(args) - 1]:
        src = sh:resolve(args[i])
        target = dest
        if sh.env.fs.isDir(dest):
            target = sh.env.fs.combine(dest, sh.env.fs.getName(src))
        ok, err = pcall(sh.env.fs.copy, src, target)
        if not ok:
            sh:eprint("cp: " .. args[i] .. ": " .. tostring(err))
            status = 1
    return status
add("cp", b_cp)

def b_mv(sh, args):
    if len(args) < 2:
        sh:eprint("usage: mv source dest")
        return 2
    dest = sh:resolve(args[len(args)])
    status = 0
    for i in range[1, len(args) - 1]:
        src = sh:resolve(args[i])
        target = dest
        if sh.env.fs.isDir(dest):
            target = sh.env.fs.combine(dest, sh.env.fs.getName(src))
        ok, err = pcall(sh.env.fs.move, src, target)
        if not ok:
            sh:eprint("mv: " .. args[i] .. ": " .. tostring(err))
            status = 1
    return status
add("mv", b_mv)

# ------------------------------------------------------------ среда

def b_clear(sh, args):
    sh.env.term.clear()
    sh.env.term.setCursorPos(1, 1)
    return 0
add("clear", b_clear)

def b_exit(sh, args):
    sh.exit_requested = true
    return 0
add("exit", b_exit)

add("true", (sh, args) => 0)
add("false", (sh, args) => 1)

def b_sleep(sh, args):
    os.sleep(tonumber(args[1]) ?? 1)
    return 0
add("sleep", b_sleep)

def b_export(sh, args):
    for a in args:
        name, value = string.match(a, "^([%a_][%w_]*)=(.*)$")
        if name != nil:
            sh.vars[name] = value
    return 0
add("export", b_export)

def b_unset(sh, args):
    for a in args:
        sh.vars[a] = nil
    return 0
add("unset", b_unset)

def b_env(sh, args):
    names = []
    for k, v in sh.vars:
        names[len(names) + 1] = k
    table.sort(names)
    for k in names:
        sh:write_color("3", k)
        sh:println("=" .. tostring(sh.vars[k]))
    return 0
add("env", b_env)

def b_alias(sh, args):
    if len(args) == 0:
        names = []
        for k, v in sh.aliases:
            names[len(names) + 1] = k
        table.sort(names)
        for k in names:
            sh:println("alias " .. k .. "='" .. sh.aliases[k] .. "'")
        return 0
    for a in args:
        name, value = string.match(a, "^([^=]+)=(.*)$")
        if name != nil:
            sh.aliases[name] = value
        elif sh.aliases[a] != nil:
            sh:println("alias " .. a .. "='" .. sh.aliases[a] .. "'")
    return 0
add("alias", b_alias)

def b_unalias(sh, args):
    for a in args:
        sh.aliases[a] = nil
    return 0
add("unalias", b_unalias)

def b_history(sh, args):
    if args[1] == "-c":
        sh.hist:clear()
        return 0
    for i in range[1, len(sh.hist.items)]:
        sh:write_color("7", string.rep(" ", 5 - string.len(tostring(i))) .. i .. "  ")
        sh:println(sh.hist.items[i])
    return 0
add("history", b_history)

def b_type(sh, args):
    status = 0
    for a in args:
        if sh.aliases[a] != nil:
            sh:println(a .. " is an alias for '" .. sh.aliases[a] .. "'")
        elif table_of[a] != nil or sh.extra[a] != nil:
            sh:println(a .. " is a shell builtin")
        else:
            p = sh:resolve_program(a)
            if p != nil:
                sh:println(a .. " is /" .. p)
            else:
                sh:eprint("type: " .. a .. ": not found")
                status = 1
    return status
add("type", b_type)

table_of.which = table_of.type

# копия часов с другими настройками (для date -u и date -s)
def derived(c, over):
    conf = {}
    for k, v in c.conf:
        conf[k] = v
    for k, v in over:
        conf[k] = v
    return clock.new(conf, c.src)

# date [-u] [-s] [+ФОРМАТ]: -u время UTC, -s с секундами; без формата показ по настройкам (игровое время при source: ingame)
def b_date(sh, args):
    c = sh.time
    utc = false
    fmt = nil
    for a in args:
        if a == "-u":
            utc = true
        elif a == "-s":
            c = derived(c, {seconds: true})
        elif string.sub(a, 1, 1) == "+":
            fmt = string.sub(a, 2)
        else:
            sh:eprint("date: unknown argument " .. a)
            return 1
    if utc:
        c = derived(c, {tz: "UTC", dst: "off", source: "utc"})
    if fmt != nil:
        sh:println(c:format(fmt))
    elif c.conf.source == "ingame":
        sh:println(c:date_text() .. " " .. c:time_text() .. " (in-game)")
    else:
        sh:println(c:format("%a %e %b %Y") .. " " .. c:time_text() .. " " .. c:zone().abbr)
    return 0
add("date", b_date)

def tdc_status(sh):
    c = sh.time
    z = c:zone()
    local_t = c:format("%Y-%m-%d %H:%M:%S")
    sh:println("      Local time: " .. c:format("%a ") .. local_t .. " " .. z.abbr)
    sh:println("  Universal time: " .. clock.new({tz: "UTC"}, c.src):format("%a %Y-%m-%d %H:%M:%S") .. " UTC")
    sh:println("       Time zone: " .. z.name .. " (" .. z.abbr .. (z.isdst and ", summer time" or "") .. ")")
    sh:println("          Source: " .. c.conf.source)
    sh:println("         Seconds: " .. (c.conf.seconds and "on" or "off"))
    sh:println("          Format: " .. c.conf.format .. ", " .. c.conf.date_format)
    g = c:ingame()
    sh:println("   In-game time: day " .. g.day .. ", " .. g.text)

# timedatectl [status | set-timezone ЗОНА | set-source utc|ingame | set-seconds on|off | set-format 12h|24h | list-timezones [фильтр]]
def b_timedatectl(sh, args):
    sub = args[1] ?? "status"
    c = sh.time
    if sub == "status":
        tdc_status(sh)
        return 0
    if sub == "list-timezones":
        # зона, страна и смещение сейчас: «Europe/Kyiv  Ukraine  UTC+03:00»
        now = c:now()
        for name in clock.zone_names(args[2]):
            info = clock.zone_info(name)
            sh:println(name .. "  " .. (info != nil and info.country or "") .. "  " .. clock.new({tz: name}):zone(now).abbr)
        return 0
    changes = nil
    if sub == "set-timezone" and args[2] != nil:
        tz = args[2]
        # не имя зоны и не смещение: ищем по стране или городу («japan», «kyiv»); одна находка подходит, несколько показываем
        if clock.zone_info(tz) == nil and clock.parse_offset(tz) == nil:
            found = clock.zone_names(tz)
            if len(found) == 1:
                tz = found[1]
            elif len(found) > 8:
                sh:eprint("timedatectl: " .. len(found) .. " zones match '" .. args[2] .. "'; see them with: timedatectl list-timezones " .. args[2])
                return 1
            elif len(found) > 1:
                sh:eprint("timedatectl: several zones match '" .. args[2] .. "', pick one:")
                for name in found:
                    sh:eprint("  " .. name)
                return 1
        changes = {tz: tz}
    elif sub == "set-source" and args[2] != nil:
        changes = {source: args[2]}
    elif sub == "set-seconds" and (args[2] == "on" or args[2] == "off"):
        changes = {seconds: args[2] == "on"}
    elif sub == "set-format" and args[2] != nil:
        changes = {format: args[2]}
    if changes == nil:
        sh:eprint("usage: timedatectl [status | set-timezone ZONE | set-source utc|ingame | set-seconds on|off | set-format 12h|24h | list-timezones [filter]]")
        return 1
    ok, problems = c:set_conf(changes)
    if not ok:
        for p in problems:
            sh:eprint("timedatectl: " .. p)
        return 1
    if sh.time_save != nil:
        saved, why = sh.time_save(changes)
        if not saved:
            sh:eprint("timedatectl: the setting is applied but not saved: " .. tostring(why))
            return 1
    return 0
add("timedatectl", b_timedatectl)

const LEVEL_COLORS = {debug: "8", info: "0", warn: "4", error: "e", crit: "e"}

# logs [-f] [-n N] [-l УРОВЕНЬ] [служба]: журнал /cubeos/var/log/<служба или system>.log; -f следит за новыми строками (Ctrl+C: выход)
def b_logs(sh, args):
    n = 20
    level = nil
    follow = false
    source = "system"
    i = 1
    while i <= len(args):
        a = args[i]
        if a == "-f":
            follow = true
        elif a == "-n":
            i += 1
            n = tonumber(args[i])
            if n == nil:
                sh:eprint("logs: -n needs a number")
                return 1
        elif a == "-l":
            i += 1
            level = args[i]
        elif string.sub(a, 1, 1) == "-":
            sh:eprint("logs: unknown option " .. a)
            return 1
        else:
            source = a
        i += 1
    want = 1
    if level != nil:
        want = logd.rank(level)
        if want == nil:
            sh:eprint("logs: unknown level " .. level .. " (debug, info, warn, error, crit)")
            return 1
    path = (sh.opts.log_dir ?? "/cubeos/var/log") .. "/" .. string.gsub(source, "[^%w_%-%.]", "_") .. ".log"
    if not sh.env.fs.exists(path):
        sh:eprint("logs: no log for " .. source)
        return 1
    # строки не по формату журнала (журнал ввода, заголовки) показываются как есть, если не просили уровень
    def show(line):
        rec = logd.parse_line(line)
        if rec == nil:
            if level != nil:
                return false
            sh:write_color("7", line)
            sh:println("")
            return true
        if (logd.rank(rec.level) ?? 2) < want:
            return false
        sh:write_color("7", rec.time .. " ")
        sh:write_color(LEVEL_COLORS[rec.level] ?? "0", string.sub(rec.level .. "     ", 1, 5) .. " ")
        sh:write_color("3", rec.source .. " ")
        sh:println(rec.text)
        return true
    lines = read_lines(sh, path)
    shown = []
    for line in lines:
        rec = logd.parse_line(line)
        if (rec == nil and level == nil) or (rec != nil and (logd.rank(rec.level) ?? 2) >= want):
            shown[len(shown) + 1] = line
    first = math.max(1, len(shown) - n + 1)
    for k in range[first, len(shown)]:
        show(shown[k])
    if follow:
        seen = len(lines)
        while true:
            os.sleep(1)
            lines = read_lines(sh, path)
            if len(lines) < seen:
                seen = 0
            for k in range[seen + 1, len(lines)]:
                show(lines[k])
            seen = len(lines)
    return 0
add("logs", b_logs)

# shutdown / reboot: просьба службе питания через sh.power(action) -> ok, причина (сессия подставляет вызов powerd)
def power_command(action):
    def run(sh, args):
        if sh.power == nil:
            sh:eprint(action .. ": the power service is not available here")
            return 1
        ok, why = sh.power(action)
        if not ok:
            sh:eprint(action .. ": " .. tostring(why))
            return 1
        sh:println("The system is going down for " .. (action == "reboot" and "reboot" or "power off") .. ".")
        return 0
    return run
add("shutdown", power_command("shutdown"))
add("poweroff", power_command("shutdown"))
add("reboot", power_command("reboot"))
add("restart", power_command("reboot"))

# inputlog [on|off|status]: журнал ввода (D220), каждое нажатие клавиши в /cubeos/var/log/input.log, кроме паролей
def b_inputlog(sh, args):
    if sh.inputlog == nil:
        sh:eprint("inputlog: the log service is not available here")
        return 1
    sub = args[1] ?? "status"
    on = nil
    if sub == "on":
        on = true
    elif sub == "off":
        on = false
    elif sub != "status":
        sh:eprint("usage: inputlog [on|off|status]")
        return 1
    st, why = sh.inputlog(on)
    if type(st) != "table":
        sh:eprint("inputlog: " .. tostring(why ?? st))
        return 1
    if st.on:
        sh:println("Input log: on, " .. tostring(st.minutes_left) .. " min left, file " .. st.path)
        sh:println("Every key you press is written there, except passwords and other hidden fields.")
    else:
        sh:println("Input log: off")
    if st.delete:
        sh:println("The file is deleted " .. st.ttl_minutes .. " minutes after it was created.")
    return 0
add("inputlog", b_inputlog)

def b_whoami(sh, args):
    sh:println(sh.vars.USER)
    return 0
add("whoami", b_whoami)

def b_hostname(sh, args):
    sh:println(sh.vars.HOST)
    return 0
add("hostname", b_hostname)

def b_uptime(sh, args):
    secs = math.floor(os.clock())
    sh:println("up " .. math.floor(secs / 3600) .. "h " .. math.floor(secs / 60) % 60 .. "m " .. secs % 60 .. "s")
    return 0
add("uptime", b_uptime)

# ------------------------------------------------------------ задачи

def b_jobs(sh, args):
    for j in sh.jobs:
        if j != sh.fg:
            state = j.stopped and "Stopped" or "Running"
            sh:write_color("3", "[" .. j.id .. "]  ")
            sh:write_color(j.stopped and "4" or "5", state .. string.rep(" ", 9 - string.len(state)))
            sh:println(j.name)
    return 0
add("jobs", b_jobs)

def b_fg(sh, args):
    j = sh:find_job(args[1])
    if j == nil:
        sh:eprint("fg: no such job")
        return 1
    sh:promote(j)
    return 0
add("fg", b_fg)

def b_bg(sh, args):
    j = sh:find_job(args[1])
    if j == nil:
        sh:eprint("bg: no such job")
        return 1
    j.stopped = false
    sh:println("[" .. j.id .. "] " .. j.name)
    return 0
add("bg", b_bg)

def b_kill(sh, args):
    j = sh:find_job(args[1])
    if j == nil:
        sh:eprint("kill: no such job")
        return 1
    sh:kill_job(j)
    return 0
add("kill", b_kill)

# help [команда | слово]: справка из реестра (cush.help)
def b_help(sh, args):
    return help_mod.run(sh, args)
add("help", b_help)

# locale [set LANG | list]: язык оболочки и справки (cush.conf: lang); без CC:Graphics текст остаётся английским
def b_locale(sh, args):
    sub = args[1]
    if sub == nil:
        sh:println("Language: " .. sh.lang .. (sh.lang_wanted != nil and sh.lang_wanted != sh.lang and (" (" .. sh.lang_wanted .. " needs the pixel terminal)") or ""))
        return 0
    if sub == "list":
        for l in sh:languages():
            sh:println(l)
        return 0
    if sub == "set" and args[2] != nil:
        ok, why = sh:save_lang(args[2])
        if not ok:
            sh:eprint("locale: " .. tostring(why))
            return 1
        sh:println("Language: " .. sh.lang .. (sh.lang_wanted != sh.lang and (" (" .. sh.lang_wanted .. " needs the pixel terminal)") or ""))
        return 0
    sh:eprint("usage: locale [set LANG | list]")
    return 2
add("locale", b_locale)

# ------------------------------------------------------------ учётная запись и права (D226, D227, D224)

# скрытый ввод (пароль, PIN): в журнал ввода не попадает
def ask_secret(sh, prompt):
    sh:write_color("0", prompt)
    return sh.env.read("*")

def account_or_fail(sh, name):
    if sh.account == nil:
        sh:eprint(name .. ": accounts are not available here")
        return false
    return true

# sudo [-k] команда...: команда с правами администратора; пароль спрашивается, если вход был не по паролю (PIN, автовход)
# или права уже не повышены (5 минут)
def b_sudo(sh, args):
    if sh.sudo == nil:
        sh:eprint("sudo: not available here")
        return 1
    if args[1] == "-k":
        sh.sudo("forget")
        return 0
    if len(args) == 0:
        sh:eprint("usage: sudo command [args...]")
        return 2
    st = sh.sudo("status")
    if type(st) != "table" or not st.admin:
        sh:eprint("sudo: " .. sh.vars.USER .. " is not an administrator")
        return 1
    if not st.elevated:
        ok = false
        why = nil
        if st.trusted:
            ok, why = sh.sudo("elevate")
        if not ok:
            for attempt in range[1, 3]:
                pw = ask_secret(sh, "[sudo] password for " .. sh.vars.USER .. ": ")
                if pw == nil:
                    return 1
                ok, why = sh.sudo("elevate", pw)
                if ok or string.find(tostring(why), "wait", 1, true) != nil:
                    break
                sh:eprint("sudo: " .. tostring(why))
        if not ok:
            sh:eprint("sudo: " .. tostring(why))
            return 1
    fs_admin = sh.sudo("fs")
    old = sh.env.fs
    if type(fs_admin) == "table":
        sh.env.fs = fs_admin
    sh.sudo_active = true
    ok2, res = pcall(() => sh:run_command(args))
    sh.sudo_active = false
    sh.env.fs = old
    if not ok2:
        error(res, 0)
    return res

# passwd: сменить свой пароль
def b_passwd(sh, args):
    if not account_or_fail(sh, "passwd"):
        return 1
    st = sh.account("status")
    old = nil
    if type(st) == "table" and st.password:
        old = ask_secret(sh, "Current password: ")
    new = ask_secret(sh, "New password (empty: no password): ")
    again = ask_secret(sh, "Repeat the new password: ")
    if new != again:
        sh:eprint("passwd: the passwords do not match")
        return 1
    ok, why = sh.account("passwd", {password: old, new: new})
    if not ok:
        sh:eprint("passwd: " .. tostring(why))
        return 1
    sh:println("Password changed.")
    return 0

# pin [set|remove]: PIN для входа (пароль остаётся для sudo, восстановления и CraftOS)
def b_pin(sh, args):
    if not account_or_fail(sh, "pin"):
        return 1
    sub = args[1] ?? "status"
    st = sh.account("status")
    if sub == "status":
        sh:println(type(st) == "table" and st.pin and "A PIN is set: you sign in with it." or "No PIN: you sign in with your password.")
        return 0
    if sub != "set" and sub != "remove":
        sh:eprint("usage: pin [set | remove]")
        return 2
    pw = nil
    if type(st) == "table" and st.password:
        pw = ask_secret(sh, "Your password: ")
    pin = nil
    if sub == "set":
        pin = ask_secret(sh, "New PIN (4 or more characters): ")
        again = ask_secret(sh, "Repeat the PIN: ")
        if pin != again:
            sh:eprint("pin: the PINs do not match")
            return 1
    ok, why = sh.account("pin", {password: pw, pin: pin})
    if not ok:
        sh:eprint("pin: " .. tostring(why))
        return 1
    sh:println(sub == "set" and "PIN set. Next time you sign in with it." or "PIN removed.")
    return 0

# remember [MINUTES|off]: не спрашивать пароль столько минут после последнего входа
def b_remember(sh, args):
    if not account_or_fail(sh, "remember"):
        return 1
    st = sh.account("status")
    if args[1] == nil:
        m = type(st) == "table" and st.remember or 0
        sh:println(m > 0 and ("The login does not ask again for " .. m .. " minutes after you signed in.") or "Every login asks for the password or PIN.")
        return 0
    minutes = args[1] == "off" and 0 or tonumber(args[1])
    if minutes == nil or minutes < 0:
        sh:eprint("usage: remember [MINUTES | off]")
        return 2
    pw = nil
    if type(st) == "table" and st.password:
        pw = ask_secret(sh, "Your password: ")
    ok, why = sh.account("remember", {password: pw, minutes: math.floor(minutes)})
    if not ok:
        sh:eprint("remember: " .. tostring(why))
        return 1
    sh:println(minutes > 0 and ("Saved: no password for " .. math.floor(minutes) .. " minutes after a login.") or "Saved: every login asks.")
    return 0

# autologin [NAME|off]: кто входит сам при включении (только с sudo)
def b_autologin(sh, args):
    if not account_or_fail(sh, "autologin"):
        return 1
    if args[1] == nil:
        sh:eprint("usage: sudo autologin NAME | off")
        return 2
    name = args[1] != "off" and args[1] or nil
    ok, why = sh.account("autologin", {name: name, sudo: sh.sudo_active == true})
    if not ok:
        sh:eprint("autologin: " .. tostring(why))
        return 1
    sh:println(name != nil and (name .. " will be signed in automatically at start.") or "Automatic login is off.")
    return 0

# disk [list | trust [SIDE] | untrust ID | boot MODE]: дискеты и загрузка с них (D224)
def _disk_startup(mount):
    for n in ["startup.lua", "startup"]:
        p = "/" .. fs.combine(mount, n)
        if fs.exists(p) and not fs.isDir(p):
            return p
    return nil

def b_disk(sh, args):
    per = sh.env.peripheral
    d = sh.env.disk
    if per == nil or d == nil:
        sh:eprint("disk: no disk API here")
        return 1
    sub = args[1] ?? "list"
    drives = []
    for side in per.getNames():
        if d.isPresent(side):
            drives[len(drives) + 1] = side
    if sub == "list":
        if len(drives) == 0:
            sh:println("No disks in the drives.")
        for side in drives:
            mount = d.hasData(side) and d.getMountPath(side) or nil
            start = mount != nil and _disk_startup(mount) or nil
            sh:write_color("5", side)
            sh:println("  #" .. tostring(d.getID(side)) .. "  " .. tostring(d.getLabel(side) ?? "-") .. (start != nil and "  (has a startup program)" or ""))
        return 0
    if not account_or_fail(sh, "disk"):
        return 1
    if sub == "boot":
        ok, why = sh.account("disk_boot", {mode: args[2], sudo: sh.sudo_active == true})
        if not ok:
            sh:eprint("disk: " .. tostring(why))
            return 1
        sh:println("Disk boot: " .. tostring(args[2]))
        return 0
    if sub == "untrust":
        ok, why = sh.account("trust_disk", {id: tonumber(args[2]), remove: true, sudo: sh.sudo_active == true})
        if not ok:
            sh:eprint("disk: " .. tostring(why))
            return 1
        sh:println("Disk #" .. tostring(args[2]) .. " is not trusted any more.")
        return 0
    if sub == "trust":
        side = args[2]
        start = nil
        for s_ in drives:
            if side == nil or s_ == side:
                m = d.hasData(s_) and d.getMountPath(s_) or nil
                start = m != nil and _disk_startup(m) or nil
                if start != nil:
                    side = s_
                    break
        if start == nil:
            sh:eprint("disk: no disk with a startup program" .. (args[2] != nil and (" in " .. args[2]) or ""))
            return 1
        f = fs.open(start, "r")
        text = f.readAll() ?? ""
        f.close()
        ok, why = sh.account("trust_disk", {id: d.getID(side), hash: sha256.hex(text), label: d.getLabel(side) ?? "", sudo: sh.sudo_active == true})
        if not ok:
            sh:eprint("disk: " .. tostring(why))
            return 1
        sh:println("Disk #" .. tostring(d.getID(side)) .. " is trusted. If its startup program changes, trust it again.")
        return 0
    sh:eprint("usage: disk [list | trust [SIDE] | untrust ID | boot off|trusted|password|all]")
    return 2

add("sudo", b_sudo)
add("passwd", b_passwd)
add("pin", b_pin)
add("remember", b_remember)
add("autologin", b_autologin)
add("disk", b_disk)
