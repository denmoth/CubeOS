# cush.commands: реестр встроенных команд (D228). Только данные, по-английски; переводы в assets/lang/<язык>.lang (lib/i18n.cub),
# ключ перевода это сам английский текст. Из реестра строятся help, help <команда>, help <слово>, <команда> --help и Tab.
#
# Команда: cat (категория из CATEGORIES), summary (одна строка), usage, about (что делает, несколько предложений), flags [[флаг, что
# делает]], examples [[команда, что получится]], see [связанные команды]. Новая встроенная команда без записи здесь не проходит тест
# lib_cush_help (у каждой команды есть описание, у каждого флага пояснение).

export const CATEGORIES = [
    ["files", "Files and folders"],
    ["text", "Text and filters"],
    ["system", "System"],
    ["time", "Date and time"],
    ["jobs", "Programs and jobs"],
    ["shell", "Shell"],
    ["users", "Users and security"],
]

export const COMMANDS = {
    # ------------------------------------------------------------ файлы
    ls: {cat: "files", summary: "List the files in a folder", usage: "ls [-la1h] [path]",
        about: "Shows the folder you are in, or the one you name. Folders come first and end with a slash; programs are green.",
        flags: [["-l", "Long list: type, rights and size of every entry"], ["-a", "Also show hidden files (names that start with a dot)"],
            ["-1", "One name per line (handy in pipes)"], ["-h", "With -l: sizes in KB instead of bytes"]],
        examples: [["ls", "What is in the current folder"], ["ls -la ~", "Everything in your home, hidden files too, with sizes"]],
        see: ["cd", "pwd", "cat"]},
    cd: {cat: "files", summary: "Go to another folder", usage: "cd [folder]",
        about: "Without a folder it takes you home (~). 'cd -' goes back to the folder you were in before; '..' is the folder above.",
        flags: [], examples: [["cd /cubeos", "Go to the system folder"], ["cd ..", "One folder up"], ["cd -", "Back to the previous folder"]],
        see: ["pwd", "ls"]},
    pwd: {cat: "files", summary: "Show the folder you are in", usage: "pwd", about: "Prints the full path of the current folder.",
        flags: [], examples: [], see: ["cd"]},
    cat: {cat: "files", summary: "Print files", usage: "cat [file...]",
        about: "Prints the files one after another. Without files it prints what comes through a pipe.",
        flags: [], examples: [["cat notes.txt", "Show a file"], ["cat a.txt b.txt > both.txt", "Join two files into a new one"]],
        see: ["head", "tail", "grep"]},
    mkdir: {cat: "files", summary: "Create folders", usage: "mkdir folder...",
        about: "Creates the folders, together with any missing folders above them.", flags: [],
        examples: [["mkdir games/saves", "Create games and games/saves at once"]], see: ["rm", "touch"]},
    touch: {cat: "files", summary: "Create empty files", usage: "touch file...", about: "Creates empty files; existing files are left as they are.",
        flags: [], examples: [["touch todo.txt", "An empty file to fill later"]], see: ["mkdir", "rm"]},
    rm: {cat: "files", summary: "Delete files and folders", usage: "rm [-r] path...",
        about: "Deletes for good, there is no undo here. A folder needs -r. The root and /rom cannot be removed.",
        flags: [["-r", "Delete folders together with everything inside"]],
        examples: [["rm old.txt", "Delete a file"], ["rm -r build", "Delete a folder with its contents"]], see: ["mkdir", "mv"]},
    cp: {cat: "files", summary: "Copy files", usage: "cp source... destination",
        about: "Copies files or folders. If the destination is a folder, the copies go inside it under their own names.",
        flags: [], examples: [["cp notes.txt notes.bak", "Make a backup copy"], ["cp a.txt b.txt docs", "Copy two files into docs"]],
        see: ["mv", "rm"]},
    mv: {cat: "files", summary: "Move or rename", usage: "mv source... destination",
        about: "Moves files or folders. With one file and a new name it renames it.", flags: [],
        examples: [["mv draft.txt final.txt", "Rename a file"], ["mv *.lua programs", "Move into a folder"]], see: ["cp", "rm"]},

    tree: {cat: "files", summary: "Show folders as a tree", usage: "tree [-a] [-L N] [path]",
        about: "Draws the folder and everything inside it as a tree, then counts folders and files.",
        flags: [["-a", "Also show hidden files"], ["-L N", "Go only N levels deep"]],
        examples: [["tree -L 2 /cubeos", "Two levels of the system folder"]], see: ["ls", "find", "du"]},
    find: {cat: "files", summary: "Find files by name", usage: "find [path] [-name PATTERN] [-type f|d]",
        about: "Walks through the folder and everything inside it and prints matching paths. In the pattern * means any text and ? any one character; capital letters do not matter.",
        flags: [["-name PATTERN", "Only names that match, for example *.lua"], ["-type f", "Only files"], ["-type d", "Only folders"]],
        examples: [["find / -name *.lua", "All Lua files"], ["find ~ -type d", "All your folders"]], see: ["tree", "grep"]},
    du: {cat: "files", summary: "How much space files take", usage: "du [-s] [path...]",
        about: "For a folder lists what is inside with sizes, biggest first, and the total.",
        flags: [["-s", "Only the total"]], examples: [["du ~", "What takes space in your home"]], see: ["df", "stat"]},
    df: {cat: "files", summary: "Free space on the computer and disks", usage: "df",
        about: "Size, used and free space of the computer and of every floppy disk in a drive.", flags: [], examples: [], see: ["du"]},
    stat: {cat: "files", summary: "Details of a file", usage: "stat path...", about: "Type, size, rights and the time of the last change.",
        flags: [], examples: [["stat notes.txt", "When was it changed"]], see: ["ls", "du"]},
    less: {cat: "files", summary: "Read a long file page by page", usage: "less [file]",
        about: "Shows a screen at a time: Space for the next page, Enter for one more line, q to stop. Works with a pipe too. 'more' is the same.",
        flags: [], examples: [["less /cubeos/var/log/system.log", "Read the whole log"], ["ls -l / | less", "A long list page by page"]],
        see: ["cat", "head"]},
    more: {cat: "files", summary: "Same as less", usage: "more [file]", about: "Reads a long file page by page.", flags: [], examples: [], see: ["less"]},
    paste: {cat: "files", summary: "Save the Windows clipboard to a file", usage: "paste [file]",
        about: "Waits for Ctrl+V and writes what you pasted to the file, every line of it (or prints it without a file). Plain CC passes only the first line of the clipboard; the MothPaste mod passes all of it.",
        flags: [], examples: [["paste program.lua", "Then press Ctrl+V: a whole program from Windows into a file"]], see: ["clip"]},
    clip: {cat: "files", summary: "Put a file into the terminal clipboard", usage: "clip [file]",
        about: "Copies the file, or what comes through a pipe, so Ctrl+Shift+V pastes it. CC cannot put text into the Windows clipboard.",
        flags: [], examples: [["clip notes.txt", "Copy a file"], ["ls | clip", "Copy a list"]], see: ["paste"]},

    # ------------------------------------------------------------ текст
    echo: {cat: "text", summary: "Print words", usage: "echo [-n] words...",
        about: "Prints its words separated by spaces. Variables like $HOME are replaced by their values.",
        flags: [["-n", "Do not end with a new line"]], examples: [["echo Hello, $USER", "Greet yourself"], ["echo hi > note.txt", "Write a word into a file"]],
        see: ["cat"]},
    head: {cat: "text", summary: "First lines of a file", usage: "head [-n N] [file]",
        about: "Prints the first 10 lines, or as many as you ask. Without a file it reads a pipe.",
        flags: [["-n N", "How many lines (also written as -N, for example -5)"]], examples: [["head -n 3 log.txt", "The first three lines"]],
        see: ["tail", "cat"]},
    tail: {cat: "text", summary: "Last lines of a file", usage: "tail [-n N] [file]",
        about: "Prints the last 10 lines, or as many as you ask. Without a file it reads a pipe.",
        flags: [["-n N", "How many lines (also written as -N, for example -5)"]], examples: [["tail -n 20 log.txt", "The end of a long log"]],
        see: ["head", "logs"]},
    grep: {cat: "text", summary: "Find lines that contain a text", usage: "grep [-ivnc] text [file]",
        about: "Prints the lines that contain the text; the found part is highlighted. Without a file it reads a pipe.",
        flags: [["-i", "Ignore the difference between capital and small letters"], ["-v", "The opposite: lines that do NOT contain it"],
            ["-n", "Show line numbers"], ["-c", "Only count the lines"]],
        examples: [["grep error log.txt", "Lines with 'error'"], ["ls | grep lua", "Only names with 'lua'"]], see: ["wc", "sort"]},
    wc: {cat: "text", summary: "Count lines, words and bytes", usage: "wc [-lwc] [file]",
        about: "Without flags prints all three numbers.", flags: [["-l", "Lines"], ["-w", "Words"], ["-c", "Bytes"]],
        examples: [["wc -l notes.txt", "How many lines"], ["ls | wc -l", "How many files"]], see: ["grep"]},
    sort: {cat: "text", summary: "Sort lines", usage: "sort [-rnu] [file]", about: "Sorts lines alphabetically.",
        flags: [["-r", "Reverse order"], ["-n", "Compare as numbers (2 before 10)"], ["-u", "Drop repeated lines"]],
        examples: [["sort names.txt", "A to Z"], ["sort -rn scores.txt", "Biggest numbers first"]], see: ["uniq"]},
    uniq: {cat: "text", summary: "Drop repeated lines that follow each other", usage: "uniq [-c] [file]",
        about: "Keeps one line of every run of equal lines. Sort first to drop all repeats.",
        flags: [["-c", "Show how many times each line was repeated"]], examples: [["sort words.txt | uniq -c", "How often each word appears"]],
        see: ["sort"]},
    tee: {cat: "text", summary: "Print what comes in and save it to a file", usage: "tee file",
        about: "Passes a pipe through to the screen and writes the same text to a file.", flags: [],
        examples: [["ls | tee list.txt", "See the list and keep a copy"]], see: ["cat"]},

    rev: {cat: "text", summary: "Reverse every line", usage: "rev [file]", about: "Prints every line backwards.", flags: [],
        examples: [["echo hello | rev", "olleh"]], see: ["sort"]},
    seq: {cat: "text", summary: "Count numbers", usage: "seq [first [step]] last",
        about: "Prints numbers from first (1) to last, with the step (1). Handy with pipes.", flags: [],
        examples: [["seq 5", "1 to 5"], ["seq 10 -2 0", "10, 8, ... 0"]], see: ["calc"]},
    basename: {cat: "text", summary: "The name at the end of a path", usage: "basename path [suffix]",
        about: "Drops the folders, and the suffix if given.", flags: [], examples: [["basename /cubeos/sys/boot.conf .conf", "boot"]], see: ["dirname"]},
    dirname: {cat: "text", summary: "The folder part of a path", usage: "dirname path", about: "Drops the last name of the path.", flags: [],
        examples: [["dirname /cubeos/sys/boot.conf", "/cubeos/sys"]], see: ["basename"]},
    calc: {cat: "text", summary: "Calculator", usage: "calc EXPRESSION",
        about: "Counts an expression: + - * / % and ^ (power), brackets, sqrt abs floor ceil round min max sin cos tan log exp, pi and e.",
        flags: [], examples: [["calc (2+3)*4", "20"], ["calc round(pi, 2)", "3.14"]], see: ["seq"]},

    # ------------------------------------------------------------ система
    fetch: {cat: "system", summary: "System information with the logo", usage: "fetch",
        about: "Shows the system version, user, computer, disk, graphics, peripherals, network and time.", flags: [], examples: [],
        see: ["uptime", "whoami"]},
    logs: {cat: "system", summary: "Read the system log", usage: "logs [-f] [-n N] [-l level] [source]",
        about: "Shows the end of the system log, or of one service's log (kernel, boot, timed, shell...). Errors are red, warnings yellow.",
        flags: [["-f", "Keep watching and print new lines as they come (Ctrl+C stops)"], ["-n N", "How many lines (20)"],
            ["-l level", "Only this level and worse: debug, info, warn, error, crit"]],
        examples: [["logs -l warn", "Only problems"], ["logs shell", "Errors of shell commands"], ["logs -f", "Watch the log live"]],
        see: ["inputlog"]},
    inputlog: {cat: "system", summary: "Record every key you press, for debugging", usage: "inputlog [on|off|status]",
        about: "Writes every key, character, paste and click with the time in milliseconds to /cubeos/var/log/input.log. Passwords and other hidden fields are never written: only one line saying that a secret was entered. It turns itself off after 90 minutes or at reboot, and the file is deleted 90 minutes after it was made. Administrators only. To see the login screen too, choose 'CubeOS (input log)' in the boot menu (Delete while starting).",
        flags: [["on", "Start recording now"], ["off", "Stop recording"], ["status", "Is it on and how many minutes are left"]],
        examples: [["inputlog on", "Start, then repeat the problem"], ["logs input", "Read what was recorded"]], see: ["logs"]},
    ps: {cat: "system", summary: "Running processes", usage: "ps", about: "Number, state, user and name of every process of the system.",
        flags: [], examples: [], see: ["jobs", "devices"]},
    groups: {cat: "system", summary: "Who you are and your rights", usage: "groups",
        about: "Your name, whether you are an administrator, whether sudo is active and how you signed in.", flags: [], examples: [], see: ["whoami", "sudo"]},
    devices: {cat: "system", summary: "Devices attached to the computer", usage: "devices [-m]",
        about: "Monitors, drives, speakers, modems and other peripherals with their type.",
        flags: [["-m", "Also list what each device can do (its methods)"]], examples: [], see: ["df", "fetch"]},
    uname: {cat: "system", summary: "System name and version", usage: "uname [-a]", about: "Prints the system name.",
        flags: [["-a", "Everything: version, CC version and computer number"]], examples: [], see: ["fetch"]},
    whoami: {cat: "system", summary: "Your user name", usage: "whoami", about: "Prints the name you are signed in with.", flags: [], examples: [], see: ["hostname"]},
    hostname: {cat: "system", summary: "The computer's name", usage: "hostname", about: "Prints the computer label, or cubeos when it has none.",
        flags: [], examples: [], see: ["whoami"]},
    uptime: {cat: "system", summary: "How long the computer has been on", usage: "uptime", about: "Hours, minutes and seconds since the start.",
        flags: [], examples: [], see: ["fetch"]},
    shutdown: {cat: "system", summary: "Turn the computer off properly", usage: "shutdown",
        about: "Closes programs and services, saves what they need to save, then turns the computer off.", flags: [], examples: [],
        see: ["reboot"]},
    poweroff: {cat: "system", summary: "Same as shutdown", usage: "poweroff", about: "Turns the computer off properly.", flags: [], examples: [],
        see: ["shutdown"]},
    reboot: {cat: "system", summary: "Restart the computer properly", usage: "reboot",
        about: "Closes programs and services, then starts the computer again.", flags: [], examples: [], see: ["shutdown"]},
    restart: {cat: "system", summary: "Same as reboot", usage: "restart", about: "Restarts the computer properly.", flags: [], examples: [],
        see: ["reboot"]},
    locale: {cat: "system", summary: "Language of the shell and its help", usage: "locale [set LANG | list]",
        about: "Shows or changes your language: en (English), ru (Russian), uk (Ukrainian). Translations need the pixel terminal; in text mode the text stays English because plain CC cannot draw Cyrillic.",
        flags: [["set LANG", "Use this language from now on (saved in your settings)"], ["list", "Languages that have translations"]],
        examples: [["locale set ru", "Switch to Russian"]], see: ["help"]},

    # ------------------------------------------------------------ время
    date: {cat: "time", summary: "Date and time", usage: "date [-u] [-s] [+FORMAT]",
        about: "Prints the date and time in your time zone (see timedatectl). A +FORMAT uses % codes: %Y year, %m month, %d day, %H hour, %M minute, %S second, %A weekday, %B month name.",
        flags: [["-u", "In UTC instead of your zone"], ["-s", "With seconds"], ["+FORMAT", "Your own format, for example +%H:%M"]],
        examples: [["date", "Now"], ["date +%d.%m.%Y", "Only the date, like 15.10.2026"]], see: ["timedatectl"]},
    cal: {cat: "time", summary: "Calendar of a month", usage: "cal [month [year]]",
        about: "This month, or the one you ask for; today is highlighted. The week starts on the day set in time.conf.", flags: [],
        examples: [["cal", "This month"], ["cal 12 2026", "December 2026"]], see: ["date"]},
    timedatectl: {cat: "time", summary: "Time zone and clock settings", usage: "timedatectl [command]",
        about: "Without a command shows the time zone, summer time, the clock source and the in-game time. All world time zones are known; find yours by country or city.",
        flags: [["status", "Show the settings (the same as no command)"], ["set-timezone ZONE", "Zone name (Europe/Kyiv), offset (+03:00) or a country with one zone (japan)"],
            ["list-timezones [WORD]", "Zones with their country and offset; WORD filters by name, country or code (ua)"],
            ["set-source utc|ingame", "Real time, or the Minecraft day and time"], ["set-seconds on|off", "Show seconds in clocks"],
            ["set-format 12h|24h", "12 or 24 hour clock"]],
        examples: [["timedatectl list-timezones germany", "Zones of Germany"], ["timedatectl set-timezone Europe/Moscow", "Moscow time"]],
        see: ["date"]},

    # ------------------------------------------------------------ программы и задачи
    jobs: {cat: "jobs", summary: "Programs running in the background", usage: "jobs",
        about: "Lists the jobs of this shell with their numbers (%1, %2...) and state.", flags: [], examples: [], see: ["fg", "bg", "kill"]},
    fg: {cat: "jobs", summary: "Bring a job to the front", usage: "fg [%N]", about: "Continues a stopped or background job in the front.",
        flags: [], examples: [["fg %1", "Job 1 to the front"]], see: ["jobs", "bg"]},
    bg: {cat: "jobs", summary: "Continue a stopped job in the background", usage: "bg [%N]",
        about: "A job stopped with Ctrl+Z goes on running in the background.", flags: [], examples: [["bg %1", "Continue job 1"]], see: ["jobs", "fg"]},
    kill: {cat: "jobs", summary: "Stop a job", usage: "kill %N", about: "Asks the job to finish (like Ctrl+T for the front program).",
        flags: [], examples: [["kill %2", "Stop job 2"]], see: ["jobs"]},
    sleep: {cat: "jobs", summary: "Wait some seconds", usage: "sleep seconds", about: "Does nothing for the given time (fractions work: 0.5).",
        flags: [], examples: [["sleep 5 && echo done", "Print after five seconds"]], see: []},
    type: {cat: "jobs", summary: "What a command is", usage: "type command", about: "Says whether a name is a built-in command, an alias or a program file.",
        flags: [], examples: [["type ls", "ls is built in"]], see: ["which", "help"]},
    which: {cat: "jobs", summary: "Same as type", usage: "which command", about: "Says what a command name runs.", flags: [], examples: [], see: ["type"]},

    # ------------------------------------------------------------ оболочка
    help: {cat: "shell", summary: "Help on commands", usage: "help [command | word]",
        about: "Without anything lists the commands by group. With a command name shows its full help; with any other word finds commands about it. Every command also understands --help.",
        flags: [], examples: [["help ls", "All about ls"], ["help time", "Commands about time"], ["grep --help", "The same as help grep"]], see: []},
    clear: {cat: "shell", summary: "Clear the screen", usage: "clear", about: "Empties the screen (Ctrl+L does the same).", flags: [], examples: [], see: []},
    exit: {cat: "shell", summary: "Leave the shell", usage: "exit", about: "Closes the shell and returns to the login screen.", flags: [], examples: [], see: []},
    history: {cat: "shell", summary: "Commands you typed before", usage: "history [-c]",
        about: "Numbered list of earlier commands. Up and Down arrows walk through them, Ctrl+R searches.",
        flags: [["-c", "Forget the whole history"]], examples: [["history | grep cd", "Earlier cd commands"]], see: []},
    alias: {cat: "shell", summary: "Short names for commands", usage: "alias [name=command]",
        about: "Without arguments lists the aliases. An alias lasts until you leave the shell; to keep it, add it to aliases in your cush.conf (/cubeos/users/NAME/cfg/cush.conf).", flags: [],
        examples: [["alias ll=\"ls -l\"", "ll prints a long list"]], see: ["unalias"]},
    unalias: {cat: "shell", summary: "Remove an alias", usage: "unalias name", about: "Forgets a short name made with alias.", flags: [], examples: [],
        see: ["alias"]},
    export: {cat: "shell", summary: "Set a variable", usage: "export NAME=value", about: "Sets a shell variable; use it as $NAME.", flags: [],
        examples: [["export GREETING=hi", "Then: echo $GREETING"]], see: ["unset", "env"]},
    unset: {cat: "shell", summary: "Remove a variable", usage: "unset NAME", about: "Forgets a variable.", flags: [], examples: [], see: ["export"]},
    env: {cat: "shell", summary: "List the variables", usage: "env", about: "Prints all shell variables with their values.", flags: [], examples: [],
        see: ["export"]},
    "true": {cat: "shell", summary: "Do nothing, successfully", usage: "true", about: "Exit code 0; useful in scripts.", flags: [], examples: [], see: ["false"]},
    "false": {cat: "shell", summary: "Do nothing, unsuccessfully", usage: "false", about: "Exit code 1; useful in scripts.", flags: [], examples: [], see: ["true"]},

    # ------------------------------------------------------------ пользователи и защита
    sudo: {cat: "users", summary: "Run a command as administrator", usage: "sudo [-k] command [args...]",
        about: "Runs one command with administrator rights. It asks for your password unless you signed in with your password (then you already proved who you are) or used sudo in the last 5 minutes. Only administrators can use it.",
        flags: [["-k", "Forget the rights now, so the next sudo asks again"]],
        examples: [["sudo ls /cubeos/var/log", "Look into a folder only administrators may read"], ["sudo autologin off", "Change a system setting"]],
        see: ["passwd", "autologin"]},
    passwd: {cat: "users", summary: "Change your password", usage: "passwd",
        about: "Asks for the current password and the new one twice. The password is what sudo, recovery and CraftOS ask for; with a PIN you sign in with the PIN.",
        flags: [], examples: [], see: ["pin", "remember"]},
    pin: {cat: "users", summary: "A short PIN for signing in", usage: "pin [set | remove]",
        about: "With a PIN you sign in and unlock with it instead of your long password; the password stays for sudo, recovery and CraftOS. After 5 wrong PINs the login asks for the password, which unlocks the PIN again.",
        flags: [["set", "Choose a PIN (4 or more characters)"], ["remove", "Sign in with the password again"]],
        examples: [["pin set", "Choose your PIN"]], see: ["passwd", "remember"]},
    remember: {cat: "users", summary: "Do not ask for the password again for a while", usage: "remember [MINUTES | off]",
        about: "After you sign in, the login does not ask again for this many minutes (choose your name and you are in). Off by default. Anyone near the computer can use this time, so keep it short if your data matters.",
        flags: [["MINUTES", "How long, for example 30"], ["off", "Always ask"]], examples: [["remember 30", "Half an hour without the password"]],
        see: ["pin", "autologin"]},
    autologin: {cat: "users", summary: "Sign one user in automatically at start", usage: "autologin NAME | off  (with sudo)",
        about: "The computer signs this user in by itself when it starts, without the login screen. Needs administrator rights (sudo). Anyone who starts the computer gets this account.",
        flags: [["NAME", "The user to sign in"], ["off", "Show the login screen again"]], examples: [["sudo autologin steve", "Steve is signed in at start"]],
        see: ["remember", "sudo"]},
    disk: {cat: "users", summary: "Floppy disks and booting from them", usage: "disk [list | trust [SIDE] | untrust ID | boot MODE]",
        about: "Lists disks in the drives. A trusted disk with a startup program may start instead of CubeOS. Booting from disks: off (default), trusted (only trusted disks), password (others need the administrator password), all (any disk). Changing trust and the mode needs sudo.",
        flags: [["list", "Disks in the drives, with their number and label"], ["trust [SIDE]", "Trust this disk (by number and the contents of its startup)"],
            ["untrust ID", "Stop trusting disk number ID"], ["boot MODE", "off, trusted, password or all"]],
        examples: [["sudo disk trust", "Trust the inserted disk"], ["sudo disk boot trusted", "Only trusted disks may boot"]],
        see: ["sudo"]},
}

# подсказки к строке и клавишам для help без аргументов (тоже переводятся)
export const LINE_HELP = [
    ["|", "pass the output to the next command"],
    ["> >>", "write or add the output to a file"],
    ["&", "run in the background"],
    ["; && ||", "then / if it worked / if it failed"],
]
export const KEY_HELP = [
    ["Tab", "complete a name"],
    ["Up / Down", "earlier commands; Ctrl+R searches them"],
    ["Ctrl+C", "copy the selection, or stop the program / reset the line"],
    ["Ctrl+V", "paste from Windows (all lines with the MothPaste mod; Enter runs them)"],
    ["Ctrl+Shift+C / V", "copy / paste"],
    ["Ctrl+A / X", "select the whole line / cut the selection"],
    ["Ctrl+Z / Y", "undo / redo in the line"],
    ["Ctrl+Backspace", "delete a word (Ctrl+Delete: the word to the right)"],
    ["Ctrl+T", "stop the program; hold it to kill a stuck program or restart the shell"],
    ["Ctrl+Z", "pause the program (fg / bg continue it)"],
    ["Ctrl+Shift", "switch the keyboard layout (press and release)"],
    ["Shift+PgUp / PgDn", "scroll the screen"],
    ["Drag a file", "drop files from Windows onto the computer window: they are saved in the current folder, all lines"],
]
