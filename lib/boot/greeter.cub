# boot.greeter: текстовый экран входа и первичная настройка (до появления библиотеки интерфейса)
#
#   g = TextGreeter(console, auth, sessions)
#   result = g:login()      сессия (открытая), или {action: "shutdown"|"reboot"}, или nil (повторить показ)
#
# Тексты английские: родной терминал CC не умеет русские буквы (решение D135); локализованный экран входа
# придёт вместе с графической и плиточной библиотекой интерфейса.

import boot.auth as auth_mod

export class TextGreeter:
    # opts: title (по умолчанию "CubeOS"), allow_guest (true), retries (3), notice (строка под заголовком, например про грязное выключение)
    def init(self, console, auth, sessions, opts=nil):
        o = opts ?? {}
        self.console = console
        self.auth = auth
        self.sessions = sessions
        self.title = o.title ?? "CubeOS"
        self.retries = o.retries ?? 3
        self.notice = o.notice
        # busy(текст или nil): долгая проверка пароля (PBKDF2), ядро не пишет «не отвечает»
        self.busy = o.busy

    def _open(self, name, password, pin=false):
        if self.busy != nil:
            self.busy(pin and "checking the PIN" or "checking the password")
        s = nil
        why = nil
        wait = nil
        if pin:
            s, why, wait = self.sessions:open_pin(name, password)
        else:
            s, why, wait = self.sessions:open(name, password)
        if self.busy != nil:
            self.busy(nil)
        return s, why, wait

    def _secret_prompt(self, rec):
        if self.auth:pin_locked(rec.name):
            return "Password for " .. rec.display .. " (too many wrong PINs): "
        return "PIN or password for " .. rec.display .. ": "

    def _wrong(self, why, left, wait):
        if why == "locked":
            return "Too many attempts. Wait " .. tostring(wait) .. " s."
        if left == 0:
            return "Wrong PIN or password. Too many wrong PINs: now only the password works."
        return "Wrong PIN or password." .. (left != nil and (" PIN tries left: " .. left) or "")

    # одно поле: PIN или пароль
    def _secret_login(self, rec):
        c = self.console
        for attempt in range[1, self.retries]:
            secret = c:read_line(self:_secret_prompt(rec), true)
            if secret == nil:
                return nil
            if self.busy != nil:
                self.busy("checking the PIN or password")
            s, why, left, wait = self.sessions:open_secret(rec.name, secret)
            if self.busy != nil:
                self.busy(nil)
            if s != nil:
                return s
            c:write_line(self:_wrong(why, left, wait))
            if why == "locked":
                return nil
        return nil

    # PIN (D226): «p» вместо PIN переходит к паролю; после 5 неверных PIN только пароль. nil, если надо спросить пароль
    def _pin_login(self, rec):
        c = self.console
        for attempt in range[1, self.retries]:
            pin = c:read_line("PIN for " .. rec.display .. " (p: use the password): ", true)
            if pin == nil:
                return nil, true
            if string.lower(pin) == "p":
                return nil
            s, why, left = self:_open(rec.name, pin, true)
            if s != nil:
                return s
            if why == "pin locked":
                c:write_line("Too many wrong PINs. Sign in with your password.")
                return nil
            c:write_line("Wrong PIN." .. (left != nil and (" Tries left: " .. left) or ""))
        return nil, true

    def _header(self):
        self.console:clear()
        self.console:write_line(self.title)
        if self.notice != nil:
            self.console:write_line(self.notice)
        self.console:write_line("")

    # первая загрузка: создаём первого пользователя-администратора
    def first_run(self):
        c = self.console
        self:_header()
        c:write_line("Welcome! Create the first account (administrator).")
        while true:
            display = c:read_line("Your name (shown on the screen): ")
            if display == nil:
                return nil
            name = self:_account_for(display)
            if name == nil:
                return nil
            password = c:read_line("Password (empty for none): ", true)
            if password == nil:
                return nil
            if password != "":
                again = c:read_line("Repeat the password: ", true)
                if again != password:
                    c:write_line("The passwords do not match.")
                    continue
            ok, err = pcall(() => self.auth:create_user({name: name, display: display}, password != "" and password or nil, true))
            if not ok:
                c:write_line("Cannot create the account: " .. tostring(err))
                continue
            return self.sessions:open(name, password != "" and password or nil)

    # имя учётной записи для отображаемого имени (D236): латинское имя подходит как есть; иначе объясняем разницу и предлагаем
    # транслитерацию (Enter соглашается). nil, если ввод отменён
    def _account_for(self, display):
        c = self.console
        if auth_mod.account_problem(display) == nil and self.auth:user(display) == nil:
            return display
        suggestion = auth_mod.suggest_account(display, self.auth)
        c:write_line("")
        c:write_line("Two names: the one above is only shown on the screen.")
        c:write_line("The account name is for signing in, folders and sudo:")
        c:write_line("Latin letters, digits, - and _ (it cannot be changed later).")
        while true:
            entered = c:read_line("Account name [" .. suggestion .. "]: ")
            if entered == nil:
                return nil
            name = entered == "" and suggestion or entered
            problem = auth_mod.account_problem(name)
            if problem == nil and self.auth:user(name) != nil:
                problem = "this account name is taken"
            if problem == nil:
                return name
            c:write_line("Cannot use it: " .. problem)

    def login(self):
        c = self.console
        if not self.auth:has_users():
            return self:first_run()
        self:_header()
        users = self.auth:list()
        for i, u in users:
            # отображаемое имя и, если оно другое, имя учётной записи (обычный терминал CC не рисует кириллицу)
            shown = u.display != u.name and (u.display .. " (" .. u.name .. ")") or u.name
            c:write_line("  " .. i .. ". " .. shown .. (u.temp and " (guest)" or ""))
        c:write_line("  s. Shut down")
        c:write_line("  r. Restart")
        c:write_line("")
        choice = c:read_line("User (number or name): ")
        if choice == nil:
            return nil
        lowered = string.lower(choice)
        if lowered == "s" or lowered == "shutdown":
            return {action: "shutdown"}
        if lowered == "r" or lowered == "reboot" or lowered == "restart":
            return {action: "reboot"}
        name = nil
        n = tonumber(choice)
        if n != nil and users[n] != nil:
            name = users[n].name
        elif self.auth:find(choice) != nil:
            name = self.auth:find(choice).name
        if name == nil:
            c:write_line("No such user.")
            return nil
        rec = self.auth:user(name)
        # «не спрашивать X минут после входа» (D227)
        if self.sessions.remembered != nil and self.sessions:remembered(rec.name):
            s = self.sessions:open(rec.name, nil, true, "remember")
            if s != nil:
                return s
        # PIN и пароль в одном поле (D247): что совпало, тем и вошли (пароль даёт sudo без вопроса, как раньше)
        if self.auth.has_pin != nil and self.auth:has_pin(rec.name):
            return self:_secret_login(rec)
        # без пароля: входим сразу
        if self.auth.shadow[rec.name] == nil:
            s, why = self.sessions:open(name, "")
            if s != nil:
                return s
            c:write_line("Cannot sign in: " .. tostring(why))
            return nil
        for attempt in range[1, self.retries]:
            password = c:read_line("Password for " .. rec.display .. ": ", true)
            if password == nil:
                return nil
            s, why, wait = self:_open(name, password)
            if s != nil:
                return s
            if why == "locked":
                c:write_line("Too many attempts. Wait " .. tostring(wait) .. " s.")
                return nil
            c:write_line("Wrong password.")
        return nil

    # блокировка (D226, команда lock): тот же экран входа с уже выбранным пользователем; снимается PIN (p: пароль) или паролем.
    # Возвращает true, когда разблокировано (до этого спрашивает снова)
    def unlock(self, s):
        c = self.console
        mgr = self.sessions
        rec = self.auth:user(s.user) ?? {name: s.user, display: s.display}
        has_pin = self.auth.has_pin != nil and self.auth:has_pin(s.user)
        note = nil
        while true:
            self:_header()
            c:write_line("Locked: " .. tostring(s.display ?? s.user))
            c:write_line("")
            if note != nil:
                c:write_line(note)
                c:write_line("")
            prompt = has_pin and self:_secret_prompt({name: s.user, display: s.display ?? s.user}) or ("Password for " .. tostring(s.display) .. ": ")
            secret = c:read_line(prompt, true)
            if secret != nil:
                if self.busy != nil:
                    self.busy("checking the PIN or password")
                ok, why, extra = mgr:unlock(s.id, secret)
                if self.busy != nil:
                    self.busy(nil)
                if ok:
                    return true
                note = why == "locked" and self:_wrong(why, nil, extra) or self:_wrong(why, extra, nil)
                if not has_pin:
                    note = why == "locked" and note or "Wrong password."

export def new(console, auth, sessions, opts=nil):
    return TextGreeter(console, auth, sessions, opts)
