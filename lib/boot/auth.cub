# boot.auth: учётные записи, пароли, повышение прав
#
# Файлы (читает и пишет только система):
#   /cubeos/sys/cfg/users.conf       список пользователей: имя, подпись, роли, группы, цвет плитки, флаги (JSON5)
#   /cubeos/sys/sec/shadow.lock      хэши паролей: имя -> "pbkdf2-sha256$раунды$соль$хэш"
#   /cubeos/sys/sec/sudoers.lock     администраторы: {admins: [имена]}
#   /cubeos/sys/sec/pins.lock        PIN для входа (D226): имя -> {hash, fails}; после PIN_TRIES неверных PIN вход только по паролю
#
# PIN нужен только для входа и разблокировки; пароль остаётся для sudo, восстановления и CraftOS. Без PIN вход по паролю.
# Пользователь без записи в shadow.lock это пользователь без пароля (например, гость).
# Пароль проверяется через PBKDF2-HMAC-SHA256; после трёх неудач вход замедляется (пауза растёт вдвое, не больше минуты).
#
#   auth = Auth(fsys, {rounds: 1000})
#   auth:load()
#   ok, err = auth:verify("ivan", "secret")
#   subject = auth:subject_for("ivan")          субъект CFS (роли user и группы)
#   subject2 = auth:subject_for("ivan", true)   с ролью admin (повышение прав, пользователь обязан быть администратором)

import sha256
import json5
import unicode
import cfs.rules as rules_mod
import cfs.path as paths
import cfs.atomic as atomic
import cfs.journal as journal
import input.layout as layout_mod

export const USERS_PATH = "/cubeos/sys/cfg/users.conf"
export const SHADOW_PATH = "/cubeos/sys/sec/shadow.lock"
export const SUDOERS_PATH = "/cubeos/sys/sec/sudoers.lock"
export const PINS_PATH = "/cubeos/sys/sec/pins.lock"
export const PIN_TRIES = 5
export const PIN_MIN = 4
export const JOURNAL_DIR = "/cubeos/var/journal"

def _default_clock():
    return os.epoch("utc")

def _default_entropy():
    # в CC нет генератора случайных чисел операционной системы: смешиваем время, счётчики и math.random
    return sha256.hex(tostring(os.epoch("utc")) .. ":" .. tostring(os.clock()) .. ":" .. tostring(math.random()) .. ":" .. tostring(os.getComputerID()))

def _from_hex(h):
    return (string.gsub(h, "..", (pair) => string.char(tonumber(pair, 16))))

# сравнение без досрочного выхода
def _same(a, b):
    if len(a) != len(b):
        return false
    diff = 0
    for i in range[1, len(a)]:
        if string.byte(a, i) != string.byte(b, i):
            diff += 1
    return diff == 0

# имя учётной записи (D236): только латиница, цифры, - и _, с буквы, до 32 символов. Это имя папки профиля и имя для sudo;
# на экране показывается отдельное отображаемое имя (display), оно может быть любым, хоть по-русски
export def account_problem(name):
    if name == nil or name == "":
        return "the account name is empty"
    if len(name) > 32:
        return "the account name is longer than 32 characters"
    if string.match(name, "^[A-Za-z][A-Za-z0-9_%-]*$") == nil:
        return "the account name must start with a Latin letter and use only Latin letters, digits, - and _"
    return nil

# латинское имя учётной записи по отображаемому: транслитерация (раскладки языков), нижний регистр, пробелы в «-»;
# если занято, добавляется 2, 3... (никаких случайных цифр)
export def suggest_account(display, auth=nil):
    base = string.lower(layout_mod.transliterate(display ?? ""))
    base = string.gsub(base, "%s+", "-")
    base = string.gsub(base, "[^a-z0-9_%-]", "")
    base = string.gsub(base, "%-+", "-")
    base = string.gsub(base, "^[^a-z]+", "")
    base = string.gsub(base, "%-$", "")
    if base == "":
        base = "user"
    base = string.sub(base, 1, 24)
    name = base
    n = 2
    while auth != nil and auth:user(name) != nil:
        name = base .. n
        n += 1
    return name

export def make_hash(password, salt_hex, rounds):
    return "pbkdf2-sha256$" .. rounds .. "$" .. salt_hex .. "$" .. sha256.to_hex(sha256.pbkdf2(password, _from_hex(salt_hex), rounds))

# проверка пароля по записи вида pbkdf2-sha256$раунды$соль$хэш
export def check_hash(password, record):
    algo, rounds, salt_hex, want = string.match(record, "^([%w%-]+)%$(%d+)%$(%x+)%$(%x+)$")
    if algo != "pbkdf2-sha256":
        return false
    got = sha256.to_hex(sha256.pbkdf2(password, _from_hex(salt_hex), tonumber(rounds)))
    return _same(got, want)

export const FAILS_PATH = "/cubeos/sys/sec/fails.lock"
export const DISK_KEYS_PATH = "/cubeos/sys/sec/disk_keys.lock"
export const KEY_MODES = {key: true, "key+pin": true}
const KEEP_OLD = 5

export class Auth:
    # opts: rounds (по умолчанию 1000), clock, entropy, min_password (по умолчанию 1), paths {users, shadow, sudoers}
    def init(self, fsys, opts=nil):
        o = opts ?? {}
        self.fsys = fsys
        self.rounds = o.rounds ?? 1000
        self.clock = o.clock ?? _default_clock
        self.entropy = o.entropy ?? _default_entropy
        self.min_password = o.min_password ?? 1
        self.users_path = (o.paths ?? {}).users ?? USERS_PATH
        self.shadow_path = (o.paths ?? {}).shadow ?? SHADOW_PATH
        self.sudoers_path = (o.paths ?? {}).sudoers ?? SUDOERS_PATH
        self.pins_path = (o.paths ?? {}).pins ?? PINS_PATH
        self.fails_path = (o.paths ?? {}).fails ?? FAILS_PATH
        self.disk_keys_path = (o.paths ?? {}).disk_keys ?? DISK_KEYS_PATH
        self.disk_keys = {}
        self.pins = {}
        self.records = []
        self.shadow = {}
        self.admins = {}
        self.fails = {}
        self.counter = 0

    # ------------------------------------------------------------ чтение и запись

    def _read(self, path):
        if not self.fsys:exists(nil, path):
            return nil
        return self.fsys:read_file(nil, path)

    def load(self):
        text = self:_read(self.users_path)
        self.records = []
        if text != nil:
            data = json5.parse(text)
            for rec in data.users ?? []:
                self.records[len(self.records) + 1] = rec
        text = self:_read(self.shadow_path)
        self.shadow = text != nil and json5.parse(text) or {}
        text = self:_read(self.pins_path)
        self.pins = text != nil and json5.parse(text) or {}
        text = self:_read(self.fails_path)
        ok_f, data_f = pcall(() => text != nil and json5.parse(text) or {})
        self.fails = ok_f and type(data_f) == "table" and data_f or {}
        text = self:_read(self.disk_keys_path)
        ok_k, data_k = pcall(() => text != nil and json5.parse(text) or {})
        self.disk_keys = ok_k and type(data_k) == "table" and data_k or {}
        text = self:_read(self.sudoers_path)
        self.admins = {}
        if text != nil:
            for name in (json5.parse(text).admins ?? []):
                self.admins[name] = true

    # три файла меняются одной фиксацией журнала операций: после отключения питания будут либо все новые, либо все старые (D201)
    def save(self):
        names = []
        for name, flag in self.admins:
            names[len(names) + 1] = name
        table.sort(names)
        store = atomic.fsys_io(self.fsys, nil)
        txn = journal.new(store, JOURNAL_DIR):begin("accounts")
        for pair in [[self.users_path, {users: self.records}], [self.shadow_path, self.shadow], [self.sudoers_path, {admins: names}],
                [self.pins_path, self.pins]]:
            store.mkdir(paths.parent(pair[1]))
            txn:write(pair[1], json5.stringify(pair[2], {json5: true, indent: 2}) .. "\n")
        txn:commit()

    # ------------------------------------------------------------ неверные попытки (D248): на диске, чтобы Ctrl+R их не сбрасывал
    # fails[имя] = {count (подряд, для паузы), until (мс, до этого не проверять), total (с прошлого входа), last (мс последней)}

    def _save_fails(self):
        let me = self
        pcall(() => me.fsys:mkdir(nil, paths.parent(me.fails_path), {parents: true}))
        pcall(() => me.fsys:write_file(nil, me.fails_path, json5.stringify(me.fails) .. "\n"))

    # неверная попытка: пауза после третьей подряд 5 с, дальше вдвое, но не больше минуты; возвращает паузу в мс
    def _failed(self, name, t, pause=true):
        f = self.fails[name] ?? {}
        f.total = (f.total ?? 0) + 1
        f.last = t
        wait = 0
        if pause:
            f.count = (f.count ?? 0) + 1
            if f.count >= 3:
                wait = math.min(60000, 5000 * 2 ** (f.count - 3))
            f.until = t + wait
        self.fails[name] = f
        self:_save_fails()
        return wait

    def _succeeded(self, name):
        f = self.fails[name]
        if f != nil and ((f.count ?? 0) > 0 or (f.until ?? 0) > 0):
            f.count = 0
            f.until = 0
            self:_save_fails()

    # сколько было неверных попыток с прошлого входа и когда последняя: {total, last} или nil; счёт начинается заново
    def take_failures(self, name):
        rec = self:user(name)
        f = rec != nil and self.fails[rec.name] or nil
        if f == nil or (f.total ?? 0) == 0:
            return nil
        res = {total: f.total, last: f.last}
        f.total = 0
        self:_save_fails()
        return res

    # ------------------------------------------------------------ ключ-дискета (D248)
    # disk_keys[имя] = [{id (номер дискеты), hash (секрета), next (новый, пока он пишется на дискету), old (прошлые хэши: так видна
    # копия), mode ("key": вместо пароля, "key+pin": вместе с PIN), label, created, used, copied (когда пытались войти копией)}]

    def _save_keys(self):
        let me = self
        pcall(() => me.fsys:mkdir(nil, paths.parent(me.disk_keys_path), {parents: true}))
        me.fsys:write_file(nil, me.disk_keys_path, json5.stringify(me.disk_keys) .. "\n")

    # новый секрет для дискеты: 64 шестнадцатеричных знака
    def new_secret(self):
        self.counter += 1
        return sha256.hex(self.entropy() .. ":" .. self.counter .. ":" .. tostring(self.clock()))

    def has_disk_keys(self):
        for name, list in self.disk_keys:
            if len(list) > 0:
                return true
        return false

    # дискета с этим номером становится ключом пользователя (у другого пользователя она ключом быть перестаёт)
    def add_disk_key(self, name, id, secret, mode="key", label=nil):
        rec = self:user(name)
        if rec == nil:
            raise Error("no such user: " .. tostring(name))
        if not KEY_MODES[mode]:
            raise Error("the key mode is key or key+pin")
        for user, list in self.disk_keys:
            keep = []
            for k in list:
                if k.id != id:
                    keep[len(keep) + 1] = k
            self.disk_keys[user] = keep
        list = self.disk_keys[rec.name] ?? []
        list[len(list) + 1] = {id: id, hash: sha256.hex(secret), old: [], mode: mode, label: label, created: self.clock()}
        self.disk_keys[rec.name] = list
        self:_save_keys()

    def remove_disk_key(self, name, id):
        rec = self:user(name)
        keep = []
        found = false
        for k in (rec != nil and self.disk_keys[rec.name] or nil) ?? []:
            if k.id == id:
                found = true
            else:
                keep[len(keep) + 1] = k
        if found:
            self.disk_keys[rec.name] = keep
            self:_save_keys()
        return found

    def list_disk_keys(self, name):
        rec = self:user(name)
        out = []
        for k in (rec != nil and self.disk_keys[rec.name] or nil) ?? []:
            out[len(out) + 1] = {id: k.id, mode: k.mode, label: k.label, created: k.created, used: k.used}
        return out

    # PIN действует только вместе с дискетой
    def pin_needs_key(self, name):
        for k in self.disk_keys[name] ?? []:
            if k.mode == "key+pin":
                return true
        return false

    # проверка дискеты: {name, mode, key} или nil и причина ("unknown key", "bad key", "copied": это старая копия)
    def check_disk_key(self, id, user, secret):
        rec = self:user(user)
        if rec == nil:
            return nil, "unknown key"
        h = sha256.hex(tostring(secret))
        for k in self.disk_keys[rec.name] ?? []:
            if k.id == id:
                if _same(h, k.hash) or (k.next != nil and _same(h, k.next)):
                    return {name: rec.name, mode: k.mode, key: k}
                for o in k.old ?? []:
                    if _same(h, o):
                        k.copied = self.clock()
                        self:_save_keys()
                        return nil, "copied"
                return nil, "bad key"
        return nil, "unknown key"

    # смена секрета: сначала запоминается новый (next), потом он пишется на дискету, потом становится главным
    def begin_rotate(self, k, secret):
        k.next = sha256.hex(secret)
        self:_save_keys()

    def finish_rotate(self, k):
        old = k.old ?? []
        table.insert(old, 1, k.hash)
        while len(old) > KEEP_OLD:
            table.remove(old)
        k.old = old
        k.hash = k.next ?? k.hash
        k.next = nil
        k.used = self.clock()
        self:_save_keys()

    # пытались войти старой копией дискеты: когда (последний раз) или nil; сообщается один раз
    def take_key_alert(self, name):
        rec = self:user(name)
        when_ = nil
        changed = false
        for k in (rec != nil and self.disk_keys[rec.name] or nil) ?? []:
            if k.copied != nil:
                when_ = math.max(when_ ?? 0, k.copied)
                k.copied = nil
                changed = true
        if changed:
            self:_save_keys()
        return when_

    # ------------------------------------------------------------ пользователи

    def has_users(self):
        return len(self.records) > 0

    def user(self, name):
        lowered = unicode.lower(name)
        for rec in self.records:
            if unicode.lower(rec.name) == lowered:
                return rec
        return nil

    # по имени учётной записи или по отображаемому имени (на экране входа можно набрать любое)
    def find(self, text):
        rec = self:user(text)
        if rec != nil:
            return rec
        lowered = unicode.lower(text)
        for r in self.records:
            if r.display != nil and unicode.lower(r.display) == lowered:
                return r
        return nil

    # публичные сведения для экрана входа (без хэшей)
    def list(self):
        out = []
        for rec in self.records:
            out[len(out) + 1] = {name: rec.name, display: rec.display ?? rec.name, color: rec.color, temp: rec.temp ?? false,
                passwordless: self.shadow[rec.name] == nil, admin: self.admins[rec.name] == true, roles: rec.roles ?? ["user"]}
        return out

    def is_admin(self, name):
        return self.admins[name] == true

    def _salt(self):
        self.counter += 1
        return string.sub(sha256.hex(self.entropy() .. ":" .. self.counter), 1, 32)

    # record: {name, display?, roles?, groups?, color?, temp?}; admin: сделать администратором; password: nil без пароля
    def create_user(self, record, password=nil, admin=false):
        problem = account_problem(record.name)
        if problem != nil:
            raise Error("invalid user name: " .. problem)
        if self:user(record.name) != nil:
            raise Error("user already exists: " .. record.name)
        if password != nil and len(password) < self.min_password:
            raise Error("the password is too short (at least " .. self.min_password .. ")")
        rec = {name: record.name, display: record.display ?? record.name, roles: record.roles ?? ["user"],
            groups: record.groups ?? [], color: record.color, temp: record.temp ?? false}
        self.records[len(self.records) + 1] = rec
        if password != nil:
            self.shadow[record.name] = make_hash(password, self:_salt(), self.rounds)
        if admin:
            self.admins[record.name] = true
        self:save()
        return rec

    def set_password(self, name, password):
        rec = self:user(name)
        if rec == nil:
            raise Error("no such user: " .. name)
        if password == nil or password == "":
            self.shadow[rec.name] = nil
        else:
            if len(password) < self.min_password:
                raise Error("the password is too short (at least " .. self.min_password .. ")")
            self.shadow[rec.name] = make_hash(password, self:_salt(), self.rounds)
        self.fails[rec.name] = nil
        self:save()

    def set_admin(self, name, flag):
        rec = self:user(name)
        if rec == nil:
            raise Error("no such user: " .. name)
        self.admins[rec.name] = flag and true or nil
        self:save()

    def delete_user(self, name):
        rec = self:user(name)
        if rec == nil:
            return false
        for i, r in self.records:
            if r == rec:
                table.remove(self.records, i)
                break
        self.shadow[rec.name] = nil
        self.admins[rec.name] = nil
        self.pins[rec.name] = nil
        self:save()
        return true

    # ------------------------------------------------------------ PIN (D226)

    def has_pin(self, name):
        rec = self:user(name)
        return rec != nil and self.pins[rec.name] != nil

    def pin_locked(self, name):
        rec = self:user(name)
        p = rec != nil and self.pins[rec.name] or nil
        return p != nil and (p.fails ?? 0) >= PIN_TRIES

    # pin nil или "": убрать PIN (вход снова по паролю)
    def set_pin(self, name, pin):
        rec = self:user(name)
        if rec == nil:
            raise Error("no such user: " .. name)
        if pin == nil or pin == "":
            self.pins[rec.name] = nil
        else:
            if unicode.length(pin) < PIN_MIN:
                raise Error("the PIN is too short (at least " .. PIN_MIN .. ")")
            self.pins[rec.name] = {hash: make_hash(pin, self:_salt(), self.rounds), fails: 0}
        self:save()

    # true или false и причина: "no pin", "pin locked" (нужен пароль), "bad pin" (третье значение: сколько попыток осталось)
    def verify_pin(self, name, pin):
        rec = self:user(name)
        if rec == nil:
            return false, "unknown"
        p = self.pins[rec.name]
        if p == nil:
            return false, "no pin"
        if (p.fails ?? 0) >= PIN_TRIES:
            return false, "pin locked"
        if pin != nil and pin != "" and check_hash(pin, p.hash):
            if (p.fails ?? 0) > 0:
                p.fails = 0
                self:save()
            return true
        p.fails = (p.fails ?? 0) + 1
        self:save()
        self:_failed(rec.name, self.clock(), false)
        if p.fails >= PIN_TRIES:
            return false, "pin locked"
        return false, "bad pin", PIN_TRIES - p.fails

    # поле учётной записи (например remember_minutes), без хэшей
    def set_field(self, name, key, value):
        rec = self:user(name)
        if rec == nil:
            raise Error("no such user: " .. name)
        rec[key] = value
        self:save()

    # ------------------------------------------------------------ проверка

    # возвращает true или false и причину: "unknown", "bad password", "locked" (поле wait: секунд до следующей попытки)
    def verify(self, name, password):
        rec = self:user(name)
        if rec == nil:
            return false, "unknown"
        t = self.clock()
        fail = self.fails[rec.name]
        if fail != nil and (fail.until ?? 0) > t:
            return false, "locked", math.ceil((fail.until - t) / 1000)
        stored = self.shadow[rec.name]
        ok = false
        if stored == nil:
            ok = password == nil or password == ""
        else:
            ok = password != nil and check_hash(password, stored)
        if ok:
            self:_succeeded(rec.name)
            # верный пароль снимает блокировку PIN
            p = self.pins[rec.name]
            if p != nil and (p.fails ?? 0) > 0:
                p.fails = 0
                self:save()
            return true
        wait = self:_failed(rec.name, t)
        return false, "bad password", math.ceil(wait / 1000)

    # одно поле для PIN и пароля (D247): совпал пароль -> "password" (вход «с админкой»), совпал PIN (если не заблокирован) -> "pin".
    # Неверное считается и попыткой пароля, и попыткой PIN. Возвращает способ или nil, причину ("bad secret", "locked", "unknown"),
    # сколько попыток PIN осталось (nil, если PIN нет или он заблокирован) и сколько секунд ждать до следующей попытки
    def verify_secret(self, name, secret, key_ok=false):
        rec = self:user(name)
        if rec == nil:
            return nil, "unknown"
        t = self.clock()
        fail = self.fails[rec.name]
        if fail != nil and (fail.until ?? 0) > t:
            return nil, "locked", nil, math.ceil((fail.until - t) / 1000)
        stored = self.shadow[rec.name]
        p = self.pins[rec.name]
        pw_ok = false
        if stored == nil:
            pw_ok = secret == nil or secret == ""
        else:
            pw_ok = secret != nil and check_hash(secret, stored)
        if pw_ok:
            self:_succeeded(rec.name)
            if p != nil and (p.fails ?? 0) > 0:
                p.fails = 0
                self:save()
            return "password"
        pin_usable = p != nil and (p.fails ?? 0) < PIN_TRIES and (key_ok or not self:pin_needs_key(rec.name))
        if pin_usable and secret != nil and secret != "" and check_hash(secret, p.hash):
            self:_succeeded(rec.name)
            if (p.fails ?? 0) > 0:
                p.fails = 0
                self:save()
            return "pin"
        wait = self:_failed(rec.name, t)
        left = nil
        if pin_usable:
            p.fails = (p.fails ?? 0) + 1
            self:save()
            left = math.max(0, PIN_TRIES - p.fails)
        return nil, "bad secret", left, math.ceil(wait / 1000)

    # субъект CFS для пользователя; elevated: добавить роль admin (только для администраторов)
    def subject_for(self, name, elevated=false):
        rec = self:user(name)
        if rec == nil:
            raise Error("no such user: " .. name)
        roles = []
        for r in rec.roles ?? ["user"]:
            roles[len(roles) + 1] = r
        if elevated and self.admins[rec.name] == true:
            roles[len(roles) + 1] = "admin"
        return rules_mod.subject(rec.name, roles, rec.groups ?? [])

export def new(fsys, opts=nil):
    return Auth(fsys, opts)
