# boot.console: текстовый ввод и вывод для загрузки и входа (до появления библиотеки интерфейса)
#
# Интерфейс консоли (любой объект с этими методами):
#   write(text), write_line(text), clear()
#   read_line(prompt, hidden) -> строка или nil, если ввод отменён (hidden: показывать звёздочки вместо символов)
#
# ScriptedConsole: для тестов (ввод из списка, вывод копится).
# TermConsole: настоящий терминал CC (term, read).

export class ScriptedConsole:
    def init(self, inputs=nil):
        self.inputs = inputs ?? []
        self.pos = 0
        self.output = []
        self.prompts = []

    def push(self, text):
        self.inputs[len(self.inputs) + 1] = text

    def write(self, text):
        self.output[len(self.output) + 1] = text

    def write_line(self, text):
        self.output[len(self.output) + 1] = text .. "\n"

    def clear(self):
        self.output[len(self.output) + 1] = "<clear>"

    def read_line(self, prompt, hidden=false):
        self.prompts[len(self.prompts) + 1] = prompt
        self.pos += 1
        return self.inputs[self.pos]

    # весь вывод одной строкой
    def text(self):
        return table.concat(self.output)

    def remaining(self):
        return len(self.inputs) - self.pos

# Если задан sys (процесс ядра), ввод идёт через sys.wait_event: read из CC в процессе ядра работать не может
# (он ждёт события напрямую у CC, а не у планировщика). bind(sys) возвращает такую консоль для процесса.
export class TermConsole:
    def init(self, sys=nil):
        self.sys = sys

    def bind(self, sys):
        return TermConsole(sys)

    def _newline(self):
        x, y = term.getCursorPos()
        w, h = term.getSize()
        if y >= h:
            term.scroll(1)
            term.setCursorPos(1, h)
        else:
            term.setCursorPos(1, y + 1)

    def _read_sys(self, prompt, hidden):
        sys = self.sys
        term.write(prompt)
        buf = ""
        # ввод отсюда в журналы не пишется; скрытое поле (пароль) прячется и от журнала ввода (D196, D220)
        if hidden and sys.secret_input != nil:
            sys.secret_input(true)
        while true:
            ev, a = sys.wait_event(["char", "key", "paste"])
            if (ev == "char" or ev == "paste") and type(a) == "string":
                buf = buf .. a
                term.write(hidden and string.rep("*", string.len(a)) or a)
            elif ev == "key":
                if a == keys.enter or a == keys["numPadEnter"]:
                    break
                if a == keys.backspace and string.len(buf) > 0:
                    buf = string.sub(buf, 1, string.len(buf) - 1)
                    x, y = term.getCursorPos()
                    if x > 1:
                        term.setCursorPos(x - 1, y)
                        term.write(" ")
                        term.setCursorPos(x - 1, y)
        if hidden and sys.secret_input != nil:
            sys.secret_input(false)
        self:_newline()
        return buf

    def write(self, text):
        term.write(text)

    def write_line(self, text):
        term.write(text)
        x, y = term.getCursorPos()
        w, h = term.getSize()
        if y >= h:
            term.scroll(1)
            term.setCursorPos(1, h)
        else:
            term.setCursorPos(1, y + 1)

    def clear(self):
        term.clear()
        term.setCursorPos(1, 1)

    def read_line(self, prompt, hidden=false):
        if self.sys != nil:
            return self:_read_sys(prompt, hidden)
        term.write(prompt)
        line = read(hidden and "*" or nil)
        self:_newline()
        return line
