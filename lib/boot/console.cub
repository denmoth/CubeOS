# boot.console: текстовый ввод и вывод для загрузки и входа (до появления библиотеки интерфейса)
#
# Интерфейс консоли (любой объект с этими методами):
#   write(text), write_line(text), clear()
#   read_line(prompt, hidden) -> строка или nil, если ввод отменён (hidden: показывать звёздочки вместо символов)
#
# ScriptedConsole: для тестов (ввод из списка, вывод копится).
# TermConsole: настоящий терминал CC (term, read).

import unicode
import json5
import input.layout as layout_mod

export class ScriptedConsole:
    def init(self, inputs=nil):
        self.inputs = inputs ?? []
        self.pos = 0
        self.output = []
        self.prompts = []

    def push(self, text):
        self.inputs[len(self.inputs) + 1] = text

    def write(self, text):
        self.output[len(self.output) + 1] = text

    def write_line(self, text):
        self.output[len(self.output) + 1] = text .. "\n"

    def clear(self):
        self.output[len(self.output) + 1] = "<clear>"

    def read_line(self, prompt, hidden=false):
        self.prompts[len(self.prompts) + 1] = prompt
        self.pos += 1
        return self.inputs[self.pos]

    # весь вывод одной строкой
    def text(self):
        return table.concat(self.output)

    def remaining(self):
        return len(self.inputs) - self.pos

# Если задан sys (процесс ядра), ввод идёт через sys.wait_event: read из CC в процессе ядра работать не может
# (он ждёт события напрямую у CC, а не у планировщика). bind(sys) возвращает такую консоль для процесса.
# Клавиатура как в терминале (D235): второй язык из /cubeos/sys/cfg/locale.conf; клавиша без символа (Windows печатает не латиницу)
# даёт букву второго языка. opts.layout: готовая раскладка (для тестов), opts.layout_dirs: где файлы раскладок.
export class TermConsole:
    def init(self, sys=nil, opts=nil):
        self.sys = sys
        self.opts = opts ?? {}
        self.layout = self.opts.layout

    def bind(self, sys):
        return TermConsole(sys, self.opts)

    def _layout(self):
        if self.layout == nil:
            conf = {}
            if fs.exists("/cubeos/sys/cfg/locale.conf"):
                f = fs.open("/cubeos/sys/cfg/locale.conf", "r")
                ok, data = pcall(() => json5.parse(f.readAll()))
                f.close()
                if ok and type(data) == "table":
                    conf = data
            self.layout = layout_mod.new(nil, nil, {mode: "auto", keyboard: conf.keyboard ?? "ru", dirs: self.opts.layout_dirs})
        return self.layout

    def _newline(self):
        x, y = term.getCursorPos()
        w, h = term.getSize()
        if y >= h:
            term.scroll(1)
            term.setCursorPos(1, h)
        else:
            term.setCursorPos(1, y + 1)

    def _read_sys(self, prompt, hidden):
        sys = self.sys
        term.write(prompt)
        buf = ""
        # ввод отсюда в журналы не пишется; скрытое поле (пароль) прячется и от журнала ввода (D196, D220)
        if hidden and sys.secret_input != nil:
            sys.secret_input(true)
        lay = self:_layout()
        shift = {on: false}
        pending = []
        def put(text):
            buf = buf .. text
            # кириллицу обычный терминал CC не рисует: видна как «?», в скрытом поле звёздочки по числу букв
            shown = hidden and string.rep("*", unicode.length(text)) or string.gsub(text, "[\128-\255][\128-\191]*", "?")
            term.write(shown)
        while true:
            ev = nil
            a = nil
            if len(pending) > 0:
                nxt = table.remove(pending, 1)
                ev = nxt[1]
                a = nxt[2]
            else:
                ev, a = sys.wait_event(["char", "key", "key_up", "paste"])
            if ev == "char" and type(a) == "string":
                put(lay:translate(a))
            elif ev == "paste" and type(a) == "string":
                put(string.match(a, "^[^\r\n]*"))
            elif ev == "key_up":
                if a == keys.leftShift or a == keys.rightShift:
                    shift.on = false
            elif ev == "key":
                if a == keys.leftShift or a == keys.rightShift:
                    shift.on = true
                elif a == keys.enter or a == keys["numPadEnter"]:
                    break
                elif a == keys.backspace:
                    if string.len(buf) > 0:
                        buf = unicode.sub(buf, 1, unicode.length(buf) - 1)
                        x, y = term.getCursorPos()
                        if x > 1:
                            term.setCursorPos(x - 1, y)
                            term.write(" ")
                            term.setCursorPos(x - 1, y)
                elif lay:base_char(a, shift.on) != nil:
                    # символ этой клавиши должен прийти следом; не пришёл за 0.1 с: буква второго языка по месту клавиши
                    ev2, b2 = sys.wait_event(["char", "key", "key_up", "paste"], 0.1)
                    if ev2 == "char":
                        pending[len(pending) + 1] = [ev2, b2]
                    else:
                        miss = lay:missing(a, shift.on)
                        if miss != nil:
                            put(miss)
                        if ev2 != nil:
                            pending[len(pending) + 1] = [ev2, b2]
        if hidden and sys.secret_input != nil:
            sys.secret_input(false)
        self:_newline()
        return buf

    def write(self, text):
        term.write(text)

    def write_line(self, text):
        term.write(text)
        x, y = term.getCursorPos()
        w, h = term.getSize()
        if y >= h:
            term.scroll(1)
            term.setCursorPos(1, h)
        else:
            term.setCursorPos(1, y + 1)

    def clear(self):
        term.clear()
        term.setCursorPos(1, 1)

    def read_line(self, prompt, hidden=false):
        if self.sys != nil:
            return self:_read_sys(prompt, hidden)
        term.write(prompt)
        line = read(hidden and "*" or nil)
        self:_newline()
        return line
