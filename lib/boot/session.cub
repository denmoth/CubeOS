# boot.session: сессии пользователей
#
# Сессия это вход пользователя в систему: его субъект CFS, вид файловой системы (`$home` и другие алиасы), окружение и
# процессы, запущенные от его имени. Сессий может быть несколько (быстрая смена пользователя), активна одна.
# Гость (запись с temp: true) получает временный профиль users/<имя>-<номер сессии>, который удаляется при выходе.
#
#   sm = SessionManager(fsys, auth, {kernel: k})
#   s = sm:open("ivan", "secret")                 проверяет пароль, готовит профиль, возвращает сессию
#   pid = sm:spawn(s.id, program, args, {ui: true})
#   sm:elevate(s.id, "secret")                    повышение прав на время (по умолчанию 5 минут), только администраторам
#   sm:lock(s.id); sm:unlock(s.id, "secret")
#   sm:close(s.id)                                завершает процессы сессии и закрывает её
#   sm:open_pin("ivan", "1234")                   вход по PIN (D226), s.login_method = "pin"
#   sm:remembered("ivan")                         true, если «не спрашивать X минут после входа» ещё действует (D227)
#   sm:account(s.id, op, args)                    смена пароля, PIN, «запомнить», автовход, доверенные дискеты (для терминала)
#
# Способ входа (s.login_method): "password", "pin", "remember", "trusted" (автовход, без пароля). После входа по паролю sudo
# не спрашивает пароль снова (trust_login, по умолчанию true: один пароль на всё); после PIN или без пароля спрашивает.

import cfs
import cfs.rules as rules_mod
import json5

const PROFILE_DIRS = ["home/documents", "home/pictures", "home/videos", "home/projects", "apps", "cache", "cfg", "data",
    "desktop", "trash"]

def _default_clock():
    return os.epoch("utc")

export class Session:
    def init(self, id, record, profile, subject, view, opts):
        self.id = id
        self.user = record.name
        self.display = record.display ?? record.name
        self.profile = profile
        self.home = "/cubeos/users/" .. profile
        self.base_subject = subject
        self.view = view
        self.guest = record.temp ?? false
        self.admin_capable = false
        self.state = "active"
        self.elevated_until = 0
        self.created = opts.now
        self.env = {user: profile, display: record.display ?? record.name, home: "/cubeos/users/" .. profile .. "/home",
            lang: opts.lang ?? "ru", de: opts.de ?? "tui"}
        self.pids = []
        self.aliases = nil

export class SessionManager:
    # opts: kernel, clock, elevate_ms (по умолчанию 300000), lang, de, aliases (общие алиасы для всех сессий)
    def init(self, fsys, auth, opts=nil):
        o = opts ?? {}
        self.fsys = fsys
        self.auth = auth
        self.kernel = o.kernel
        self.clock = o.clock ?? _default_clock
        self.elevate_ms = o.elevate_ms ?? 300000
        self.lang = o.lang
        self.de = o.de
        self.sessions = {}
        self.order = []
        self.next_id = 1
        self.active_id = nil
        self.on_open = o.on_open
        self.on_close = o.on_close
        self.trust_login = o.trust_login != false
        self.state_path = o.state_path ?? "/cubeos/var/login.state"
        self.on_event = nil
        if self.kernel != nil:
            self:attach(self.kernel)

    # следим за завершением процессов сессий
    def attach(self, kernel):
        self.kernel = kernel
        previous = kernel.on_exit
        let me = self
        kernel.on_exit = (info) => me:_process_exited(info, previous)

    def _process_exited(self, info, previous):
        for id, s in self.sessions:
            for i, pid in s.pids:
                if pid == info.pid:
                    table.remove(s.pids, i)
                    break
        if previous != nil:
            previous(info)

    # ------------------------------------------------------------ профиль

    def ensure_profile(self, profile):
        base = "/cubeos/users/" .. profile
        for dir in PROFILE_DIRS:
            self.fsys:mkdir(nil, base .. "/" .. dir, {parents: true})

    def _subject(self, s):
        if self.clock() < s.elevated_until:
            return self.auth:subject_for(s.user, true)
        return s.base_subject

    # ------------------------------------------------------------ вход и выход

    # проверяет пароль (trusted=true пропускает проверку: автовход, служебные случаи) и открывает сессию
    # возвращает сессию или nil, причина, секунд до повторной попытки
    def open(self, name, password=nil, trusted=false, method=nil):
        rec = self.auth:user(name)
        if rec == nil:
            return nil, "unknown"
        if not trusted:
            ok, why, wait = self.auth:verify(name, password)
            if not ok:
                return nil, why, wait
        id = self.next_id
        self.next_id += 1
        profile = rec.name
        if rec.temp:
            profile = rec.name .. "-" .. id
        base_subject = self.auth:subject_for(rec.name)
        # субъект профиля носит имя профиля, чтобы правила users/$user/** давали доступ именно к его папке
        subject = rules_mod.subject(profile, base_subject.roles, base_subject.groups)
        self:ensure_profile(profile)
        view = cfs.view(self.fsys, subject, {aliases: cfs.default_aliases(profile)})
        s = Session(id, rec, profile, subject, view, {now: self.clock(), lang: self.lang, de: self.de})
        s.admin_capable = self.auth:is_admin(rec.name)
        s.login_method = method ?? (trusted and "trusted" or "password")
        s.manager = self
        self:_note_login(rec)
        self.sessions[id] = s
        if self.kernel != nil:
            self.kernel:log("session " .. id .. " opened for " .. rec.name .. (rec.temp and " (guest)" or ""), "info")
        self.order[len(self.order) + 1] = id
        self.active_id = id
        if self.on_open != nil:
            self.on_open(s)
        return s

    # вход по PIN: nil и причина ("pin locked": нужен пароль), как open
    def open_pin(self, name, pin):
        ok, why, left = self.auth:verify_pin(name, pin)
        if not ok:
            return nil, why, left
        return self:open(name, nil, true, "pin")

    # ------------------------------------------------------------ «не спрашивать X минут после входа» (D227)

    def _login_state(self):
        if not self.fsys:exists(nil, self.state_path):
            return {}
        ok, data = pcall(() => json5.parse(self.fsys:read_file(nil, self.state_path)))
        return ok and type(data) == "table" and data or {}

    def _note_login(self, rec):
        if rec.temp:
            return
        st = self:_login_state()
        st[rec.name] = self.clock()
        pcall(() => self.fsys:write_file(nil, self.state_path, json5.stringify(st, {json5: true}) .. "\n"))

    def remembered(self, name):
        rec = self.auth:user(name)
        if rec == nil or (rec.remember_minutes ?? 0) <= 0:
            return false
        last = self:_login_state()[rec.name]
        return last != nil and self.clock() - last <= rec.remember_minutes * 60000

    def get(self, id):
        return self.sessions[id]

    def active(self):
        return self.active_id != nil and self.sessions[self.active_id] or nil

    def list(self):
        out = []
        for id in self.order:
            s = self.sessions[id]
            if s != nil:
                out[len(out) + 1] = s
        return out

    def switch(self, id):
        if self.sessions[id] == nil:
            return false
        self.active_id = id
        return true

    # завершает процессы сессии (просьба завершиться, затем принудительно), удаляет временный профиль
    def close(self, id):
        s = self.sessions[id]
        if s == nil:
            return false
        if self.kernel != nil:
            self.kernel:log("session " .. id .. " closed for " .. tostring(s.user), "info")
            for pid in self:_pids_copy(s):
                self.kernel:kill(pid, "kill")
        self.sessions[id] = nil
        for i, oid in self.order:
            if oid == id:
                table.remove(self.order, i)
                break
        if self.active_id == id:
            self.active_id = self.order[len(self.order)]
        if s.guest:
            path = "/cubeos/users/" .. s.profile
            if self.fsys:exists(nil, path):
                self.fsys:remove(nil, path, {recursive: true, permanent: true})
        if self.on_close != nil:
            self.on_close(s)
        return true

    def _pids_copy(self, s):
        out = []
        for pid in s.pids:
            out[len(out) + 1] = pid
        return out

    # ------------------------------------------------------------ блокировка и повышение прав

    def lock(self, id):
        s = self.sessions[id]
        if s == nil:
            return false
        s.state = "locked"
        s.elevated_until = 0
        return true

    # чем снимать блокировку: "pin", если у пользователя есть PIN и он не заблокирован, иначе "password"
    def unlock_method(self, id):
        s = self.sessions[id]
        if s != nil and self.auth.has_pin != nil and self.auth:has_pin(s.user) and not self.auth:pin_locked(s.user):
            return "pin"
        return "password"

    # снять блокировку (D226): method "pin" или "password" (nil: как unlock_method). Возвращает true или false, причину
    # ("bad pin", "pin locked", "bad password", "locked") и число (попыток PIN осталось или секунд ждать)
    def unlock(self, id, secret, method=nil):
        s = self.sessions[id]
        if s == nil:
            return false, "no session"
        how = method ?? self:unlock_method(id)
        if how == "pin":
            okp, whyp, left = self.auth:verify_pin(s.user, secret)
            if not okp:
                return false, whyp, left
        else:
            ok, why, wait = self.auth:verify(s.user, secret)
            if not ok:
                return false, why, wait
        s.state = "active"
        return true

    # повышение прав: пароль пользователя и право администратора; возвращает true или false и причину
    def elevate(self, id, password):
        s = self.sessions[id]
        if s == nil:
            return false, "no session"
        if not self.auth:is_admin(s.user):
            return false, "not an administrator"
        ok, why, wait = self.auth:verify(s.user, password)
        if not ok:
            return false, why, wait
        s.elevated_until = self.clock() + self.elevate_ms
        return true

    # повышение без пароля: вход был по паролю, а trust_login разрешает (один пароль на всё, D226)
    def elevate_trusted(self, id):
        s = self.sessions[id]
        if s == nil or not self.auth:is_admin(s.user) or not self:trusted(id):
            return false, "password needed"
        s.elevated_until = self.clock() + self.elevate_ms
        return true

    def trusted(self, id):
        s = self.sessions[id]
        return s != nil and self.trust_login and s.login_method == "password"

    # операции с учётной записью из терминала. Для своей записи нужен текущий пароль; autologin и trust_disk только при повышенных
    # правах (sudo). Возвращает true или false и причину.
    def account(self, id, op, a=nil):
        s = self.sessions[id]
        if s == nil:
            return false, "no session"
        args = a ?? {}
        def own_password():
            if self.auth.shadow[s.user] == nil:
                return true
            ok, why = self.auth:verify(s.user, args.password)
            return ok, why == "locked" and "too many attempts, wait" or "wrong password"
        if op == "passwd":
            ok, why = own_password()
            if not ok:
                return false, why
            return pcall(() => self.auth:set_password(s.user, args.new))
        if op == "pin":
            ok, why = own_password()
            if not ok:
                return false, why
            return pcall(() => self.auth:set_pin(s.user, args.pin))
        if op == "remember":
            ok, why = own_password()
            if not ok:
                return false, why
            return pcall(() => self.auth:set_field(s.user, "remember_minutes", args.minutes))
        if op == "status":
            rec = self.auth:user(s.user)
            return {pin: self.auth:has_pin(s.user), remember: rec.remember_minutes ?? 0, admin: s.admin_capable,
                elevated: self:is_elevated(id), trusted: self:trusted(id), method: s.login_method, password: self.auth.shadow[s.user] != nil}
        # только команда, запущенная через sudo (args.sudo), и только пока права повышены: как в Linux, повышение не делает
        # привилегированными остальные команды
        if not self:is_elevated(id) or not args.sudo:
            return false, "needs administrator rights: use sudo"
        if op == "autologin":
            if args.name != nil and self.auth:user(args.name) == nil:
                return false, "no such user: " .. tostring(args.name)
            return pcall(() => self:_patch_conf("/cubeos/sys/cfg/boot.conf", "autologin", args.name))
        if op == "trust_disk":
            return pcall(() => self:_trust_disk(args))
        if op == "disk_boot":
            mode = args.mode
            if mode != "off" and mode != "trusted" and mode != "password" and mode != "all":
                return false, "disk boot is off, trusted, password or all"
            return pcall(() => self:_patch_conf("/cubeos/sys/cfg/boot.conf", "disk_boot", mode))
        return false, "unknown operation " .. tostring(op)

    def _patch_conf(self, path, key, value):
        text = self.fsys:exists(nil, path) and self.fsys:read_file(nil, path) or "{}\n"
        self.fsys:write_file(nil, path, json5.patch(text, [key], value))

    # trusted_disks.conf: строки «номер sha256 метка»; args {id, hash, label} добавить или заменить, {id, remove: true} убрать
    def _trust_disk(self, args):
        path = "/cubeos/sys/cfg/trusted_disks.conf"
        lines = []
        if self.fsys:exists(nil, path):
            for line in string.gmatch(self.fsys:read_file(nil, path), "[^%c]+"):
                id = string.match(line, "^%s*(%d+)")
                if id == nil or tonumber(id) != tonumber(args.id):
                    lines[len(lines) + 1] = line
        if not args.remove:
            lines[len(lines) + 1] = tostring(args.id) .. " " .. tostring(args.hash) .. " " .. string.gsub(tostring(args.label ?? ""), "%s+", "_")
        self.fsys:write_file(nil, path, table.concat(lines, "\n") .. (len(lines) > 0 and "\n" or ""))

    def drop_elevation(self, id):
        s = self.sessions[id]
        if s != nil:
            s.elevated_until = 0

    def is_elevated(self, id):
        s = self.sessions[id]
        return s != nil and self.clock() < s.elevated_until

    # субъект сессии с учётом повышения прав
    def subject(self, id):
        s = self.sessions[id]
        if s == nil:
            return nil
        return self:_subject(s)

    # вид файловой системы сессии (после повышения прав новый вид получает права администратора)
    def view(self, id):
        s = self.sessions[id]
        if s == nil:
            return nil
        if self.clock() < s.elevated_until:
            subject = self:_subject(s)
            # субъект профиля: имя профиля и роль admin
            elevated = rules_mod.subject(s.profile, subject.roles, subject.groups)
            return cfs.view(self.fsys, elevated, {aliases: cfs.default_aliases(s.profile)})
        return s.view

    # ------------------------------------------------------------ процессы сессии

    # запускает программу от имени сессии; opts: name, ui, detached
    def spawn(self, id, program, args=nil, opts=nil):
        s = self.sessions[id]
        if s == nil:
            raise Error("no such session: " .. tostring(id))
        if self.kernel == nil:
            raise Error("the session manager has no kernel")
        if s.state == "locked":
            raise Error("the session is locked")
        o = opts ?? {}
        subject = self:_subject(s)
        profile_subject = rules_mod.subject(s.profile, subject.roles, subject.groups)
        pid = self.kernel:spawn(program, args, {name: o.name, ui: o.ui, detached: true, subject: profile_subject,
            view: self:view(id), parent: o.parent, out: o.out})
        s.pids[len(s.pids) + 1] = pid
        return pid

export def new(fsys, auth, opts=nil):
    return SessionManager(fsys, auth, opts)
