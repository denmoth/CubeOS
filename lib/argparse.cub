# argparse: разбор аргументов командной строки для программ ОС.
#
#   spec = {
#     name: "cubic", description: "Компилятор Cubic",
#     positionals: [{name: "input", help: "исходник"}, {name: "output", optional: true}],
#     options: [
#       {long: "minify", short: "m", flag: true, help: "сжать код"},
#       {long: "level", short: "l", number: true, default: 6},
#       {long: "mods", list: true},                 # --mods=a,b даёт список
#     ],
#   }
#   args = argparse.parse(spec, {"-m", "in.cub", "--level", "9"})
#   args.minify, args.input, args.level ...      ошибка пользователя: Error с текстом и строкой usage

export def usage(spec):
    parts = [spec.name ?? "program"]
    for opt in spec.options ?? []:
        label = "--" .. opt.long
        if not opt.flag:
            label = label .. "=<" .. (opt.value_name ?? opt.long) .. ">"
        parts[len(parts) + 1] = "[" .. label .. "]"
    for pos in spec.positionals ?? []:
        if pos.optional:
            parts[len(parts) + 1] = "[" .. pos.name .. "]"
        else:
            parts[len(parts) + 1] = "<" .. pos.name .. ">"
    return "usage: " .. table.concat(parts, " ")

export def help_text(spec):
    lines = [usage(spec)]
    if spec.description != nil:
        lines[len(lines) + 1] = ""
        lines[len(lines) + 1] = spec.description
    if len(spec.positionals ?? []) > 0:
        lines[len(lines) + 1] = ""
        lines[len(lines) + 1] = "arguments:"
        for pos in spec.positionals:
            lines[len(lines) + 1] = "  " .. pos.name .. "    " .. (pos.help ?? "")
    if len(spec.options ?? []) > 0:
        lines[len(lines) + 1] = ""
        lines[len(lines) + 1] = "options:"
        for opt in spec.options:
            short = opt.short != nil and ("-" .. opt.short .. ", ") or "    "
            lines[len(lines) + 1] = "  " .. short .. "--" .. opt.long .. "    " .. (opt.help ?? "")
    return table.concat(lines, "\n")

def _find_long(spec, name):
    for opt in spec.options ?? []:
        if opt.long == name:
            return opt
    return nil

def _find_short(spec, ch):
    for opt in spec.options ?? []:
        if opt.short == ch:
            return opt
    return nil

def _fail(spec, message):
    raise Error(message .. "\n" .. usage(spec))

def _convert(spec, opt, text):
    if opt.number:
        value = tonumber(text)
        if value == nil:
            _fail(spec, "option --" .. opt.long .. " needs a number, got '" .. text .. "'")
        return value
    if opt.list:
        items = []
        for piece in string.gmatch(text, "[^,]+"):
            items[len(items) + 1] = piece
        return items
    return text

# args: список строк. Возвращает таблицу: имена опций и позиционных, плюс rest (всё после "--").
export def parse(spec, args):
    result = {}
    for opt in spec.options ?? []:
        if opt.default != nil:
            result[opt.long] = opt.default
        elif opt.flag:
            result[opt.long] = false
    positionals = []
    rest = []
    i = 1
    only_positional = false
    total = len(args)
    while i <= total:
        a = args[i]
        if only_positional:
            rest[len(rest) + 1] = a
        elif a == "--":
            only_positional = true
        elif string.sub(a, 1, 2) == "--":
            name, value = string.match(a, "^%-%-([^=]+)=(.*)$")
            if name == nil:
                name = string.sub(a, 3)
            opt = _find_long(spec, name)
            if opt == nil:
                _fail(spec, "unknown option --" .. name)
            if opt.flag:
                if value != nil:
                    _fail(spec, "option --" .. name .. " does not take a value")
                result[opt.long] = true
            else:
                if value == nil:
                    i += 1
                    value = args[i]
                    if value == nil:
                        _fail(spec, "option --" .. name .. " needs a value")
                result[opt.long] = _convert(spec, opt, value)
        elif string.sub(a, 1, 1) == "-" and len(a) > 1:
            # короткие флаги, можно склеивать: -mv, значение у последнего: -l 9 или -l9
            j = 2
            while j <= len(a):
                ch = string.sub(a, j, j)
                opt = _find_short(spec, ch)
                if opt == nil:
                    _fail(spec, "unknown option -" .. ch)
                if opt.flag:
                    result[opt.long] = true
                    j += 1
                else:
                    value = string.sub(a, j + 1)
                    if value == "":
                        i += 1
                        value = args[i]
                        if value == nil:
                            _fail(spec, "option -" .. ch .. " needs a value")
                    result[opt.long] = _convert(spec, opt, value)
                    j = len(a) + 1
        else:
            positionals[len(positionals) + 1] = a
        i += 1
    needed = 0
    for pos in spec.positionals ?? []:
        if not pos.optional:
            needed += 1
    if len(positionals) < needed:
        _fail(spec, "missing argument: " .. spec.positionals[len(positionals) + 1].name)
    names = spec.positionals ?? []
    if len(positionals) > len(names):
        _fail(spec, "unexpected argument: " .. positionals[len(names) + 1])
    for k, a in positionals:
        result[names[k].name] = a
    result.rest = rest
    return result
