# compress: единый вход для сжатия .cpk/.cbx/.stp.
# Формат блока: 1 байт метода (0 без сжатия, 1 быстрый lzfast, 2 сильный deflate), 4 байта длины исходных данных
# (little endian), затем данные метода.
#
#   compress.pack(data, "auto")   -> блок (auto выбирает самый маленький из подходящих методов)
#   compress.unpack(block)        -> исходные данные

import lzfast
import deflate

export const STORE = 0
export const FAST = 1
export const STRONG = 2

def _le32(n):
    return string.char(n % 256, math.floor(n / 256) % 256, math.floor(n / 65536) % 256, math.floor(n / 16777216) % 256)

# mode: "store" | "fast" | "strong" | "auto"
export def pack(data, mode="auto"):
    n = len(data)
    best_method = STORE
    best = data
    if mode == "store":
        return string.char(STORE) .. _le32(n) .. data
    if mode == "fast" or mode == "auto":
        fast = lzfast.compress(data)
        if len(fast) < len(best):
            best = fast
            best_method = FAST
    if mode == "strong" or mode == "auto":
        strong = deflate.deflate(data)
        if len(strong) < len(best):
            best = strong
            best_method = STRONG
    return string.char(best_method) .. _le32(n) .. best

export def method_of(block):
    return string.byte(block, 1)

export def original_size(block):
    a, b, c, d = string.byte(block, 2, 5)
    if d == nil:
        raise Error("compress: block too short")
    return a + b * 256 + c * 65536 + d * 16777216

export def unpack(block):
    if len(block) < 5:
        raise Error("compress: block too short")
    method = string.byte(block, 1)
    size = original_size(block)
    payload = string.sub(block, 6)
    result = nil
    if method == STORE:
        result = payload
    elif method == FAST:
        result = lzfast.decompress(payload)
    elif method == STRONG:
        result = deflate.inflate(payload)
    else:
        raise Error("compress: unknown method " .. method)
    if len(result) != size:
        raise Error("compress: size mismatch (expected " .. size .. ", got " .. len(result) .. ")")
    return result
