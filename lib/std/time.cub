# std.time: даты по реальному (UTC) времени. Время в миллисекундах от 1970-01-01, как os.epoch("utc").

export const MS_PER_DAY = 86400000

# число дней от 1970-01-01 до гражданской даты (алгоритм Хиннанта)
export def days_from_civil(year, month, day):
    y = year
    if month <= 2:
        y = y - 1
    era = y // 400
    yoe = y - era * 400
    m = month
    if m > 2:
        m = m - 3
    else:
        m = m + 9
    doy = (153 * m + 2) // 5 + day - 1
    doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
    return era * 146097 + doe - 719468

# {year, month, day} по числу дней от 1970-01-01
export def civil_from_days(days):
    z = days + 719468
    era = z // 146097
    doe = z - era * 146097
    yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    y = yoe + era * 400
    doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
    mp = (5 * doy + 2) // 153
    d = doy - (153 * mp + 2) // 5 + 1
    m = mp + 3
    if m > 12:
        m = m - 12
    if m <= 2:
        y = y + 1
    return {year: y, month: m, day: d}

export def now_ms():
    return os.epoch("utc")

# номер суток от 1970-01-01 (для "слова дня"); offset_hours сдвигает границу суток
export def day_index(ms=nil, offset_hours=0):
    t = ms ?? os.epoch("utc")
    return (t + offset_hours * 3600000) // MS_PER_DAY

# 0 = воскресенье ... 6 = суббота
export def weekday(ms):
    days = ms // MS_PER_DAY
    return (days + 4) % 7

export def to_date(ms):
    days = ms // MS_PER_DAY
    rest = ms - days * MS_PER_DAY
    c = civil_from_days(days)
    seconds = rest // 1000
    return {
        year: c.year, month: c.month, day: c.day,
        hour: seconds // 3600, minute: (seconds // 60) % 60, second: seconds % 60,
        weekday: (days + 4) % 7,
    }

export def from_date(year, month, day, hour=0, minute=0, second=0):
    return days_from_civil(year, month, day) * MS_PER_DAY + (hour * 3600 + minute * 60 + second) * 1000

# "YYYY-MM-DD HH:MM:SS"
export def format_date(ms):
    d = to_date(ms)
    return f"{d.year:04d}-{d.month:02d}-{d.day:02d} {d.hour:02d}:{d.minute:02d}:{d.second:02d}"

export def is_leap_year(year):
    return (year % 4 == 0 and year % 100 != 0) or year % 400 == 0
