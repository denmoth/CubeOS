# svc.rpc: запросы к службам поверх сообщений ядра (sys.send / sys.receive)
#
# Служба:
#   rpc.serve(sys, {now: (args, from) => ..., set: (args, from) => ...}, {tick: () => ..., timeout: () => секунды})
#     читает сообщения {op, args, from, id}, вызывает handlers[op](args, from), отвечает {id, result} или {id, error}.
#     tick() вызывается после каждого сообщения и по таймауту; timeout() задаёт, сколько ждать сообщение (nil: без ограничения);
#     on_message(msg) получает сообщения без op (события от своих помощников).
# Клиент (из процесса ядра):
#   result, err = rpc.call(sys, "timed", "get_conf", nil, 2)       err: текст, если службы нет, она не ответила или ответила ошибкой
#
# Сообщения службы своим подписчикам (события) это просто sys.send(pid, {event: "minute", ...}): подписчик читает их своим receive.
# Ответы и события различаются полем id и event; пока call() ждёт свой ответ, пришедшие события откладываются, и их читает
# rpc.next_event(sys, timeout) (вместо sys.receive): так события не теряются между вызовами.

const state = {next_id: 0, stash: {}}
const STASH_LIMIT = 100

# события и чужие сообщения, пришедшие, пока процесс ждал ответ в call(): их отдаёт next_event (до 100 на процесс, старые вытесняются)
def _stash(pid, msg):
    list = state.stash[pid]
    if list == nil:
        list = []
        state.stash[pid] = list
    list[len(list) + 1] = msg
    if len(list) > STASH_LIMIT:
        table.remove(list, 1)

# следующее сообщение для процесса: сначала отложенные в call(), потом sys.receive(timeout); возвращает сообщение или nil
export def next_event(sys, timeout=nil):
    list = state.stash[sys.getpid()]
    if list != nil and len(list) > 0:
        return table.remove(list, 1)
    who, msg = sys.receive(timeout)
    return msg

export def call(sys, service, op, args=nil, timeout=2):
    pid = sys.lookup(service)
    if pid == nil:
        return nil, "service is not running: " .. service
    state.next_id += 1
    id = state.next_id
    sys.send(pid, {op: op, args: args, sender: sys.getpid(), id: id})
    while true:
        _who, msg = sys.receive(timeout)
        if msg == nil:
            return nil, "no answer from " .. service
        if type(msg) == "table" and msg.id == id:
            if msg.error != nil:
                return nil, msg.error
            return msg.result
        if msg != nil:
            _stash(sys.getpid(), msg)

def reply(sys, msg, result, err):
    if msg.sender != nil and msg.id != nil:
        sys.send(msg.sender, {id: msg.id, result: result, error: err})

export def serve(sys, handlers, opts=nil):
    o = opts ?? {}
    while true:
        wait = nil
        if o.timeout != nil:
            wait = o.timeout()
        msg = next_event(sys, wait)
        if msg != nil and type(msg) == "table" and msg.op == nil and o.on_message != nil:
            ok, err = pcall(o.on_message, msg)
            if not ok:
                sys.log("error", "message handler failed: " .. tostring(err))
        if msg != nil and type(msg) == "table" and msg.op != nil:
            h = handlers[msg.op]
            if h == nil:
                reply(sys, msg, nil, "unknown operation: " .. tostring(msg.op))
            else:
                ok, res = pcall(h, msg.args, msg.sender)
                if ok:
                    reply(sys, msg, res, nil)
                else:
                    reply(sys, msg, nil, tostring(res))
        if o.tick != nil:
            o.tick()
