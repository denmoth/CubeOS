# cdk.ui: среда элементов cdk в окне CDE: события, фокус, мышь, таймеры, раскладка клавиатуры, перерисовка изменённого
#
#   def main(sys, ctx):
#       ui = cdk.open(sys, ctx, {title: "Настройки", w: 200, h: 140})
#       ui:set_root(cdk.column({padding: 6}, [cdk.label("Привет"), cdk.button("OK", {on_click: () => ui:close()})]))
#       ui:run()
#
# Окно пиксельное (cde.app.open), элементы рисуются в его холст. Перерисовка: после раскладки весь холст, дальше только элементы,
# которые попросили (widget:invalidate): прямоугольник элемента заливается фоном родителя и рисуется заново. Фокус: Tab и Shift+Tab
# по кругу, клик по элементу с focusable. Мышь: элемент под нажатием захватывает перетаскивание и отпускание. Таймеры: ui:after,
# ui:every (по часам ядра). Буквы второго языка (кириллица в Windows) переводятся по раскладке системы, как в терминале (D235).
# Слои поверх окна (меню, выпадающие списки, диалоги): ui:open_layer(w, {x, y, center, modal, dismiss, on_close}),
# ui:close_layer(w). Фокус и Tab живут в верхнем слое; клик мимо закрывает слой с dismiss; модальный слой затемняет окно под собой
# и не пускает к нему ввод; Esc закрывает верхний слой.

import cde.app as app
import cdk.style as style_mod
import input.layout as layout_mod
import json5

export class UI:
    def init(self, sys, win, opts=nil):
        o = opts ?? {}
        self.sys = sys
        self.win = win
        self.style = style_mod.new(win.wm)
        self.root = nil
        self.focus = nil
        self.capture = nil
        self.dirty = []
        self.layout_dirty = true
        self.timers = []
        self.mods = {ctrl: false, shift: false, alt: false}
        self.quit = false
        self.on_close = o.on_close
        self.on_key = o.on_key
        self.pending = nil
        self.layers = []
        self.stats = {layouts: 0, redraws: 0, full: 0}
        self.kbd = layout_mod.new(nil, nil, {mode: "auto", keyboard: o.keyboard ?? self:_keyboard(), dirs: o.layout_dirs})

    def _keyboard(self):
        ok, kb = pcall(() => json5.parse(self:_read("/cubeos/sys/cfg/locale.conf") ?? "{}").keyboard)
        if ok and type(kb) == "string":
            return kb
        return "ru"

    def _read(self, path):
        v = self.sys.view()
        if v != nil and v:exists(path):
            return v:read(path)
        return nil

    # ------------------------------------------------------------ дерево

    def set_root(self, w):
        self.root = w
        w:_attach(self)
        self:relayout()

    def relayout(self):
        self.layout_dirty = true

    def redraw(self, w):
        for d in self.dirty:
            if d == w:
                return
        self.dirty[len(self.dirty) + 1] = w

    # ------------------------------------------------------------ слои

    def open_layer(self, w, opts=nil):
        o = opts ?? {}
        cv = self.win.canvas
        w:_attach(self)
        pw, ph = w:pref(self.style)
        pw = math.min(pw, cv.w - 4)
        ph = math.min(ph, cv.h - 4)
        x = o.x ?? 0
        y = o.y ?? 0
        if o.center:
            x = math.floor((cv.w - pw) / 2)
            y = math.floor((cv.h - ph) / 2)
        x = math.max(2, math.min(x, cv.w - pw - 2))
        y = math.max(2, math.min(y, cv.h - ph - 2))
        layer = {w: w, modal: o.modal ?? false, dismiss: o.dismiss ?? true, on_close: o.on_close, focus_before: self.focus}
        self.layers[len(self.layers) + 1] = layer
        w:layout(x, y, pw, ph)
        chain = []
        self:_chain(w, chain)
        self:set_focus(chain[1])
        self:relayout()
        return w

    def close_layer(self, w=nil):
        for i in range[len(self.layers), 1] step -1:
            layer = self.layers[i]
            if w == nil or layer.w == w:
                table.remove(self.layers, i)
                self.focus = nil
                f = layer.focus_before
                if f != nil and self:_shown(f):
                    self:set_focus(f)
                self:relayout()
                if layer.on_close != nil:
                    layer.on_close()
                return true
        return false

    def top_layer(self):
        return self.layers[len(self.layers)]

    # корень элемента: окно или слой
    def _top_of(self, w):
        while w.parent != nil:
            w = w.parent
        return w

    # элемент под точкой с учётом слоёв; второе значение true: клик поглощён (мимо модального слоя или закрыл меню)
    def _hit(self, px, py, closing):
        for i in range[len(self.layers), 1] step -1:
            layer = self.layers[i]
            got = layer.w:hit(px, py)
            if got != nil:
                return got, false
            if layer.modal:
                return nil, true
            if layer.dismiss and closing:
                self:close_layer(layer.w)
                return nil, true
            if layer.dismiss:
                return nil, true
        return self.root != nil and self.root:hit(px, py) or nil, false

    def _forget(self, w):
        if self.focus == w:
            self.focus = nil
        if self.capture == w:
            self.capture = nil

    def now(self):
        return self.sys.now() / 1000

    # ------------------------------------------------------------ таймеры

    def after(self, seconds, fn):
        t = {at: self:now() + seconds, fn: fn}
        self.timers[len(self.timers) + 1] = t
        return t

    def every(self, seconds, fn):
        t = {at: self:now() + seconds, every: seconds, fn: fn}
        self.timers[len(self.timers) + 1] = t
        return t

    def cancel(self, t):
        for i, x in self.timers:
            if x == t:
                table.remove(self.timers, i)
                return

    def _timeout(self):
        best = nil
        for t in self.timers:
            if best == nil or t.at < best:
                best = t.at
        if best == nil:
            return nil
        return math.max(0, best - self:now())

    def _run_timers(self):
        now = self:now()
        due = []
        for t in self.timers:
            if t.at <= now:
                due[len(due) + 1] = t
        for t in due:
            if t.every != nil:
                t.at = now + t.every
            else:
                self:cancel(t)
            t.fn()

    # ------------------------------------------------------------ фокус

    def _chain(self, w, out):
        if not w.visible:
            return
        if w.focusable and w.enabled:
            out[len(out) + 1] = w
        for c in w.children:
            self:_chain(c, out)

    def set_focus(self, w):
        if self.focus == w:
            return
        old = self.focus
        self.focus = w
        if old != nil:
            old.focused = false
            old:handle({name: "blur"})
            old:invalidate()
        if w != nil:
            w.focused = true
            w:handle({name: "focus"})
            w:invalidate()

    def focus_next(self, dir=1):
        chain = []
        top = self:top_layer()
        if top != nil:
            self:_chain(top.w, chain)
        elif self.root != nil:
            self:_chain(self.root, chain)
        if len(chain) == 0:
            return
        pos = 0
        for i, w in chain:
            if w == self.focus:
                pos = i
        nxt = pos + dir
        if pos == 0:
            nxt = dir > 0 and 1 or len(chain)
        if nxt < 1:
            nxt = len(chain)
        if nxt > len(chain):
            nxt = 1
        self:set_focus(chain[nxt])

    # ------------------------------------------------------------ события

    def _ev(self, name):
        return {name: name, ctrl: self.mods.ctrl, shift: self.mods.shift, alt: self.mods.alt}

    # событие элементу и дальше родителям, пока кто-то не возьмёт
    def _bubble(self, w, ev):
        while w != nil:
            if w:handle(ev):
                return w
            w = w.parent
        return nil

    def _mod(self, code, down):
        if code == keys.leftCtrl or code == keys.rightCtrl:
            self.mods.ctrl = down
        elif code == keys.leftShift or code == keys.rightShift:
            self.mods.shift = down
        elif code == keys.leftAlt or code == keys.rightAlt:
            self.mods.alt = down

    def _char(self, ch):
        self.pending = nil
        ev = self:_ev("char")
        ev.char = ch
        if self.focus != nil:
            self:_bubble(self.focus, ev)

    # символ клавиши не пришёл: Windows печатает не латиницу, буква второго языка по месту клавиши
    def _no_char(self, tok):
        if self.pending != tok:
            return
        self.pending = nil
        ch = self.kbd:missing(tok.code, tok.shift)
        if ch != nil:
            self:_char(ch)

    def dispatch(self, name, a, b, c):
        if name == "mouse_click" or name == "mouse_drag" or name == "mouse_up" or name == "mouse_scroll":
            kind = name == "mouse_click" and "down" or (name == "mouse_drag" and "drag" or (name == "mouse_up" and "up" or "scroll"))
            ev = self:_ev(kind)
            ev.x = b
            ev.y = c
            ev.button = a
            ev.dir = a
            if kind == "down":
                target, eaten = self:_hit(b, c, true)
                if eaten:
                    self.capture = nil
                    self.down_at = nil
                    return
                f = target
                while f != nil and not (f.focusable and f.enabled):
                    f = f.parent
                if f != nil:
                    self:set_focus(f)
                self.capture = target
                self.down_at = target
                if target != nil:
                    self:_bubble(target, ev)
            elif kind == "scroll":
                target, eaten = self:_hit(b, c, false)
                if target != nil:
                    self:_bubble(target, ev)
            else:
                target = self.capture
                if target != nil:
                    got = self:_bubble(target, ev)
                if kind == "up":
                    # клик: нажали и отпустили над тем же элементом
                    over, eaten2 = self:_hit(b, c, false)
                    if self.down_at != nil and over != nil and (over == self.down_at or self:_inside(over, self.down_at)):
                        click = self:_ev("click")
                        click.x = b
                        click.y = c
                        self:_bubble(self.down_at, click)
                    self.capture = nil
                    self.down_at = nil
            return
        if name == "key":
            self:_mod(a, true)
            if a == keys.tab and not self.mods.ctrl and not self.mods.alt:
                self:focus_next(self.mods.shift and -1 or 1)
                return
            if (a == keys.escape or a == 256 or a == 1) and len(self.layers) > 0:
                top = self:top_layer()
                if top.w.on_escape == nil or top.w:on_escape() != false:
                    self:close_layer(top.w)
                return
            ev = self:_ev("key")
            ev.key = a
            ev.held = b
            took = nil
            if self.focus != nil:
                took = self:_bubble(self.focus, ev)
            if took == nil and self.on_key != nil and len(self.layers) == 0:
                self.on_key(ev)
            if not self.mods.ctrl and not self.mods.alt and self.kbd:base_char(a, self.mods.shift) != nil:
                let me = self
                tok = {code: a, shift: self.mods.shift}
                self.pending = tok
                self:after(0.1, () => me:_no_char(tok))
            return
        if name == "key_up":
            self:_mod(a, false)
            return
        if name == "char":
            self:_char(self.kbd:translate(a))
            return
        if name == "paste":
            ev = self:_ev("paste")
            ev.text = a
            if self.focus != nil:
                self:_bubble(self.focus, ev)

    def _inside(self, w, parent):
        while w != nil:
            if w == parent:
                return true
            w = w.parent
        return false

    # ------------------------------------------------------------ рисование

    def _bg_of(self, w):
        p = w.parent
        while p != nil:
            c = p:bg()
            if c != nil:
                return c
            p = p.parent
        return self.style.bg

    def _shown(self, w):
        while w != nil:
            if not w.visible:
                return false
            if w == self.root:
                return true
            if w.parent == nil:
                for layer in self.layers:
                    if layer.w == w:
                        return true
            w = w.parent
        return false

    def flush(self):
        if self.root == nil:
            return
        cv = self.win.canvas
        st = self.style
        if self.layout_dirty:
            self.layout_dirty = false
            self.stats.layouts += 1
            self.root:layout(0, 0, cv.w, cv.h)
            self.dirty = []
            cv:clear(self.root:bg() ?? st.bg)
            self.root:draw_tree(cv, st)
            for layer in self.layers:
                layer.w:layout(layer.w.x, layer.w.y, layer.w.w, layer.w.h)
                self:_draw_layer(cv, st, layer)
            self.stats.full += 1
            self.win:present()
            return
        if len(self.dirty) == 0:
            return
        list = self.dirty
        self.dirty = []
        for w in list:
            if self:_shown(w) and w.w > 0 and w.h > 0:
                # внутри области прокрутки рисуется только видимая часть
                views = 0
                a = w.parent
                while a != nil:
                    if a.viewport:
                        cv:push_clip(a.x, a.y, a.w - 5, a.h)
                        views += 1
                    a = a.parent
                # кольцо фокуса выходит на пиксель за элемент: перерисовывается с запасом
                cv:push_clip(w.x - 1, w.y - 1, w.w + 2, w.h + 2)
                cv:fill_rect(w.x - 1, w.y - 1, w.w + 2, w.h + 2, self:_bg_of(w))
                if w.parent != nil:
                    w.parent:draw(cv, st)
                w:draw_tree(cv, st)
                cv:pop_clip()
                for i in range[1, views]:
                    cv:pop_clip()
                self.stats.redraws += 1
                # под модальным слоем перерисованное снова затемняется; слои сверху рисуются заново
                if len(self.layers) > 0 and self:_top_of(w) == self.root:
                    if self:_modal():
                        self:_dim(cv, st.shadow, w.x - 1, w.y - 1, w.w + 2, w.h + 2)
                    for layer in self.layers:
                        self:_draw_layer(cv, st, layer, true)
        self.win:present()

    def _modal(self):
        for layer in self.layers:
            if layer.modal:
                return true
        return false

    def _dim(self, cv, map, x, y, w, h):
        x0 = math.max(0, x)
        y0 = math.max(0, y)
        x1 = math.min(cv.w - 1, x + w - 1)
        y1 = math.min(cv.h - 1, y + h - 1)
        px = cv.px
        for yy in range[y0, y1]:
            base = yy * cv.w + 1
            for xx in range[x0, x1]:
                v = px[base + xx]
                px[base + xx] = map[v] ?? v
        if x1 >= x0 and y1 >= y0:
            cv:mark(x0, y0, x1, y1)

    # слой: затемнение окна под модальным (один раз при полной перерисовке), тень, сам слой
    def _draw_layer(self, cv, st, layer, again=false):
        w = layer.w
        if layer.modal and not again:
            self:_dim(cv, st.shadow, 0, 0, cv.w, cv.h)
        if not again:
            self:_dim(cv, st.shadow, w.x + 2, w.y + w.h, w.w, 2)
            self:_dim(cv, st.shadow, w.x + w.w, w.y + 2, 2, w.h - 2)
        cv:push_clip(w.x - 1, w.y - 1, w.w + 2, w.h + 2)
        w:draw_tree(cv, st)
        cv:pop_clip()

    # ------------------------------------------------------------ цикл

    def close(self):
        self.quit = true

    def run(self):
        self:flush()
        while not self.quit:
            ev = table.pack(self.win:wait_event(self:_timeout()))
            name = ev[1]
            if name == "win_close":
                if self.on_close == nil or self.on_close() != false:
                    self.quit = true
            elif name == "win_resize":
                self:relayout()
            elif name == "win_theme":
                self.style:rebuild()
                self:relayout()
            elif name == "win_blur":
                self.mods = {ctrl: false, shift: false, alt: false}
            elif name != nil:
                self:dispatch(name, ev[2], ev[3], ev[4])
            self:_run_timers()
            self:flush()
        self.win:close()

# окно с элементами: opts как у cde.app.open (title, w, h, x, y, resizable, decorations...) и on_close, on_key, keyboard
export def open(sys, ctx, opts=nil):
    o = opts ?? {}
    o.kind = "pixel"
    win = app.open(sys, ctx, o)
    return UI(sys, win, o)
