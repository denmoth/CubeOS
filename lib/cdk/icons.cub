# cdk.icons: пиксельные значки 9x9 (живут в cde.icons, потому что их рисует и панель рабочего стола)
#
#   icons.draw(s, "folder", x, y, c1, c2)
#   icons.names()                       список имён
#   icons.register("my", ["...", ...])  свой значок (9 строк по 9 символов)

import cde.icons as base

export const names = base.names
export const has = base.has
export const register = base.register
export const draw = base.draw
