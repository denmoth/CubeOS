# cdk.icons: пиксельные значки 9x9 в два тона: "#" основной цвет, "+" второй (обычно темнее), "." прозрачно
#
#   icons.draw(s, "folder", x, y, c1, c2)
#   icons.names()                       список имён
#   icons.register("my", ["...", ...])  свой значок (9 строк по 9 символов)

const ICONS = {
    folder: [".........", "###......", "#++#####.", "#+++++++#", "#########", "#+++++++#", "#+++++++#", "#########", "........."],
    file: ["..#####..", "..#+++##.", "..#+++#+#", "..#++++##", "..#+++++#", "..#+++++#", "..#+++++#", "..#######", "........."],
    gear: ["....#....", ".#.###.#.", "..#####..", ".##+++##.", "###+.+###", ".##+++##.", "..#####..", ".#.###.#.", "....#...."],
    search: [".###.....", "#+++#....", "#+..+#...", "#+...#...", ".#+++#...", "..####...", ".....##..", "......##.", ".......#."],
    home: ["....#....", "...###...", "..#####..", ".#######.", "###+++###", ".#+++++#.", ".#++#++#.", ".#++#++#.", ".#######."],
    user: ["...###...", "..#####..", "..#####..", "...###...", ".........", ".#######.", "#########", "#########", "........."],
    terminal: ["#########", "#+++++++#", "#+#+++++#", "#++#++++#", "#+#+++++#", "#+++###+#", "#+++++++#", "#########", "........."],
    trash: ["...###...", "#########", ".#+#+#+#.", ".#+#+#+#.", ".#+#+#+#.", ".#+#+#+#.", ".#+#+#+#.", "..#####..", "........."],
    check: [".........", ".......##", "......##.", ".....##..", "##..##...", ".####....", "..##.....", ".........", "........."],
    close: [".........", ".##...##.", "..##.##..", "...###...", "...###...", "..##.##..", ".##...##.", ".........", "........."],
    plus: [".........", "....#....", "....#....", "....#....", ".#######.", "....#....", "....#....", "....#....", "........."],
    minus: [".........", ".........", ".........", ".........", ".#######.", ".........", ".........", ".........", "........."],
    play: [".........", "..#......", "..##.....", "..###....", "..####...", "..###....", "..##.....", "..#......", "........."],
    pause: [".........", ".##..##..", ".##..##..", ".##..##..", ".##..##..", ".##..##..", ".##..##..", ".##..##..", "........."],
    wifi: [".........", "..#####..", ".#.....#.", "#..###..#", "..#...#..", "....#....", "...###...", "....#....", "........."],
    volume: [".........", "...#.....", "..##..#..", "####...#.", "####.#.#.", "####...#.", "..##..#..", "...#.....", "........."],
    bell: ["....#....", "...###...", "..#+++#..", "..#+++#..", "..#+++#..", ".#+++++#.", "#########", "...###...", "........."],
    star: ["....#....", "....#....", "...###...", "#########", ".#+++++#.", "..#+++#..", ".#+#.#+#.", ".##...##.", "........."],
    heart: [".........", ".##...##.", "#++#.#++#", "#+++#+++#", "#+++++++#", ".#+++++#.", "..#+++#..", "...#+#...", "....#...."],
    lock: ["...###...", "..#...#..", "..#...#..", ".#######.", ".#+++++#.", ".#++#++#.", ".#++#++#.", ".#######.", "........."],
    cube: ["....#....", "..##+##..", "##+++++##", "#.##+##.#", "#+..#..+#", "#++.#.++#", "#++.#.++#", ".##.#.##.", "...###..."],
    info: ["..#####..", ".#+++++#.", "#+++#+++#", "#+++++++#", "#+++#+++#", "#+++#+++#", ".#++#++#.", "..#####..", "........."],
    warn: ["....#....", "...###...", "...#+#...", "..##+##..", "..#+++#..", ".##+++##.", ".#+++++#.", "##+++++##", "#########"],
}

export def names():
    out = []
    for k, v in ICONS:
        out[len(out) + 1] = k
    table.sort(out)
    return out

export def has(name):
    return ICONS[name] != nil

export def register(name, rows):
    ICONS[name] = rows

# рисует значок с левым верхним углом в (x, y); c2 nil: второй тон не рисуется
export def draw(s, name, x, y, c1, c2=nil):
    rows = ICONS[name]
    if rows == nil:
        return false
    for j, line in rows:
        for i in range[1, string.len(line)]:
            ch = string.sub(line, i, i)
            if ch == "#":
                s:set(x + i - 1, y + j - 1, c1)
            elif ch == "+" and c2 != nil:
                s:set(x + i - 1, y + j - 1, c2)
    return true
