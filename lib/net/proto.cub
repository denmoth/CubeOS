# net.proto: сообщения сети CubeNet (docs/13-network-cluster.md, D242). Одно сообщение это таблица, которую modem.transmit передаёт
# как есть:
#   {proto: "cubenet", v: 1, src: номер компьютера, dst: номер или nil (всем), seq, ts (мс UTC), type, body, re (ответ на id), mac}
# id запроса это src .. ":" .. seq. Подпись mac это HMAC-SHA256 общего ключа пары от канонической записи всех полей, кроме mac.
# Обнаружение и ping идут без подписи (это открытые сведения); всё про файлы только с подписью, счётчиком и свежей меткой времени.
#
#   proto.canon(value)              однозначная запись значения (ключи по порядку): одинаковая у обеих сторон
#   proto.sign(msg, key)            ставит mac
#   proto.verify(msg, key)          подпись верна
#   proto.fresh(msg, last_seq, now) не повтор: seq больше последнего и время в пределах окна
#   proto.seal(msg, key, encrypt)   (D246) с encrypt тело шифруется ChaCha20 (поле enc вместо body), потом подпись поверх
#   proto.open(msg, key)            подпись верна; если тело зашифровано, расшифровывает его обратно в body (msg.was_enc = true)
# Ключ шифрования это HMAC(ключ пары, "cubenet:enc"), nonce: номер отправителя (4 байта) и его счётчик seq (8 байт): у каждого
# сообщения свой. Версия 3 (D248): сопряжение с обменом ключами X25519, старые версии не принимаются.

import sha256
import chacha20

export const NAME = "cubenet"
export const VERSION = 3
export const CHANNEL = 47100
export const WINDOW_MS = 60000

def _num(n):
    if n == math.floor(n) and math.abs(n) < 1e15:
        return string.format("%.0f", n)
    return string.format("%.17g", n)

export def canon(v):
    t = type(v)
    if v == nil:
        return "n"
    if t == "boolean":
        return v and "T" or "F"
    if t == "number":
        return "#" .. _num(v) .. ";"
    if t == "string":
        return "s" .. len(v) .. ":" .. v
    if t == "table":
        names = []
        for k, x in v:
            names[len(names) + 1] = k
        table.sort(names, (a, b) => canon(a) < canon(b))
        parts = ["{"]
        for k in names:
            parts[len(parts) + 1] = canon(k)
            parts[len(parts) + 1] = canon(v[k])
        parts[len(parts) + 1] = "}"
        return table.concat(parts)
    return "?" .. t

def _body(msg):
    copy_ = {}
    for k, x in msg:
        if k != "mac":
            copy_[k] = x
    return canon(copy_)

export def mac_of(msg, key):
    return sha256.to_hex(sha256.hmac(key, _body(msg)))

export def sign(msg, key):
    msg.mac = mac_of(msg, key)
    return msg

# разбор записи canon обратно в значение
def _dec(s, i):
    c = string.sub(s, i, i)
    if c == "n":
        return nil, i + 1
    if c == "T":
        return true, i + 1
    if c == "F":
        return false, i + 1
    if c == "#":
        j = string.find(s, ";", i, true)
        return tonumber(string.sub(s, i + 1, j - 1)), j + 1
    if c == "s":
        j = string.find(s, ":", i, true)
        n = tonumber(string.sub(s, i + 1, j - 1))
        return string.sub(s, j + 1, j + n), j + n + 1
    if c == "{":
        t = {}
        i += 1
        while string.sub(s, i, i) != "}":
            if i > len(s):
                raise Error("cubenet: broken value")
            k = nil
            v = nil
            k, i = _dec(s, i)
            v, i = _dec(s, i)
            if k != nil:
                t[k] = v
        return t, i + 1
    raise Error("cubenet: broken value")

export def decode(s):
    v, i = _dec(s, 1)
    return v

def _u32(n):
    n = n % 4294967296
    return string.char(n % 256, math.floor(n / 256) % 256, math.floor(n / 65536) % 256, math.floor(n / 16777216) % 256)

def _nonce(msg):
    seq = msg.seq ?? 0
    return _u32(msg.src ?? 0) .. _u32(seq % 4294967296) .. _u32(math.floor(seq / 4294967296))

def _enc_key(key):
    return sha256.hmac(key, "cubenet:enc")

export def seal(msg, key, encrypt=false):
    if encrypt:
        msg.enc = chacha20.crypt(_enc_key(key), _nonce(msg), canon(msg.body))
        msg.body = nil
    return sign(msg, key)

export def open(msg, key):
    if not verify(msg, key):
        return false
    if type(msg.enc) == "string":
        ok, body = pcall(() => decode(chacha20.crypt(_enc_key(key), _nonce(msg), msg.enc)))
        if not ok:
            return false
        msg.body = body
        msg.enc = nil
        msg.was_enc = true
    return true

# сравнение без досрочного выхода
def _same(a, b):
    if type(a) != "string" or type(b) != "string" or len(a) != len(b):
        return false
    diff = 0
    for i in range[1, len(a)]:
        if string.byte(a, i) != string.byte(b, i):
            diff += 1
    return diff == 0

export def verify(msg, key):
    return key != nil and _same(msg.mac, mac_of(msg, key))

export def fresh(msg, last_seq, now):
    if type(msg.seq) != "number" or type(msg.ts) != "number":
        return false
    if last_seq != nil and msg.seq <= last_seq:
        return false
    return math.abs(now - msg.ts) <= WINDOW_MS

# похоже ли на сообщение CubeNet
export def valid(msg):
    return type(msg) == "table" and msg.proto == NAME and msg.v == VERSION and type(msg.src) == "number" and type(msg.type) == "string"

export def id_of(msg):
    return tostring(msg.src) .. ":" .. tostring(msg.seq)

# общий ключ пары: код сопряжения, случайные числа обеих сторон и общий секрет X25519 (shared, hex). Без shared (его знают только
# два компьютера) подслушавший сопряжение не может подобрать код перебором (D248)
export def pair_key(code, salt, client_nonce, host_nonce, rounds, shared=""):
    return sha256.pbkdf2(tostring(code), tostring(salt) .. ":" .. tostring(client_nonce) .. ":" .. tostring(host_nonce) .. ":" .. tostring(shared), rounds)

export def unhex(h):
    if type(h) != "string" or len(h) % 2 != 0 or string.find(h, "[^%x]") != nil:
        return nil
    return (string.gsub(h, "..", (x) => string.char(tonumber(x, 16))))
