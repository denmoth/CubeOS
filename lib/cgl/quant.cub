# cgl.quant: перевод цветов поверхности (палитра до 256 цветов) в ограниченную палитру терминала (16 цветов CC)
#
# Для каждого номера цвета поверхности заранее считается ближайший цвет терминала и, если включён дизеринг, второй цвет, которым
# можно «разбавить» первый, чтобы получилась нужная смесь (порядковая растеризация Байера 4x4 по координатам пикселя).
#
#   q = quant.new(src_palette, dst_palette, {dither: true, clear: 15})
#   q:index(v)            номер цвета терминала для номера v (или для CLEAR)
#   q:pick(v, x, y)       то же с дизерингом в точке (x, y)

import cgl.color as color

export class Quantizer:
    # src: палитра поверхности; dst: палитра терминала (до 16 цветов); opts: dither (по умолчанию false), clear (номер цвета
    # терминала вместо прозрачного пикселя, по умолчанию самый тёмный)
    def init(self, src, dst, opts=nil):
        o = opts ?? {}
        self.src = src
        self.dst = dst
        self.dither = o.dither ?? false
        self.clear_opt = o.clear
        self.clear = o.clear ?? dst:nearest(0, 0, 0)
        self.main = []
        self.alt = []
        self.share = []
        self:rebuild()

    # пересчитать таблицы (после изменения палитр)
    def rebuild(self):
        self.clear = self.clear_opt ?? self.dst:nearest(0, 0, 0)
        self.main = []
        self.alt = []
        self.share = []
        self.main[1] = self.clear
        for v in range[0, self.src.size - 1]:
            r, g, b = self.src:get(v)
            a = self.dst:nearest(r, g, b)
            self.main[v + 2] = a
            if self.dither:
                self:_mix(v + 2, r, g, b, a)

    # лучшая смесь двух цветов терминала для цвета (r, g, b); если одиночный ближайший цвет лучше, смесь не нужна
    def _mix(self, slot, r, g, b, a):
        ar, ag, ab = self.dst:get(a)
        sr = r - ar
        sg = g - ag
        sb = b - ab
        base = 0.30 * sr * sr + 0.59 * sg * sg + 0.11 * sb * sb
        if base < 30:
            return
        n = self.dst.size
        best_score = 1e30
        best_a = nil
        best_b = nil
        best_t = 0
        for i in range[0, n - 2]:
            r1, g1, b1 = self.dst:get(i)
            for j in range[i + 1, n - 1]:
                r2, g2, b2 = self.dst:get(j)
                dr = r2 - r1
                dg = g2 - g1
                db = b2 - b1
                len2 = dr * dr + dg * dg + db * db
                if len2 > 0:
                    t = ((r - r1) * dr + (g - g1) * dg + (b - b1) * db) / len2
                    if t >= 0.08 and t <= 0.92:
                        er = r - r1 - dr * t
                        eg = g - g1 - dg * t
                        eb = b - b1 - db * t
                        err = 0.30 * er * er + 0.59 * eg * eg + 0.11 * eb * eb
                        # среди хороших смесей берём пару ближайших цветов: меньше шума
                        score = err + 0.02 * len2
                        if err < base * 0.6 and score < best_score:
                            best_score = score
                            best_a = i
                            best_b = j
                            best_t = t
        if best_a != nil:
            if best_t < 0.5:
                self.main[slot] = best_a
                self.alt[slot] = best_b
                self.share[slot] = best_t
            else:
                self.main[slot] = best_b
                self.alt[slot] = best_a
                self.share[slot] = 1 - best_t

    def index(self, v):
        return self.main[v + 2] ?? self.clear

    def pick(self, v, x, y):
        slot = v + 2
        alt = self.alt[slot]
        if alt != nil and color.dither(self.share[slot], x, y):
            return alt
        return self.main[slot] ?? self.clear

    # расстояние между двумя цветами терминала (для выбора ближайшего из двух)
    def distance(self, i, j):
        r1, g1, b1 = self.dst:get(i)
        r2, g2, b2 = self.dst:get(j)
        return 0.30 * (r1 - r2) ** 2 + 0.59 * (g1 - g2) ** 2 + 0.11 * (b1 - b2) ** 2

export def new(src, dst, opts=nil):
    return Quantizer(src, dst, opts)

# Адаптивная палитра: подбирает n цветов терминала под картинку (медианное сечение по числу пикселей каждого цвета).
#   list = quant.adaptive(surface, palette, 16)     список из n троек [r, g, b]
# Берутся реально использованные цвета поверхности с весом по числу пикселей; прозрачные (CLEAR) не учитываются.
export def adaptive(s, palette, n=16):
    counts = {}
    for i in range[1, s.w * s.h]:
        v = s.px[i]
        if v >= 0:
            counts[v] = (counts[v] ?? 0) + 1
    items = []
    for v, c in counts:
        r, g, b = palette:get(v)
        items[len(items) + 1] = {r: r, g: g, b: b, n: c}
    if len(items) == 0:
        return [[0, 0, 0]]
    boxes = [items]
    while len(boxes) < n:
        # делим ящик с самым большим «разбросом * вес»
        best = nil
        best_score = -1
        for bi, box in boxes:
            if len(box) > 1:
                lo_r = 255
                hi_r = 0
                lo_g = 255
                hi_g = 0
                lo_b = 255
                hi_b = 0
                total = 0
                for it in box:
                    lo_r = math.min(lo_r, it.r)
                    hi_r = math.max(hi_r, it.r)
                    lo_g = math.min(lo_g, it.g)
                    hi_g = math.max(hi_g, it.g)
                    lo_b = math.min(lo_b, it.b)
                    hi_b = math.max(hi_b, it.b)
                    total += it.n
                score = math.max(hi_r - lo_r, hi_g - lo_g, hi_b - lo_b) * math.sqrt(total)
                if score > best_score:
                    best_score = score
                    best = bi
        if best == nil:
            break
        box = boxes[best]
        lo_r = 255
        hi_r = 0
        lo_g = 255
        hi_g = 0
        lo_b = 255
        hi_b = 0
        for it in box:
            lo_r = math.min(lo_r, it.r)
            hi_r = math.max(hi_r, it.r)
            lo_g = math.min(lo_g, it.g)
            hi_g = math.max(hi_g, it.g)
            lo_b = math.min(lo_b, it.b)
            hi_b = math.max(hi_b, it.b)
        axis = "g"
        if hi_r - lo_r >= hi_g - lo_g and hi_r - lo_r >= hi_b - lo_b:
            axis = "r"
        elif hi_b - lo_b > hi_g - lo_g:
            axis = "b"
        table.sort(box, (p, q) => p[axis] < q[axis])
        # медиана по числу пикселей
        total = 0
        for it in box:
            total += it.n
        acc = 0
        cut = 1
        for i, it in box:
            acc += it.n
            if acc >= total / 2:
                cut = math.min(i, len(box) - 1)
                break
        left = []
        right = []
        for i, it in box:
            if i <= cut:
                left[len(left) + 1] = it
            else:
                right[len(right) + 1] = it
        boxes[best] = left
        boxes[len(boxes) + 1] = right
    out = []
    for box in boxes:
        sr = 0
        sg = 0
        sb = 0
        total = 0
        for it in box:
            sr += it.r * it.n
            sg += it.g * it.n
            sb += it.b * it.n
            total += it.n
        out[len(out) + 1] = [math.floor(sr / total + 0.5), math.floor(sg / total + 0.5), math.floor(sb / total + 0.5)]
    return out
