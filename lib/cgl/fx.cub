# cgl.fx: готовые эффекты для демо, заставок и фонов: плазма, звёздное поле, частицы
#
# Эффекты считаются целыми числами и таблицами, чтобы укладываться в кадр на CC. Для экрана целиком считайте эффект в малом
# размере и растяните blit'ом (opts.scale): 3 раза по каждой оси дают в 9 раз меньше работы.
#
#   p = fx.Plasma(102, 57, ramp)         ramp: список номеров цветов (см. palette:gradient)
#   p:draw(small, time_seconds)          small: Surface 102x57
#   screen.surface:blit(small, 0, 0, {scale: 3})
#
#   st = fx.Starfield(w, h, 80); st:update(dt); st:draw(surface, ramp)
#   ps = fx.Particles(); ps:burst(x, y, 30, {color: 9}); ps:update(dt); ps:draw(surface)

# таблица синуса на 256 шагов, значения 0..63
def _make_sin():
    out = []
    for i in range[0, 255]:
        out[i + 1] = math.floor((math.sin(i * math.pi * 2 / 256) + 1) * 31.5 + 0.5)
    return out

export class Plasma:
    def init(self, w, h, ramp):
        self.w = w
        self.h = h
        self.ramp = ramp
        self.sin = _make_sin()
        self.dist = []
        for y in range[0, h - 1]:
            for x in range[0, w - 1]:
                dx = x - w / 2
                dy = y - h / 2
                self.dist[y * w + x + 1] = math.floor(math.sqrt(dx * dx + dy * dy) * 4) % 256

    def draw(self, s, time):
        n = len(self.ramp)
        tab = self.sin
        t1 = math.floor(time * 40) % 256
        t2 = math.floor(time * 55) % 256
        t3 = math.floor(time * 30) % 256
        w = self.w
        dist = self.dist
        ramp = self.ramp
        s:touch()
        px = s.px
        sw = s.w
        for y in range[0, self.h - 1]:
            sy = tab[(y * 3 + t2) % 256 + 1]
            base = y * sw + 1
            drow = y * w + 1
            for x in range[0, w - 1]:
                v = tab[(x * 2 + t1) % 256 + 1] + sy + tab[(dist[drow + x] + t3) % 256 + 1]
                px[base + x] = ramp[v * n // 190 + 1]

export class Starfield:
    def init(self, w, h, count, opts=nil):
        o = opts ?? {}
        self.w = w
        self.h = h
        self.speed = o.speed ?? 0.9
        self.stars = []
        self.cx = w / 2
        self.cy = h / 2
        self.drawn = []
        for i in range[1, count]:
            self.stars[i] = self:_new_star(true)

    def _new_star(self, anywhere):
        return {x: (math.random() - 0.5) * 2, y: (math.random() - 0.5) * 2, z: anywhere and math.random() or 1}

    def update(self, dt):
        for i, st in self.stars:
            st.z -= self.speed * dt
            if st.z <= 0.02:
                self.stars[i] = self:_new_star(false)

    # стирает нарисованное прошлым draw, возвращая цвета из bg (копия поверхности без звёзд): так фон не перерисовывается целиком
    def erase(self, s, bg):
        d = self.drawn
        if d != nil:
            for i in range[1, len(d)] step 2:
                v = bg:get(d[i], d[i + 1])
                if v != nil:
                    s:set(d[i], d[i + 1], v)
        self.drawn = []

    # ramp: цвета от дальнего (тусклого) к ближнему (яркому); skip = [x0, y0, x1, y1]: прямоугольник, где звёзды не рисуются
    def draw(self, s, ramp, skip=nil):
        self.drawn = []
        drawn = self.drawn
        n = len(ramp)
        scale = math.max(self.w, self.h) / 2
        for st in self.stars:
            px = self.cx + st.x / st.z * scale * 0.4
            py = self.cy + st.y / st.z * scale * 0.4
            if px >= 0 and py >= 0 and px < self.w and py < self.h:
                k = math.floor((1 - st.z) * (n - 1) + 1.5)
                if k > n:
                    k = n
                if k < 1:
                    k = 1
                c = ramp[k]
                x = math.floor(px)
                y = math.floor(py)
                if skip == nil or x < skip[1] or x > skip[3] or y < skip[2] or y > skip[4]:
                    s:set(x, y, c)
                    drawn[len(drawn) + 1] = x
                    drawn[len(drawn) + 1] = y
                    if st.z < 0.25:
                        s:set(x + 1, y, c)
                        s:set(x, y + 1, c)
                        drawn[len(drawn) + 1] = x + 1
                        drawn[len(drawn) + 1] = y
                        drawn[len(drawn) + 1] = x
                        drawn[len(drawn) + 1] = y + 1

export class Particles:
    def init(self, opts=nil):
        o = opts ?? {}
        self.gravity = o.gravity ?? 40
        self.items = []

    def emit(self, x, y, vx, vy, life, c):
        self.items[len(self.items) + 1] = {x: x, y: y, vx: vx, vy: vy, life: life, max: life, c: c}

    # n частиц разлетаются из точки; opts: speed, life, color (номер или список цветов), spread (угол в радианах, по умолчанию весь круг)
    def burst(self, x, y, n, opts=nil):
        o = opts ?? {}
        speed = o.speed ?? 30
        life = o.life ?? 1
        spread = o.spread ?? (math.pi * 2)
        dir = o.direction ?? 0
        for i in range[1, n]:
            a = dir + (math.random() - 0.5) * spread
            v = speed * (0.3 + math.random() * 0.7)
            c = o.color ?? 1
            if type(c) == "table":
                c = c[math.random(1, len(c))]
            self:emit(x, y, math.cos(a) * v, math.sin(a) * v, life * (0.5 + math.random() * 0.5), c)

    def update(self, dt):
        keep = []
        for p in self.items:
            p.life -= dt
            if p.life > 0:
                p.vy += self.gravity * dt
                p.x += p.vx * dt
                p.y += p.vy * dt
                keep[len(keep) + 1] = p
        self.items = keep

    def count(self):
        return len(self.items)

    def draw(self, s):
        for p in self.items:
            s:set(math.floor(p.x + 0.5), math.floor(p.y + 0.5), p.c)

# заменяет цвета по таблице map (цвет -> цвет) на поверхности или в её прямоугольнике (x, y, w, h): быстрое затухание кадра для
# следов за объектами. Изменённая область отмечается только там, где что-то заменилось
export def remap(s, map, x=0, y=0, w=nil, h=nil):
    x0 = math.max(0, x)
    y0 = math.max(0, y)
    x1 = math.min(s.w - 1, x + (w ?? s.w) - 1)
    y1 = math.min(s.h - 1, y + (h ?? s.h) - 1)
    px = s.px
    sw = s.w
    lo_x = 1e9
    hi_x = -1
    lo_y = 1e9
    hi_y = -1
    for yy in range[y0, y1]:
        base = yy * sw + 1
        for xx in range[x0, x1]:
            m = map[px[base + xx]]
            if m != nil:
                px[base + xx] = m
                if xx < lo_x:
                    lo_x = xx
                if xx > hi_x:
                    hi_x = xx
                if lo_y > yy:
                    lo_y = yy
                hi_y = yy
    if hi_x >= 0:
        s:mark(lo_x, lo_y, hi_x, hi_y)

# следы: Trail хранит ряды ступеней яркости (ramps: список списков номеров цветов от тёмного к яркому) и фоновый цвет.
#   t = fx.Trail([ramp_red, ramp_cyan], bg, {every: 1, steps: 1, taper: 0.5})   ramp_red[1] тёмный, ramp_red[n] яркий
#   t:fade(s)                                   каждый кадр: все яркие пиксели на ступень темнее, самые тёмные становятся фоном
#   t:stamp(s, x0, y0, x1, y1, r, ramp)        сплошной мазок объекта из прошлой точки в новую (вместо ряда кругов)
# fade идёт по таблице, одна проверка на пиксель; область (x, y, w, h) задаёт, где затухать (по умолчанию вся поверхность)
export class Trail:
    # opts: every (затухать раз в N вызовов fade; длина следа в кадрах = ступеней * every), steps (на сколько ступеней темнеет
    # за раз: больше значит короче след), min_speed (меньше этого расстояния за кадр мазок рисуется одной точкой, по умолчанию 1.5),
    # taper (0..1: какой доле радиуса сужается хвост мазка, 1 без сужения), from_level (с какой ступени начинается хвост мазка,
    # по умолчанию на 4 темнее самой яркой), max_sweep (самый длинный мазок в пикселях, по умолчанию 400)
    def init(self, ramps, bg, opts=nil):
        o = opts ?? {}
        self.bg = bg
        self.every = o.every ?? 1
        self.steps = math.max(1, o.steps ?? 1)
        self.min_speed = o.min_speed ?? 1.5
        self.taper = o.taper ?? 1
        self.from_level = o.from_level
        self.max_sweep = o.max_sweep ?? 400
        self.count = 0
        self.map = {}
        for ramp in ramps:
            for k in range[1, len(ramp)]:
                target = k - self.steps
                self.map[ramp[k]] = target >= 1 and ramp[target] or bg

    def fade(self, s, x=0, y=0, w=nil, h=nil):
        self.count += 1
        if self.count % self.every != 0:
            return
        remap(s, self.map, x, y, w, h)

    # Сплошной мазок объекта из прошлой точки (x0, y0) в новую (x1, y1): круги радиуса r вдоль отрезка, яркость растёт к новому концу
    # (от ступени from_level до самой яркой), радиус сужается к хвосту по taper. Если объект почти не двигался, рисуется одна точка.
    # Так след выглядит как плавная полоса, а не как ряд кругов в местах прошлых кадров.
    def stamp(self, s, x0, y0, x1, y1, r, ramp):
        n = len(ramp)
        dx = x1 - x0
        dy = y1 - y0
        dist = math.sqrt(dx * dx + dy * dy)
        if dist < self.min_speed:
            s:circle(math.floor(x1 + 0.5), math.floor(y1 + 0.5), r, ramp[n], true)
            return
        dist = math.min(dist, self.max_sweep)
        from_level = self.from_level ?? math.max(1, n - 4)
        spacing = math.max(1, math.floor(r / 2))
        count = math.max(1, math.ceil(dist / spacing))
        for i in range[0, count]:
            t = i / count
            level = math.floor(from_level + (n - from_level) * t + 0.5)
            radius = math.max(1, math.floor(r * (self.taper + (1 - self.taper) * t) + 0.5))
            s:circle(math.floor(x0 + dx * t + 0.5), math.floor(y0 + dy * t + 0.5), radius, ramp[level], true)
