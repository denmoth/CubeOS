# cgl.teletext: вывод поверхности через «телетекстные» символы 128..159, работает на любом цветном терминале CC
#
# Один символ несёт 2x3 пикселя и два цвета (текст и фон), поэтому изображение получается в 2 раза шире и в 3 раза выше, чем
# число клеток: на 51x19 клеток выходит 102x57 пикселей. Из шести пикселей клетки выбираются два самых частых цвета терминала
# (16 цветов CC), остальные пиксели отходят к ближайшему из этих двух. Правый нижний пиксель символа всегда фоновый, поэтому
# при необходимости цвета меняются местами, а рисунок инвертируется.
#
#   d = teletext.new(term, {dither: true})
#   d:open(); d:present(surface); d:close()

import cgl.color as color
import cgl.quant as quant

const HEX = "0123456789abcdef"

export class TeletextDisplay:
    # opts: palette (палитра поверхности), dither, clear, terminal_palette (палитра терминала из 16 цветов; если задана,
    # она переносится в терминал при open)
    def init(self, t, opts=nil):
        o = opts ?? {}
        self.term = t
        self.palette = o.palette ?? color.default_palette()
        self.term_palette = o.terminal_palette ?? color.cc_palette()
        self.load_palette = o.terminal_palette != nil
        self.quant = quant.new(self.palette, self.term_palette, {dither: o.dither ?? false, clear: o.clear})
        self.cols, self.rows = t.getSize()
        self.w = self.cols * 2
        self.h = self.rows * 3
        self.prev = nil
        self.enc = {}
        self.enc_count = 0
        self.spare = nil
        self.stats = {frames: 0, pixels: 0, calls: 0, scan_ms: 0, send_ms: 0}
        self.kind = "teletext"
        self.opened = false

    def open(self):
        self.cols, self.rows = self.term.getSize()
        self.w = self.cols * 2
        self.h = self.rows * 3
        self:sync_palette()
        self.term.setBackgroundColor(2 ** self.quant.clear)
        self.term.clear()
        self.prev = nil
        self.opened = true

    def sync_palette(self):
        if self.load_palette:
            for i in range[0, 15]:
                r, g, b = self.term_palette:get(i)
                self.term.setPaletteColor(2 ** i, r / 255, g / 255, b / 255)
        self.quant:rebuild()
        self.enc = {}
        self.enc_count = 0
        self.prev = nil

    # меняет цвета палитры поверхности: список [номер, r, g, b]; квантование пересчитывается, кадр уходит заново
    def set_colors(self, list):
        for e in list:
            self.palette:set(e[1], e[2], e[3], e[4])
        self.quant:rebuild()
        self.enc = {}
        self.enc_count = 0
        self.prev = nil

    def close(self):
        if self.opened:
            self.term.setBackgroundColor(32768)
            self.term.setTextColor(1)
            self.term.clear()
            self.term.setCursorPos(1, 1)
            self.opened = false

    def invalidate(self):
        self.prev = nil

    def size(self):
        return self.w, self.h

    # клетка (x, y) события мыши -> пиксель в её левом верхнем углу
    def to_pixel(self, x, y):
        return (x - 1) * 2, (y - 1) * 3

    # символ и цвета клетки по шести номерам цветов терминала (слева направо, сверху вниз)
    def encode(self, p):
        q = self.quant
        # два самых частых цвета
        counts = {}
        order = []
        for i in range[1, 6]:
            c = p[i]
            if counts[c] == nil:
                counts[c] = 0
                order[len(order) + 1] = c
            counts[c] += 1
        first = order[1]
        for i in range[2, len(order)]:
            c = order[i]
            if counts[c] > counts[first] or (counts[c] == counts[first] and c < first):
                first = c
        second = first
        best = 0
        for i in range[1, len(order)]:
            c = order[i]
            if c != first and (counts[c] > best or (counts[c] == best and c < second)):
                second = c
                best = counts[c]
        fg = first
        bg = second
        bits = 0
        weight = 1
        for i in range[1, 5]:
            on = p[i] == fg
            if p[i] != fg and p[i] != bg:
                on = q:distance(p[i], fg) < q:distance(p[i], bg)
            if on:
                bits += weight
            weight = weight * 2
        br_fg = p[6] == fg
        if p[6] != fg and p[6] != bg:
            br_fg = q:distance(p[6], fg) < q:distance(p[6], bg)
        if br_fg:
            # правый нижний пиксель должен быть фоновым: меняем роли цветов и инвертируем рисунок
            fg, bg = bg, fg
            bits = 31 - bits
        return 128 + bits, fg, bg

    # символ и цвета для сигнатуры клетки (шесть номеров по 4 бита); результат кэшируется: плоские области и повторяющиеся
    # узоры дают всего несколько разных клеток, и кодировать их заново каждый кадр незачем
    def _encode_sig(self, sig):
        e = self.enc[sig]
        if e != nil:
            return e
        p = [sig % 16, (sig // 16) % 16, (sig // 256) % 16, (sig // 4096) % 16, (sig // 65536) % 16, (sig // 1048576) % 16]
        ch, fg, bg = self:encode(p)
        e = [string.char(ch), string.sub(HEX, fg + 1, fg + 1), string.sub(HEX, bg + 1, bg + 1)]
        if self.enc_count > 30000:
            self.enc = {}
            self.enc_count = 0
        self.enc[sig] = e
        self.enc_count += 1
        return e

    # рисует кадр; возвращает число изменившихся клеток
    def present(self, s):
        t0 = os.epoch("utc")
        send = 0
        cols = math.min(self.cols, s.w // 2)
        rows = math.min(self.rows, s.h // 3)
        q = self.quant
        main = q.main
        clear = q.clear
        dither = q.dither
        full = self.prev == nil
        if full:
            self.prev = {}
        # постоянный массив сигнатур клеток (что сейчас на экране); сканируем только клетки изменённой области
        prev = self.prev
        cur = prev
        cx_lo = 0
        cy_lo = 0
        cx_hi = cols - 1
        cy_hi = rows - 1
        if not full:
            cx_lo = math.max(0, s.dx0 // 2)
            cy_lo = math.max(0, s.dy0 // 3)
            cx_hi = math.min(cols - 1, s.dx1 // 2)
            cy_hi = math.min(rows - 1, s.dy1 // 3)
        s:clean()
        if cx_lo > cx_hi or cy_lo > cy_hi:
            return 0
        spx = s.px
        sw = s.w
        changed = 0
        term = self.term
        for cy in range[cy_lo, cy_hi]:
            first_x = nil
            last_x = nil
            y = cy * 3
            kbase = cy * cols + 1
            for cx in range[cx_lo, cx_hi]:
                x = cx * 2
                i1 = y * sw + x + 1
                i2 = i1 + sw
                i3 = i2 + sw
                p1 = 0
                p2 = 0
                p3 = 0
                p4 = 0
                p5 = 0
                p6 = 0
                if dither:
                    p1 = q:pick(spx[i1], x, y)
                    p2 = q:pick(spx[i1 + 1], x + 1, y)
                    p3 = q:pick(spx[i2], x, y + 1)
                    p4 = q:pick(spx[i2 + 1], x + 1, y + 1)
                    p5 = q:pick(spx[i3], x, y + 2)
                    p6 = q:pick(spx[i3 + 1], x + 1, y + 2)
                else:
                    p1 = main[spx[i1] + 2] ?? clear
                    p2 = main[spx[i1 + 1] + 2] ?? clear
                    p3 = main[spx[i2] + 2] ?? clear
                    p4 = main[spx[i2 + 1] + 2] ?? clear
                    p5 = main[spx[i3] + 2] ?? clear
                    p6 = main[spx[i3 + 1] + 2] ?? clear
                sig = p1 + p2 * 16 + p3 * 256 + p4 * 4096 + p5 * 65536 + p6 * 1048576
                k = kbase + cx
                if full or prev[k] != sig:
                    cur[k] = sig
                    if first_x == nil:
                        first_x = cx
                    last_x = cx
                    changed += 1
            if first_x != nil:
                chars = []
                fgs = []
                bgs = []
                n = 0
                for cx in range[first_x, last_x]:
                    e = self:_encode_sig(cur[kbase + cx])
                    n += 1
                    chars[n] = e[1]
                    fgs[n] = e[2]
                    bgs[n] = e[3]
                ts = os.epoch("utc")
                term.setCursorPos(first_x + 1, cy + 1)
                term.blit(table.concat(chars), table.concat(fgs), table.concat(bgs))
                send += os.epoch("utc") - ts
                self.stats.calls += 1
        self.stats.frames += 1
        self.stats.pixels += changed * 6
        self.stats.send_ms += send
        self.stats.scan_ms += os.epoch("utc") - t0 - send
        return changed

export def new(t, opts=nil):
    return TeletextDisplay(t, opts)
