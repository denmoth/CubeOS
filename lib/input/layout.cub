# input.layout: раскладки клавиатуры для текста. CC присылает события char только в английской раскладке (коды 32..255), поэтому
# русский и украинский текст получается заменой клавиш по их месту на клавиатуре (ЙЦУКЕН).
#
#   lay = layout.new(["en", "ru", "uk"])
#   lay:translate("q")           -> "й" (пока включена русская раскладка)
#   lay:key(keys.leftShift) / lay:key_up(code)       следят за Ctrl, Alt и Shift; key возвращает true, когда раскладка переключилась
#   lay:label()                   -> "RU" (для индикатора)
#
# Переключение (D223): Ctrl+Shift или Alt+Shift, срабатывает при отпускании, если между нажатием и отпусканием не было других клавиш
# (как в Windows; иначе Ctrl+Shift+C и Ctrl+Shift+стрелки меняли бы раскладку). opts.switch: "both" (по умолчанию), "ctrl+shift",
# "alt+shift", "off". Заглавные буквы и Caps Lock работают сами: смотрим на регистр символа.
#   lay:base_char(code, shift)    символ клавиши по её месту в английской раскладке ("q", "Q", ";") или nil
#   lay:native()                  если включена английская, переключиться на первую другую (Windows печатает не латиницу)

import unicode

# место на клавиатуре (английская раскладка), без Shift и с Shift
const BASE = "qwertyuiop[]asdfghjkl;'zxcvbnm,./`"
const SHIFTED = "QWERTYUIOP{}ASDFGHJKL:\"ZXCVBNM<>?~"

const RU_BASE = "йцукенгшщзхъфывапролджэячсмитьбю.ё"
const RU_SHIFTED = "ЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮ,Ё"
# цифровой ряд с Shift отличается
const RU_EXTRA = {"@": "\"", "#": "№", "$": ";", "^": ":", "&": "?"}

const UK_BASE = "йцукенгшщзхїфівапролджєячсмитьбю.ґ"
const UK_SHIFTED = "ЙЦУКЕНГШЩЗХЇФІВАПРОЛДЖЄЯЧСМИТЬБЮ,Ґ"
const UK_EXTRA = {"@": "\"", "#": "№", "$": ";", "^": ":", "&": "?"}

const NAMES = {en: "EN", ru: "RU", uk: "UK"}

def _make(eng, native, extra):
    out = {}
    e = unicode.chars(eng)
    n = unicode.chars(native)
    for i in range[1, len(e)]:
        out[e[i]] = n[i]
    for k, v in extra:
        out[k] = v
    return out

def _table(name):
    if name == "ru":
        m = _make(BASE, RU_BASE, RU_EXTRA)
        s = _make(SHIFTED, RU_SHIFTED, {})
        for k, v in s:
            m[k] = v
        return m
    if name == "uk":
        m = _make(BASE, UK_BASE, UK_EXTRA)
        s = _make(SHIFTED, UK_SHIFTED, {})
        for k, v in s:
            m[k] = v
        return m
    return nil

# клавиши-знаки по имени в keys (буквы берутся из имени как есть)
const PUNCT = {semicolon: ";", semiColon: ";", apostrophe: "'", leftBracket: "[", rightBracket: "]", comma: ",", period: ".", slash: "/",
    grave: "`"}

def _is_mod(code):
    return code == keys.leftShift or code == keys.rightShift or code == keys.leftCtrl or code == keys.rightCtrl or code == keys.leftAlt or code == keys.rightAlt

export class Layout:
    # order: список раскладок по кругу (по умолчанию en, ru); start: с какой начать
    def init(self, order=nil, start=nil, opts=nil):
        self.order = order ?? ["en", "ru"]
        self.switch = (opts ?? {}).switch ?? "both"
        self.armed = false
        self.index = 1
        if start != nil:
            for i in range[1, len(self.order)]:
                if self.order[i] == start:
                    self.index = i
        self.tables = {}
        for name in self.order:
            self.tables[name] = _table(name)
        self.mods = {ctrl: false, alt: false, shift: false}

    def name(self):
        return self.order[self.index]

    def label(self):
        return NAMES[self:name()] ?? string.upper(self:name())

    def next(self):
        self.index = self.index % len(self.order) + 1

    def set(self, name):
        for i in range[1, len(self.order)]:
            if self.order[i] == name:
                self.index = i

    # символ как его печатает текущая раскладка (чужие символы остаются как есть)
    def translate(self, ch):
        t = self.tables[self:name()]
        if t == nil:
            return ch
        return t[ch] ?? ch

    def _track(self, code, down):
        if code == keys.leftShift or code == keys.rightShift:
            self.mods.shift = down
        elif code == keys.leftCtrl or code == keys.rightCtrl:
            self.mods.ctrl = down
        elif code == keys.leftAlt or code == keys.rightAlt:
            self.mods.alt = down

    def _combo(self):
        if not self.mods.shift:
            return false
        sw = self.switch
        return (self.mods.ctrl and (sw == "both" or sw == "ctrl+shift")) or (self.mods.alt and (sw == "both" or sw == "alt+shift"))

    # нажатие клавиши: сочетание взводится, любая другая клавиша его сбрасывает. Всегда false (переключение при отпускании)
    def key(self, code):
        self:_track(code, true)
        if _is_mod(code):
            if self:_combo():
                self.armed = true
        else:
            self.armed = false
        return false

    # отпускание; true, если раскладка переключилась
    def key_up(self, code):
        fire = self.armed and _is_mod(code)
        self:_track(code, false)
        if fire:
            self.armed = false
            if len(self.order) > 1:
                self:next()
                return true
        return false

    def base_char(self, code, shift=false):
        if type(code) != "number":
            return nil
        name = keys.getName(code)
        if name == nil:
            return nil
        ch = PUNCT[name]
        if ch == nil:
            if string.match(name, "^%a$") == nil:
                return nil
            ch = name
        if shift:
            i = string.find(BASE, ch, 1, true)
            if i != nil:
                return string.sub(SHIFTED, i, i)
        return ch

    def native(self):
        if self:name() == "en":
            for i in range[1, len(self.order)]:
                if self.order[i] != "en":
                    self.index = i
                    return true
        return false

export def new(order=nil, start=nil, opts=nil):
    return Layout(order, start, opts)
