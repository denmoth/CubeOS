# json5: разбор и запись JSON5, плюс точечная правка текста с сохранением комментариев.
#
#   json5.parse(text)                    -> значение (null -> json5.null)
#   json5.stringify(value, opts)         -> текст (opts: indent=2, sort_keys=true, json5=false)
#   json5.patch(text, path, value)       -> новый текст: меняет/добавляет одно значение, остальное не трогает
#   json5.remove(text, path)             -> новый текст без одного значения
# path: список ключей (строки) и номеров (с 1), например ["window", "size"] или ["items", 2].

export null = setmetatable({}, {__tostring: () => "null"})
export array_mt = {}

def _fail(st, pos, msg):
    s = st.s
    line = 1
    last_nl = 0
    i = 1
    while true:
        j = string.find(s, "\n", i, true)
        if j == nil or j >= pos:
            break
        line += 1
        last_nl = j
        i = j + 1
    raise Error("json5: line " .. line .. ", column " .. (pos - last_nl) .. ": " .. msg)

def _utf8(cp):
    if cp < 128:
        return string.char(cp)
    if cp < 2048:
        return string.char(192 + cp // 64, 128 + cp % 64)
    if cp < 65536:
        return string.char(224 + cp // 4096, 128 + (cp // 64) % 64, 128 + cp % 64)
    return string.char(240 + cp // 262144, 128 + (cp // 4096) % 64, 128 + (cp // 64) % 64, 128 + cp % 64)

# пропускает пробелы и комментарии
def _skip(st):
    s = st.s
    p = st.pos
    while true:
        a, b = string.find(s, "^[ \t\r\n\v\f]*", p)
        p = b + 1
        c = string.sub(s, p, p)
        if c == "/":
            n = string.sub(s, p + 1, p + 1)
            if n == "/":
                e = string.find(s, "\n", p, true)
                if e == nil:
                    p = len(s) + 1
                else:
                    p = e + 1
            elif n == "*":
                e = string.find(s, "*/", p + 2, true)
                if e == nil:
                    _fail(st, p, "unterminated comment")
                p = e + 2
            else:
                break
        elif c == "\xC2" and string.sub(s, p + 1, p + 1) == "\xA0":
            p += 2
        elif string.sub(s, p, p + 2) == "\xEF\xBB\xBF":
            p += 3
        else:
            break
    st.pos = p

def _hex4(st, p):
    h = string.sub(st.s, p, p + 3)
    if string.find(h, "^%x%x%x%x$") == nil:
        _fail(st, p, "invalid \\u escape")
    return tonumber(h, 16)

# строка в кавычках q ("'" или '"'); pos указывает на открывающую кавычку
def _string(st):
    s = st.s
    q = string.sub(s, st.pos, st.pos)
    p = st.pos + 1
    parts = []
    n = 0
    stop_set = "[\\" .. q .. "\n]"
    while true:
        i = string.find(s, stop_set, p)
        if i == nil:
            _fail(st, st.pos, "unterminated string")
        if i > p:
            n += 1
            parts[n] = string.sub(s, p, i - 1)
        c = string.sub(s, i, i)
        if c == q:
            st.pos = i + 1
            return table.concat(parts)
        if c == "\n":
            _fail(st, i, "unescaped newline in string")
        # escape
        e = string.sub(s, i + 1, i + 1)
        p = i + 2
        piece = nil
        if e == "n":
            piece = "\n"
        elif e == "t":
            piece = "\t"
        elif e == "r":
            piece = "\r"
        elif e == "b":
            piece = "\b"
        elif e == "f":
            piece = "\f"
        elif e == "v":
            piece = "\v"
        elif e == "0":
            if string.find(string.sub(s, p, p), "%d") != nil:
                _fail(st, i, "octal escapes are not allowed")
            piece = "\0"
        elif e == "x":
            h = string.sub(s, p, p + 1)
            if string.find(h, "^%x%x$") == nil:
                _fail(st, i, "invalid \\x escape")
            piece = string.char(tonumber(h, 16))
            p += 2
        elif e == "u":
            cp = _hex4(st, p)
            p += 4
            if cp >= 55296 and cp <= 56319 and string.sub(s, p, p + 1) == "\\u":
                lo = _hex4(st, p + 2)
                if lo >= 56320 and lo <= 57343:
                    cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)
                    p += 6
            piece = _utf8(cp)
        elif e == "\n":
            piece = ""
        elif e == "\r":
            piece = ""
            if string.sub(s, p, p) == "\n":
                p += 1
        elif e == "":
            _fail(st, i, "unterminated string")
        else:
            piece = e
        n += 1
        parts[n] = piece

def _number(st):
    s = st.s
    p = st.pos
    sign = 1
    c = string.sub(s, p, p)
    if c == "-" or c == "+":
        if c == "-":
            sign = -1
        p += 1
    word = string.match(s, "^%a+", p)
    if word == "Infinity":
        st.pos = p + 8
        return sign * math.huge
    if word == "NaN":
        st.pos = p + 3
        return 0 / 0
    a, b = string.find(s, "^0[xX]%x+", p)
    if a != nil:
        st.pos = b + 1
        return sign * tonumber(string.sub(s, p, b))
    a, b = string.find(s, "^%d+%.?%d*", p)
    if a == nil:
        a, b = string.find(s, "^%.%d+", p)
    if a == nil:
        _fail(st, st.pos, "invalid number")
    ea, eb = string.find(s, "^[eE][+-]?%d+", b + 1)
    if ea != nil:
        b = eb
    st.pos = b + 1
    nxt = string.sub(s, st.pos, st.pos)
    if string.find(nxt, "[%w_]") != nil:
        _fail(st, st.pos, "invalid number")
    return sign * tonumber(string.sub(s, p, b))

def _key(st):
    s = st.s
    c = string.sub(s, st.pos, st.pos)
    if c == '"' or c == "'":
        return _string(st)
    a, b = string.find(s, "^[%a_$\x80-\xFF][%w_$\x80-\xFF]*", st.pos)
    if a == nil:
        _fail(st, st.pos, "expected an object key")
    st.pos = b + 1
    return string.sub(s, a, b)

def _object(st):
    start = st.pos
    st.pos += 1
    obj = {}
    members = []
    while true:
        _skip(st)
        if string.sub(st.s, st.pos, st.pos) == "}":
            break
        kstart = st.pos
        k = _key(st)
        kstop = st.pos - 1
        _skip(st)
        if string.sub(st.s, st.pos, st.pos) != ":":
            _fail(st, st.pos, "expected ':' after the key")
        st.pos += 1
        v, node = _value(st)
        if st.track:
            members[len(members) + 1] = {key: k, kstart: kstart, kstop: kstop, node: node}
        if v != nil:
            obj[k] = v
        _skip(st)
        c = string.sub(st.s, st.pos, st.pos)
        if c == ",":
            st.pos += 1
        elif c == "}":
            break
        else:
            _fail(st, st.pos, "expected ',' or '}'")
    st.pos += 1
    if st.track:
        return obj, {kind: "object", start: start, stop: st.pos - 1, members: members}
    return obj, nil

def _array(st):
    start = st.pos
    st.pos += 1
    arr = setmetatable({}, array_mt)
    items = []
    n = 0
    while true:
        _skip(st)
        if string.sub(st.s, st.pos, st.pos) == "]":
            break
        v, node = _value(st)
        n += 1
        arr[n] = v
        if st.track:
            items[n] = node
        _skip(st)
        c = string.sub(st.s, st.pos, st.pos)
        if c == ",":
            st.pos += 1
        elif c == "]":
            break
        else:
            _fail(st, st.pos, "expected ',' or ']'")
    st.pos += 1
    if st.track:
        return arr, {kind: "array", start: start, stop: st.pos - 1, items: items}
    return arr, nil

def _value(st):
    _skip(st)
    s = st.s
    p = st.pos
    c = string.sub(s, p, p)
    if c == "":
        _fail(st, p, "unexpected end of input")
    if c == "{":
        return _object(st)
    if c == "[":
        return _array(st)
    v = nil
    if c == '"' or c == "'":
        v = _string(st)
    elif c == "-" or c == "+" or c == "." or string.find(c, "%d") != nil:
        v = _number(st)
    elif string.sub(s, p, p + 3) == "true":
        st.pos = p + 4
        v = true
    elif string.sub(s, p, p + 4) == "false":
        st.pos = p + 5
        v = false
    elif string.sub(s, p, p + 3) == "null":
        st.pos = p + 4
        v = null
    elif string.sub(s, p, p + 7) == "Infinity":
        st.pos = p + 8
        v = math.huge
    elif string.sub(s, p, p + 2) == "NaN":
        st.pos = p + 3
        v = 0 / 0
    else:
        _fail(st, p, "unexpected character '" .. c .. "'")
    if st.track:
        return v, {kind: "scalar", start: p, stop: st.pos - 1}
    return v, nil


def _parse_text(text, track):
    st = {s: text, pos: 1, track: track}
    v, node = _value(st)
    _skip(st)
    if st.pos <= len(text):
        _fail(st, st.pos, "unexpected characters after the value")
    return v, node

export def parse(text):
    v = _parse_text(text, false)
    return v

# ---------------------------------------------------------------- запись

let _escapes = {["\\"]: "\\\\", ["\n"]: "\\n", ["\r"]: "\\r", ["\t"]: "\\t", ["\b"]: "\\b", ["\f"]: "\\f", ["\v"]: "\\v"}

def _quote(s, q):
    out = string.gsub(s, "[%c\\\"']", (ch) => _escape_char(ch, q))
    return q .. out .. q

def _escape_char(ch, q):
    e = _escapes[ch]
    if e != nil:
        return e
    if ch == q:
        return "\\" .. ch
    if ch == '"' or ch == "'":
        return ch
    return string.format("\\u%04x", string.byte(ch))

def _is_ident(k):
    return string.find(k, "^[%a_$][%w_$]*$") != nil

def _is_array(t):
    if getmetatable(t) == array_mt:
        return true
    count = 0
    for k, v in t:
        if type(k) != "number" or k < 1 or k != math.floor(k):
            return false
        count += 1
    return count > 0 and count == lua("#t")

def _key_order(a, b):
    ta = type(a)
    tb = type(b)
    if ta != tb:
        return ta == "number"
    return a < b

def _sorted_keys(t, sort):
    ks = []
    n = 0
    for k, v in t:
        n += 1
        ks[n] = k
    if sort:
        table.sort(ks, _key_order)
    return ks

def _number_text(v):
    if v != v:
        return "NaN"
    if v == math.huge:
        return "Infinity"
    if v == -math.huge:
        return "-Infinity"
    if v == math.floor(v) and v > -9007199254740992 and v < 9007199254740992:
        return string.format("%d", v)
    text = string.format("%.14g", v)
    if tonumber(text) != v:
        text = string.format("%.17g", v)
    return text

# opts: indent (число пробелов, 0 = в одну строку), sort_keys, json5, quote
def _encode(v, opts, level):
    t = type(v)
    if v == nil or v == null:
        return "null"
    if t == "boolean":
        return v and "true" or "false"
    if t == "number":
        return _number_text(v)
    if t == "string":
        return _quote(v, opts.quote)
    if t != "table":
        raise Error("json5: cannot encode a value of type " .. t)
    pretty = opts.indent > 0
    pad = pretty and string.rep(" ", opts.indent * (level + 1)) or ""
    close_pad = pretty and string.rep(" ", opts.indent * level) or ""
    nl = pretty and "\n" or ""
    comma_end = (pretty and opts.json5) and "," or ""
    item_sep = pretty and ("," .. nl) or (opts.spaced and ", " or ",")
    key_sep = (pretty or opts.spaced) and ": " or ":"
    if _is_array(v):
        n = len(v)
        if n == 0:
            return "[]"
        parts = []
        for i in range[1, n]:
            parts[i] = pad .. _encode(v[i], opts, level + 1)
        return "[" .. nl .. table.concat(parts, item_sep) .. comma_end .. nl .. close_pad .. "]"
    ks = _sorted_keys(v, opts.sort_keys)
    if len(ks) == 0:
        return "{}"
    parts = []
    for i, k in ks:
        kt = type(k)
        key_text = nil
        if kt == "string":
            if opts.json5 and _is_ident(k):
                key_text = k
            else:
                key_text = _quote(k, opts.quote)
        elif kt == "number":
            key_text = _quote(_number_text(k), opts.quote)
        else:
            raise Error("json5: object keys must be strings or numbers")
        parts[i] = pad .. key_text .. key_sep .. _encode(v[k], opts, level + 1)
    return "{" .. nl .. table.concat(parts, item_sep) .. comma_end .. nl .. close_pad .. "}"

def _opts(o):
    r = {indent: 2, sort_keys: true, json5: false, quote: '"'}
    if o != nil:
        for k, v in o:
            r[k] = v
    return r

export def stringify(value, options=nil):
    return _encode(value, _opts(options), 0)

# ---------------------------------------------------------------- точечная правка

def _find_member(node, key):
    for m in node.members:
        if m.key == key:
            return m
    return nil

# следующий значимый символ после позиции p (пропуская пробелы и комментарии): позиция и символ
def _next_sig(text, p):
    st = {s: text, pos: p, track: false}
    _skip(st)
    return st.pos, string.sub(text, st.pos, st.pos)

def _line_indent(text, p):
    # отступ строки, в которой находится позиция p
    ls = p
    while ls > 1 and string.sub(text, ls - 1, ls - 1) != "\n":
        ls -= 1
    return string.match(text, "^[ \t]*", ls)

def _contains_newline(text, a, b):
    return string.find(string.sub(text, a, b), "\n", 1, true) != nil

def _style_of(text, node):
    # стиль ключей и кавычек, взятый из существующих членов объекта
    unquoted = false
    quote = '"'
    for m in node.members:
        first = string.sub(text, m.kstart, m.kstart)
        if first == '"' or first == "'":
            quote = first
        else:
            unquoted = true
        break
    return unquoted, quote

def _nested(path, i, value):
    # собирает вложенные таблицы для остатка пути
    if i > len(path):
        return value
    return {[path[i]]: _nested(path, i + 1, value)}

def _enc(value, text, node, base_indent, multi):
    unquoted, quote = _style_of(text, node)
    if not multi:
        return _encode(value, {indent: 0, spaced: true, sort_keys: true, json5: unquoted, quote: quote}, 0)
    pretty = _encode(value, {indent: 2, sort_keys: true, json5: unquoted, quote: quote}, 0)
    # продолжение строк сдвигаем на отступ родителя
    return (string.gsub(pretty, "\n", "\n" .. base_indent))

def _replace(text, a, b, piece):
    return string.sub(text, 1, a - 1) .. piece .. string.sub(text, b + 1)

def _style_root(text, root):
    if root.kind == "object" and len(root.members) > 0:
        return root
    return {members: []}

def _patch_node(text, root, node, path, i, value):
    key = path[i]
    last = i == len(path)
    if node.kind == "object":
        m = _find_member(node, key)
        if m != nil:
            if last:
                indent = _line_indent(text, m.kstart)
                return _replace(text, m.node.start, m.node.stop, _enc(value, text, _style_root(text, root), indent, _contains_newline(text, node.start, node.stop)))
            return _patch_node(text, root, m.node, path, i + 1, value)
        # новый член
        return _insert_member(text, root, node, key, last and value or _nested(path, i + 1, value))
    if node.kind == "array":
        idx = key
        item = node.items[idx]
        if item != nil:
            if last:
                indent = _line_indent(text, item.start)
                return _replace(text, item.start, item.stop, _enc(value, text, _style_root(text, root), indent, _contains_newline(text, node.start, node.stop)))
            return _patch_node(text, root, item, path, i + 1, value)
        if idx == len(node.items) + 1:
            return _insert_item(text, root, node, last and value or _nested(path, i + 1, value))
        raise Error("json5: array index out of range: " .. tostring(idx))
    raise Error("json5: cannot descend into a scalar value at path element " .. tostring(key))

def _key_text(key, unquoted, quote):
    if unquoted and type(key) == "string" and _is_ident(key):
        return key
    return _quote(tostring(key), quote)

def _insert_member(text, root, node, key, value):
    unquoted, quote = _style_of(text, node)
    ref = len(node.members) > 0 and node or root
    if len(node.members) == 0:
        unquoted, quote = _style_of(text, _style_root(text, root))
    key_text = _key_text(key, unquoted, quote)
    if len(node.members) == 0:
        base = _line_indent(text, node.start)
        body = _enc(value, text, _style_root(text, root), base .. "  ", true)
        piece = "{\n" .. base .. "  " .. key_text .. ": " .. body .. "\n" .. base .. "}"
        return _replace(text, node.start, node.stop, piece)
    last = node.members[len(node.members)]
    indent = _line_indent(text, last.kstart)
    multiline = _contains_newline(text, node.start, last.kstart)
    body = _enc(value, text, _style_root(text, root), indent, multiline)
    pos, ch = _next_sig(text, last.node.stop + 1)
    if multiline:
        if ch == ",":
            # запятая уже есть: вставляем после неё
            piece = "\n" .. indent .. key_text .. ": " .. body .. ","
            return string.sub(text, 1, pos) .. piece .. string.sub(text, pos + 1)
        piece = ",\n" .. indent .. key_text .. ": " .. body
        return string.sub(text, 1, last.node.stop) .. piece .. string.sub(text, last.node.stop + 1)
    if ch == ",":
        piece = " " .. key_text .. ": " .. body .. ","
        return string.sub(text, 1, pos) .. piece .. string.sub(text, pos + 1)
    piece = ", " .. key_text .. ": " .. body
    return string.sub(text, 1, last.node.stop) .. piece .. string.sub(text, last.node.stop + 1)

def _insert_item(text, root, node, value):
    if len(node.items) == 0:
        base = _line_indent(text, node.start)
        body = _enc(value, text, _style_root(text, root), base .. "  ", true)
        return _replace(text, node.start, node.stop, "[" .. body .. "]")
    last = node.items[len(node.items)]
    multiline = _contains_newline(text, node.start, last.start)
    indent = _line_indent(text, last.start)
    body = _enc(value, text, _style_root(text, root), indent, multiline)
    pos, ch = _next_sig(text, last.stop + 1)
    if multiline:
        if ch == ",":
            piece = "\n" .. indent .. body .. ","
            return string.sub(text, 1, pos) .. piece .. string.sub(text, pos + 1)
        piece = ",\n" .. indent .. body
        return string.sub(text, 1, last.stop) .. piece .. string.sub(text, last.stop + 1)
    if ch == ",":
        piece = " " .. body .. ","
        return string.sub(text, 1, pos) .. piece .. string.sub(text, pos + 1)
    return string.sub(text, 1, last.stop) .. ", " .. body .. string.sub(text, last.stop + 1)

# Меняет или добавляет значение по пути, остальной текст (комментарии, отступы) остаётся как был
export def patch(text, path, value):
    v, root = _parse_text(text, true)
    if len(path) == 0:
        return _enc(value, text, _style_root(text, root), "", true)
    return _patch_node(text, root, root, path, 1, value)

def _remove_node(text, node, path, i):
    key = path[i]
    last = i == len(path)
    if node.kind == "object":
        m = _find_member(node, key)
        if m == nil:
            return text
        if not last:
            return _remove_node(text, m.node, path, i + 1)
        return _cut(text, node.members, m, m.kstart, m.node.stop)
    if node.kind == "array":
        item = node.items[key]
        if item == nil:
            return text
        if not last:
            return _remove_node(text, item, path, i + 1)
        return _cut(text, node.items, item, item.start, item.stop)
    return text

# вырезает элемент [a, b] вместе с запятой и пустой строкой
def _cut(text, siblings, target, a, b):
    pos, ch = _next_sig(text, b + 1)
    idx = nil
    for k, sib in siblings:
        if sib == target:
            idx = k
    on_own_line = string.find(string.sub(text, 1, a - 1), "\n[ \t]*$") != nil
    if ch == ",":
        b = pos
        if on_own_line:
            # забираем конец строки после запятой
            tail = string.match(text, "^[ \t]*\n", b + 1)
            if tail != nil:
                b += len(tail)
            a = a - len(string.match(string.sub(text, 1, a - 1), "[ \t]*$"))
        else:
            tail = string.match(text, "^[ \t]*", b + 1)
            b += len(tail)
        return string.sub(text, 1, a - 1) .. string.sub(text, b + 1)
    # последний элемент без запятой: убираем запятую перед ним
    if idx != nil and idx > 1:
        prev = siblings[idx - 1]
        prev_stop = prev.node != nil and prev.node.stop or prev.stop
        cpos, cch = _next_sig(text, prev_stop + 1)
        if cch == ",":
            return string.sub(text, 1, cpos - 1) .. string.sub(text, b + 1)
    if on_own_line:
        a = a - len(string.match(string.sub(text, 1, a - 1), "[ \t]*$"))
        tail = string.match(text, "^[ \t]*\n", b + 1)
        if tail != nil:
            b += len(tail)
    return string.sub(text, 1, a - 1) .. string.sub(text, b + 1)

export def remove(text, path):
    v, root = _parse_text(text, true)
    if len(path) == 0:
        raise Error("json5: remove needs a non-empty path")
    return _remove_node(text, root, path, 1)
