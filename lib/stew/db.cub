# stew.db: пути, база установленных, индекс модулей для загрузчика (boot.idx) и сводка contributes (docs/packages/09-stew-api.md).
#
#   d = db.new(fsys, root)              fsys: CraftOS-подобный fs; root: корень диска ("/" или папка в тестах)
#   d:path("/cubeos/pkg")               путь с учётом root
#   d:load() -> {format, packages: {id: rec}}     d:save(state)
#   d:write_index(state)                /cubeos/var/stew/boot.idx (таблица Lua) и contrib.json5
#   db.placement(id, path) -> куда кладётся файл системного пакета вне пакета (или nil: остаётся внутри)

import json5

export const PKG = "/cubeos/pkg"
export const VAR = "/cubeos/var/stew"
export const SHARE = "/cubeos/share"
export const SYS = "/cubeos/sys"

# Файлы системных пакетов (cubeos.*), которые живут на своих местах, а не внутри пакета. cfg: true значит «не заменять
# изменённое пользователем и не удалять при удалении пакета».
export def placement(id, path):
    if string.sub(id, 1, 7) != "cubeos.":
        return nil
    if path == "sys/startup.lua":
        return {to: "/startup.lua"}
    rest = string.match(path, "^sys/boot/(.+)$")
    if rest != nil:
        return {to: SYS .. "/boot/" .. rest}
    rest = string.match(path, "^sys/services/(.+)$")
    if rest != nil:
        return {to: SYS .. "/services/" .. rest}
    rest = string.match(path, "^sys/cfg/(.+)$")
    if rest != nil:
        return {to: SYS .. "/cfg/" .. rest, cfg: true}
    rest = string.match(path, "^src/(.+)$")
    if rest != nil:
        return {to: SYS .. "/" .. rest}
    rest = string.match(path, "^assets/(.+)$")
    if rest != nil:
        return {to: SHARE .. "/assets/" .. rest}
    return nil

def _arr(t=nil):
    return setmetatable(t ?? {}, json5.array_mt)

# строка Lua без спецсимволов: %q даёт корректный литерал
def _lq(s):
    return string.format("%q", s)

export class Db:
    def init(self, fsys, root="/"):
        self.fs = fsys
        self.root = root

    def path(self, p):
        if self.root == "/" or self.root == "":
            return p
        return "/" .. self.fs.combine(self.root, p)

    def read(self, p):
        h = self.fs.open(self:path(p), "rb")
        if h == nil:
            return nil
        s = h.readAll() ?? ""
        h.close()
        return s

    def write(self, p, data):
        full = self:path(p)
        self.fs.makeDir(self.fs.getDir(full))
        tmp = full .. ".new"
        h = self.fs.open(tmp, "wb")
        if h == nil:
            error("stew: cannot write " .. p, 0)
        h.write(data)
        h.close()
        if self.fs.exists(full):
            self.fs.delete(full)
        self.fs.move(tmp, full)

    def read_json(self, p, default=nil):
        text = self:read(p)
        if text == nil:
            return default
        ok, v = pcall(json5.parse, text)
        if not ok:
            error("stew: " .. p .. " is damaged: " .. tostring(v), 0)
        return v

    def write_json(self, p, v, pretty=false):
        self:write(p, json5.stringify(v, {json5: true, indent: pretty and 2 or 0}) .. "\n")

    def load(self):
        st = self:read_json(VAR .. "/installed.json5", nil) ?? {format: 1, packages: {}}
        st.packages = st.packages ?? {}
        return st

    def save(self, st):
        self:write_json(VAR .. "/installed.json5", st)

    # где лежит код пакета
    def pkg_location(self, rec):
        if rec.storage == "packed":
            return {packed: PKG .. "/" .. rec.id .. ".cpk"}
        return {dir: PKG .. "/" .. rec.id}

    def write_index(self, st):
        ids = []
        for id, _ in st.packages:
            ids[len(ids) + 1] = id
        table.sort(ids)
        lines = ["-- generated by stew, do not edit", "return {"]
        lines[len(lines) + 1] = "  share = " .. _lq(SHARE) .. ", rt = " .. _lq(SYS .. "/cubic/rt.lua") .. ", maps = " .. _lq(self:path(VAR .. "/maps")) .. ","
        if st.packages["cubeos.cubic"] != nil:
            lines[len(lines) + 1] = "  cubic = " .. _lq(SYS .. "/cubic") .. ","
        lines[len(lines) + 1] = "  packages = {"
        for id in ids:
            loc = self:pkg_location(st.packages[id])
            if loc.packed != nil:
                lines[len(lines) + 1] = "    [" .. _lq(id) .. "] = { packed = " .. _lq(self:path(loc.packed)) .. " },"
            else:
                lines[len(lines) + 1] = "    [" .. _lq(id) .. "] = { dir = " .. _lq(self:path(loc.dir)) .. " },"
        lines[len(lines) + 1] = "  },"
        lines[len(lines) + 1] = "  modules = {"
        for id in ids:
            mods = st.packages[id].modules ?? {}
            names = []
            for name, _ in mods:
                names[len(names) + 1] = name
            table.sort(names)
            for name in names:
                lines[len(lines) + 1] = "    [" .. _lq(name) .. "] = { " .. _lq(id) .. ", " .. _lq(mods[name]) .. " },"
        lines[len(lines) + 1] = "  },"
        lines[len(lines) + 1] = "}"
        self:write(VAR .. "/boot.idx", table.concat(lines, "\n") .. "\n")
        self:write_json(VAR .. "/contrib.json5", contrib(st, self))

# Всё, что пакеты дают системе, одной сводкой: потребители (меню, ассоциации, службы, темы...) читают её, а не код пакетов.
# Пути ресурсов становятся полными: внутри распакованного пакета, на своём месте (системные), или "cpk:<id>:<путь>".
export def contrib(st, d=nil):
    out = {}
    kinds = ["apps", "services", "associations", "desktop_icons", "autostart", "settings", "themes", "fonts", "wallpapers", "langs",
        "sounds", "music"]
    for k in kinds:
        out[k] = _arr()
    ids = []
    for id, _ in st.packages:
        ids[len(ids) + 1] = id
    table.sort(ids)
    for id in ids:
        rec = st.packages[id]
        c = rec.contributes ?? {}
        for k in kinds:
            for item in c[k] ?? []:
                copy = {}
                for kk, vv in item:
                    copy[kk] = vv
                copy.package = id
                for field in ["icon", "file", "path", "image"]:
                    v = copy[field]
                    if type(v) == "string" and string.sub(v, 1, 1) != "/":
                        copy[field] = resource_path(rec, v, d)
                out[k][len(out[k]) + 1] = copy
    return out

export def resource_path(rec, rel, d=nil):
    pl = placement(rec.id, rel)
    if pl != nil:
        return d != nil and d:path(pl.to) or pl.to
    if rec.storage == "packed":
        return "cpk:" .. rec.id .. ":" .. rel
    p = PKG .. "/" .. rec.id .. "/" .. rel
    return d != nil and d:path(p) or p

export def new(fsys, root="/"):
    return Db(fsys, root)
