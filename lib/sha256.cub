# sha256: SHA-256, HMAC-SHA256 и PBKDF2-HMAC-SHA256 на чистом Lua (через bit32)
#
#   sha256.hex("abc")        -> "ba7816bf..."   (64 hex-символа)
#   sha256.digest("abc")     -> 32 байта строкой
#   sha256.hmac(key, msg)    -> 32 байта
#   sha256.pbkdf2(password, salt, rounds) -> 32 байта (для хранения паролей)

bxor = bit32.bxor
band = bit32.band
bnot = bit32.bnot
rshift = bit32.rshift
rrot = bit32.rrotate

K = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
]

def _u32(x):
    return string.char(rshift(x, 24), band(rshift(x, 16), 255), band(rshift(x, 8), 255), band(x, 255))

export def digest(msg):
    n = len(msg)
    bits = n * 8
    msg = msg .. "\x80" .. string.rep("\0", (55 - n) % 64) .. _u32(math.floor(bits / 4294967296)) .. _u32(bits % 4294967296)
    h0 = 0x6a09e667
    h1 = 0xbb67ae85
    h2 = 0x3c6ef372
    h3 = 0xa54ff53a
    h4 = 0x510e527f
    h5 = 0x9b05688c
    h6 = 0x1f83d9ab
    h7 = 0x5be0cd19
    w = []
    total = len(msg)
    for start in range[1, total] step 64:
        for i in range[1, 16]:
            p = start + (i - 1) * 4
            b1, b2, b3, b4 = string.byte(msg, p, p + 3)
            w[i] = b1 * 16777216 + b2 * 65536 + b3 * 256 + b4
        for i in range[17, 64]:
            x = w[i - 15]
            y = w[i - 2]
            s0 = bxor(rrot(x, 7), rrot(x, 18), rshift(x, 3))
            s1 = bxor(rrot(y, 17), rrot(y, 19), rshift(y, 10))
            w[i] = band(w[i - 16] + s0 + w[i - 7] + s1, 0xFFFFFFFF)
        a = h0
        b = h1
        c = h2
        d = h3
        e = h4
        f = h5
        g = h6
        h = h7
        for i in range[1, 64]:
            big_s1 = bxor(rrot(e, 6), rrot(e, 11), rrot(e, 25))
            ch = bxor(band(e, f), band(bnot(e), g))
            temp1 = band(h + big_s1 + ch + K[i] + w[i], 0xFFFFFFFF)
            big_s0 = bxor(rrot(a, 2), rrot(a, 13), rrot(a, 22))
            maj = bxor(band(a, b), band(a, c), band(b, c))
            temp2 = big_s0 + maj
            h = g
            g = f
            f = e
            e = band(d + temp1, 0xFFFFFFFF)
            d = c
            c = b
            b = a
            a = band(temp1 + temp2, 0xFFFFFFFF)
        h0 = band(h0 + a, 0xFFFFFFFF)
        h1 = band(h1 + b, 0xFFFFFFFF)
        h2 = band(h2 + c, 0xFFFFFFFF)
        h3 = band(h3 + d, 0xFFFFFFFF)
        h4 = band(h4 + e, 0xFFFFFFFF)
        h5 = band(h5 + f, 0xFFFFFFFF)
        h6 = band(h6 + g, 0xFFFFFFFF)
        h7 = band(h7 + h, 0xFFFFFFFF)
    return _u32(h0) .. _u32(h1) .. _u32(h2) .. _u32(h3) .. _u32(h4) .. _u32(h5) .. _u32(h6) .. _u32(h7)

export def to_hex(raw):
    return (string.gsub(raw, ".", (ch) => string.format("%02x", string.byte(ch))))

export def hex(msg):
    return to_hex(digest(msg))

export def hmac(key, msg):
    if len(key) > 64:
        key = digest(key)
    key = key .. string.rep("\0", 64 - len(key))
    inner = string.gsub(key, ".", (ch) => string.char(bxor(string.byte(ch), 0x36)))
    outer = string.gsub(key, ".", (ch) => string.char(bxor(string.byte(ch), 0x5c)))
    return digest(outer .. digest(inner .. msg))

def _xor_strings(a, b):
    out = []
    for i in range[1, len(a)]:
        out[i] = string.char(bxor(string.byte(a, i), string.byte(b, i)))
    return table.concat(out)

# PBKDF2-HMAC-SHA256, один блок (32 байта). Чем больше rounds, тем дольше подбирать пароль.
export def pbkdf2(password, salt, rounds):
    u = hmac(password, salt .. "\0\0\0\1")
    result = u
    for i in range[2, rounds]:
        u = hmac(password, u)
        result = _xor_strings(result, u)
    return result
