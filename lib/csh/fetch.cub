# csh.fetch: команда fetch (fastfetch): логотип CubeOS блоками телетекста и сведения о системе
#
#   fetch.run(sh)          печатает логотип и справа строки «ключ: значение», внизу цветные квадраты палитры
#
# Логотип это рисунок 32x33 «подпикселя» (куб из трёх граней), который переводится в символы CC 128..159 (блоки 2x3) с двумя цветами
# на клетку, поэтому он выглядит одинаково на настоящем CC, в пиксельном терминале и на мониторе.

import version
import term.chars as chars

const LOGO_W = 32
const LOGO_H = 33
# цвета граней (буквы палитры CC): верх, левая, правая, фон
const TOP = "3"
const LEFT = "9"
const RIGHT = "b"
const BACK = "f"

# точка внутри выпуклого многоугольника (вершины по кругу)
def inside(poly, x, y):
    sign = 0
    n = len(poly)
    for i in range[1, n]:
        a = poly[i]
        b = poly[i % n + 1]
        cross = (b[1] - a[1]) * (y - a[2]) - (b[2] - a[2]) * (x - a[1])
        if cross != 0:
            s = cross > 0 and 1 or -1
            if sign == 0:
                sign = s
            elif sign != s:
                return false
    return true

def pixel_color(x, y):
    if inside([[16, 0], [32, 8], [16, 16], [0, 8]], x, y):
        return TOP
    if inside([[0, 8], [16, 16], [16, 32], [0, 24]], x, y):
        return LEFT
    if inside([[16, 16], [32, 8], [32, 24], [16, 32]], x, y):
        return RIGHT
    return BACK

# рисунок как строки символов CC: список {text, fg, bg} по строкам клеток
export def logo_rows():
    rows = []
    cw = LOGO_W / 2
    ch = math.ceil(LOGO_H / 3)
    for cy in range[0, ch - 1]:
        text = []
        fg = []
        bg = []
        for cx in range[0, cw - 1]:
            px = []
            for sy in range[0, 2]:
                for sx in range[0, 1]:
                    # центр подпикселя
                    px[len(px) + 1] = pixel_color(cx * 2 + sx + 0.5, cy * 3 + sy + 0.5)
            # px[1..6]: левый верх, правый верх, левый середина, правый середина, левый низ, правый низ
            back = px[6]
            counts = {}
            best = nil
            for i in range[1, 5]:
                if px[i] != back:
                    counts[px[i]] = (counts[px[i]] ?? 0) + 1
                    if best == nil or counts[px[i]] > counts[best]:
                        best = px[i]
            if best == nil:
                text[len(text) + 1] = " "
                fg[len(fg) + 1] = back
                bg[len(bg) + 1] = back
            else:
                bits = 0
                for i in range[1, 5]:
                    if px[i] != back:
                        bits += 2 ** (i - 1)
                text[len(text) + 1] = string.char(128 + bits)
                fg[len(fg) + 1] = best
                bg[len(bg) + 1] = back
        rows[len(rows) + 1] = {text: table.concat(text), fg: table.concat(fg), bg: table.concat(bg)}
    return rows

def plural_kb(n):
    if n >= 1073741824:
        return string.format("%.1f GB", n / 1073741824)
    if n >= 1048576:
        return string.format("%.1f MB", n / 1048576)
    return string.format("%.0f KB", n / 1024)

def uptime_text():
    secs = math.floor(os.clock())
    if secs >= 3600:
        return math.floor(secs / 3600) .. " h " .. math.floor(secs / 60) % 60 .. " min"
    if secs >= 60:
        return math.floor(secs / 60) .. " min " .. secs % 60 .. " s"
    return secs .. " s"

# список {key, value} сведений о системе
export def facts(sh):
    env = sh.env
    out = []
    w, h = env.term.getSize()
    out[len(out) + 1] = ["OS", version.full()]
    host = _G._HOST ?? "ComputerCraft"
    out[len(out) + 1] = ["Host", string.gsub(host, " %(.*$", "")]
    out[len(out) + 1] = ["Kernel", "Cubic -> " .. (_G._VERSION ?? "Lua")]
    out[len(out) + 1] = ["Uptime", uptime_text()]
    out[len(out) + 1] = ["Shell", "csh"]
    info = sh.info ?? {}
    out[len(out) + 1] = ["Terminal", w .. "x" .. h .. " cells" .. (info.display != nil and (", " .. info.display) or "")]
    if info.font != nil:
        out[len(out) + 1] = ["Font", info.font]
    id = os.getComputerID()
    label = os.getComputerLabel()
    out[len(out) + 1] = ["Computer", "#" .. id .. (label != nil and (" " .. label) or "")]
    ok, free = pcall(env.fs.getFreeSpace, "/")
    ok2, cap = pcall(env.fs.getCapacity, "/")
    if ok and type(free) == "number":
        if ok2 and type(cap) == "number":
            out[len(out) + 1] = ["Disk", plural_kb(cap - free) .. " / " .. plural_kb(cap)]
        else:
            out[len(out) + 1] = ["Disk", plural_kb(free) .. " free"]
    count = 0
    if env.peripheral != nil:
        count = len(env.peripheral.getNames())
    out[len(out) + 1] = ["Peripherals", tostring(count)]
    out[len(out) + 1] = ["Time", os.date("%Y-%m-%d %H:%M")]
    return out

export def run(sh):
    env = sh.env
    term = env.term
    rows = logo_rows()
    f = facts(sh)
    title = sh.vars.USER .. "@" .. sh.vars.HOST
    lines = []
    lines[1] = {title: true}
    lines[2] = {rule: string.len(title)}
    for kv in f:
        lines[len(lines) + 1] = {key: kv[1], value: kv[2]}
    lines[len(lines) + 1] = {}
    lines[len(lines) + 1] = {blocks: 1}
    lines[len(lines) + 1] = {blocks: 2}
    total = math.max(len(rows), len(lines))
    lw = string.len(rows[1].text)
    # логотип по вертикали посередине, если сведений больше
    top = math.max(0, math.floor((len(lines) - len(rows)) / 2))
    for i in range[1, total]:
        r = rows[i - top]
        if r != nil:
            term.blit(r.text, r.fg, r.bg)
        else:
            term.write(string.rep(" ", lw))
        term.write("  ")
        ln = lines[i]
        if ln != nil:
            if ln.title:
                sh:write_color("5", sh.vars.USER)
                sh:write_color("0", "@")
                sh:write_color("3", sh.vars.HOST)
            elif ln.rule != nil:
                sh:write_color("7", string.rep("-", ln.rule))
            elif ln.key != nil:
                sh:write_color("3", ln.key .. string.rep(" ", 12 - string.len(ln.key)))
                sh:write_color("0", ln.value)
            elif ln.blocks != nil:
                for k in range[1, 8]:
                    idx = (ln.blocks - 1) * 8 + k
                    c = string.sub("0123456789abcdef", idx, idx)
                    term.blit("   ", "000", c .. c .. c)
        sh:println("")
    return 0
