# Демонстрация Cube Graphics Library: заставка, плазма, трёхмерная сцена, галерея фигур и окно, логотип.
# Запуск в игре: game/cgl_demo.lua (стрелки: сцена, D: дизеринг телетекста, A: адаптивные цвета телетекста, M: смена вывода,
# Q: выход, мышь: частицы). Терминал обновляется раз в игровой тик, поэтому кадров больше 20 в секунду на экране не бывает.
#
# main(opts): fps (по умолчанию 20, 0 без ограничения), backend, term (например, монитор), monitor (его имя для касаний), log_path (файл со средним fps по сценам), view_budget (ограничить плазму, 3D и следы окном такого числа пикселей), auto (переключать сцены каждые N кадров и выйти, для проверок), wait, clock.
# Работает с CC: Graphics (пиксели 6x9 на клетку) и на обычном цветном терминале (телетекст, 2x3 пикселя на клетку).

import cgl
import cgl.surface as sf
import cgl.color as color
import cgl.fx as fx
import cgl.g3d as g3d
import cgl.anim as anim
import cgl.cimg as cimg
import font as fontlib
import unicode

const ROOT = "/repo"

# окно для сцен, которые перерисовываются целиком каждый кадр. По умолчанию весь экран; opts.view_budget (число пикселей)
# ограничивает его по центру: на огромном мониторе иначе не больше 6-7 кадров в секунду
def make_view(w, h, budget=nil):
    if budget == nil or w * h <= budget * 1.3:
        return {x: 0, y: 0, w: w, h: h}
    f = math.sqrt(budget / (w * h))
    vw = math.floor(w * f)
    vh = math.floor(h * f)
    return {x: math.floor((w - vw) / 2), y: math.floor((h - vh) / 2), w: vw, h: vh}

def _scale(ctx, graphics_value, text_value):
    return ctx.screen.kind == "graphics" and graphics_value or text_value

# ---------------------------------------------------------------- вспомогательное

# текст по центру с контуром и тенью
def centered(ctx, msg, y, c, scale, outline=nil, x0=0, width=nil):
    width = width ?? ctx.w
    msg = sf.ellipsize(ctx.font, msg, width - 2, "..", 0, scale)
    w = sf.measure(ctx.font, msg, 0, scale)
    ctx.s:text(ctx.font, x0 + math.floor((width - w) / 2), y, msg, c, {scale: scale, outline: outline, shadow: outline == nil and {color: ctx.black, dx: 1, dy: 1} or nil})

def label(ctx, x, y, msg, c):
    msg = sf.ellipsize(ctx.font, msg, ctx.w - x - 1, "..")
    ctx.s:text(ctx.font, x, y, msg, c, {outline: ctx.black})

# ---------------------------------------------------------------- сцена 0: проявление логотипа анимацией палитры

# Надпись нарисована один раз номерами «групп столбцов»; волна проявления меняет только цвета этих номеров в палитре
# (на пиксельном режиме 2 это десятки вызовов setPaletteColor в кадр и ни одного пикселя). На других выводах группы
# перекрашиваются через blit с таблицей замены.
class Intro:
    def init(self, ctx):
        self.band = math.max(1, math.ceil(ctx.w / 48))
        self.groups = math.ceil(ctx.w / self.band)
        self.base = 256 - self.groups
        self.palette_mode = ctx.screen.kind == "graphics" and ctx.screen.display.mode == 2
        self.saved = []
        for g in range[0, self.groups - 1]:
            r, gg, b = ctx.pal:get(self.base + g)
            self.saved[g + 1] = [self.base + g, r, gg, b]
        # маска: каждому пикселю надписи номер группы по его столбцу
        mask = sf.new(ctx.w, ctx.h, sf.CLEAR)
        ink = sf.new(ctx.w, ctx.h, 0)
        scale = math.max(1, math.floor(ctx.w / 80))
        title = "CGL"
        tw = sf.measure(ctx.font, title, scale, scale)
        ty = math.floor(ctx.h * 0.3)
        ink:text(ctx.font, math.floor((ctx.w - tw) / 2), ty, title, 1, {scale: scale, spacing: scale})
        sub = sf.ellipsize(ctx.font, "Cube Graphics Library", ctx.w - 2, "..")
        sw = sf.measure(ctx.font, sub, 0, 1)
        ink:text(ctx.font, math.floor((ctx.w - sw) / 2), ty + 9 * scale + 6, sub, 1)
        for y in range[0, ctx.h - 1]:
            for x in range[0, ctx.w - 1]:
                if ink.px[y * ctx.w + x + 1] == 1:
                    mask.px[y * ctx.w + x + 1] = math.floor(x / self.band)
        self.mask = mask
        self.bg = ctx.pal:ramp([[18, 22, 30], [30, 40, 56]], 12, 0, self.base - 1)
        self.cycle = 3.6
        ctx.s:fill_gradient(0, 0, ctx.w, ctx.h, self.bg, "v")
        if self.palette_mode:
            # номера групп прямо в кадре: base + группа
            for i in range[1, ctx.w * ctx.h]:
                if mask.px[i] != sf.CLEAR:
                    mask.px[i] = mask.px[i] + self.base
            ctx.s:blit(mask, 0, 0)
        self.last = nil

    # цвет группы g в момент u цикла (0..cycle): проявление слева направо, пауза, угасание слева направо
    def group_color(self, g, u, w):
        x = g * self.band
        fade = w * 0.35
        front_in = u / 1.2 * (w + fade) - fade
        k = math.max(0, math.min(1, (front_in - x) / fade))
        if u > 2.4:
            front_out = (u - 2.4) / 1.2 * (w + fade) - fade
            k = k * (1 - math.max(0, math.min(1, (front_out - x) / fade)))
        # блик на фронте проявления
        glow = math.max(0, 1 - math.abs(front_in - x) / (fade * 0.5)) * 0.6
        hr, hg, hb = color.hsv_to_rgb((x / w * 220 + 170 + u * 20) % 360, 0.55, 1)
        r = 24 + (hr - 24) * k + glow * 80
        gr = 30 + (hg - 30) * k + glow * 80
        b = 40 + (hb - 40) * k + glow * 80
        return math.min(255, r), math.min(255, gr), math.min(255, b)

    def draw(self, ctx, dt, t):
        u = t % self.cycle
        entries = []
        for g in range[0, self.groups - 1]:
            r, gg, b = self:group_color(g, u, ctx.w)
            entries[g + 1] = [self.base + g, r, gg, b]
        if self.palette_mode:
            ctx.screen:set_colors(entries)
        else:
            map = {}
            ctx.s:fill_gradient(0, 0, ctx.w, ctx.h, self.bg, "v")
            for g in range[0, self.groups - 1]:
                e = entries[g + 1]
                map[g] = ctx.pal:nearest(e[2], e[3], e[4], 0, self.base - 1)
            ctx.s:blit(self.mask, 0, 0, {map: map})
        if u < 1:
            label(ctx, 2, 2, "палитра меняется, пиксели нет", ctx.light_gray)

    def leave(self, ctx):
        ctx.screen:set_colors(self.saved)

# ---------------------------------------------------------------- сцена 1: заставка

# Небо, солнце, море и полоса палитры рисуются один раз. Каждый кадр меняются только волны (стираются прошлые линии цветом воды),
# звёзды (стираются точки из копии фона) и, пока идёт анимация, прямоугольник заголовка. Так сцена не зависит от размера экрана.
class Title:
    def init(self, ctx):
        s = ctx.s
        self.sky = ctx.pal:ramp([[6, 8, 36], [30, 20, 80], [150, 50, 120], [250, 130, 80], [255, 210, 120]], 30, 0, 207)
        self.sun_ramp = ctx.pal:ramp([[255, 240, 160], [255, 150, 60], [230, 60, 90]], 6, 0, 207)
        s:fill_gradient(0, 0, ctx.w, ctx.h, self.sky, "v")
        self.horizon = math.floor(ctx.h * 0.72)
        r = math.floor(ctx.h * 0.22)
        sx = math.floor(ctx.w / 2)
        n = len(self.sun_ramp)
        bh = math.ceil(r / n)
        for i in range[0, n - 1]:
            s:push_clip(0, self.horizon - r + i * bh, ctx.w, bh)
            s:circle(sx, self.horizon, r, self.sun_ramp[i + 1], true)
            s:pop_clip()
        s:fill_rect(0, self.horizon, ctx.w, ctx.h - self.horizon, ctx.deep)
        if ctx.screen.kind == "graphics":
            for i in range[0, 207]:
                s:fill_rect(math.floor(i * ctx.w / 208), ctx.h - 4, math.ceil(ctx.w / 208), 4, i)
        self.bg = s:copy()
        self.stars = fx.Starfield(ctx.w, ctx.h, 40, {speed: 0.05})
        self.animator = anim.Animator()
        self.drop = {y: -40}
        self.scale = math.max(1, math.floor(ctx.w / 70))
        self.title = "CGL"
        self.sub = sf.ellipsize(ctx.font, "Cube Graphics Library", ctx.w - 2, "..")
        self.typed = {n: 0}
        # прямоугольник, который занимает заголовок за всё время анимации
        tw = sf.measure(ctx.font, self.title, 0, self.scale)
        sw = sf.measure(ctx.font, self.sub, 0, 1)
        self.rect = [math.floor((ctx.w - math.max(tw, sw)) / 2) - 3 * self.scale, 0, math.max(tw, sw) + 6 * self.scale,
            math.floor(ctx.h * 0.18) + 9 * self.scale + 3 + 14]
        let me = self
        self.animator:add(anim.tween({from: -40, to: math.floor(ctx.h * 0.18), time: 1.4, ease: "out_bounce", delay: 0.2,
            on_update: (v) => me:set_drop(v)}))
        self.animator:add(anim.tween({from: 0, to: unicode.length(self.sub), time: 1.6, delay: 1.2, on_update: (v) => me:set_typed(v)}))
        self.title_done = false
        self.prev_t = nil

    def set_drop(self, v):
        self.drop.y = v

    def set_typed(self, v):
        self.typed.n = math.floor(v)

    def draw_waves(self, ctx, t, colors):
        s = ctx.s
        for k in range[0, 3]:
            yy = self.horizon + 2 + k * k * math.floor(ctx.h / 40) + k
            prev_x = 0
            prev_y = yy
            for x in range[0, ctx.w - 1] step 2:
                y2 = yy + math.floor(math.sin(x / (6 + k * 2) + t * (1 + k * 0.4)) * (1 + k * 0.5))
                s:line(prev_x, prev_y, x, y2, colors[k + 1])
                prev_x = x
                prev_y = y2

    def draw(self, ctx, dt, t):
        s = ctx.s
        r = self.rect
        self.stars:erase(s, self.bg)
        if self.prev_t != nil:
            self:draw_waves(ctx, self.prev_t, [ctx.deep, ctx.deep, ctx.deep, ctx.deep])
        self.stars:update(dt)
        self.stars:draw(s, [ctx.dark_gray, ctx.light_gray, ctx.white], [r[1], r[2], r[1] + r[3], r[2] + r[4]])
        self:draw_waves(ctx, t, ctx.waves)
        self.prev_t = t
        animating = self.animator:busy()
        if animating or not self.title_done:
            self.animator:update(dt)
            s:restore(self.bg, r[1], r[2], r[3], r[4])
            centered(ctx, self.title, math.floor(self.drop.y), ctx.white, self.scale, ctx.black)
            if self.typed.n > 0:
                centered(ctx, unicode.sub(self.sub, 1, self.typed.n), math.floor(self.drop.y) + 9 * self.scale + 3, ctx.yellow, 1, ctx.black)
            if not animating:
                self.title_done = true

# ---------------------------------------------------------------- сцена 2: плазма

# Плазма занимает окно не больше ~90 тысяч пикселей: перерисовывать весь большой монитор 20 раз в секунду Lua не может
class PlasmaScene:
    def init(self, ctx):
        v = ctx.view
        self.v = v
        if v.w < ctx.w:
            ctx.s:rect(v.x - 2, v.y - 2, v.w + 4, v.h + 4, ctx.gray)
        # считаем плазму не крупнее ~110 пикселей в ширину и растягиваем
        self.k = math.max(1, math.ceil(v.w / 110))
        self.small = sf.new(math.ceil(v.w / self.k), math.ceil(v.h / self.k), 0)
        ramp = ctx.pal:ramp(color.rainbow_stops(12, 0.9, 1), 48, 0, 207)
        self.plasma = fx.Plasma(self.small.w, self.small.h, ramp)

    def draw(self, ctx, dt, t):
        v = self.v
        s = ctx.s
        self.plasma:draw(self.small, t)
        s:push_clip(v.x, v.y, v.w, v.h)
        s:blit(self.small, v.x, v.y, {scale: self.k})
        s:pop_clip()
        centered(ctx, "Plasma", v.y + math.floor(v.h / 2) - 5, ctx.white, _scale(ctx, 2, 1), ctx.black, v.x, v.w)

# ---------------------------------------------------------------- сцена 3: трёхмерная графика

class Scene3D:
    def init(self, ctx):
        v = ctx.view
        self.v = v
        if v.w < ctx.w:
            ctx.s:rect(v.x - 2, v.y - 2, v.w + 4, v.h + 4, ctx.gray)
        self.stars = fx.Starfield(v.w, v.h, 60, {speed: 0.35})
        self.torus = g3d.torus(1, 0.42, 18, 10)
        self.cube = g3d.cube(1)
        self.ramp = ctx.pal:ramp([[8, 20, 60], [30, 90, 200], [90, 200, 255], [255, 255, 255]], 10, 0, 207)
        self.ramp2 = ctx.pal:ramp([[40, 10, 10], [200, 60, 40], [255, 200, 90]], 6, 0, 207)
        # трёхмерная часть считается в уменьшенном размере и растягивается
        self.k = math.max(1, math.ceil(v.w / 150))
        self.small = sf.new(math.ceil(v.w / self.k), math.ceil(v.h / self.k), sf.CLEAR)

    def draw(self, ctx, dt, t):
        v = self.v
        s = ctx.s
        s:push_clip(v.x, v.y, v.w, v.h)
        s:push_origin(v.x, v.y)
        s:fill_rect(0, 0, v.w, v.h, ctx.deep)
        self.stars:update(dt)
        self.stars:draw(s, [ctx.dark_gray, ctx.gray, ctx.light_gray, ctx.white])
        sm = self.small
        sm:clear(sf.CLEAR)
        g3d.render(sm, self.torus, {mode: "flat", ramp: self.ramp, rx: t * 0.7, ry: t * 0.45, z: 3.6, fov: sm.h * 1.3})
        size = math.floor(sm.h * 0.3)
        g3d.render(sm, self.cube, {mode: "flat", ramp: self.ramp2, rx: t * 0.9, ry: t * 1.3, rz: t * 0.3, z: 5, fov: sm.h * 1.2,
            cx: sm.w - size, cy: size})
        g3d.render(sm, self.cube, {mode: "wire", color: ctx.green, rx: -t * 0.6, ry: t * 0.8, z: 5, fov: sm.h * 1.2,
            cx: size, cy: sm.h - size})
        s:blit(sm, 0, 0, {scale: self.k})
        s:text(ctx.font, 2, 2, "g3d: flat + wire", ctx.white, {outline: ctx.black})
        s:pop_origin()
        s:pop_clip()

# ---------------------------------------------------------------- сцена 4: фигуры и окно

# Окно рисуется один раз и запоминается; каждый кадр восстанавливаются и перерисовываются только полоса прогресса, ряд кругов и
# место, где летают частицы
class Gallery:
    def init(self, ctx):
        s = ctx.s
        self.particles = fx.Particles({gravity: 60})
        self.bar = {v: 0}
        self.animator = anim.Animator()
        let me = self
        self.animator:add(anim.tween({from: 0, to: 1, time: 2.5, ease: "in_out_sine", repeat: -1, yoyo: true,
            on_update: (v) => me:set_bar(v)}))
        bgramp = ctx.pal:ramp([[18, 24, 48], [40, 56, 96]], 16, 0, 207)
        self.hue = ctx.pal:ramp(color.rainbow_stops(6, 0.8, 1), 24, 0, 207)
        s:fill_gradient(0, 0, ctx.w, ctx.h, bgramp, "v")
        wx = math.floor(ctx.w * 0.1)
        wy = math.floor(ctx.h * 0.12)
        ww = math.floor(ctx.w * 0.8)
        wh = math.floor(ctx.h * 0.76)
        s:round_rect(wx + 3, wy + 3, ww, wh, 4, ctx.black, true)
        s:round_rect(wx, wy, ww, wh, 4, ctx.panel, true)
        s:round_rect(wx, wy, ww, wh, 4, ctx.light_gray, false)
        s:push_clip(wx, wy, ww, 11)
        s:fill_gradient(wx, wy, ww, 11, self.hue, "h")
        s:pop_clip()
        s:circle(wx + 7, wy + 5, 2, ctx.red, true)
        s:circle(wx + 14, wy + 5, 2, ctx.yellow, true)
        s:circle(wx + 21, wy + 5, 2, ctx.green, true)
        s:text(ctx.font, wx + 28, wy + 1, "cgl: окно", ctx.black)
        self.px = wx + 6
        self.py = wy + 16
        self.pw = ww - 12
        px = self.px
        py = self.py
        pw = self.pw
        s:rect(px, py, pw, 7, ctx.light_gray)
        s:fill_pattern(px, py + 11, math.floor(pw / 3), 14, [0x55, 0xAA, 0x55, 0xAA, 0x55, 0xAA, 0x55, 0xAA], ctx.cyan, ctx.blue)
        s:ellipse(px + math.floor(pw * 0.55), py + 18, 14, 7, ctx.orange, true)
        s:ellipse(px + math.floor(pw * 0.55), py + 18, 14, 7, ctx.white, false)
        s:triangle(px + pw - 24, py + 30, px + pw - 4, py + 30, px + pw - 14, py + 44, ctx.yellow, true)
        s:triangle(px + pw - 24, py + 30, px + pw - 4, py + 30, px + pw - 14, py + 44, ctx.white, false)
        s:text(ctx.font, px, wy + wh - 11, "Клик: частицы", ctx.white)
        self.bg = s:copy()
        self.pbox = nil

    def set_bar(self, v):
        self.bar.v = v

    def click(self, ctx, x, y):
        self.particles:burst(x, y, 40, {speed: 70, life: 1.4, color: [ctx.yellow, ctx.orange, ctx.red, ctx.white]})

    def draw(self, ctx, dt, t):
        s = ctx.s
        self.animator:update(dt)
        px = self.px
        py = self.py
        pw = self.pw
        # полоса прогресса
        s:restore(self.bg, px + 1, py + 1, pw - 2, 5)
        s:fill_rect(px + 1, py + 1, math.floor((pw - 2) * self.bar.v), 5, ctx.green)
        # ряд кругов
        s:restore(self.bg, px, py + 28, 60, 18)
        for i in range[0, 4]:
            s:circle(px + 6 + i * 10, py + 36 + math.floor(math.sin(t * 3 + i) * 3), 4, self.hue[i * 4 + 1], true)
        # частицы: стираем прошлый прямоугольник, двигаем, рисуем
        if self.pbox != nil:
            b = self.pbox
            s:restore(self.bg, b[1] - 1, b[2] - 1, b[3] - b[1] + 3, b[4] - b[2] + 3)
            self.pbox = nil
        self.particles:update(dt)
        items = self.particles.items
        if len(items) > 0:
            self.particles:draw(s)
            x0 = 1e9
            y0 = 1e9
            x1 = -1e9
            y1 = -1e9
            for p in items:
                x0 = math.min(x0, math.floor(p.x + 0.5))
                y0 = math.min(y0, math.floor(p.y + 0.5))
                x1 = math.max(x1, math.floor(p.x + 0.5))
                y1 = math.max(y1, math.floor(p.y + 0.5))
            self.pbox = [x0, y0, x1, y1]

# ---------------------------------------------------------------- сцена 5: следы

# Три шара летают по фигурам Лиссажу. Следы делает fx.Trail: каждый кадр все яркие пиксели темнеют на ступень (одна проверка в
# таблице на пиксель), потом шары рисуются самой яркой ступенью. Для плавности нужны ступени яркости, поэтому на время сцены
# последние 48 номеров палитры перекрашиваются в три оттенка по 16 ступеней (после сцены палитра возвращается).
class Trails:
    def init(self, ctx):
        v = ctx.view
        self.v = v
        if v.w < ctx.w:
            ctx.s:rect(v.x - 2, v.y - 2, v.w + 4, v.h + 4, ctx.gray)
        ctx.s:fill_rect(v.x, v.y, v.w, v.h, ctx.deep)
        self.base = 208
        hues = [[255, 80, 70], [70, 200, 255], [255, 220, 70]]
        self.saved = []
        entries = []
        self.ramps = []
        for h in range[0, 2]:
            steps = color.shade_steps(hues[h + 1][1], hues[h + 1][2], hues[h + 1][3], 16, 6, 8, 24)
            ramp = []
            for k in range[1, 16]:
                slot = self.base + h * 16 + k - 1
                r, g, b = ctx.pal:get(slot)
                self.saved[len(self.saved) + 1] = [slot, r, g, b]
                entries[len(entries) + 1] = [slot, steps[k][1], steps[k][2], steps[k][3]]
                ramp[k] = slot
            self.ramps[h + 1] = ramp
        ctx.screen:set_colors(entries)
        # настройки: след длиной 16 кадров, хвост мазка сужается до 40% радиуса
        self.trail = fx.Trail(self.ramps, ctx.deep, {every: 1, steps: 1, taper: 0.4})
        self.prev = []

    def leave(self, ctx):
        ctx.screen:set_colors(self.saved)

    def draw(self, ctx, dt, t):
        v = self.v
        s = ctx.s
        self.trail:fade(s, v.x, v.y, v.w, v.h)
        cx = v.x + v.w / 2
        cy = v.y + v.h / 2
        r = math.max(2, math.floor(v.h / 28))
        for i in range[0, 2]:
            a = t * (1.1 + i * 0.37) + i * 2.1
            b = t * (0.8 + i * 0.53) + i
            x = cx + math.sin(a) * v.w * 0.42
            y = cy + math.sin(b) * v.h * 0.4
            p = self.prev[i + 1] ?? [x, y]
            self.trail:stamp(s, p[1], p[2], x, y, r, self.ramps[i + 1])
            self.prev[i + 1] = [x, y]
        s:text(ctx.font, v.x + 2, v.y + 2, "fx.Trail: мазок вместо кругов", ctx.white)

# ---------------------------------------------------------------- сцена 6: логотип

class LogoScene:
    def init(self, ctx):
        s = ctx.s
        self.logo = cimg.read_file(ROOT .. "/assets/images/cubeos-logo.cimg")
        bg = ctx.pal:ramp([[10, 14, 30], [30, 40, 80]], 12, 0, 207)
        s:fill_gradient(0, 0, ctx.w, ctx.h, bg, "v")
        self.bg = s:copy()
        self.k = ctx.h >= 120 and 1 or 0.4
        self.lw = math.floor(self.logo.w * self.k)
        self.lh = math.floor(self.logo.h * self.k)
        self.base = math.floor(ctx.h * 0.78)
        half = math.floor(self.lw * 0.6) + 6
        top = self.base - self.lh - math.floor(ctx.h * 0.25) - 3
        # полоса, в которой всё происходит (логотип, тень, подпись)
        self.band = [math.floor(ctx.w / 2) - half, top, half * 2, self.base + 24 - top]

    def draw(self, ctx, dt, t):
        s = ctx.s
        b = self.band
        s:restore(self.bg, b[1], b[2], b[3], b[4])
        bounce = math.abs(math.sin(t * 2.2))
        y = self.base - self.lh - math.floor(bounce * ctx.h * 0.25)
        # тень на полу уменьшается с высотой
        sh = math.floor(self.lw * (0.6 - bounce * 0.25))
        s:ellipse(math.floor(ctx.w / 2), self.base + 2, math.max(2, sh), math.max(1, math.floor(sh / 4)), ctx.black, true)
        # «монета»: сжатие по горизонтали
        squeeze = math.abs(math.cos(t * 1.1))
        sw = math.max(1, self.lw * squeeze)
        s:blit(self.logo, math.floor((ctx.w - sw) / 2), y, {scale_x: sw / self.logo.w, scale_y: self.k, flip_x: math.cos(t * 1.1) < 0})
        centered(ctx, "CubeOS", self.base + 8, ctx.white, 1, ctx.black)

# ---------------------------------------------------------------- запуск

export def main(opts=nil):
    o = opts ?? {}
    backend = o.backend ?? "auto"
    screen = cgl.open({backend: backend, term: o.term})
    fnt = fontlib.default(ROOT .. "/assets")
    ctx = {screen: screen, s: screen.surface, w: screen.w, h: screen.h, font: fnt, pal: screen.palette, t: 0}
    p = screen.palette

    # цвета интерфейса берутся из первых 208 номеров: последние отданы анимации палитры в интро
    def near(r, g, b):
        return p:nearest(r, g, b, 0, 207)

    ctx.black = near(0, 0, 0)
    ctx.white = near(255, 255, 255)
    ctx.deep = near(6, 8, 24)
    ctx.dark_gray = near(60, 60, 70)
    ctx.gray = near(110, 110, 120)
    ctx.light_gray = near(190, 190, 200)
    ctx.yellow = near(255, 220, 60)
    ctx.orange = near(255, 140, 30)
    ctx.red = near(230, 60, 60)
    ctx.green = near(70, 220, 90)
    ctx.cyan = near(70, 200, 230)
    ctx.blue = near(40, 70, 190)
    ctx.panel = near(34, 40, 66)
    ctx.waves = [near(250, 150, 90), near(220, 90, 130), near(150, 60, 150), near(80, 40, 120)]
    # окно для тяжёлых сцен (плазма, 3D, следы): по умолчанию весь экран
    ctx.view = make_view(ctx.w, ctx.h, o.view_budget)
    classes = [Intro, Title, PlasmaScene, Scene3D, Gallery, Trails, LogoScene]
    names = ["Интро", "Заставка", "Плазма", "3D", "Фигуры", "Следы", "Логотип"]
    state = {index: 1, scene: nil, quit: false, flip: false, adapted: false}
    perf = []
    for i in range[1, len(classes)]:
        perf[i] = {frames: 0, time: 0}

    def enter(i):
        if state.scene != nil and state.scene.leave != nil:
            state.scene:leave(ctx)
        state.index = i
        ctx.s = ctx.screen.surface
        ctx.s:clear(ctx.black)
        state.scene = classes[i](ctx)

    def key(code):
        if code == keys.right or code == keys.space:
            enter(state.index % len(classes) + 1)
        elif code == keys.left:
            enter((state.index - 2) % len(classes) + 1)
        elif code == keys.q:
            state.quit = true
        elif code == keys.d and ctx.screen.kind == "teletext":
            q = ctx.screen.display.quant
            q.dither = not q.dither
            q:rebuild()
            ctx.screen.display:invalidate()
        elif code == keys.a and ctx.screen.display.adapt != nil and ctx.screen.kind == "teletext":
            # адаптивные цвета: 16 цветов терминала подбираются под текущую картинку, ещё раз A возвращает стандартные
            if state.adapted:
                ctx.screen.display:reset_terminal_palette()
                state.adapted = false
            else:
                ctx.screen:adapt()
                state.adapted = true
        elif code == keys.m:
            state.flip = true
            ctx.screen:stop()

    def on_event(ev, a, b, c):
        if ev == "key":
            key(a)
        elif ev == "mouse_click" and state.scene.click != nil:
            px, py = ctx.screen:to_pixel(b, c)
            state.scene:click(ctx, px, py)
        elif ev == "monitor_touch" and a == o.monitor and state.scene.click != nil:
            # касание монитора приходит в клетках; в пиксельном режиме переводим клетку в пиксель её угла
            if ctx.screen.kind == "graphics":
                state.scene:click(ctx, (b - 1) * 6, (c - 1) * 9)
            else:
                px, py = ctx.screen:to_pixel(b, c)
                state.scene:click(ctx, px, py)
        elif ev == "term_resize" or (ev == "monitor_resize" and a == o.monitor):
            state.flip = true
            ctx.screen:stop()
        return state.quit

    def update(dt, frame):
        ctx.t += dt
        if frame > 0:
            rec = perf[state.index]
            rec.frames += 1
            rec.time += dt
        if o.auto != nil and frame > 0 and frame % o.auto == 0:
            if state.index == len(classes):
                state.quit = true
            else:
                enter(state.index + 1)
        ctx.s = ctx.screen.surface
        state.scene:draw(ctx, dt, ctx.t)
        # подпись на своём фоне: сцены вроде «Интро» не перерисовывают кадр, и цифры fps иначе накладывались бы друг на друга
        info = names[state.index] .. "  " .. math.floor(ctx.screen.fps + 0.5) .. " fps  [" .. ctx.screen.kind .. "]"
        info = sf.ellipsize(ctx.font, info, ctx.w - 3, "..")
        ctx.s:fill_rect(0, ctx.h - 11, sf.measure(ctx.font, info) + 4, 11, ctx.black)
        label(ctx, 2, ctx.h - 10, info, ctx.white)
        return not state.quit

    enter(1)
    while not state.quit:
        state.flip = false
        ctx.screen:run(update, {fps: o.fps ?? 20, on_event: on_event, wait: o.wait, clock: o.clock})
        if state.flip and not state.quit:
            kind = ctx.screen.kind == "graphics" and "teletext" or "graphics"
            ctx.screen:close()
            ctx.screen = cgl.open({backend: kind, term: o.term})
            ctx.s = ctx.screen.surface
            ctx.w = ctx.screen.w
            ctx.h = ctx.screen.h
            ctx.pal = ctx.screen.palette
            ctx.view = make_view(ctx.w, ctx.h, o.view_budget)
            enter(state.index)
        else:
            state.quit = true
    st = ctx.screen.display.stats
    if o.log_path != nil:
        lines = ["CGL demo: " .. ctx.screen.kind .. " " .. ctx.w .. "x" .. ctx.h]
        for i in range[1, len(classes)]:
            r = perf[i]
            if r.time > 0:
                lines[len(lines) + 1] = names[i] .. ": " .. string.format("%.1f", r.frames / r.time) .. " fps (" .. r.frames .. " frames)"
        lines[len(lines) + 1] = "present: scan " .. st.scan_ms .. " ms, send " .. st.send_ms .. " ms, calls " .. st.calls .. ", frames " .. st.frames
        f = fs.open(o.log_path, "w")
        if f != nil:
            f.write(table.concat(lines, "\n") .. "\n")
            f.close()
    ctx.screen:close()
